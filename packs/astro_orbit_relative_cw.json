  "nodes": [
    {
      "id": "astro.cw.cw01_lvlh_frame_def",
      "short_code": "CW01",
      "kind": "definition",
      "title": "LVLH（局所垂直・局所水平）回転座標系と相対位置ベクトルの定義",
      "summary": "半径 r0 の円軌道上を平均運動 n で周回する基準機（チーフ）に固定された LVLH 右手正規直交基底と、追従機（デピュティ）の相対位置ベクトルを定義する。",
      "canonical_latex": "\\hat{\\mathbf{i}} := \\frac{\\mathbf{r}_0}{r_0},\\quad \\hat{\\mathbf{k}} := \\frac{\\mathbf{h}_0}{h_0},\\quad \\hat{\\mathbf{j}} := \\hat{\\mathbf{k}} \\times \\hat{\\mathbf{i}},\\quad \\boldsymbol{\\omega} = n\\hat{\\mathbf{k}},\\quad \\boldsymbol{\\rho} := \\mathbf{r} - \\mathbf{r}_0 = x\\hat{\\mathbf{i}} + y\\hat{\\mathbf{j}} + z\\hat{\\mathbf{k}}",
      "aliases_latex": [
        "\\mathbf{r} = \\mathbf{r}_0 + \\boldsymbol{\\rho},\\; \\boldsymbol{\\rho} = (x, y, z)_{\\mathrm{LVLH}}^\\top,\\; \\mathbf{r}_0 = r_0\\hat{\\mathbf{i}},\\; n = \\sqrt{\\mu / r_0^3}"
      ],
      "keywords": [
        "LVLH",
        "Hill frame",
        "relative motion",
        "circular orbit",
        "rotating frame"
      ],
      "domain_tags": [
        "orbital_mechanics",
        "spacecraft_rendezvous"
      ]
    },
    {
      "id": "astro.cw.cw02_rotating_frame_kinematics",
      "short_code": "CW02",
      "kind": "theorem_formula",
      "title": "LVLH 回転座標系における相対加速度の運動学的変換",
      "summary": "定角速度 ω = n k_hat で回転する LVLH 座標系における輸送定理を用いて、慣性系加速度の差を LVLH 成分の 2 階微分・コリオリ項・遠心力項へ展開する。",
      "canonical_latex": "\\ddot{\\mathbf{r}} - \\ddot{\\mathbf{r}}_0 = (\\ddot{x} - 2n\\dot{y} - n^2 x)\\hat{\\mathbf{i}} + (\\ddot{y} + 2n\\dot{x} - n^2 y)\\hat{\\mathbf{j}} + \\ddot{z}\\hat{\\mathbf{k}}",
      "aliases_latex": [
        "\\ddot{\\boldsymbol{\\rho}}_{\\mathrm{inertial}} = \\ddot{\\boldsymbol{\\rho}}_{\\mathrm{LVLH}} + 2\\boldsymbol{\\omega}\\times\\dot{\\boldsymbol{\\rho}}_{\\mathrm{LVLH}} + \\boldsymbol{\\omega}\\times(\\boldsymbol{\\omega}\\times\\boldsymbol{\\rho})"
      ],
      "keywords": [
        "transport theorem",
        "Coriolis acceleration",
        "centrifugal acceleration",
        "LVLH kinematics"
      ],
      "domain_tags": [
        "orbital_mechanics",
        "kinematics"
      ]
    },
    {
      "id": "astro.cw.cw03_nonlinear_relative_eom",
      "short_code": "CW03",
      "kind": "theorem_formula",
      "title": "2体重力場における厳密な非線形相対運動方程式",
      "summary": "基準機と追従機の双方に 2 体問題のニュートン重力を適用し、LVLH 回転座標系における厳密な非線形相対運動方程式を導く。",
      "canonical_latex": "\\ddot{x} - 2n\\dot{y} - n^2(r_0 + x) = -\\frac{\\mu(r_0 + x)}{\\left[(r_0+x)^2 + y^2 + z^2\\right]^{3/2}},\\quad \\ddot{y} + 2n\\dot{x} - n^2 y = -\\frac{\\mu y}{\\left[(r_0+x)^2 + y^2 + z^2\\right]^{3/2}},\\quad \\ddot{z} = -\\frac{\\mu z}{\\left[(r_0+x)^2 + y^2 + z^2\\right]^{3/2}}",
      "aliases_latex": [
        "\\ddot{\\mathbf{r}} - \\ddot{\\mathbf{r}}_0 = -\\frac{\\mu}{\\|\\mathbf{r}_0 + \\boldsymbol{\\rho}\\|^3}(\\mathbf{r}_0 + \\boldsymbol{\\rho}) + \\frac{\\mu}{r_0^3}\\mathbf{r}_0"
      ],
      "keywords": [
        "nonlinear relative motion",
        "two-body relative EOM",
        "exact LVLH equations"
      ],
      "domain_tags": [
        "orbital_mechanics",
        "spacecraft_rendezvous"
      ]
    },
    {
      "id": "astro.cw.cw04_gravity_gradient_linearization",
      "short_code": "CW04",
      "kind": "theorem_formula",
      "title": "微小相対距離における重力勾配の1次線形化",
      "summary": "相対距離が基準軌道半径より十分小さい（||ρ|| << r0）仮定の下で、重力項を 1 次までテイラー展開し、重力勾配項を導出する。",
      "canonical_latex": "-\\frac{\\mu}{\\|\\mathbf{r}_0 + \\boldsymbol{\\rho}\\|^3}(\\mathbf{r}_0 + \\boldsymbol{\\rho}) + \\frac{\\mu}{r_0^3}\\mathbf{r}_0 = n^2(2x\\hat{\\mathbf{i}} - y\\hat{\\mathbf{j}} - z\\hat{\\mathbf{k}}) + \\mathcal{O}\\!\\left(\\frac{\\|\\boldsymbol{\\rho}\\|^2}{r_0}\\right)n^2",
      "aliases_latex": [
        "\\mathbf{g}(\\mathbf{r}_0 + \\boldsymbol{\\rho}) - \\mathbf{g}(\\mathbf{r}_0) \\approx \\left(2n^2 x,\\; -n^2 y,\\; -n^2 z\\right)_{\\mathrm{LVLH}}^\\top"
      ],
      "keywords": [
        "gravity gradient",
        "linearization",
        "binomial expansion",
        "tidal force"
      ],
      "domain_tags": [
        "orbital_mechanics",
        "perturbation"
      ]
    },
    {
      "id": "astro.cw.cw05_clohessy_wiltshire_equations",
      "short_code": "CW05",
      "kind": "theorem_formula",
      "title": "クロヘッシー＝ウィルトシャー（CW / ヒル）方程式",
      "summary": "LVLH 系の運動学的変換と線形化重力勾配を等置することで得られる、円軌道上の線形相対運動方程式（CW 方程式）。",
      "canonical_latex": "\\ddot{x} - 2n\\dot{y} - 3n^2 x = f_x,\\quad \\ddot{y} + 2n\\dot{x} = f_y,\\quad \\ddot{z} + n^2 z = f_z",
      "aliases_latex": [
        "\\ddot{x} - 2n\\dot{y} - 3n^2 x = 0,\\quad \\ddot{y} + 2n\\dot{x} = 0,\\quad \\ddot{z} + n^2 z = 0"
      ],
      "keywords": [
        "Clohessy-Wiltshire equations",
        "Hill equations",
        "CW equations",
        "linear relative dynamics"
      ],
      "domain_tags": [
        "orbital_mechanics",
        "spacecraft_rendezvous"
      ]
    },
    {
