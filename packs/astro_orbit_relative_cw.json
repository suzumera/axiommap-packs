    {
      "id": "astro.cw.cw07_cw_in_plane_analytical_solution",
      "short_code": "CW07",
      "kind": "theorem_formula",
      "title": "CW 方程式の面内（x-y平面）閉形式解析解",
      "summary": "y 方向方程式の 1 回積分を用いて x 方向の強制単振動方程式を解き、さらに y(t) を積分して面内相対運動の厳密解析解を得る。",
      "canonical_latex": "x(t) = (4 - 3\\cos nt)x_0 + \\frac{\\sin nt}{n}\\dot{x}_0 + \\frac{2(1 - \\cos nt)}{n}\\dot{y}_0,\\quad y(t) = 6(\\sin nt - nt)x_0 + y_0 - \\frac{2(1 - \\cos nt)}{n}\\dot{x}_0 + \\frac{4\\sin nt - 3nt}{n}\\dot{y}_0",
      "aliases_latex": [
        "\\dot{x}(t) = 3n\\sin(nt)x_0 + \\cos(nt)\\dot{x}_0 + 2\\sin(nt)\\dot{y}_0,\\; \\dot{y}(t) = 6n(\\cos nt - 1)x_0 - 2\\sin(nt)\\dot{x}_0 + (4\\cos nt - 3)\\dot{y}_0"
      ],
      "keywords": [
        "in-plane CW solution",
        "closed-form solution",
        "secular drift"
      ],
      "domain_tags": [
        "orbital_mechanics",
        "spacecraft_rendezvous"
      ]
    },
    {
      "id": "astro.cw.cw08_cw_state_transition_matrix",
      "short_code": "CW08",
      "kind": "theorem_formula",
      "title": "CW 方程式の状態遷移行列（STM）と無ドリフト周期条件",
      "summary": "面内および面外解析解を 6×6 の状態遷移行列 Φ(t) に統合し、さらに永年ドリフトが消滅する閉じた 2×1 相対楕円軌道の条件を導く。",
      "canonical_latex": "\\mathbf{X}(t) = \\Phi(t)\\mathbf{X}_0,\\quad \\Phi(t) = \\begin{pmatrix} \\Phi_{rr}(t) & \\Phi_{rv}(t) \\\\ \\Phi_{vr}(t) & \\Phi_{vv}(t) \\end{pmatrix} \\in \\mathbb{R}^{6\\times 6};\\qquad \\dot{y}_0 = -2n x_0 \\implies \\text{no secular drift } (y(t)\\text{ periodic})",
      "aliases_latex": [
        "\\Phi_{rr}(t)=\\begin{pmatrix}4-3\\cos nt & 0 & 0\\\\ 6(\\sin nt-nt) & 1 & 0\\\\ 0 & 0 & \\cos nt\\end{pmatrix},\\; \\Phi_{rv}(t)=\\frac{1}{n}\\begin{pmatrix}\\sin nt & 2(1-\\cos nt) & 0\\\\ -2(1-\\cos nt) & 4\\sin nt-3nt & 0\\\\ 0 & 0 & \\sin nt\\end{pmatrix}"
      ],
      "keywords": [
