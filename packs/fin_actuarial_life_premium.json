    "title": "保険数理（アクチュアリー）：死力・生存確率・生命年金現価と収支相当の原則による純保険料",
    "language": "ja",
    "description": "生存関数S(x)から死力μ_x=-S'(x)/S(x)、割引因子v=1/(1+i)を用いた終身保険一時払純保険料Axと生命年金現価axの関係式、収支相当の原則による平準純保険料を導出する。"
  },
  "nodes": [
    {
      "id": "fin.act.n01_survival_function_def",
      "short_code": "ACT01",
      "kind": "definition",
      "title": "生存関数と条件付き生存確率・死亡確率の定義",
      "summary": "出生時からの将来余命確率変数 T_0 に基づき、年齢 x までの生存確率を表す生存関数 S(x) と、x 歳から t 年間の条件付き生存確率 {}_t p_x および死亡確率 {}_t q_x を定義する。",
      "canonical_latex": "S(x) := P(T_0 > x),\\quad {}_t p_x := P(T_x > t) = \\frac{S(x+t)}{S(x)},\\quad {}_t q_x := 1 - {}_t p_x",
      "aliases_latex": [
        "{}_1 p_x = p_x,\\quad {}_1 q_x = q_x,\\quad {}_{k+m} p_x = {}_k p_x \\cdot {}_m p_{x+k}"
      ],
      "keywords": [
        "生存関数",
        "条件付き生存確率",
        "死亡確率",
        "将来余命"
      ],
      "domain_tags": [
        "actuarial",
        "probability"
      ]
    },
    {
      "id": "fin.act.n02_force_of_mortality_def",
      "short_code": "ACT02",
      "kind": "definition",
      "title": "死力（瞬間死亡率）の定義",
      "summary": "年齢 x における微小時間あたりの条件付き死亡確率の極限として死力（瞬間死亡率）\\mu_x を定義し、生存関数 S(x) の対数微分の符号反転として表す。",
      "canonical_latex": "\\mu_x := \\lim_{\\Delta x \\to 0^+} \\frac{{}_{\\Delta x} q_x}{\\Delta x} = -\\frac{S'(x)}{S(x)} = -\\frac{d}{dx}\\ln S(x)",
      "aliases_latex": [
        "\\mu_{x+t} = -\\frac{1}{{}_t p_x}\\frac{d}{dt}{}_t p_x"
      ],
      "keywords": [
        "死力",
        "瞬間死亡率",
        "ハザード率",
        "対数微分"
      ],
      "domain_tags": [
        "actuarial",
        "calculus"
      ]
    },
    {
      "id": "fin.act.n03_survival_prob_from_force",
      "short_code": "ACT03",
      "kind": "theorem_formula",
      "title": "死力による生存確率の指数積分表示",
      "summary": "死力 \\mu_{x+s} を区間 [0, t] で積分して指数関数に代入することで、条件付き生存確率 {}_t p_x および将来余命の確率密度関数 {}_t p_x \\mu_{x+t} を導出する。",
      "canonical_latex": "{}_t p_x = \\exp\\!\\left(-\\int_0^t \\mu_{x+s}\\,ds\\right),\\qquad {}_t p_x \\mu_{x+t} = -\\frac{d}{dt}{}_t p_x",
      "aliases_latex": [
        "S(x) = \\exp\\!\\left(-\\int_0^x \\mu_s\\,ds\\right)"
      ],
      "keywords": [
        "生存確率",
        "死力",
        "指数積分表示",
        "確率密度関数"
      ],
      "domain_tags": [
        "actuarial",
        "calculus"
      ]
    },
    {
      "id": "fin.act.n04_discount_factor_def",
      "short_code": "ACT04",
      "kind": "definition",
      "title": "予定利率・割引因子および割引率の定義",
      "summary": "一定の年予定利率 i に対して、1年後の1単位の金額の現在価値を表す割引因子 v と、期首における割引率 d を定義する。",
      "canonical_latex": "v := \\frac{1}{1+i},\\qquad d := iv = 1 - v = \\frac{i}{1+i} \\quad (i > 0)",
      "aliases_latex": [
        "v = 1 - d,\\quad \\delta := \\ln(1+i) = -\\ln v"
      ],
      "keywords": [
        "予定利率",
        "割引因子",
        "割引率",
        "現在価値"
      ],
      "domain_tags": [
        "actuarial",
        "finance"
      ]
    },
    {
      "id": "fin.act.n05_whole_life_insurance_pv_def",
      "short_code": "ACT05",
      "kind": "definition",
      "title": "終身保険の一時払純保険料（保険現価）の定義",
      "summary": "x 歳で加入し死亡年度末に保険金 1 を支払う終身保険について、切捨て将来余命 K_x を用いた確率的割引現在価値の期待値として一時払純保険料 A_x を定義する。",
      "canonical_latex": "A_x := \\mathbb{E}\\big[v^{K_x + 1}\\big] = \\sum_{k=0}^{\\infty} v^{k+1}\\,{}_k p_x\\, q_{x+k} \\quad (q_{x+k} = 1 - p_{x+k})",
      "aliases_latex": [
        "A_x = \\sum_{k=0}^{\\infty} v^{k+1}({}_k p_x - {}_{k+1} p_x)"
      ],
      "keywords": [
        "終身保険",
        "一時払純保険料",
        "保険現価",
        "切捨て将来余命"
      ],
      "domain_tags": [
        "actuarial",
        "finance"
      ]
    },
    {
      "id": "fin.act.n06_life_annuity_pv_def",
      "short_code": "ACT06",
      "kind": "definition",
      "title": "期首払終身生命年金現価の定義",
      "summary": "x 歳から生存している限り毎期首に 1 を支払う期首払終身生命年金の期待現在価値 \\ddot{a}_x を定義し、期末払終身生命年金現価 a_x との関係を明示する。",
      "canonical_latex": "\\ddot{a}_x := \\mathbb{E}\\!\\left[\\sum_{k=0}^{K_x} v^k\\right] = \\sum_{k=0}^{\\infty} v^k\\,{}_k p_x = 1 + a_x",
      "aliases_latex": [
        "a_x := \\sum_{k=1}^{\\infty} v^k\\,{}_k p_x = \\ddot{a}_x - 1"
      ],
      "keywords": [
        "生命年金現価",
        "期首払終身年金",
        "期待現在価値"
      ],
      "domain_tags": [
        "actuarial",
        "finance"
      ]
    },
    {
      "id": "fin.act.n07_insurance_annuity_identity",
      "short_code": "ACT07",
      "kind": "theorem_formula",
      "title": "終身保険現価と生命年金現価の基本関係式",
      "summary": "死亡確率を生存確率の差分で表し和の添字をずらすことで、終身保険の一時払純保険料 A_x と期首払生命年金現価 \\ddot{a}_x を結びつける基本恒等式を導出する。",
      "canonical_latex": "A_x = 1 - d\\,\\ddot{a}_x = v\\,\\ddot{a}_x - a_x",
      "aliases_latex": [
        "A_x + d\\,\\ddot{a}_x = 1,\\quad A_x = v - d\\,a_x"
      ],
      "keywords": [
        "保険現価",
        "年金現価",
        "恒等式",
        "アーベル変換"
      ],
      "domain_tags": [
        "actuarial",
        "finance"
      ]
    },
    {
      "id": "fin.act.n08_equivalence_principle_net_premium",
      "short_code": "ACT08",
      "kind": "theorem_formula",
      "title": "収支相当の原則による平準純保険料の公式",
      "summary": "保険給付の期待現在価値と純保険料収入の期待現在価値が等しいとする収支相当の原則から、終身保険の年払平準純保険料 P_x の公式を導出する。",
      "canonical_latex": "P_x\\,\\ddot{a}_x = A_x \\implies P_x = \\frac{A_x}{\\ddot{a}_x} = \\frac{1}{\\ddot{a}_x} - d",
      "aliases_latex": [
        "P_x = \\frac{1 - d\\,\\ddot{a}_x}{\\ddot{a}_x}"
      ],
      "keywords": [
        "収支相当の原則",
        "平準純保険料",
        "終身保険"
      ],
      "domain_tags": [
        "actuarial",
        "finance"
      ]
    }
