    "language": "ja",
    "description": "磁気双極子のトルク方程式からラーモア周波数、回転座標系でのブロッホ方程式、縦緩和T1・横緩和T2の解、傾斜磁場によるk空間フーリエエンコーディングを導出する。"
  },
  "nodes": [
    {
      "id": "med.mri.n01_magnetic_torque_boundary",
      "short_code": "MRI01",
      "kind": "math_boundary",
      "title": "磁気双極子の運動方程式と緩和現象の基礎境界",
      "summary": "静磁場および時間変動磁場中の巨視的磁化ベクトルが受ける磁気トルクによる運動方程式と、スピン-格子緩和（T1）およびスピン-スピン緩和（T2）の現象論的緩和率の境界。",
      "canonical_latex": "\\frac{d\\mathbf{M}}{dt} = \\gamma \\mathbf{M} \\times \\mathbf{B},\\quad \\mathbf{B}_0 = B_0 \\hat{\\mathbf{z}},\\quad \\left(\\frac{dM_z}{dt}\\right)_{\\text{relax}} = -\\frac{M_z - M_0}{T_1},\\quad \\left(\\frac{d\\mathbf{M}_{xy}}{dt}\\right)_{\\text{relax}} = -\\frac{\\mathbf{M}_{xy}}{T_2}",
      "aliases_latex": [
        "\\dot{\\mathbf{M}} = \\gamma \\mathbf{M} \\times \\mathbf{B}"
      ],
      "keywords": [
        "磁気回転比",
        "磁気トルク",
        "ラーモア歳差",
        "T1緩和",
        "T2緩和",
        "MRI"
      ],
      "domain_tags": [
        "medical_imaging",
        "mri",
        "electromagnetism"
      ]
    },
    {
      "id": "med.mri.n02_larmor_precession",
      "short_code": "MRI02",
      "kind": "theorem_formula",
      "title": "静磁場中のラーモア歳差運動とラーモア周波数",
      "summary": "一様な静磁場 B_0 下での非緩和磁化ベクトルが、z軸成分を保存しつつ横平面内で角周波数 ω_0 = γ B_0 で歳差運動（ラーモア歳差）することを示す公式。",
      "canonical_latex": "\\frac{dM_z}{dt} = 0,\\quad \\ddot{M}_x + \\omega_0^2 M_x = 0,\\quad M_{xy}(t) = M_{xy}(0) e^{-i\\omega_0 t}\\quad \\left(\\omega_0 := \\gamma B_0,\\; M_{xy} := M_x + i M_y\\right)",
      "aliases_latex": [
        "\\omega_0 = \\gamma B_0",
        "M_+(t) = M_+(0)e^{-i\\gamma B_0 t}"
      ],
      "keywords": [
        "ラーモア周波数",
        "歳差運動",
        "横磁化",
        "複素磁化"
      ],
      "domain_tags": [
        "medical_imaging",
        "mri"
      ]
    },
    {
      "id": "med.mri.n03_rotating_frame_bloch",
      "short_code": "MRI03",
      "kind": "theorem_formula",
      "title": "回転座標系におけるブロッホ方程式",
      "summary": "角速度 Ω = -ω z^ で回転する座標系において、見かけの磁場（実効磁場 B_eff）と T1/T2 緩和項を統合した巨視的磁化の運動方程式。",
      "canonical_latex": "\\frac{d\\mathbf{M}'}{dt} = \\gamma \\mathbf{M}' \\times \\mathbf{B}_{\\mathrm{eff}} - \\frac{M'_x \\hat{\\mathbf{x}}' + M'_y \\hat{\\mathbf{y}}'}{T_2} - \\frac{M'_z - M_0}{T_1}\\hat{\\mathbf{z}}',\\quad \\mathbf{B}_{\\mathrm{eff}} = \\left(B_0 - \\frac{\\omega}{\\gamma}\\right)\\hat{\\mathbf{z}}' + \\mathbf{B}_{1,\\mathrm{rot}}",
      "aliases_latex": [
        "\\frac{d\\mathbf{M}'}{dt} = \\gamma \\mathbf{M}' \\times \\mathbf{B}_{\\mathrm{eff}} + \\mathbf{R}(\\mathbf{M}')"
      ],
      "keywords": [
        "ブロッホ方程式",
        "回転座標系",
        "実効磁場",
        "RFパルス",
        "共鳴条件"
      ],
      "domain_tags": [
        "medical_imaging",
        "mri"
      ]
    },
    {
      "id": "med.mri.n04_t1_t2_relaxation_solutions",
      "short_code": "MRI04",
      "kind": "theorem_formula",
      "title": "自由緩和時の縦緩和（T1回復）および横緩和（T2減衰）の解析解",
      "summary": "オン共鳴回転座標系でRFパルス印加後（B_eff = 0）のブロッホ方程式を解くことで得られる、縦磁化 M_z の指数回復解と横磁化 M'_{xy} の指数減衰解。",
      "canonical_latex": "M_z(t) = M_0\\left(1 - e^{-t/T_1}\\right) + M_z(0)e^{-t/T_1},\\qquad M'_{xy}(t) = M'_{xy}(0)e^{-t/T_2}",
      "aliases_latex": [
        "M_z(t) = M_0 - (M_0 - M_z(0))e^{-t/T_1}"
      ],
      "keywords": [
        "縦緩和",
        "横緩和",
        "T1回復",
        "T2減衰",
        "自由誘導減衰"
      ],
      "domain_tags": [
        "medical_imaging",
        "mri"
      ]
    },
    {
      "id": "med.mri.n05_gradient_field_larmor_def",
      "short_code": "MRI05",
      "kind": "definition",
      "title": "空間傾斜磁場と位置依存ラーモア周波数の定義",
      "summary": "空間位置 r に比例して静磁場強度を線形変調させる傾斜磁場ベクトル G(t) と、それによって生じる位置依存のラーモア周波数および共鳴周波数シフトの定義。",
      "canonical_latex": "B_z(\\mathbf{r}, t) := B_0 + \\mathbf{G}(t)\\cdot\\mathbf{r},\\qquad \\omega(\\mathbf{r}, t) := \\gamma B_z(\\mathbf{r}, t) = \\omega_0 + \\gamma \\mathbf{G}(t)\\cdot\\mathbf{r}",
      "aliases_latex": [
        "\\Delta\\omega(\\mathbf{r}, t) = \\gamma \\mathbf{G}(t)\\cdot\\mathbf{r}"
      ],
      "keywords": [
        "傾斜磁場",
        "勾配磁場",
        "空間エンコーディング",
        "共鳴周波数シフト"
      ],
      "domain_tags": [
        "medical_imaging",
        "mri"
      ]
    },
    {
      "id": "med.mri.n06_k_space_trajectory_def",
      "short_code": "MRI06",
      "kind": "definition",
      "title": "k空間座標（空間周波数ベクトル）の定義",
      "summary": "時間変動する傾斜磁場 G(τ) の時間積分によって定義される、MRI撮像における空間周波数空間（k空間）上のサンプリング軌道座標 k(t)。",
      "canonical_latex": "\\mathbf{k}(t) := \\gamma \\int_{0}^{t} \\mathbf{G}(\\tau)\\,d\\tau,\\qquad \\phi(\\mathbf{r}, t) := \\int_{0}^{t} \\Delta\\omega(\\mathbf{r}, \\tau)\\,d\\tau = \\mathbf{k}(t)\\cdot\\mathbf{r}",
      "aliases_latex": [
        "\\mathbf{k}(t) = \\frac{\\gamma}{2\\pi}\\int_0^t \\mathbf{G}(\\tau)\\,d\\tau"
      ],
      "keywords": [
        "k空間",
        "空間周波数",
        "k空間軌道",
        "位相エンコーディング",
        "周波数エンコーディング"
      ],
      "domain_tags": [
        "medical_imaging",
        "mri",
        "fourier_analysis"
      ]
    },
    {
      "id": "med.mri.n07_mri_signal_k_space_fourier",
      "short_code": "MRI07",
      "kind": "theorem_formula",
      "title": "MRI受信信号のk空間フーリエエンコーディング定理",
      "summary": "傾斜磁場下における全スピンからの復調受信信号 s(t) が、スピン密度（緩和重み付き有効横磁化密度）ρ(r) のk空間座標 k(t) におけるフーリエ変換に等しいことを示すMRI画像再構成の核心定理。",
      "canonical_latex": "s(t) = \\int_{\\mathbb{R}^d} \\rho(\\mathbf{r}) e^{-i \\mathbf{k}(t)\\cdot\\mathbf{r}}\\,d\\mathbf{r} = \\mathcal{F}\\{\\rho\\}\\big(\\mathbf{k}(t)\\big)",
      "aliases_latex": [
        "s(\\mathbf{k}) = \\iint \\rho(x,y)e^{-i(k_x x + k_y y)}\\,dx\\,dy"
      ],
      "keywords": [
        "MRI再構成",
        "フーリエエンコーディング",
        "k空間信号",
        "スピン密度",
        "2次元フーリエ変換"
      ],
      "domain_tags": [
        "medical_imaging",
        "mri",
        "fourier_analysis"
      ]
    }
