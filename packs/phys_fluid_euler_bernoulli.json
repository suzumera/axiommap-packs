    "language": "ja",
    "description": "ラグランジュ微分（実質微分）、質量保存（連続の式）、完全流体のオイラー方程式、流線上のベルヌーイ定理、ケルビンの循環定理を導出する。"
  },
  "nodes": [
    {
      "id": "phys.fluid.fl01_eulerian_lagrangian_field_def",
      "short_code": "FL01",
      "kind": "definition",
      "title": "オイラー描像・ラグランジュ描像と流跡線の方程式",
      "summary": "空間固定座標と時刻で物理量を表すオイラー描像と、初期位置でラベル付けした流体粒子を追跡するラグランジュ描像およびフロー写像を定義する。",
      "canonical_latex": "\\frac{\\partial \\mathbf{\\Phi}(\\mathbf{a}, t)}{\\partial t} = \\mathbf{u}\\big(\\mathbf{\\Phi}(\\mathbf{a}, t), t\\big),\\quad \\mathbf{\\Phi}(\\mathbf{a}, 0) = \\mathbf{a},\\quad f_L(\\mathbf{a}, t) := f\\big(\\mathbf{\\Phi}(\\mathbf{a}, t), t\\big).",
      "aliases_latex": [
        "\\dot{\\mathbf{x}}(t) = \\mathbf{u}(\\mathbf{x}(t), t),\\; \\mathbf{x}(0) = \\mathbf{a}"
      ],
      "keywords": [
        "オイラー描像",
        "ラグランジュ描像",
        "流跡線",
        "フロー写像",
        "速度場"
      ],
      "domain_tags": [
        "physics",
        "fluid_mechanics"
      ]
    },
    {
      "id": "phys.fluid.fl02_material_derivative",
      "short_code": "FL02",
      "kind": "theorem_formula",
      "title": "ラグランジュ微分（実質微分・物質微分）",
      "summary": "流体粒子に沿って移動しながら観測するスカラー場およびベクトル場の時間変化率を与える微分演算子 D/Dt を導出する。",
      "canonical_latex": "\\frac{Df}{Dt} := \\left.\\frac{\\partial f_L(\\mathbf{a}, t)}{\\partial t}\\right|_{\\mathbf{a}} = \\frac{\\partial f}{\\partial t} + (\\mathbf{u}\\cdot\\nabla)f,\\qquad \\frac{D\\mathbf{A}}{Dt} = \\frac{\\partial \\mathbf{A}}{\\partial t} + (\\mathbf{u}\\cdot\\nabla)\\mathbf{A}.",
      "aliases_latex": [
        "\\frac{D}{Dt} = \\frac{\\partial}{\\partial t} + \\mathbf{u}\\cdot\\nabla"
      ],
      "keywords": [
        "ラグランジュ微分",
        "実質微分",
        "物質微分",
        "移流項"
      ],
      "domain_tags": [
        "physics",
        "fluid_mechanics"
      ]
    },
    {
      "id": "phys.fluid.fl03_reynolds_transport_theorem",
      "short_code": "FL03",
      "kind": "theorem_formula",
      "title": "レイノルズの輸送定理",
      "summary": "流体粒子と共に移動・変形する物質体積 V(t) 上の体積積分の時間微分を、実質微分と速度の発散を含む積分および検査体積の境界流束積分で表す。",
      "canonical_latex": "\\frac{d}{dt}\\iiint_{V(t)} f(\\mathbf{x}, t)\\,dV = \\iiint_{V(t)} \\left(\\frac{Df}{Dt} + f(\\nabla\\cdot\\mathbf{u})\\right)dV = \\iiint_{V(t)} \\frac{\\partial f}{\\partial t}\\,dV + \\iint_{\\partial V(t)} f(\\mathbf{u}\\cdot\\mathbf{n})\\,dS.",
      "aliases_latex": [
        "\\frac{d}{dt}\\int_{V(t)} f\\,dV = \\int_{V(t)} \\left(\\frac{\\partial f}{\\partial t} + \\nabla\\cdot(f\\mathbf{u})\\right)dV"
      ],
      "keywords": [
        "レイノルズの輸送定理",
        "物質体積",
        "ヤコビアン",
        "オイラーの膨張公式"
      ],
      "domain_tags": [
        "physics",
        "fluid_mechanics"
      ]
    },
    {
      "id": "phys.fluid.fl04_continuity_equation",
      "short_code": "FL04",
      "kind": "theorem_formula",
      "title": "質量保存則（連続の式）と非圧縮性条件",
      "summary": "物質体積内の質量保存から微分形の連続の式を導出し、密度一定（または実質微分零）の非圧縮性流体におけるソレノイダル条件を得る。",
      "canonical_latex": "\\frac{\\partial \\rho}{\\partial t} + \\nabla\\cdot(\\rho\\mathbf{u}) = 0 \\iff \\frac{D\\rho}{Dt} + \\rho(\\nabla\\cdot\\mathbf{u}) = 0;\\qquad \\frac{D\\rho}{Dt} = 0 \\implies \\nabla\\cdot\\mathbf{u} = 0.",
      "aliases_latex": [
        "\\partial_t \\rho + \\nabla\\cdot(\\rho\\mathbf{u}) = 0"
      ],
      "keywords": [
        "連続の式",
        "質量保存則",
        "非圧縮性流体",
        "発散零"
      ],
      "domain_tags": [
        "physics",
        "fluid_mechanics"
      ]
    },
    {
      "id": "phys.fluid.fl05_ideal_fluid_pressure_stress",
      "short_code": "FL05",
      "kind": "definition",
      "title": "完全流体の等方応力テンソルと圧力勾配力",
      "summary": "粘性によるせん断応力が存在しない完全流体において、コーシー応力テンソルが静水圧による等方形式で表され、正味表面力が圧力勾配力となることを定式化する。",
      "canonical_latex": "\\sigma_{ij} = -p\\,\\delta_{ij},\\quad \\mathbf{t}(\\mathbf{x},\\mathbf{n}) = \\boldsymbol{\\sigma}\\mathbf{n} = -p\\,\\mathbf{n},\\quad \\iint_{\\partial V(t)} (-p\\,\\mathbf{n})\\,dS = -\\iiint_{V(t)} \\nabla p\\,dV.",
      "aliases_latex": [
        "\\boldsymbol{\\sigma} = -p I_3"
      ],
      "keywords": [
        "完全流体",
        "圧力",
        "等方応力テンソル",
        "圧力勾配力"
      ],
      "domain_tags": [
        "physics",
        "fluid_mechanics"
      ]
    },
    {
      "id": "phys.fluid.fl06_euler_equation",
      "short_code": "FL06",
      "kind": "theorem_formula",
      "title": "完全流体のオイラー運動方程式",
      "summary": "物質体積に対する運動量保存則と完全流体の圧力応力を組み合わせ、非粘性流体の基礎運動方程式であるオイラー方程式を導出する。",
      "canonical_latex": "\\rho\\frac{D\\mathbf{u}}{Dt} = \\rho\\left(\\frac{\\partial \\mathbf{u}}{\\partial t} + (\\mathbf{u}\\cdot\\nabla)\\mathbf{u}\\right) = -\\nabla p + \\rho\\mathbf{f}.",
      "aliases_latex": [
        "\\frac{\\partial \\mathbf{u}}{\\partial t} + (\\mathbf{u}\\cdot\\nabla)\\mathbf{u} = -\\frac{1}{\\rho}\\nabla p + \\mathbf{f}"
      ],
      "keywords": [
        "オイラー方程式",
        "運動量保存",
        "完全流体",
        "流体力学"
      ],
      "domain_tags": [
        "physics",
        "fluid_mechanics"
      ]
    },
    {
      "id": "phys.fluid.fl07_lamb_form_vorticity_def",
      "short_code": "FL07",
      "kind": "theorem_formula",
      "title": "渦度の定義とオイラー方程式のラム（Lamb）形式",
      "summary": "速度場の回転として渦度ベクトルを定義し、ベクトル恒等式により移流項を運動エネルギー勾配と渦力項に分解したラム形式を導出する。",
      "canonical_latex": "\\boldsymbol{\\omega} := \\nabla\\times\\mathbf{u},\\quad (\\mathbf{u}\\cdot\\nabla)\\mathbf{u} = \\nabla\\left(\\frac{1}{2}u^2\\right) - \\mathbf{u}\\times\\boldsymbol{\\omega} \\implies \\frac{\\partial \\mathbf{u}}{\\partial t} + \\nabla\\left(\\frac{1}{2}u^2\\right) - \\mathbf{u}\\times\\boldsymbol{\\omega} = -\\frac{1}{\\rho}\\nabla p + \\mathbf{f}.",
      "aliases_latex": [
        "\\partial_t \\mathbf{u} + \\nabla(\\tfrac{1}{2}u^2) - \\mathbf{u}\\times(\\nabla\\times\\mathbf{u}) = -\\frac{1}{\\rho}\\nabla p + \\mathbf{f}"
      ],
      "keywords": [
        "渦度",
        "ラム形式",
        "クロッコの式",
        "移流項分解"
      ],
      "domain_tags": [
        "physics",
        "fluid_mechanics"
      ]
    },
    {
      "id": "phys.fluid.fl08_bernoulli_theorem",
      "short_code": "FL08",
      "kind": "theorem_formula",
      "title": "流線上のベルヌーイの定理",
      "summary": "定常・保存体積力・バロトロピー（または非圧縮性）の完全流体において、単位質量あたりのエネルギー和が流線に沿って一定となるベルヌーイの定理を導出する。",
      "canonical_latex": "\\frac{1}{2}u^2 + \\int \\frac{dp}{\\rho(p)} + \\Psi(\\mathbf{x}) = \\text{const. (along a streamline)},\\qquad \\rho=\\text{const.},\\;\\Psi=gz \\implies \\frac{1}{2}u^2 + \\frac{p}{\\rho} + gz = \\text{const.}",
      "aliases_latex": [
        "\\frac{1}{2}\\rho u^2 + p + \\rho g z = \\text{const.}"
      ],
      "keywords": [
        "ベルヌーイの定理",
        "流線",
        "定常流",
        "エネルギー保存"
      ],
      "domain_tags": [
        "physics",
        "fluid_mechanics"
      ]
    },
    {
      "id": "phys.fluid.fl09_circulation_kelvin_theorem",
      "short_code": "FL09",
      "kind": "theorem_formula",
      "title": "速度循環とケルビンの循環定理",
      "summary": "流体と共に移動する閉曲線に沿う速度循環の時間変化を評価し、バロトロピー・保存力下の完全流体で循環が保存されるケルビンの循環定理を導出する。",
      "canonical_latex": "\\Gamma(t) := \\oint_{C(t)} \\mathbf{u}\\cdot d\\mathbf{r} = \\iint_{S(t)} \\boldsymbol{\\omega}\\cdot\\mathbf{n}\\,dS,\\qquad \\frac{d\\Gamma}{dt} = \\oint_{C(t)} \\left(-\\frac{1}{\\rho}\\nabla p + \\mathbf{f}\\right)\\cdot d\\mathbf{r} = 0\\;\\big(\\rho=\\rho(p),\\; \\mathbf{f}=-\\nabla\\Psi\\big).",
      "aliases_latex": [
        "\\frac{d}{dt}\\oint_{C(t)} \\mathbf{u}\\cdot d\\mathbf{r} = 0"
      ],
      "keywords": [
        "循環",
        "ケルビンの循環定理",
        "渦度保存",
        "ストークスの定理"
      ],
      "domain_tags": [
        "physics",
        "fluid_mechanics"
      ]
    }
