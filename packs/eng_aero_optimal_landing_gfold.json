    {
      "id": "aerosp.gfold.n02_pontryagin_maximum_principle",
      "short_code": "GF02",
      "kind": "theorem_formula",
      "title": "ポントリャーギンの最大原理（PMP）と最適制御の必要条件",
      "summary": "入力制約を伴う最適制御問題において、制御ハミルトニアンの最小化条件と随伴変数（コステート）の微分方程式を与える変分原理の拡張定理。",
      "canonical_latex": "H(\\mathbf{x}, \\mathbf{u}, \\boldsymbol{\\lambda}) = L(\\mathbf{x}, \\mathbf{u}) + \\boldsymbol{\\lambda}^\\top \\mathbf{f}(\\mathbf{x}, \\mathbf{u}),\\quad \\dot{\\boldsymbol{\\lambda}} = -\\nabla_{\\mathbf{x}} H,\\quad \\mathbf{u}^*(t) = \\arg\\min_{\\mathbf{u} \\in \\mathcal{U}} H(\\mathbf{x}^*(t), \\mathbf{u}, \\boldsymbol{\\lambda}(t))",
      "aliases_latex": [
        "H(\\mathbf{x}^*,\\mathbf{u}^*,\\boldsymbol{\\lambda}) \\le H(\\mathbf{x}^*,\\mathbf{u},\\boldsymbol{\\lambda})\\;(\\forall \\mathbf{u}\\in\\mathcal{U}),\\quad \\dot{\\boldsymbol{\\lambda}} = -\\left(\\frac{\\partial H}{\\partial \\mathbf{x}}\\right)^\\top"
      ],
      "keywords": [
        "ポントリャーギンの最大原理",
        "制御ハミルトニアン",
        "随伴方程式",
        "最適制御"
      ],
      "domain_tags": [
