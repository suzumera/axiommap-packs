  "nodes": [
    {
      "id": "psy.irt.n01_ctt_measurement_boundary",
      "short_code": "IRT01",
      "kind": "math_boundary",
      "title": "古典的テスト理論と潜在特性測定の基礎境界",
      "summary": "観測得点の加法誤差モデル（真値と誤差の無相関性）および潜在特性に基づく項目反応の局所独立性・単調性の確率的基礎を与える境界。",
      "canonical_latex": "X = T + E,\\quad \\mathbb{E}[E]=0,\\quad \\operatorname{Cov}(T,E)=0,\\quad P(\\mathbf{U}=\\mathbf{u}\\mid\\theta)=\\prod_{j=1}^{J} P_j(\\theta)^{u_j}(1-P_j(\\theta))^{1-u_j}",
      "aliases_latex": [
        "X_i = T_i + E_i,\\quad \\mathbb{E}[E_i\\mid T_i]=0",
        "P(U_1=u_1,\\dots,U_J=u_J\\mid\\theta)=\\prod_{j=1}^{J} P(U_j=u_j\\mid\\theta)"
      ],
      "keywords": [
        "古典的テスト理論",
        "真値",
        "測定誤差",
        "局所独立性",
        "潜在特性"
      ],
      "domain_tags": [
        "psychology",
        "psychometrics",
        "statistics"
      ]
    },
    {
      "id": "psy.irt.n02_reliability_variance_decomp",
      "short_code": "IRT02",
      "kind": "theorem_formula",
      "title": "観測得点の分散分解と信頼性係数",
      "summary": "真値と誤差の無相関性から観測得点の分散が真値分散と誤差分散の和に分解されることを導き、信頼性係数を定式化する。",
      "canonical_latex": "\\sigma_X^2 = \\sigma_T^2 + \\sigma_E^2,\\qquad \\rho_{XX'} := \\frac{\\sigma_T^2}{\\sigma_X^2} = 1 - \\frac{\\sigma_E^2}{\\sigma_X^2}",
      "aliases_latex": [
        "\\operatorname{Var}(X) = \\operatorname{Var}(T) + \\operatorname{Var}(E),\\quad \\rho_{XX'} = \\frac{\\operatorname{Var}(T)}{\\operatorname{Var}(X)}"
      ],
      "keywords": [
        "信頼性係数",
        "分散分解",
        "真値分散",
        "誤差分散"
      ],
      "domain_tags": [
        "psychology",
        "psychometrics"
      ]
    },
    {
      "id": "psy.irt.n03_parallel_test_correlation",
      "short_code": "IRT03",
      "kind": "theorem_formula",
      "title": "平行テストの相関係数と信頼性係数の等価性",
      "summary": "同一の真値と等分散・無相関の誤差を持つ2つの平行テスト間のピアソン相関係数が信頼性係数に一致することを示す。",
      "canonical_latex": "X_1 = T + E_1,\\; X_2 = T + E_2 \\implies \\operatorname{Corr}(X_1, X_2) = \\frac{\\sigma_T^2}{\\sigma_X^2} = \\rho_{XX'}",
      "aliases_latex": [
        "\\rho_{X_1 X_2} = \\frac{\\operatorname{Cov}(X_1, X_2)}{\\sigma_{X_1}\\sigma_{X_2}} = \\rho_{XX'}"
      ],
      "keywords": [
        "平行テスト",
        "相関係数",
        "信頼性係数",
        "古典的テスト理論"
      ],
      "domain_tags": [
        "psychology",
        "psychometrics"
      ]
    },
    {
      "id": "psy.irt.n04_factor_analysis_model_def",
      "short_code": "IRT04",
      "kind": "definition",
      "title": "線形潜在因子モデルと因子負荷量の定義",
      "summary": "複数の観測変数を少数の潜在共通因子と独自因子の線形結合として表現する因子分析モデルと因子負荷量行列を定義する。",
      "canonical_latex": "\\mathbf{x} - \\boldsymbol{\\mu} = \\Lambda \\mathbf{f} + \\boldsymbol{\\varepsilon},\\quad \\mathbb{E}[\\mathbf{f}] = \\mathbf{0},\\; \\mathbb{E}[\\boldsymbol{\\varepsilon}] = \\mathbf{0},\\; \\operatorname{Cov}(\\mathbf{f},\\boldsymbol{\\varepsilon}) = O,\\; \\operatorname{Cov}(\\boldsymbol{\\varepsilon}) = \\Psi = \\operatorname{diag}(\\psi_1,\\dots,\\psi_p)",
      "aliases_latex": [
        "x_i - \\mu_i = \\sum_{m=1}^{k} \\lambda_{im} f_m + \\varepsilon_i"
      ],
      "keywords": [
        "因子分析",
        "潜在因子",
        "因子負荷量",
        "独自因子"
      ],
      "domain_tags": [
        "psychology",
        "psychometrics",
        "multivariate_statistics"
      ]
    },
    {
      "id": "psy.irt.n05_covariance_communality_decomp",
      "short_code": "IRT05",
      "kind": "theorem_formula",
      "title": "因子分析の基本方程式と共通性の分散分解",
      "summary": "因子モデルから共分散行列の分解式を導出し、直交因子モデルにおける各変数の分散の共通性と独自性への分解を示す。",
      "canonical_latex": "\\Sigma = \\Lambda \\Phi \\Lambda^\\top + \\Psi,\\qquad \\Phi = I_k \\implies \\operatorname{Var}(x_i) = h_i^2 + \\psi_i,\\quad h_i^2 := \\sum_{m=1}^{k} \\lambda_{im}^2",
      "aliases_latex": [
        "\\Sigma = \\Lambda \\Lambda^\\top + \\Psi,\\quad \\sigma_{ii} = \\sum_{m=1}^{k} \\lambda_{im}^2 + \\psi_i"
      ],
      "keywords": [
        "因子分析の基本方程式",
        "共通性",
        "独自性",
        "共分散構造"
      ],
      "domain_tags": [
        "psychology",
        "psychometrics",
        "multivariate_statistics"
      ]
    },
    {
      "id": "psy.irt.n06_irt_2pl_logistic_def",
      "short_code": "IRT06",
      "kind": "definition",
      "title": "2パラメータ・ロジスティック（2PL）項目反応モデルの定義",
      "summary": "潜在特性と項目の識別力・困難度パラメータを用いて正答確率を記述するロジスティック型項目反応関数を定義する。",
      "canonical_latex": "P_j(\\theta) := P(U_j = 1 \\mid \\theta) = \\frac{1}{1 + \\exp\\big(-D a_j(\\theta - b_j)\\big)}\\quad (a_j > 0,\\; D = 1.702\\text{ or }1)",
      "aliases_latex": [
        "P_j(\\theta) = \\frac{\\exp\\big(D a_j(\\theta - b_j)\\big)}{1 + \\exp\\big(D a_j(\\theta - b_j)\\big)}"
      ],
      "keywords": [
        "項目反応理論",
        "2PLモデル",
        "識別力",
        "困難度",
        "項目特性曲線"
      ],
      "domain_tags": [
        "psychology",
        "psychometrics"
      ]
    },
    {
      "id": "psy.irt.n07_rasch_1pl_specific_objectivity",
      "short_code": "IRT07",
      "kind": "theorem_formula",
      "title": "ラッシュモデル（1PL）と対数オッズの加法分離性",
      "summary": "2PLモデルで識別力を共通定数としたラッシュモデルを導き、ロジット変換によって能力値と困難度が加法分離される特定客観性を示す。",
      "canonical_latex": "P_j(\\theta) = \\frac{\\exp(\\theta - b_j)}{1 + \\exp(\\theta - b_j)} \\iff \\ln\\frac{P_j(\\theta)}{1 - P_j(\\theta)} = \\theta - b_j",
      "aliases_latex": [
        "\\operatorname{logit}\\big(P_j(\\theta)\\big) = \\theta - b_j"
      ],
      "keywords": [
        "ラッシュモデル",
        "1PLモデル",
        "ロジット変換",
        "特定客観性"
      ],
      "domain_tags": [
        "psychology",
        "psychometrics"
      ]
    },
    {
      "id": "psy.irt.n08_item_information_function",
      "short_code": "IRT08",
      "kind": "theorem_formula",
      "title": "2PL項目反応モデルの項目情報関数（フィッシャー情報量）",
      "summary": "2PLモデルの正答確率の微分とベルヌーイ分散から、潜在特性の推定精度を表す項目情報関数を導出する。",
      "canonical_latex": "I_j(\\theta) = \\frac{\\big(P_j'(\\theta)\\big)^2}{P_j(\\theta)\\big(1 - P_j(\\theta)\\big)} = D^2 a_j^2 P_j(\\theta)\\big(1 - P_j(\\theta)\\big)",
      "aliases_latex": [
        "I_j(\\theta) = -\\mathbb{E}\\left[\\frac{\\partial^2 \\ln L_j(\\theta)}{\\partial \\theta^2}\\right] = D^2 a_j^2 P_j(\\theta)Q_j(\\theta)"
      ],
      "keywords": [
        "項目情報関数",
        "フィッシャー情報量",
        "項目反応理論",
        "測定精度"
      ],
      "domain_tags": [
        "psychology",
        "psychometrics",
        "statistics"
      ]
    }
