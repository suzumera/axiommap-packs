        "mathematical_physics"
      ]
    },
    {
      "id": "phys.qft10.n02_grassmann_calculus_berezin_integral",
      "short_code": "QFT10_02",
      "kind": "definition",
      "title": "グラスマン微積分（左微分とベレジン積分）",
      "summary": "反可換変数に対する左微分の規則と、並進不変性を満たす形式的な積分（ベレジン積分）の定義。グラスマン変数では微分と積分が同一の演算として振る舞う。",
      "canonical_latex": "\\frac{\\partial}{\\partial\\theta_i}(\\theta_j f) = \\delta_{ij}f - \\theta_j\\frac{\\partial f}{\\partial\\theta_i},\\qquad \\int d\\theta\\, 1 = 0,\\qquad \\int d\\theta\\,\\theta = 1",
      "aliases_latex": [
        "\\int d\\theta\\, f(\\theta) = \\frac{\\partial f}{\\partial\\theta}",
        "\\int d\\theta\\, f(\\theta + \\eta) = \\int d\\theta\\, f(\\theta)"
      ],
      "keywords": [
        "ベレジン積分",
        "左微分",
        "並進不変性",
        "グラスマン微積分"
      ],
      "domain_tags": [
        "physics",
        "quantum_field_theory",
        "mathematical_physics"
      ]
    },
    {
      "id": "phys.qft10.n03_grassmann_gaussian_integral",
      "short_code": "QFT10_03",
      "kind": "theorem_formula",
      "title": "グラスマン変数のガウス積分と行列式（パフィアン）",
      "summary": "複素グラスマン変数に対するガウス積分が通常の可換変数の場合（行列式の逆数）とは逆に行列式の分子として与えられること、および外場源を伴うガウス積分の評価公式。",
      "canonical_latex": "\\int \\left(\\prod_{i=1}^n d\\bar{\\theta}_i\\, d\\theta_i\\right) \\exp\\!\\left(-\\bar{\\theta}_i M_{ij}\\theta_j\\right) = \\det M,\\qquad \\int \\left(\\prod_{i=1}^n d\\bar{\\theta}_i\\, d\\theta_i\\right) \\exp\\!\\left(-\\bar{\\theta}M\\theta + \\bar{\\eta}\\theta + \\bar{\\theta}\\eta\\right) = (\\det M)\\exp\\!\\left(\\bar{\\eta}M^{-1}\\eta\\right)",
      "aliases_latex": [
        "\\int \\mathcal{D}\\bar{\\theta}\\mathcal{D}\\theta\\, e^{-\\bar{\\theta}M\\theta} = \\det M",
        "\\int \\left(\\prod_i d\\theta_i\\right) e^{-\\frac{1}{2}\\theta_i A_{ij}\\theta_j} = \\operatorname{Pf}(A)"
      ],
      "keywords": [
        "グラスマンガウス積分",
        "行列式",
        "パフィアン",
        "フェルミオンループ"
      ],
      "domain_tags": [
        "physics",
        "quantum_field_theory"
      ]
    },
    {
      "id": "phys.qft10.n04_fermionic_coherent_states",
      "short_code": "QFT10_04",
      "kind": "theorem_formula",
      "title": "フェルミオンのコヒーレント状態と完全性関係",
      "summary": "フェルミオン消滅演算子の固有状態としてグラスマン数を用いたコヒーレント状態を構成し、その内積とベレジン積分による完全性関係を導出する。",
      "canonical_latex": "|\\xi\\rangle := \\exp\\!\\left(-\\sum_i \\xi_i \\hat{c}_i^\\dagger\\right)|0\\rangle,\\quad \\hat{c}_i|\\xi\\rangle = \\xi_i|\\xi\\rangle,\\quad \\langle\\bar{\\xi}'|\\xi\\rangle = \\exp\\!\\left(\\sum_i \\bar{\\xi}'_i\\xi_i\\right),\\quad \\int \\left(\\prod_i d\\bar{\\xi}_i\\,d\\xi_i\\right) e^{-\\sum_i\\bar{\\xi}_i\\xi_i}|\\xi\\rangle\\langle\\bar{\\xi}| = \\hat{I}",
      "aliases_latex": [
        "\\hat{c}_i|\\xi\\rangle = \\xi_i|\\xi\\rangle",
        "\\langle\\bar{\\xi}|\\hat{c}_i^\\dagger = \\langle\\bar{\\xi}|\\bar{\\xi}_i"
      ],
      "keywords": [
