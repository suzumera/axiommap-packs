      "id": "phys.qft10.n01_grassmann_algebra_def",
      "short_code": "QFT10_01",
      "kind": "definition",
      "title": "グラスマン数とグラスマン代数（反可換変数）",
      "summary": "フェルミオンの正準反交換関係に対応する古典極限の変数として導入される反可換な生成元と、それらが張る外積代数（グラスマン代数）および複素共役（インボリューション）の規約。",
      "canonical_latex": "\\theta_i\\theta_j + \\theta_j\\theta_i = 0,\\quad \\theta_i^2 = 0,\\quad f(\\theta) = a + b\\theta,\\quad (\\theta_1\\theta_2)^* = \\theta_2^*\\theta_1^*",
      "aliases_latex": [
        "\\{\\theta_i, \\theta_j\\} = 0",
        "\\bar{\\theta}_i\\theta_j = -\\theta_j\\bar{\\theta}_i"
      ],
      "keywords": [
