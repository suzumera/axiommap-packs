      ]
    },
    {
      "id": "phys.qft10.n05_dirac_field_canonical_quantization",
      "short_code": "QFT10_05",
      "kind": "theorem_formula",
      "title": "自由ディラック場の正準共役運動量と正準反交換関係",
      "summary": "自然単位系および(-,+,+,+)計量の下で、ディラック・ラグランジアン密度から正準共役運動量密度・ハミルトニアン密度を導き、同時刻正準反交換関係による量子化を行う。",
      "canonical_latex": "\\pi_\\psi(x) = \\frac{\\partial\\mathcal{L}_D}{\\partial\\dot{\\psi}(x)} = i\\psi^\\dagger(x),\\quad \\mathcal{H}_D = \\bar{\\psi}(-i\\gamma^k\\partial_k + m)\\psi,\\quad \\{\\hat{\\psi}_\\alpha(t,\\mathbf{x}), \\hat{\\psi}_\\beta^\\dagger(t,\\mathbf{y})\\} = \\delta_{\\alpha\\beta}\\delta^{(3)}(\\mathbf{x}-\\mathbf{y})",
      "aliases_latex": [
        "\\{\\hat{\\psi}_\\alpha(t,\\mathbf{x}), \\hat{\\pi}_{\\psi,\\beta}(t,\\mathbf{y})\\} = i\\delta_{\\alpha\\beta}\\delta^{(3)}(\\mathbf{x}-\\mathbf{y})",
        "\\{\\hat{\\psi}_\\alpha(t,\\mathbf{x}), \\hat{\\psi}_\\beta(t,\\mathbf{y})\\} = 0"
      ],
      "keywords": [
