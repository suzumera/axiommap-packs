      ]
    },
    {
      "id": "phys.qft10.n06_dirac_mode_expansion_normal_hamiltonian",
      "short_code": "QFT10_06",
      "kind": "theorem_formula",
      "title": "ディラック場のモード展開・ディラックの海と正規順序ハミルトニアン",
      "summary": "自由ディラック場を粒子・反粒子のスピノル解でモード展開し、反交換関係を用いて正定値な正規順序ハミルトニアンを得ることで負エネルギー問題を解消する。",
      "canonical_latex": "\\hat{\\psi}(x) = \\int \\frac{d^3\\mathbf{p}}{(2\\pi)^3\\sqrt{2\\omega_{\\mathbf{p}}}}\\sum_{s=\\pm 1/2}\\big(\\hat{b}_{\\mathbf{p},s}u(\\mathbf{p},s)e^{ip\\cdot x} + \\hat{d}_{\\mathbf{p},s}^\\dagger v(\\mathbf{p},s)e^{-ip\\cdot x}\\big),\\qquad :\\!\\hat{H}_D\\!: \\,= \\int \\frac{d^3\\mathbf{p}}{(2\\pi)^3}\\sum_{s=\\pm 1/2}\\omega_{\\mathbf{p}}\\big(\\hat{b}_{\\mathbf{p},s}^\\dagger\\hat{b}_{\\mathbf{p},s} + \\hat{d}_{\\mathbf{p},s}^\\dagger\\hat{d}_{\\mathbf{p},s}\\big)",
      "aliases_latex": [
        "\\{\\hat{b}_{\\mathbf{p},s}, \\hat{b}_{\\mathbf{q},s'}^\\dagger\\} = \\{\\hat{d}_{\\mathbf{p},s}, \\hat{d}_{\\mathbf{q},s'}^\\dagger\\} = (2\\pi)^3\\delta^{(3)}(\\mathbf{p}-\\mathbf{q})\\delta_{ss'}",
        "\\omega_{\\mathbf{p}} = \\sqrt{|\\mathbf{p}|^2 + m^2}"
      ],
      "keywords": [
        "モード展開",
        "ディラックの海",
        "正規順序",
        "粒子・反粒子"
      ],
      "domain_tags": [
        "physics",
        "quantum_field_theory"
      ]
    },
    {
      "id": "phys.qft10.n07_dirac_path_integral_generating_functional",
      "short_code": "QFT10_07",
      "kind": "definition",
      "title": "自由ディラック場の経路積分とグラスマン外場源による母汎関数",
      "summary": "フェルミオン・コヒーレント状態と自由ディラック場の作用汎関数を用いて定義される、グラスマン値スピノル場およびグラスマン外場源に関する経路積分母汎関数。",
      "canonical_latex": "Z_0[\\bar{\\eta},\\eta] := \\int \\mathcal{D}\\bar{\\psi}\\mathcal{D}\\psi\\,\\exp\\!\\left(i\\int d^4x\\,\\big[\\bar{\\psi}(i\\gamma^\\mu\\partial_\\mu - m + i\\epsilon)\\psi + \\bar{\\eta}\\psi + \\bar{\\psi}\\eta\\big]\\right)",
      "aliases_latex": [
        "S_D[\\bar{\\psi},\\psi] = \\int d^4x\\,\\bar{\\psi}(i\\gamma^\\mu\\partial_\\mu - m)\\psi",
        "W_0[\\bar{\\eta},\\eta] = -i\\ln Z_0[\\bar{\\eta},\\eta]"
      ],
      "keywords": [
        "経路積分",
        "ディラック場",
        "母汎関数",
        "グラスマン外場源"
      ],
      "domain_tags": [
        "physics",
        "quantum_field_theory"
      ]
    },
    {
      "id": "phys.qft10.n08_dirac_gaussian_path_integral_propagator",
      "short_code": "QFT10_08",
      "kind": "theorem_formula",
      "title": "ディラック場のガウス経路積分評価とファインマン伝播関数",
      "summary": "自由ディラック場の母汎関数をグラスマン変数のガウス汎関数積分で厳密に評価し、外場源に関する2階汎関数微分からディラック場のファインマン伝播関数を導出する。",
      "canonical_latex": "Z_0[\\bar{\\eta},\\eta] = Z_0[0,0]\\exp\\!\\left(-\\int d^4x\\,d^4y\\,\\bar{\\eta}(x)S_F(x-y)\\eta(y)\\right),\\qquad \\langle 0|T\\{\\hat{\\psi}_\\alpha(x)\\hat{\\bar{\\psi}}_\\beta(y)\\}|0\\rangle = \\left.\\frac{1}{Z_0[0,0]}\\frac{\\delta^2 Z_0[\\bar{\\eta},\\eta]}{\\delta\\bar{\\eta}_\\alpha(x)\\delta\\eta_\\beta(y)}\\right|_{\\eta=\\bar{\\eta}=0} = S_{F,\\alpha\\beta}(x-y)",
      "aliases_latex": [
        "Z_0[0,0] = \\det(i\\gamma^\\mu\\partial_\\mu - m + i\\epsilon)",
        "(i\\gamma^\\mu\\partial_\\mu - m)S_F(x-y) = i\\delta^{(4)}(x-y)"
      ],
      "keywords": [
        "ファインマン伝播関数",
        "ガウス汎関数積分",
        "ディラック伝播関数",
        "2点相関関数"
      ],
      "domain_tags": [
        "physics",
        "quantum_field_theory"
      ]
    },
    {
      "id": "phys.qft10.n09_fermion_wick_theorem_loop_sign",
      "short_code": "QFT10_09",
      "kind": "theorem_formula",
      "title": "フェルミオンのウィックの定理と閉じたフェルミオンループの負符号",
      "summary": "母汎関数の多階グラスマン汎関数微分により任意の多点時間順序積が符号付き縮約の和（フェルミオンのウィックの定理）に展開されること、および閉じたフェルミオンループに伴う-1因子の導出。",
      "canonical_latex": "\\langle 0|T\\{\\hat{\\psi}(x_1)\\cdots\\hat{\\psi}(x_n)\\hat{\\bar{\\psi}}(y_1)\\cdots\\hat{\\bar{\\psi}}(y_n)\\}|0\\rangle = \\sum_{P\\in S_n} (-1)^{\\operatorname{sgn}(P)}\\prod_{k=1}^n S_F(x_k - y_{P(k)}),\\qquad \\text{closed fermion loop} \\implies (-1)",
      "aliases_latex": [
        "\\operatorname{Tr}\\ln(i\\gamma^\\mu\\partial_\\mu - m) = \\ln\\det(i\\gamma^\\mu\\partial_\\mu - m)",
        "\\langle 0|T\\{\\hat{\\psi}_1\\hat{\\bar{\\psi}}_2\\hat{\\psi}_3\\hat{\\bar{\\psi}}_4\\}|0\\rangle = S_{F,12}S_{F,34} - S_{F,14}S_{F,32}"
      ],
      "keywords": [
        "ウィックの定理",
