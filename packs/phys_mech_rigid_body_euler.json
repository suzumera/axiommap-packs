    {
      "id": "phys.mech.rb02_inertia_tensor_def",
      "short_code": "RB02",
      "kind": "definition",
      "title": "剛体の角運動量と慣性テンソルの定義",
      "summary": "一点の周りで回転する剛体の全角運動量は角速度ベクトルに対する線形写像として表され、その表現行列が慣性テンソル（2階対称テンソル）として定義される。",
      "canonical_latex": "\\mathbf{L} = \\mathbf{I}\\boldsymbol{\\omega},\\quad I_{jk} := \\sum_i m_i\\big(r_i^2\\delta_{jk} - x_{i,j}x_{i,k}\\big) = \\int_V \\rho(\\mathbf{r})\\big(r^2\\delta_{jk} - x_j x_k\\big)\\,dV",
      "aliases_latex": [
        "\\mathbf{I} = \\int_V \\rho(\\mathbf{r})\\big((\\mathbf{r}\\cdot\\mathbf{r})I_3 - \\mathbf{r}\\mathbf{r}^\\top\\big)\\,dV"
      ],
      "keywords": [
        "角運動量",
        "慣性テンソル",
        "慣性モーメント",
        "慣性乗積"
      ],
      "domain_tags": [
        "physics",
        "mechanics",
        "rigid_body"
      ],
      "intuition_oneliner": "要するに、回転のしにくさを表す「慣性」を、3次元のどの軸まわりでも扱えるように拡張した行列のことです。",
      "diagram_svg": "<svg viewBox='0 0 600 260' xmlns='http://www.w3.org/2000/svg'><g fill='none' stroke='currentColor' stroke-width='2'><path d='M300 200 L150 150 L300 50 L450 150 Z' stroke='#3b82f6'/><path d='M300 50 L300 220' stroke-dasharray='4 4'/><circle cx='300' cy='130' r='50' stroke='#f97316'/><text x='300' y='30' text-anchor='middle' fill='currentColor' font-size='14'>慣性テンソル</text><text x='130' y='160' fill='#3b82f6' font-size='12'≯̇</text></g></svg>"
    },
    {
      "id": "phys.mech.rb03_rotational_kinetic_energy",
      "short_code": "RB03",
      "kind": "theorem_formula",
      "title": "剛体の回転運動エネルギーと慣性テンソルの2次形式",
      "summary": "固定点または重心周りの剛体の回転運動エネルギーは、角速度ベクトルと角運動量の内積の半分、すなわち慣性テンソルを核とする正定値（半正定値）2次形式で表される。",
      "canonical_latex": "T_{\\mathrm{rot}} = \\frac{1}{2}\\boldsymbol{\\omega}\\cdot\\mathbf{L} = \\frac{1}{2}\\boldsymbol{\\omega}^\\top \\mathbf{I}\\boldsymbol{\\omega} = \\frac{1}{2}\\sum_{j,k=1}^{3} I_{jk}\\omega_j\\omega_k",
      "aliases_latex": [
        "K_{\\mathrm{rot}} = \\frac{1}{2}\\boldsymbol{\\omega}^\\top \\mathbf{I}\\boldsymbol{\\omega}"
      ],
      "keywords": [
        "回転運動エネルギー",
        "2次形式",
        "慣性テンソル"
      ],
      "domain_tags": [
        "physics",
        "mechanics",
        "rigid_body"
      ]
    },
    {
      "id": "phys.mech.rb04_parallel_axis_theorem",
      "short_code": "RB04",
      "kind": "theorem_formula",
      "title": "平行軸の定理（シュタイナーの定理）",
      "summary": "重心を通る軸に関する慣性テンソルに対し、平行移動した点に関する慣性テンソルは、全質量を重心に集中させた質点の慣性テンソルを加えたものに等しい。",
      "canonical_latex": "I_{jk}(\\mathbf{a}) = I_{jk}^{\\mathrm{cm}} + M\\big(a^2\\delta_{jk} - a_j a_k\\big)",
      "aliases_latex": [
        "I = I_{\\mathrm{cm}} + M d^2"
      ],
      "keywords": [
        "平行軸の定理",
        "シュタイナーの定理",
        "重心",
        "慣性テンソル"
      ],
      "domain_tags": [
        "physics",
        "mechanics",
        "rigid_body"
      ]
    },
    {
      "id": "phys.mech.rb05_principal_axes_inertia",
      "short_code": "RB05",
      "kind": "theorem_formula",
      "title": "慣性テンソルの直交対角化と慣性主軸・主慣性モーメント",
      "summary": "慣性テンソルは実対称半正定値行列であるためスペクトル定理により直交対角化可能であり、固有ベクトルが互いに直交する慣性主軸、固有値が非負の主慣性モーメントを与える。",
      "canonical_latex": "\\exists Q\\in\\mathrm{SO}(3):\\; Q^\\top \\mathbf{I} Q = \\operatorname{diag}(I_1, I_2, I_3)\\;(I_k \\ge 0),\\quad T_{\\mathrm{rot}} = \\frac{1}{2}\\sum_{k=1}^{3} I_k \\omega_k^2",
      "aliases_latex": [
        "\\mathbf{L} = I_1\\omega_1\\mathbf{e}'_1 + I_2\\omega_2\\mathbf{e}'_2 + I_3\\omega_3\\mathbf{e}'_3"
      ],
      "keywords": [
        "慣性主軸",
        "主慣性モーメント",
        "直交対角化",
        "スペクトル定理"
      ],
      "domain_tags": [
        "physics",
        "mechanics",
        "rigid_body"
      ]
    },
    {
      "id": "phys.mech.rb06_rigid_body_torque_eom",
      "short_code": "RB06",
      "kind": "theorem_formula",
      "title": "剛体の回転運動方程式（全角運動量と外力トルク）",
      "summary": "固定点または重心を原点にとるとき、作用・反作用の法則により内力によるトルクは互いに打ち消し合い、剛体の全角運動量の時間変化率は外力による合トルクに等しい。",
      "canonical_latex": "\\frac{d\\mathbf{L}}{dt} = \\mathbf{N}^{\\mathrm{ext}} = \\sum_i \\mathbf{r}_i\\times\\mathbf{F}_i^{\\mathrm{ext}}",
      "aliases_latex": [
        "\\dot{\\mathbf{L}} = \\boldsymbol{\\tau}_{\\mathrm{ext}}"
      ],
      "keywords": [
        "回転運動方程式",
        "外力トルク",
        "角運動量",
        "内力相殺"
      ],
      "domain_tags": [
        "physics",
        "mechanics",
        "rigid_body"
      ]
    },
    {
      "id": "phys.mech.rb07_euler_equations_rigid_body",
      "short_code": "RB07",
      "kind": "theorem_formula",
      "title": "オイラーの剛体運動方程式（主軸固定座標系）",
      "summary": "剛体に固定された慣性主軸座標系で輸送定理を適用することにより、慣性テンソルが定数対角行列となる形で剛体回転の非線形連立微分方程式が得られる。",
      "canonical_latex": "I_1\\dot{\\omega}_1 - (I_2 - I_3)\\omega_2\\omega_3 = N_1,\\quad I_2\\dot{\\omega}_2 - (I_3 - I_1)\\omega_3\\omega_1 = N_2,\\quad I_3\\dot{\\omega}_3 - (I_1 - I_2)\\omega_1\\omega_2 = N_3",
      "aliases_latex": [
        "\\mathbf{I}\\dot{\\boldsymbol{\\omega}} + \\boldsymbol{\\omega}\\times(\\mathbf{I}\\boldsymbol{\\omega}) = \\mathbf{N}"
      ],
      "keywords": [
        "オイラーの運動方程式",
        "剛体回転",
        "主軸座標系",
        "ジャイロ項"
      ],
      "domain_tags": [
        "physics",
        "mechanics",
        "rigid_body"
      ]
    },
    {
      "id": "phys.mech.rb08_euler_angles_rotation",
      "short_code": "RB08",
      "kind": "definition",
      "title": "オイラー角（ZXZ規約）による回転行列のパラメータ表示",
      "summary": "3次元特殊直交群 SO(3) の元を、歳差角 φ・章動角 θ・自転角 ψ の3つの独立な角度を用いた3回の連続基本回転の積として表現する。",
      "canonical_latex": "R(\\phi,\\theta,\\psi) = R_z(\\phi)R_x(\\theta)R_z(\\psi) = \\begin{pmatrix} \\cos\\phi\\cos\\psi - \\sin\\phi\\cos\\theta\\sin\\psi & -\\cos\\phi\\sin\\psi - \\sin\\phi\\cos\\theta\\cos\\psi & \\sin\\phi\\sin\\theta \\\\ \\sin\\phi\\cos\\psi + \\cos\\phi\\cos\\theta\\sin\\psi & -\\sin\\phi\\sin\\psi + \\cos\\phi\\cos\\theta\\cos\\psi & -\\cos\\phi\\sin\\theta \\\\ \\sin\\theta\\sin\\psi & \\sin\\theta\\cos\\psi & \\cos\\theta \\end{pmatrix}",
      "aliases_latex": [
        "R(\\phi,\\theta,\\psi) = \\exp(\\phi J_3)\\exp(\\theta J_1)\\exp(\\psi J_3)"
      ],
      "keywords": [
        "オイラー角",
        "回転行列",
        "SO(3)",
        "姿勢表現"
      ],
      "domain_tags": [
        "physics",
        "mechanics",
        "rigid_body"
      ]
    },
    {
      "id": "phys.mech.rb09_euler_kinematic_equations",
      "short_code": "RB09",
      "kind": "theorem_formula",
      "title": "オイラーの運動学方程式（角速度とオイラー角速度の関係）",
      "summary": "オイラー角による回転行列 R(φ,θ,ψ) の時間微分から導かれる、本体固定座標系における角速度ベクトル成分とオイラー角の時間微分の線形関係式。",
      "canonical_latex": "\\omega_1 = \\dot{\\phi}\\sin\\theta\\sin\\psi + \\dot{\\theta}\\cos\\psi,\\quad \\omega_2 = \\dot{\\phi}\\sin\\theta\\cos\\psi - \\dot{\\theta}\\sin\\psi,\\quad \\omega_3 = \\dot{\\phi}\\cos\\theta + \\dot{\\psi}",
      "aliases_latex": [
        "\\boldsymbol{\\omega}_{\\mathrm{body}} = \\dot{\\phi}\\,R_z(-\\psi)R_x(-\\theta)\\mathbf{e}_3 + \\dot{\\theta}\\,R_z(-\\psi)\\mathbf{e}_1 + \\dot{\\psi}\\mathbf{e}_3"
      ],
      "keywords": [
        "オイラーの運動学方程式",
        "角速度",
        "オイラー角",
        "ジンバルロック"
      ],
      "domain_tags": [
        "physics",
        "mechanics",
        "rigid_body"
      ]
    }
  ],
