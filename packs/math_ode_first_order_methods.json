    {
      "id": "math.ode.fo08_exact_ode_condition",
      "short_code": "FO08",
      "kind": "theorem_formula",
      "title": "完全微分方程式の判定条件とポテンシャル解法",
      "summary": "微分形式 M(x, y)dx + N(x, y)dy = 0 が単連結領域上で完全微分 dPhi = 0 となるための必要十分条件 dM/dy = dN/dx と、ポテンシャル関数 Phi(x, y) = C による一般解の構成法。",
      "canonical_latex": "\\frac{\\partial M}{\\partial y} = \\frac{\\partial N}{\\partial x} \\iff \\exists \\Phi(x,y)\\text{ s.t. } d\\Phi = M\\,dx + N\\,dy,\\quad \\Phi(x,y) = \\int M\\,dx + \\int\\left(N - \\frac{\\partial}{\\partial y}\\int M\\,dx\\right)dy = C",
      "aliases_latex": [
        "\\frac{\\partial \\Phi}{\\partial x} = M(x,y),\\quad \\frac{\\partial \\Phi}{\\partial y} = N(x,y)"
      ],
      "keywords": [
        "完全微分方程式",
        "ポテンシャル関数",
        "閉形式条件"
      ],
      "domain_tags": [
        "mathematics",
        "ode"
      ]
    },
    {
      "id": "math.ode.fo09_exact_ode_integrating_factor",
      "short_code": "FO09",
      "kind": "theorem_formula",
      "title": "非完全微分方程式の積分因子（1変数依存の判定公式）",
      "summary": "M dx + N dy = 0 が完全でないとき、積分因子 mu(x, y) を乗じて完全微分化する条件、および (M_y - N_x)/N が x のみ、あるいは (N_x - M_y)/M が y のみに依存する場合の積分因子の陽的公式。",
      "canonical_latex": "\\frac{1}{N}\\left(\\frac{\\partial M}{\\partial y} - \\frac{\\partial N}{\\partial x}\\right) = \\alpha(x) \\implies \\mu(x) = \\exp\\!\\left(\\int \\alpha(x)\\,dx\\right),\\qquad \\frac{1}{M}\\left(\\frac{\\partial N}{\\partial x} - \\frac{\\partial M}{\\partial y}\\right) = \\beta(y) \\implies \\mu(y) = \\exp\\!\\left(\\int \\beta(y)\\,dy\\right)",
      "aliases_latex": [
        "\\frac{\\partial(\\mu M)}{\\partial y} = \\frac{\\partial(\\mu N)}{\\partial x}"
      ],
      "keywords": [
