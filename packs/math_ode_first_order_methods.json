    {
      "id": "math.ode.fo02_separable_ode",
      "short_code": "FO02",
      "kind": "theorem_formula",
      "title": "変数分離形1階常微分方程式の解法",
      "summary": "右辺が x のみの関数と y のみの関数の積 g(x)h(y) に分解できる1階ODEに対し、両辺を分離して積分することで得られる一般解（および h(y_0)=0 に対応する特異解）の公式。",
      "canonical_latex": "\\frac{dy}{dx} = g(x)h(y) \\implies \\int \\frac{dy}{h(y)} = \\int g(x)\\,dx + C\\quad (h(y) \\neq 0)",
      "aliases_latex": [
        "\\int_{y_0}^{y} \\frac{d\\eta}{h(\\eta)} = \\int_{x_0}^{x} g(\\xi)\\,d\\xi"
      ],
      "keywords": [
        "変数分離形",
        "1階ODE",
        "求積法"
      ],
      "domain_tags": [
        "mathematics",
        "ode"
      ]
    },
    {
      "id": "math.ode.fo03_homogeneous_ode",
      "short_code": "FO03",
      "kind": "theorem_formula",
      "title": "同次形1階常微分方程式の解法",
      "summary": "右辺が y/x の関数 f(y/x) として表される同次形1階ODEを、変数変換 u = y/x によって変数分離形に帰着させる公式。",
      "canonical_latex": "\\frac{dy}{dx} = F\\!\\left(\\frac{y}{x}\\right),\\quad u = \\frac{y}{x} \\implies x\\frac{du}{dx} = F(u) - u \\implies \\int \\frac{du}{F(u) - u} = \\ln|x| + C",
      "aliases_latex": [
        "y(x) = x u(x),\\quad \\frac{dy}{dx} = u + x\\frac{du}{dx}"
      ],
      "keywords": [
        "同次形",
        "変数変換",
        "変数分離"
      ],
      "domain_tags": [
        "mathematics",
        "ode"
      ]
    },
    {
      "id": "math.ode.fo04_linear_ode_1st_def",
      "short_code": "FO04",
      "kind": "definition",
      "title": "1階線形常微分方程式の標準形と解の構造",
      "summary": "1階非同次線形ODE y' + P(x)y = Q(x) と対応する同次方程式 y' + P(x)y = 0 の定義、および一般解が同次解と特解の和で表される線形構造。",
      "canonical_latex": "L[y] := \\frac{dy}{dx} + P(x)y = Q(x),\\quad y = y_h + y_p\\quad (L[y_h] = 0,\\; L[y_p] = Q(x))",
      "aliases_latex": [
        "y'(x) + P(x)y(x) = Q(x)"
      ],
      "keywords": [
        "1階線形ODE",
        "同次解",
        "特解",
        "線形作用素"
      ],
      "domain_tags": [
        "mathematics",
        "ode"
      ]
    },
    {
      "id": "math.ode.fo05_integrating_factor_linear",
      "short_code": "FO05",
      "kind": "theorem_formula",
      "title": "1階線形常微分方程式の積分因子法と一般解公式",
      "summary": "積分因子 mu(x) = exp(int P(x) dx) を乗じて左辺を積の微分 (mu y)' にまとめることで導かれる1階線形ODEの陽的解法公式。",
      "canonical_latex": "\\mu(x) = \\exp\\!\\left(\\int P(x)\\,dx\\right) \\implies \\frac{d}{dx}\\big(\\mu(x)y\\big) = \\mu(x)Q(x) \\implies y(x) = \\mu(x)^{-1}\\left(\\int \\mu(x)Q(x)\\,dx + C\\right)",
      "aliases_latex": [
        "y(x) = e^{-\\int P(x)\\,dx}\\left(\\int Q(x)e^{\\int P(x)\\,dx}\\,dx + C\\right)"
      ],
      "keywords": [
        "積分因子法",
        "1階線形ODE",
        "一般解公式"
      ],
      "domain_tags": [
        "mathematics",
        "ode"
      ]
    },
    {
      "id": "math.ode.fo06_variation_of_parameters_1st",
      "short_code": "FO06",
      "kind": "theorem_formula",
      "title": "定数変化法による1階非同次線形ODEの解法",
      "summary": "同次方程式の一般解 y_h = C exp(-int P(x) dx) の任意定数 C を未知関数 C(x) に置き換えて非同次方程式に代入し、C'(x) を求積して特解・一般解を得る手法。",
      "canonical_latex": "y(x) = C(x)\\exp\\!\\left(-\\int P(x)\\,dx\\right) \\implies C'(x) = Q(x)\\exp\\!\\left(\\int P(x)\\,dx\\right) \\implies C(x) = \\int Q(x)\\exp\\!\\left(\\int P(x)\\,dx\\right)dx + C_0",
      "aliases_latex": [
        "y(x) = C(x)y_1(x),\\quad C'(x)y_1(x) = Q(x)"
