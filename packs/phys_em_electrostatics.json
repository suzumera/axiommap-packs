    },
    {
      "id": "phys.em.es02_electric_field_superposition",
      "short_code": "ES02",
      "kind": "definition",
      "title": "電場ベクトルと重ね合わせの原理",
      "summary": "単位正試験電荷が受ける静電気力として定義される静電場と、離散・連続電荷分布に対する線形重ね合わせの原理。",
      "canonical_latex": "\\mathbf{E}(\\mathbf{r}) := \\frac{\\mathbf{F}(\\mathbf{r})}{q_0} = \\frac{1}{4\\pi\\varepsilon_0}\\sum_{i=1}^{N} q_i\\frac{\\mathbf{r}-\\mathbf{r}_i}{|\\mathbf{r}-\\mathbf{r}_i|^3} = \\frac{1}{4\\pi\\varepsilon_0}\\iiint_{V} \\rho(\\mathbf{r}')\\frac{\\mathbf{r}-\\mathbf{r}'}{|\\mathbf{r}-\\mathbf{r}'|^3}\\,dV'",
      "aliases_latex": [
        "\\mathbf{E}(\\mathbf{r}) = \\frac{1}{4\\pi\\varepsilon_0}\\int \\frac{\\mathbf{r}-\\mathbf{r}'}{|\\mathbf{r}-\\mathbf{r}'|^3}\\,dq'"
