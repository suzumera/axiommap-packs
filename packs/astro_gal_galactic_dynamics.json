    {
      "id": "astro.gal.n02_collisionless_boltzmann_eq",
      "short_code": "GD02",
      "kind": "theorem_formula",
      "title": "無衝突ボルツマン方程式（CBE）",
      "summary": "二体緩和を無視できる恒星系において、重力ポテンシャル Φ のもとでの位相空間密度保存（リウヴィルの定理）を表す基本偏微分方程式。",
      "canonical_latex": "\\frac{\\partial f}{\\partial t} + \\mathbf{v}\\cdot\\nabla_{\\mathbf{x}} f - \\nabla\\Phi\\cdot\\nabla_{\\mathbf{v}} f = 0",
      "aliases_latex": [
        "\\frac{df}{dt} = \\frac{\\partial f}{\\partial t} + \\dot{\\mathbf{x}}\\cdot\\frac{\\partial f}{\\partial\\mathbf{x}} + \\dot{\\mathbf{v}}\\cdot\\frac{\\partial f}{\\partial\\mathbf{v}} = 0"
      ],
      "keywords": [
        "collisionless Boltzmann equation",
        "Vlasov equation",
        "phase space conservation"
      ],
      "domain_tags": [
        "astronomy",
        "galactic_dynamics"
      ]
    },
