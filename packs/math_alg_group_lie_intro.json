    {
      "id": "math.alg.gr06_so3_generators_commutation",
      "short_code": "GR06",
      "kind": "theorem_formula",
      "title": "SO(3) の無限小生成子とリー代数 so(3) の交換関係",
      "summary": "SO(3) のリー代数 so(3) が3次実歪対称行列の空間に一致し、エディントンのイプシロンを構造定数とする基本交換関係を満たすことを示す。",
      "canonical_latex": "\\mathfrak{so}(3)=\\{X\\in\\mathbb{R}^{3\\times 3}\\mid X^\\top=-X,\\;\\operatorname{tr}X=0\\},\\quad (J_i)_{jk}=-\\varepsilon_{ijk},\\quad J_i\\mathbf{v}=\\mathbf{e}_i\\times\\mathbf{v},\\quad [J_i,J_j]=\\sum_{k=1}^{3}\\varepsilon_{ijk}J_k",
      "aliases_latex": [
        "[J_1,J_2]=J_3,\\quad [J_2,J_3]=J_1,\\quad [J_3,J_1]=J_2"
      ],
      "keywords": [
