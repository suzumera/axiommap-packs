    {
      "id": "math.alg.gr10_su2_so3_double_cover",
      "short_code": "GR10",
      "kind": "theorem_formula",
      "title": "SU(2) から SO(3) への随伴準同型写像と二重被覆関係",
      "summary": "3次元ベクトルをトレース零エルミート行列に対応させる共役作用により全射準同型 Ad: SU(2) -> SO(3) を構成し、核が {±I2} であることから SU(2) が SO(3) の二重被覆群であることを示す。",
      "canonical_latex": "\\Phi(U)\\mathbf{x}\\cdot\\boldsymbol{\\sigma}:=U(\\mathbf{x}\\cdot\\boldsymbol{\\sigma})U^*,\\quad \\Phi\\big(U(\\hat{\\mathbf{n}},\\theta)\\big)=R(\\hat{\\mathbf{n}},\\theta),\\quad \\Phi: \\mathrm{SU}(2)\\twoheadrightarrow\\mathrm{SO}(3),\\quad \\ker\\Phi=\\{\\pm I_2\\},\\quad \\mathrm{SU}(2)/\\{\\pm I_2\\}\\cong\\mathrm{SO}(3)$$",
      "aliases_latex": [
