    {
      "id": "math.alg.gr09_su2_exp_spinor_rotation",
      "short_code": "GR09",
      "kind": "theorem_formula",
      "title": "パウリ行列の指数写像と SU(2) 元の回転軸表示",
      "summary": "su(2) の生成子の線形結合を指数写像で展開することで、SU(2) の任意の元が半角の三角関数とパウリ行列で表されることを示す。",
      "canonical_latex": "U(\\hat{\\mathbf{n}},\\theta)=\\exp\\!\\left(-i\\frac{\\theta}{2}\\hat{\\mathbf{n}}\\cdot\\boldsymbol{\\sigma}\\right)=\\cos\\frac{\\theta}{2}\\,I_2-i\\sin\\frac{\\theta}{2}(\\hat{\\mathbf{n}}\\cdot\\boldsymbol{\\sigma}),\\quad (\\hat{\\mathbf{n}}\\cdot\\boldsymbol{\\sigma})^2=I_2,\\; U(\\hat{\\mathbf{n}},\\theta+2\\pi)=-U(\\hat{\\mathbf{n}},\\theta)$$",
      "aliases_latex": [
