        "lie_groups"
      ]
    },
    {
      "id": "math.alg.gr07_rodrigues_rotation_exp_map",
      "short_code": "GR07",
      "kind": "theorem_formula",
      "title": "指数写像による SO(3) の生成とロドリゲスの回転公式",
      "summary": "単位回転軸ベクトルと回転角に対する無限小生成子の行列指数関数がロドリゲスの回転公式と一致し、SO(3) の回転行列を閉形式で与えることを示す。",
      "canonical_latex": "R(\\hat{\\mathbf{n}},\\theta)=\\exp(\\theta K)=\\exp\\!\\left(\\theta\\sum_{i=1}^{3}n_i J_i\\right)=I_3+\\sin\\theta\\,K+(1-\\cos\\theta)K^2,\\quad K\\mathbf{v}=\\hat{\\mathbf{n}}\\times\\mathbf{v},\\; K^3=-K",
      "aliases_latex": [
        "R(\\hat{\\mathbf{n}},\\theta)\\mathbf{v}=\\mathbf{v}\\cos\\theta+(\\hat{\\mathbf{n}}\\times\\mathbf{v})\\sin\\theta+\\hat{\\mathbf{n}}(\\hat{\\mathbf{n}}\\cdot\\mathbf{v})(1-\\cos\\theta)"
      ],
      "keywords": [
        "exponential map",
        "Rodrigues rotation formula",
        "axis-angle representation",
