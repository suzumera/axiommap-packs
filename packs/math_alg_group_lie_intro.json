    {
      "id": "math.alg.gr04_so3_su2_matrix_groups_def",
      "short_code": "GR04",
      "kind": "definition",
      "title": "3次元特殊直交群 SO(3) と 2次特殊ユニタリ群 SU(2) の定義",
      "summary": "3次元実空間の向きを保つ回転を表す特殊直交群 SO(3) と、2次元複素空間のノルム保存変換で determinant が 1 である特殊ユニタリ群 SU(2) を行列群として定義する。",
      "canonical_latex": "\\mathrm{SO}(3):=\\{R\\in\\mathbb{R}^{3\\times 3}\\mid R^\\top R=I_3,\\;\\det R=1\\},\\qquad \\mathrm{SU}(2):=\\{U\\in\\mathbb{C}^{2\\times 2}\\mid U^* U=I_2,\\;\\det U=1\\},\\qquad U=\\begin{pmatrix}\\alpha & -\\bar{\\beta}\\\\\\beta & \\bar{\\alpha}\\end{pmatrix}\\;( |\\alpha|^2+|\\beta|^2=1 )",
      "aliases_latex": [
        "\\mathrm{SO}(3)=\\{R\\in O(3)\\mid \\det R=1\\},\\quad \\mathrm{SU}(2)=\\{U\\in U(2)\\mid \\det U=1\\}"
