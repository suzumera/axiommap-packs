    {
      "id": "math.alg.gr05_lie_algebra_commutator_def",
      "short_code": "GR05",
      "kind": "definition",
      "title": "行列リー群のリー代数と交換子積（リー括弧）の定義",
      "summary": "1パラメータ部分群の単位元における接空間として行列リー群のリー代数を定義し、双線形性・歪対称性・ヤコビ恒等式を満たす交換子積を導入する。",
      "canonical_latex": "\\mathfrak{g}:=\\{X\\in M_n(\\mathbb{F})\\mid \\forall t\\in\\mathbb{R},\\; e^{tX}\\in G\\},\\quad [X,Y]:=XY-YX,\\quad [X,Y]=-[Y,X],\\quad [X,[Y,Z]]+[Y,[Z,X]]+[Z,[X,Y]]=0",
      "aliases_latex": [
        "\\mathfrak{g}=T_I G,\\quad [X,Y]=XY-YX"
      ],
      "keywords": [
