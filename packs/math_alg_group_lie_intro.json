    {
      "id": "math.alg.gr08_su2_pauli_generators",
      "short_code": "GR08",
      "kind": "theorem_formula",
      "title": "SU(2) のリー代数 su(2) とパウリ行列による生成子・交換関係",
      "summary": "SU(2) のリー代数 su(2) がトレース零の反エルミート行列の空間であり、パウリ行列を用いた生成子が so(3) と同型な交換関係を満たすことを示す。",
      "canonical_latex": "\\mathfrak{su}(2)=\\{X\\in\\mathbb{C}^{2\\times 2}\\mid X^*=-X,\\;\\operatorname{tr}X=0\\},\\quad \\sigma_j\\sigma_k=\\delta_{jk}I_2+i\\sum_{l=1}^{3}\\varepsilon_{jkl}\\sigma_l,\\quad X_k:=-\\frac{i}{2}\\sigma_k,\\quad [X_j,X_k]=\\sum_{l=1}^{3}\\varepsilon_{jkl}X_l",
      "aliases_latex": [
        "[\\sigma_j,\\sigma_k]=2i\\sum_{l=1}^{3}\\varepsilon_{jkl}\\sigma_l,\\quad [X_j,X_k]=\\sum_{l=1}^{3}\\varepsilon_{jkl}X_l"
