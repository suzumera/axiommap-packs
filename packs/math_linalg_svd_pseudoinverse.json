  "nodes": [
    {
      "id": "math.linalg.svd01_gram_matrix_psd",
      "short_code": "SVD01",
      "kind": "theorem_formula",
      "title": "グラム行列 A^T A の半正定値性と核・階数の一致",
      "summary": "任意の実長方行列 A に対してグラム行列 A^T A は実対称半正定値であり、その核と階数は元の行列 A の核と階数に一致する。",
      "canonical_latex": "(A^\\top A)^\\top = A^\\top A,\\quad \\forall \\mathbf{x}\\in\\mathbb{R}^n,\\; \\mathbf{x}^\\top(A^\\top A)\\mathbf{x}=\\|A\\mathbf{x}\\|_2^2\\ge 0,\\quad \\ker(A^\\top A)=\\ker(A),\\quad \\operatorname{rank}(A^\\top A)=\\operatorname{rank}(A)",
      "aliases_latex": [
        "\\ker(A^\\top A) = \\ker(A) \\land \\operatorname{rank}(A^\\top A) = \\operatorname{rank}(A)"
      ],
      "keywords": [
        "グラム行列",
        "半正定値",
        "核",
        "階数",
        "Gram matrix",
        "positive semidefinite"
      ],
      "domain_tags": [
        "mathematics",
        "linear_algebra"
      ]
    },
    {
      "id": "math.linalg.svd02_singular_value_def",
      "short_code": "SVD02",
      "kind": "definition",
      "title": "特異値・右特異ベクトル・左特異ベクトルの定義",
      "summary": "A^T A の非負固有値の平方根を特異値、その単位固有ベクトルを右特異ベクトル、正の特異値に対する Av_i の正規化を左特異ベクトルと定義する。",
      "canonical_latex": "\\sigma_i := \\sqrt{\\lambda_i(A^\\top A)}\\ge 0,\\quad A^\\top A\\mathbf{v}_i = \\sigma_i^2\\mathbf{v}_i\\ (\\|\\mathbf{v}_i\\|_2=1),\\quad \\mathbf{u}_i := \\frac{1}{\\sigma_i}A\\mathbf{v}_i\\ (\\sigma_i > 0)",
      "aliases_latex": [
        "A\\mathbf{v}_i = \\sigma_i\\mathbf{u}_i,\\quad A^\\top\\mathbf{u}_i = \\sigma_i\\mathbf{v}_i"
      ],
      "keywords": [
        "特異値",
        "右特異ベクトル",
        "左特異ベクトル",
        "singular value",
        "singular vector"
      ],
      "domain_tags": [
        "mathematics",
        "linear_algebra"
      ]
    },
    {
      "id": "math.linalg.svd03_singular_value_decomposition",
      "short_code": "SVD03",
      "kind": "theorem_formula",
      "title": "特異値分解（SVD）定理（完全分解と簡約分解）",
      "summary": "任意の実行列 A ∈ R^{m×n} は直交行列 U, V と非負対角行列 Σ を用いて A = U Σ V^T に分解でき、階数 r の外積和として表現できる。",
      "canonical_latex": "A = U\\Sigma V^\\top = \\sum_{i=1}^{r}\\sigma_i\\mathbf{u}_i\\mathbf{v}_i^\\top,\\quad U^\\top U = I_m,\\; V^\\top V = I_n,\\; \\sigma_1\\ge\\cdots\\ge\\sigma_r > 0 = \\sigma_{r+1}=\\cdots=\\sigma_{\\min(m,n)}",
      "aliases_latex": [
        "A = U_r\\Sigma_r V_r^\\top"
      ],
      "keywords": [
        "特異値分解",
        "SVD",
        "直交行列",
        "外積展開",
        "singular value decomposition"
      ],
      "domain_tags": [
        "mathematics",
        "linear_algebra"
      ]
    },
    {
      "id": "math.linalg.svd04_four_fundamental_subspaces",
      "short_code": "SVD04",
      "kind": "theorem_formula",
      "title": "SVDによる4つの基本部分空間の正規直交基底と直交分解",
      "summary": "SVD の左右特異ベクトルは A の像・左零空間・行空間・零空間の正規直交基底を与え、領域と値域の直交補空間分解を構成する。",
      "canonical_latex": "\\operatorname{Im}(A)=\\operatorname{span}(\\mathbf{u}_1,\\dots,\\mathbf{u}_r),\\; \\ker(A^\\top)=\\operatorname{span}(\\mathbf{u}_{r+1},\\dots,\\mathbf{u}_m),\\; \\operatorname{Im}(A^\\top)=\\operatorname{span}(\\mathbf{v}_1,\\dots,\\mathbf{v}_r),\\; \\ker(A)=\\operatorname{span}(\\mathbf{v}_{r+1},\\dots,\\mathbf{v}_n)",
      "aliases_latex": [
        "\\mathbb{R}^m = \\operatorname{Im}(A)\\oplus\\ker(A^\\top),\\quad \\mathbb{R}^n = \\operatorname{Im}(A^\\top)\\oplus\\ker(A)"
      ],
      "keywords": [
        "4つの基本部分空間",
        "正規直交基底",
        "直交補空間",
        "four fundamental subspaces"
      ],
      "domain_tags": [
        "mathematics",
        "linear_algebra"
      ]
    },
    {
      "id": "math.linalg.svd05_least_squares_normal_eq",
      "short_code": "SVD05",
      "kind": "theorem_formula",
      "title": "線形最小二乗問題と正規方程式（Normal Equations）",
      "summary": "ユークリッド残差ノルム ||Ax - b||_2^2 を最小化する最小二乗解は正規方程式 A^T A x = A^T b の解と一致し、列フルランク時に一意となる。",
      "canonical_latex": "\\hat{\\mathbf{x}}\\in\\arg\\min_{\\mathbf{x}\\in\\mathbb{R}^n}\\|A\\mathbf{x}-\\mathbf{b}\\|_2^2 \\iff A^\\top A\\hat{\\mathbf{x}} = A^\\top\\mathbf{b},\\quad \\operatorname{rank}(A)=n \\implies \\hat{\\mathbf{x}}=(A^\\top A)^{-1}A^\\top\\mathbf{b}",
      "aliases_latex": [
        "A^\\top A\\hat{\\mathbf{x}} = A^\\top\\mathbf{b}"
      ],
      "keywords": [
        "最小二乗法",
        "正規方程式",
        "射影",
        "least squares",
        "normal equations"
      ],
      "domain_tags": [
        "mathematics",
        "linear_algebra",
        "optimization"
      ]
    },
    {
      "id": "math.linalg.svd06_moore_penrose_axioms",
      "short_code": "SVD06",
      "kind": "definition",
      "title": "ムーア＝ペンローズ一般化逆行列（擬似逆行列）の公理的定義",
      "summary": "任意の長方行列 A に対して 4 つのムーア＝ペンローズ条件を満たす行列 A^+ を擬似逆行列と定義する。",
      "canonical_latex": "A A^+ A = A,\\quad A^+ A A^+ = A^+,\\quad (A A^+)^\\top = A A^+,\\quad (A^+ A)^\\top = A^+ A",
      "aliases_latex": [
        "A^+ \\text{ satisfies Moore-Penrose conditions}"
      ],
      "keywords": [
        "ムーア＝ペンローズ",
        "擬似逆行列",
        "一般化逆行列",
        "Moore-Penrose pseudoinverse"
      ],
      "domain_tags": [
        "mathematics",
        "linear_algebra"
      ]
    },
    {
      "id": "math.linalg.svd07_pseudoinverse_svd_formula",
      "short_code": "SVD07",
      "kind": "theorem_formula",
      "title": "SVDによる擬似逆行列の明示公式と最小ノルム最小二乗解",
      "summary": "SVD を用いて A^+ = V Σ^+ U^T を構成でき、x^+ = A^+ b はあらゆる最小二乗解の中でユークリッドノルム ||x||_2 が最小の一意解を与える。",
      "canonical_latex": "A^+ = V\\Sigma^+ U^\\top = \\sum_{i=1}^{r}\\frac{1}{\\sigma_i}\\mathbf{v}_i\\mathbf{u}_i^\\top,\\quad \\mathbf{x}^+ := A^+\\mathbf{b} = \\arg\\min_{\\mathbf{x}\\in\\arg\\min\\|A\\mathbf{x}-\\mathbf{b}\\|_2}\\|\\mathbf{x}\\|_2",
      "aliases_latex": [
        "A^+ = V_r\\Sigma_r^{-1}U_r^\\top"
      ],
      "keywords": [
        "擬似逆行列",
        "最小ノルム解",
        "最小二乗法",
        "SVD",
        "minimum-norm least squares"
      ],
      "domain_tags": [
        "mathematics",
        "linear_algebra",
        "optimization"
      ]
    },
    {
      "id": "math.linalg.svd08_matrix_norms_def",
      "short_code": "SVD08",
      "kind": "definition",
      "title": "行列のフロベニウスノルムとスペクトルノルムの定義",
      "summary": "行列の成分二乗和の平方根をフロベニウスノルム、単位球の像の最大ユークリッドノルムをスペクトルノルムと定義する。",
      "canonical_latex": "\\|A\\|_F := \\sqrt{\\sum_{i=1}^{m}\\sum_{j=1}^{n} A_{ij}^2} = \\sqrt{\\operatorname{tr}(A^\\top A)},\\quad \\|A\\|_2 := \\max_{\\|\\mathbf{x}\\|_2=1}\\|A\\mathbf{x}\\|_2",
      "aliases_latex": [
        "\\|A\\|_F = \\sqrt{\\operatorname{tr}(A^\\top A)},\\quad \\|A\\|_2 = \\sigma_1(A)"
      ],
      "keywords": [
        "フロベニウスノルム",
        "スペクトルノルム",
        "Frobenius norm",
        "spectral norm"
      ],
      "domain_tags": [
        "mathematics",
        "linear_algebra"
      ]
    },
    {
      "id": "math.linalg.svd09_eckart_young_mirsky",
      "short_code": "SVD09",
      "kind": "theorem_formula",
      "title": "エッカルト＝ヤング＝ミルスキーの定理（最適低ランク近似）",
      "summary": "上位 k 個の特異値成分のみを残した打ち切り SVD 行列 A_k は、スペクトルノルムおよびフロベニウスノルムの両方においてランク k 以下の最良近似を与える。",
      "canonical_latex": "A_k := \\sum_{i=1}^{k}\\sigma_i\\mathbf{u}_i\\mathbf{v}_i^\\top \\implies \\min_{\\operatorname{rank}(B)\\le k}\\|A-B\\|_2 = \\|A-A_k\\|_2 = \\sigma_{k+1},\\quad \\min_{\\operatorname{rank}(B)\\le k}\\|A-B\\|_F = \\|A-A_k\\|_F = \\sqrt{\\sum_{i=k+1}^{r}\\sigma_i^2}",
      "aliases_latex": [
        "A_k = \\arg\\min_{\\operatorname{rank}(B)\\le k}\\|A-B\\|_{2,F}"
      ],
      "keywords": [
        "低ランク近似",
        "エッカルト＝ヤング＝ミルスキー",
        "打ち切りSVD",
        "low-rank approximation",
        "Eckart-Young-Mirsky"
      ],
      "domain_tags": [
        "mathematics",
        "linear_algebra",
        "optimization"
      ]
    }
