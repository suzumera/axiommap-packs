    {
      "id": "eng.crypto.n07_diffie_hellman_key_exchange",
      "short_code": "CR07",
      "kind": "theorem_formula",
      "title": "ディフィー＝ヘルマン（DH）鍵交換と共有鍵の一致定理",
      "summary": "公開パラメータ (G, g) と各自の秘密鍵 a, b から公開鍵 A=g^a, B=g^b を交換し、通信路上で同一の共有秘密鍵 K = g^{ab} を合意するプロトコルとその正当性。",
      "canonical_latex": "A = g^a,\\; B = g^b \\implies K_A = B^a = (g^b)^a = g^{ab} = (g^a)^b = A^b = K_B",
      "aliases_latex": [
        "K \\equiv (g^b)^a \\equiv (g^a)^b \\equiv g^{ab} \\pmod{p}"
      ],
      "keywords": [
