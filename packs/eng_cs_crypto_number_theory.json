    {
      "id": "eng.crypto.n02_modular_arithmetic_zn",
      "short_code": "CR02",
      "kind": "definition",
      "title": "合同式・剰余環 Z/nZ および既約剰余類群 (Z/nZ)^×",
      "summary": "法 n に関する合同関係と同値類による剰余環、ならびに法 n と互いに素な剰余類がなす乗法可換群の定義。",
      "canonical_latex": "a \\equiv b \\pmod{n} \\iff n \\mid (a - b),\\qquad (\\mathbb{Z}/n\\mathbb{Z})^\\times := \\{ [a]_n \\in \\mathbb{Z}/n\\mathbb{Z} \\mid \\gcd(a, n) = 1 \\}",
