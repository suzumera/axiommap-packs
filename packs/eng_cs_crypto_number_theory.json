    {
      "id": "eng.crypto.n03_euler_totient_function",
      "short_code": "CR03",
      "kind": "definition",
      "title": "オイラーの φ 関数と素数積に対する公式",
      "summary": "1 以上 n 以下の整数のうち n と互いに素なものの個数を表すオイラーのトーシェント関数 φ(n) と、異なる素数 p, q の積 n=pq に対する計数公式。",
      "canonical_latex": "\\varphi(n) := \\left|(\\mathbb{Z}/n\\mathbb{Z})^\\times\\right| = \\#\\{ k \\in \\{1,\\dots,n\\} \\mid \\gcd(k,n)=1 \\},\\qquad \\varphi(pq) = (p-1)(q-1)\\;(p \\neq q \\text{ prime})",
      "aliases_latex": [
        "\\varphi(p) = p - 1,\\quad \\varphi(p^k) = p^k - p^{k-1}"
      ],
      "keywords": [
        "オイラーのφ関数",
        "トーシェント関数",
        "互いに素"
      ],
      "domain_tags": [
        "computer_science",
        "cryptography",
        "number_theory"
      ]
    },
    {
      "id": "eng.crypto.n04_euler_fermat_theorem",
      "short_code": "CR04",
      "kind": "theorem_formula",
      "title": "オイラーの定理とフェルマーの小定理",
      "summary": "法 n と互いに素な整数 a を φ(n) 乗すると法 n で 1 に合同になるというオイラーの定理、および素数法 p に対する特殊ケースであるフェルマーの小定理。",
      "canonical_latex": "\\gcd(a, n) = 1 \\implies a^{\\varphi(n)} \\equiv 1 \\pmod{n},\\qquad p \\text{ prime},\\; p \\nmid a \\implies a^{p-1} \\equiv 1 \\pmod{p}",
      "aliases_latex": [
        "a^p \\equiv a \\pmod{p}"
      ],
      "keywords": [
        "オイラーの定理",
        "フェルマーの小定理",
        "べき剰余"
      ],
      "domain_tags": [
        "computer_science",
        "cryptography",
        "number_theory"
      ]
    },
    {
      "id": "eng.crypto.n05_rsa_cryptosystem_correctness",
      "short_code": "CR05",
      "kind": "theorem_formula",
      "title": "RSA暗号の鍵生成と復号正当性定理",
      "summary": "2つの異なる素数 p, q の積 n=pq と ed ≡ 1 (mod φ(n)) を満たす公開鍵 e・秘密鍵 d に対し、任意の平文 M で復号 (M^e)^d ≡ M (mod n) が成立する定理。",
      "canonical_latex": "n = pq,\\; ed \\equiv 1 \\pmod{\\varphi(n)} \\implies \\forall M \\in \\mathbb{Z},\\; (M^e)^d \\equiv M \\pmod{n}",
      "aliases_latex": [
        "C \\equiv M^e \\pmod{n},\\quad M \\equiv C^d \\pmod{n}"
      ],
      "keywords": [
        "RSA暗号",
        "公開鍵暗号",
        "復号正当性",
        "秘密鍵"
      ],
