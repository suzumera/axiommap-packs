  "nodes": [
    {
      "id": "math.linalg.vs01_vector_space_axioms",
      "short_code": "VS01",
      "kind": "axiom",
      "title": "ベクトル空間（線形空間）の公理",
      "summary": "体 F（実数 R または複素数 C）上の集合 V に加法とスカラー乗法が定義され、加法の可換群性、分配法則、結合法則、単位元の8公理を満たす代数的構造。",
      "canonical_latex": "\\forall \\mathbf{u},\\mathbf{v},\\mathbf{w}\\in V,\\ \\forall \\alpha,\\beta\\in\\mathbb{F}:\\; (\\mathbf{u}+\\mathbf{v})+\\mathbf{w}=\\mathbf{u}+(\\mathbf{v}+\\mathbf{w}),\\; \\mathbf{u}+\\mathbf{v}=\\mathbf{v}+\\mathbf{u},\\; \\exists\\mathbf{0}\\in V\\text{ s.t. }\\mathbf{v}+\\mathbf{0}=\\mathbf{v},\\; \\exists(-\\mathbf{v})\\in V\\text{ s.t. }\\mathbf{v}+(-\\mathbf{v})=\\mathbf{0},\\; \\alpha(\\mathbf{u}+\\mathbf{v})=\\alpha\\mathbf{u}+\\alpha\\mathbf{v},\\; (\\alpha+\\beta)\\mathbf{v}=\\alpha\\mathbf{v}+\\beta\\mathbf{v},\\; (\\alpha\\beta)\\mathbf{v}=\\alpha(\\beta\\mathbf{v}),\\; 1\\mathbf{v}=\\mathbf{v} ",
      "aliases_latex": [
        "(V, +, \\cdot)\\text{ is a vector space over }\\mathbb{F}"
      ],
      "keywords": [
        "ベクトル空間",
        "線形空間",
        "公理",
        "スカラー倍",
        "加法"
      ],
      "domain_tags": [
        "mathematics",
        "linear_algebra"
      ],
      "intuition_oneliner": "矢印や関数など、足し算（並び替えや0の存在）と定数倍（伸ばす・縮める）が直感通りに自由に行える世界のルールです。",
      "diagram_svg": "<svg viewBox=\"0 0 600 260\" xmlns=\"http://www.w3.org/2000/svg\"><defs><marker id=\"arr2\" viewBox=\"0 0 10 10\" refX=\"8\" refY=\"5\" markerWidth=\"6\" markerHeight=\"6\" orient=\"auto-start-reverse\"><path d=\"M0,0L10,5L0,10z\" fill=\"currentColor\"/></marker></defs><path d=\"M60,190L160,190\" stroke=\"#3b82f6\" stroke-width=\"3\" marker-end=\"url(#arr2)\"/><path d=\"M160,190L220,120\" stroke=\"#10b981\" stroke-width=\"3\" marker-end=\"url(#arr2)\"/><path d=\"M60,190L220,120\" stroke=\"#f97316\" stroke-width=\"3\" marker-end=\"url(#arr2)\"/><text x=\"100\" y=\"210\" font-size=\"15\" fill=\"#3b82f6\">u</text><text x=\"200\" y=\"160\" font-size=\"15\" fill=\"#10b981\">v</text><text x=\"110\" y=\"145\" font-size=\"15\" fill=\"#f97316\">u + v</text><rect x=\"280\" y=\"45\" width=\"290\" height=\"175\" rx=\"10\" fill=\"none\" stroke=\"currentColor\" stroke-dasharray=\"4,4\"/><text x=\"300\" y=\"75\" font-size=\"16\" font-weight=\"bold\" fill=\"currentColor\">ベクトル空間の2大柱 (計8公理)</text><text x=\"300\" y=\"110\" font-size=\"15\" fill=\"#3b82f6\">【加法】 自由な足し算</text><text x=\"320\" y=\"135\" font-size=\"14\" fill=\"currentColor\">u+v = v+u, 0の存在, 逆元の存在</text><text x=\"300\" y=\"170\" font-size=\"15\" fill=\"#10b981\">【スカラー倍】 自由な伸縮</text><text x=\"320\" y=\"195\" font-size=\"14\" fill=\"currentColor\">α(u+v) = αu + αv, 1v = v</text></svg>"
    },
    {
      "id": "math.linalg.vs02_subspace_criterion",
      "short_code": "VS02",
      "kind": "theorem_formula",
      "title": "部分空間の定義と部分空間判定条件",
      "summary": "ベクトル空間 V の空でない部分集合 W が同じ演算のもとでベクトル空間をなす（部分空間である）ための必要十分条件は、任意の線形結合について閉じていることである。",
      "canonical_latex": "W \\le V \\iff W \\neq \\emptyset \\land \\forall \\mathbf{u},\\mathbf{v}\\in W,\\ \\forall \\alpha,\\beta\\in\\mathbb{F},\\; \\alpha\\mathbf{u}+\\beta\\mathbf{v}\\in W",
      "aliases_latex": [
        "W \\le V \\iff \\mathbf{0}\\in W \\land (\\mathbf{u}+\\mathbf{v}\\in W) \\land (\\alpha\\mathbf{u}\\in W)"
      ],
      "keywords": [
        "部分空間",
        "閉性",
        "線形結合",
        "判定条件"
      ],
      "domain_tags": [
        "mathematics",
        "linear_algebra"
      ]
    },
    {
      "id": "math.linalg.vs03_linear_independence_span",
      "short_code": "VS03",
      "kind": "definition",
      "title": "線形結合・生成空間・線形独立の定義",
      "summary": "有限個のベクトルの線形結合全体がなす生成空間（スパン）と、自明でない線形結合で零ベクトルを表せない性質としての線形独立（1次独立）・線形従属を定義する。",
      "canonical_latex": "\\operatorname{span}(\\mathbf{v}_1,\\dots,\\mathbf{v}_k) := \\left\\{\\sum_{i=1}^{k} c_i\\mathbf{v}_i \\;\\middle|\\; c_i\\in\\mathbb{F}\\right\\},\\quad \\{\\mathbf{v}_1,\\dots,\\mathbf{v}_k\\}\\text{ linearly independent} \\iff \\left(\\sum_{i=1}^{k} c_i\\mathbf{v}_i = \\mathbf{0} \\implies c_1=\\dots=c_k=0\\right) ",
      "aliases_latex": [
        "\\langle \\mathbf{v}_1,\\dots,\\mathbf{v}_k \\rangle = \\operatorname{span}(\\mathbf{v}_1,\\dots,\\mathbf{v}_k)"
      ],
      "keywords": [
        "線形独立",
        "1次独立",
        "線形従属",
        "生成空間",
        "スパン"
      ],
      "domain_tags": [
        "mathematics",
        "linear_algebra"
      ]
    },
    {
      "id": "math.linalg.vs04_basis_and_dimension",
      "short_code": "VS04",
      "kind": "definition",
      "title": "基底・座標ベクトル・次元の定義",
      "summary": "線形独立かつベクトル空間 V 全体を生成するベクトルの組を基底と定義し、基底の元の個数（有限次元の場合）を次元 dim V と定義する。",
      "canonical_latex": "\\mathcal{B}=(\\mathbf{e}_1,\\dots,\\mathbf{e}_n)\\text{ is a basis of } V \\iff \\mathcal{B}\\text{ is linearly independent} \\land \\operatorname{span}(\\mathcal{B})=V,\\quad \\dim V := |\\mathcal{B}| = n",
      "aliases_latex": [
        "\\dim_{\\mathbb{F}} V = n"
      ],
      "keywords": [
        "基底",
        "次元",
        "生成系",
        "線形独立"
      ],
      "domain_tags": [
        "mathematics",
        "linear_algebra"
      ]
    },
    {
      "id": "math.linalg.vs05_unique_coord_steinitz",
      "short_code": "VS05",
      "kind": "theorem_formula",
      "title": "座標表示の一意性とシュタイニッツの交換定理（次元の不変性）",
      "summary": "基底による任意のベクトルの線形結合表示は一意に定まり、また任意の線形独立集合の元の個数は生成集合の元の個数を超えない（シュタイニッツの交換定理）。これにより次元は基底の選び方に依らず不変となる。",
      "canonical_latex": "\\forall \\mathbf{v}\\in V,\\ \\exists! (x_1,\\dots,x_n)^\\top\\in\\mathbb{F}^n:\\; \\mathbf{v}=\\sum_{i=1}^{n} x_i\\mathbf{e}_i,\\quad [\\mathbf{v}]_{\\mathcal{B}}:=(x_1,\\dots,x_n)^\\top;\\quad |\\mathcal{B}_1| = |\\mathcal{B}_2| = \\dim V",
      "aliases_latex": [
        "\\mathbf{v}\\in V \\leftrightarrow [\\mathbf{v}]_{\\mathcal{B}}\\in\\mathbb{F}^n,\\quad m\\le n\\text{ (Steinitz)}"
      ],
      "keywords": [
        "座標表示",
        "一意性",
        "シュタイニッツの交換定理",
        "次元の不変性"
      ],
      "domain_tags": [
        "mathematics",
        "linear_algebra"
      ]
    },
    {
      "id": "math.linalg.vs06_change_of_basis",
      "short_code": "VS06",
      "kind": "theorem_formula",
      "title": "基底変換行列と座標の変換公式",
      "summary": "旧基底 B から新基底 B' への基底変換行列 P（第 j 列が新基底ベクトル e'_j の B 座標）を定めると、任意のベクトルの座標は逆行列 P^{-1} を用いて変換される。",
      "canonical_latex": "\\mathbf{e}'_j = \\sum_{i=1}^{n} P_{ij}\\mathbf{e}_i \\implies \\det P \\neq 0 \\land [\\mathbf{v}]_{\\mathcal{B}} = P[\\mathbf{v}]_{\\mathcal{B}'} \\land [\\mathbf{v}]_{\\mathcal{B}'} = P^{-1}[\\mathbf{v}]_{\\mathcal{B}}",
      "aliases_latex": [
        "\\mathcal{B}' = \\mathcal{B}P \\implies [\\mathbf{v}]_{\\mathcal{B}'} = P^{-1}[\\mathbf{v}]_{\\mathcal{B}}"
      ],
      "keywords": [
        "基底変換",
        "変換行列",
        "座標変換",
        "正則行列"
      ],
      "domain_tags": [
        "mathematics",
        "linear_algebra"
      ]
    },
    {
      "id": "math.linalg.vs07_linear_map_ker_im_def",
      "short_code": "VS07",
      "kind": "definition",
      "title": "線形写像・核（Ker）と像（Im）の定義",
      "summary": "ベクトル空間 V から W への写像 T で加法性と斉次性（線形性）を保つものを線形写像と定義し、零ベクトルへ写される元の集合を核 ker T、値域を像 Im T と定義する。",
      "canonical_latex": "T(\\alpha\\mathbf{u}+\\beta\\mathbf{v}) = \\alpha T(\\mathbf{u})+\\beta T(\\mathbf{v}),\\quad \\ker T := \\{\\mathbf{v}\\in V \\mid T(\\mathbf{v})=\\mathbf{0}_W\\},\\quad \\operatorname{Im} T := \\{T(\\mathbf{v}) \\mid \\mathbf{v}\\in V\\} ",
      "aliases_latex": [
        "T\\in\\operatorname{Hom}(V,W),\\quad N(T)=\\ker T,\\quad R(T)=\\operatorname{Im} T"
      ],
      "keywords": [
        "線形写像",
        "核",
        "像",
        "カーネル",
        "イメージ"
      ],
      "domain_tags": [
        "mathematics",
        "linear_algebra"
      ]
    },
    {
      "id": "math.linalg.vs08_ker_im_subspace_injectivity",
      "short_code": "VS08",
      "kind": "theorem_formula",
      "title": "核・像の部分空間性と単射性の核判定定理",
      "summary": "線形写像 T の核 ker T は定義域 V の部分空間、像 Im T は終域 W の部分空間であり、T が単射であるための必要十分条件は ker T = {0_V} となることである。",
      "canonical_latex": "\\ker T \\le V,\\quad \\operatorname{Im} T \\le W,\\quad T\\text{ is injective} \\iff \\ker T = \\{\\mathbf{0}_V\\} ",
      "aliases_latex": [
        "T\\text{ injective} \\iff \\dim(\\ker T) = 0"
      ],
      "keywords": [
        "単射",
        "核空間",
        "像空間",
        "部分空間"
      ],
      "domain_tags": [
        "mathematics",
        "linear_algebra"
      ]
    },
    {
      "id": "math.linalg.vs09_matrix_representation_similarity",
      "short_code": "VS09",
      "kind": "theorem_formula",
      "title": "線形写像の表現行列と基底変換則（相似変換）",
      "summary": "基底 B, C に対する線形写像 T の表現行列 A により [T(v)]_C = A[v]_B が成立し、基底変換行列 P, Q のもとで表現行列は A' = Q^{-1}AP（自己準同型では相似変換 P^{-1}AP）へ変換される。",
      "canonical_latex": "T(\\mathbf{e}_j) = \\sum_{i=1}^{m} A_{ij}\\mathbf{f}_i \\implies [T(\\mathbf{v})]_{\\mathcal{C}} = A[\\mathbf{v}]_{\\mathcal{B}},\\quad A' = Q^{-1}AP\\quad (V=W,\\;\\mathcal{B}=\\mathcal{C} \\implies A'=P^{-1}AP) ",
      "aliases_latex": [
        "A_{\\mathcal{C}',\\mathcal{B}'} = Q^{-1} A_{\\mathcal{C},\\mathcal{B}} P"
      ],
      "keywords": [
        "表現行列",
        "相似変換",
        "基底変換",
        "線形写像の行列表現"
      ],
      "domain_tags": [
        "mathematics",
        "linear_algebra"
      ]
    },
    {
      "id": "math.linalg.vs10_rank_nullity_theorem",
      "short_code": "VS10",
      "kind": "theorem_formula",
      "title": "次元定理（ランク・退化次数定理）",
      "summary": "有限次元ベクトル空間 V から W への線形写像 T について、定義域の次元は核の次元（退化次数 nullity）と像の次元（階数 rank）の和に等しい。",
      "canonical_latex": "\\dim V = \\dim(\\ker T) + \\dim(\\operatorname{Im} T) = \\operatorname{nullity}(T) + \\operatorname{rank}(T) ",
      "aliases_latex": [
        "n = \\operatorname{nullity}(T) + \\operatorname{rank}(T)"
      ],
      "keywords": [
        "次元定理",
        "ランク・退化次数定理",
        "階数",
        "退化次数"
      ],
      "domain_tags": [
        "mathematics",
