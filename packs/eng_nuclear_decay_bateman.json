  "nodes": [
    {
      "id": "eng.nuc1.n01_decay_constant_boundary",
      "short_code": "NUC01",
      "kind": "math_boundary",
      "title": "放射性崩壊の無記憶性と崩壊確率定数（放射能の定義）",
      "summary": "個々の原子核の崩壊が過去の履歴や外部環境に依存せず単位時間あたり一定の確率定数λで起こることを表す基礎境界と、放射能A(t)の定義。",
      "canonical_latex": "\\frac{dN(t)}{dt} = -\\lambda N(t),\\quad N(0) = N_0,\\quad A(t) := -\\frac{dN(t)}{dt} = \\lambda N(t)",
      "aliases_latex": [
        "\\dot{N} = -\\lambda N,\\quad A = \\lambda N"
      ],
      "keywords": [
        "崩壊定数",
        "放射能",
