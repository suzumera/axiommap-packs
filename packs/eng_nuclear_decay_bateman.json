    {
      "id": "eng.nuc1.n06_general_bateman_equation",
      "short_code": "NUC06",
      "kind": "theorem_formula",
      "title": "多核種逐次崩壊の一般ベイトマン方程式",
      "summary": "すべての崩壊定数が相異なるn核種逐次崩壊系列において、第n核種の原子核数N_n(t)を指数関数の線形結合として与える一般解。",
      "canonical_latex": "N_n(t) = N_{1,0}\\left(\\prod_{j=1}^{n-1}\\lambda_j\\right)\\sum_{i=1}^{n}\\frac{e^{-\\lambda_i t}}{\\prod_{j=1,\\,j\\neq i}^{n}(\\lambda_j - \\lambda_i)}\\quad (\\lambda_i \\neq \\lambda_j\\text{ for }i\\neq j)",
      "aliases_latex": [
        "N_n(t) = N_{1,0}\\sum_{i=1}^{n} C_i e^{-\\lambda_i t}"
      ],
      "keywords": [
