    {
      "id": "eng.nuc1.n07_radioactive_equilibrium_conditions",
      "short_code": "NUC07",
      "kind": "theorem_formula",
      "title": "放射平衡条件（過渡平衡と永続平衡）",
      "summary": "親核種が娘核種より長寿命（λ_1 < λ_2）のとき十分長い時間後に成立する過渡平衡と、λ_1 ≪ λ_2 の極限で両者の放射能が等しくなる永続平衡。",
      "canonical_latex": "\\frac{A_2(t)}{A_1(t)} \\approx \\frac{\\lambda_2}{\\lambda_2 - \\lambda_1}\\;\\left(\\lambda_1 < \\lambda_2,\\; t \\gg \\frac{1}{\\lambda_2 - \\lambda_1},\\;\\text{transient}\\right);\\qquad A_2(t) \\approx A_1(t)\\;\\left(\\lambda_1 \\ll \\lambda_2,\\;\\text{secular}\\right)",
      "aliases_latex": [
        "\\lambda_1 N_1(t) \\approx \\lambda_2 N_2(t)"
      ],
      "keywords": [
        "放射平衡",
        "過渡平衡",
        "永続平衡"
      ],
      "domain_tags": [
        "nuclear_engineering",
        "physics"
      ]
    },
    {
      "id": "eng.nuc1.n08_no_equilibrium_condition",
      "short_code": "NUC08",
      "kind": "theorem_formula",
      "title": "非平衡条件（娘核種が長寿命の場合）と最大放射能時刻",
      "summary": "娘核種の放射能が最大となる時刻t_{max}、および親核種が娘核種より短寿命（λ_1 > λ_2）の場合に放射平衡が成立せず娘核種自身の崩壊定数で減衰する挙動。",
      "canonical_latex": "t_{\\max} = \\frac{\\ln(\\lambda_2 / \\lambda_1)}{\\lambda_2 - \\lambda_1},\\qquad A_2(t) \\approx A_{1,0}\\frac{\\lambda_2}{\\lambda_1 - \\lambda_2}e^{-\\lambda_2 t} \\gg A_1(t)\\quad \\left(\\lambda_1 > \\lambda_2,\\; t \\gg \\frac{1}{\\lambda_1}\\right)",
      "aliases_latex": [
        "t_{\\text{peak}} = \\frac{\\ln(\\lambda_2/\\lambda_1)}{\\lambda_2 - \\lambda_1}"
      ],
      "keywords": [
        "非平衡",
        "最大放射能時刻",
        "過渡応答"
      ],
