    {
      "id": "eng.nuc1.n04_serial_decay_ode_system",
      "short_code": "NUC04",
      "kind": "definition",
      "title": "逐次崩壊（崩壊系列）の連立常微分方程式系",
      "summary": "親核種から娘核種、孫核種へと連続的に崩壊するn核種系列における、各核種の生成率と崩壊率の収支を表す連立1階線形常微分方程式。",
      "canonical_latex": "\\frac{dN_1}{dt} = -\\lambda_1 N_1,\\quad \\frac{dN_i}{dt} = \\lambda_{i-1} N_{i-1} - \\lambda_i N_i\\;(i=2,\\dots,n),\\quad N_1(0)=N_{1,0},\\; N_i(0)=0\\;(i\\ge 2)",
      "aliases_latex": [
        "\\dot{N}_i = \\lambda_{i-1}N_{i-1} - \\lambda_i N_i"
