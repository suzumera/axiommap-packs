      "short_code": "EL06",
      "kind": "theorem_formula",
      "title": "ヤング率・ポアソン比・体積弾性率とラメ定数の関係",
      "summary": "単軸引張状態および静水圧状態から定義されるヤング率、ポアソン比、体積弾性率とラメ定数との相互変換関係式。",
      "canonical_latex": "E = \\frac{\\mu(3\\lambda + 2\\mu)}{\\lambda + \\mu},\\quad \\nu = \\frac{\\lambda}{2(\\lambda + \\mu)},\\quad K = \\lambda + \\frac{2}{3}\\mu = \\frac{E}{3(1 - 2\\nu)}",
      "aliases_latex": [
        "\\lambda = \\frac{E\\nu}{(1+\\nu)(1-2\\nu)},\\quad \\mu = G = \\frac{E}{2(1+\\nu)}",
        "\\varepsilon_{ij} = \\frac{1+\\nu}{E}\\sigma_{ij} - \\frac{\\nu}{E}(\\operatorname{tr}\\boldsymbol{\\sigma})\\delta_{ij}"
      ],
      "keywords": [
