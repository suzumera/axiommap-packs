        "continuum_mechanics",
        "elasticity"
      ]
    },
    {
      "id": "phys.cont.el02_cauchy_stress_principle",
      "short_code": "EL02",
      "kind": "theorem_formula",
      "title": "コーシーの応力原理とコーシー応力テンソル",
      "summary": "連続体内部の仮想切断面の単位法線ベクトルに対し、表面力（トラクション）ベクトルが線形写像すなわち2階コーシー応力テンソルによって与えられることを示す原理。",
      "canonical_latex": "\\mathbf{t}(\\mathbf{x}, \\mathbf{n}) = \\boldsymbol{\\sigma}(\\mathbf{x})\\mathbf{n},\\qquad t_i(\\mathbf{x}, \\mathbf{n}) = \\sum_{j=1}^{3} \\sigma_{ij}(\\mathbf{x})\\,n_j",
      "aliases_latex": [
        "\\mathbf{t}^{(n)} = \\boldsymbol{\\sigma}\\cdot\\mathbf{n}",
        "t_i = \\sigma_{ij}n_j"
      ],
      "keywords": [
        "コーシーの応力原理",
        "応力テンソル",
        "トラクション",
        "コーシーの四面体"
      ],
      "domain_tags": [
        "physics",
        "continuum_mechanics",
        "elasticity"
      ]
    },
    {
      "id": "phys.cont.el03_cauchy_eom_symmetry",
      "short_code": "EL03",
      "kind": "theorem_formula",
      "title": "コーシーの運動方程式と応力テンソルの対称性",
      "summary": "並進運動量保存則と発散定理から導かれる連続体の局所運動方程式、および角運動量保存則（極性モーメント不在下）から導かれる応力テンソルの対称性。",
      "canonical_latex": "\\rho\\frac{\\partial^2 u_i}{\\partial t^2} = \\sum_{j=1}^{3}\\frac{\\partial \\sigma_{ij}}{\\partial x_j} + f_i,\\qquad \\sigma_{ij} = \\sigma_{ji}",
      "aliases_latex": [
        "\\rho\\ddot{\\mathbf{u}} = \\nabla\\cdot\\boldsymbol{\\sigma} + \\mathbf{f},\\quad \\boldsymbol{\\sigma}^\\top = \\boldsymbol{\\sigma}",
        "\\sigma_{ij,j} + f_i = \\rho\\ddot{u}_i"
      ],
      "keywords": [
        "コーシーの運動方程式",
        "応力テンソルの対称性",
        "運動量保存",
        "角運動量保存"
      ],
      "domain_tags": [
        "physics",
        "continuum_mechanics",
        "elasticity"
      ]
    },
    {
      "id": "phys.cont.el04_generalized_hookes_law",
      "short_code": "EL04",
      "kind": "definition",
      "title": "一般化フックの法則と4階弾性定数テンソル",
      "summary": "微小変形領域においてひずみエネルギー密度を2次形式で展開して得られる応力とひずみの線形構成則、および弾性定数テンソルの対称性。",
      "canonical_latex": "\\sigma_{ij} = \\sum_{k,l=1}^{3} C_{ijkl}\\,\\varepsilon_{kl},\\qquad C_{ijkl} = C_{jikl} = C_{ijlk} = C_{klij}",
      "aliases_latex": [
        "\\boldsymbol{\\sigma} = \\mathbb{C} : \\boldsymbol{\\varepsilon}",
        "W(\\boldsymbol{\\varepsilon}) = \\frac{1}{2}\\sum_{i,j,k,l=1}^{3} C_{ijkl}\\varepsilon_{ij}\\varepsilon_{kl},\\quad \\sigma_{ij} = \\frac{\\partial W}{\\partial \\varepsilon_{ij}}"
      ],
      "keywords": [
        "一般化フックの法則",
        "弾性定数テンソル",
        "ひずみエネルギー密度",
        "構成則"
      ],
      "domain_tags": [
        "physics",
        "continuum_mechanics",
        "elasticity"
      ]
    },
    {
      "id": "phys.cont.el05_isotropic_lame_hooke",
      "short_code": "EL05",
      "kind": "theorem_formula",
      "title": "等方線形弾性体のフックの法則とラメ定数",
      "summary": "SO(3)回転対称性（等方性）を課すことで21個の独立弾性定数が2つのラメ定数（第一ラメ定数と剛性率）に帰着する等方弾性構成則。",
      "canonical_latex": "\\sigma_{ij} = \\lambda(\\operatorname{tr}\\boldsymbol{\\varepsilon})\\delta_{ij} + 2\\mu\\varepsilon_{ij} = \\lambda(\\nabla\\cdot\\mathbf{u})\\delta_{ij} + 2\\mu\\varepsilon_{ij}",
      "aliases_latex": [
        "\\boldsymbol{\\sigma} = \\lambda(\\operatorname{tr}\\boldsymbol{\\varepsilon})I_3 + 2\\mu\\boldsymbol{\\varepsilon}",
        "\\varepsilon_{ij} = \\frac{1}{2\\mu}\\sigma_{ij} - \\frac{\\lambda}{2\\mu(3\\lambda + 2\\mu)}(\\operatorname{tr}\\boldsymbol{\\sigma})\\delta_{ij}"
      ],
      "keywords": [
        "等方弾性体",
        "ラメ定数",
        "剛性率",
        "フックの法則",
        "等方テンソル"
      ],
      "domain_tags": [
        "physics",
        "continuum_mechanics",
        "elasticity"
      ]
    },
    {
