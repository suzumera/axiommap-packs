      "canonical_latex": "\\rho\\frac{\\partial^2 \\mathbf{u}}{\\partial t^2} = (\\lambda + \\mu)\\nabla(\\nabla\\cdot\\mathbf{u}) + \\mu\\nabla^2\\mathbf{u} + \\mathbf{f}",
      "aliases_latex": [
        "\\rho\\ddot{\\mathbf{u}} = (\\lambda + 2\\mu)\\nabla(\\nabla\\cdot\\mathbf{u}) - \\mu\\nabla\\times(\\nabla\\times\\mathbf{u}) + \\mathbf{f}",
        "\\rho\\frac{\\partial^2 u_i}{\\partial t^2} = (\\lambda + \\mu)\\frac{\\partial (\\nabla\\cdot\\mathbf{u})}{\\partial x_i} + \\mu\\nabla^2 u_i + f_i"
      ],
      "keywords": [
