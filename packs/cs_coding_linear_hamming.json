      "short_code": "CODE05",
      "kind": "theorem_formula",
      "title": "双対符号と線形符号の次元定理（GH^T=Oの線形代数的構造）",
      "summary": "[n,k]線形符号Cに対して直交補空間として定義される双対符号C^perpの次元がn-kとなり、Cのパリティ検査行列HがC^perpの生成行列となることを示す定理。",
      "canonical_latex": "\\mathcal{C}^\\perp := \\{\\mathbf{v} \\in \\mathbb{F}_q^n \\mid \\forall \\mathbf{c} \\in \\mathcal{C},\\; \\mathbf{c}\\cdot\\mathbf{v} = 0\\},\\quad \\dim \\mathcal{C} + \\dim \\mathcal{C}^\\perp = n,\\quad G H^\\top = O",
      "aliases_latex": [
        "\\mathcal{C}^\\perp = \\ker(G),\\quad \\dim \\mathcal{C}^\\perp = n - k"
      ],
      "keywords": [
        "双対符号",
        "次元定理",
        "生成行列",
        "パリティ検査行列"
      ],
      "domain_tags": [
        "coding_theory",
        "linear_algebra"
      ]
    },
    {
      "id": "cs.code.n06_binary_hamming_code",
      "short_code": "CODE06",
      "kind": "theorem_formula",
      "title": "2元ハミング符号の完全性とシンドロームによる1ビット誤り位置特定",
      "summary": "非零のrビット列すべてを列に持つパリティ検査行列Hで定義される2元ハミング符号[2^r-1, 2^r-1-r, 3]_2がハミング限界の等号を満たす完全符号であり、単一誤りのシンドロームが誤り位置を示すこと。",
      "canonical_latex": "n = 2^r - 1,\\; k = n - r,\\; d_{\\min} = 3,\\quad 2^k(1+n) = 2^n,\\quad \\mathbf{s} = (\\mathbf{c} \\oplus \\mathbf{e}_j) H^\\top = \\mathbf{h}_j^\\top",
      "aliases_latex": [
        "\\mathcal{H}_r = [2^r - 1, 2^r - 1 - r, 3]_2"
      ],
      "keywords": [
        "ハミング符号",
        "完全符号",
        "シンドローム復号",
        "1ビット誤り訂正"
      ],
      "domain_tags": [
        "coding_theory",
        "digital_communications"
      ]
    }
