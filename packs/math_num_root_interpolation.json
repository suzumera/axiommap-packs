  "nodes": [
    {
      "id": "math.num.ni01_fixed_point_convergence_def",
      "short_code": "NI01",
      "kind": "definition",
      "title": "反復法の収束次数と漸近誤差定数の定義",
      "summary": "点列 x_k が極限 x* に収束するとき、誤差 e_k = x_k - x* の減少速度を収束次数 p と漸近誤差定数 C で特徴付ける。p=1 (0<C<1) を1次収束、p=2 を2次収束と呼ぶ。",
      "canonical_latex": "e_k := x_k - x^*,\\quad \\lim_{k\\to\\infty}\\frac{\\|e_{k+1}\\|}{\\|e_k\\|^p} = C \\in (0, \\infty)\\quad (p \\ge 1)",
      "aliases_latex": [
        "\\|x_{k+1} - x^*\\| \\le C\\|x_k - x^*\\|^p"
      ],
      "keywords": [
        "収束次数",
        "2次収束",
        "漸近誤差定数",
        "反復法"
      ],
      "domain_tags": [
        "mathematics",
        "numerical_analysis"
      ]
    },
    {
      "id": "math.num.ni02_newton_raphson_method",
      "short_code": "NI02",
      "kind": "theorem_formula",
      "title": "ニュートン＝ラフソン法の反復公式（1変数・多変数）",
      "summary": "非線形方程式 f(x)=0 に対し、現在点 x_k における1次テイラー展開（接線・接超平面近似）の零点を次点 x_{k+1} とする反復解法。多変数ではヤコビ行列の連立1次方程式を解く。",
      "canonical_latex": "x_{k+1} = x_k - \\frac{f(x_k)}{f'(x_k)},\\qquad \\mathbf{x}_{k+1} = \\mathbf{x}_k - J_{\\mathbf{F}}(\\mathbf{x}_k)^{-1}\\mathbf{F}(\\mathbf{x}_k)",
      "aliases_latex": [
        "J_{\\mathbf{F}}(\\mathbf{x}_k)\\Delta\\mathbf{x}_k = -\\mathbf{F}(\\mathbf{x}_k)"
      ],
      "keywords": [
        "ニュートン法",
        "ニュートン＝ラフソン法",
        "求根アルゴリズム",
        "ヤコビ行列"
      ],
      "domain_tags": [
        "mathematics",
        "numerical_analysis"
      ]
    },
    {
      "id": "math.num.ni03_newton_quadratic_convergence",
      "short_code": "NI03",
      "kind": "theorem_formula",
      "title": "ニュートン法の2次収束定理と誤差評価",
      "summary": "単根 x* (f'(x*) != 0) の十分近傍で f が C^2 級のとき、ニュートン法の誤差は2次で減少し、漸近誤差定数は |f''(x*)| / (2|f'(x*)|) で与えられる。",
      "canonical_latex": "f(x^*)=0 \\land f'(x^*)\\neq 0 \\land f\\in C^2 \\implies \\lim_{k\\to\\infty}\\frac{|e_{k+1}|}{|e_k|^2} = \\frac{|f''(x^*)|}{2|f'(x^*)|}",
      "aliases_latex": [
        "e_{k+1} = \\frac{f''(\\xi_k)}{2f'(x_k)}e_k^2"
      ],
      "keywords": [
        "2次収束",
        "ニュートン法",
        "単根",
        "誤差評価"
      ],
      "domain_tags": [
        "mathematics",
        "numerical_analysis"
      ]
    },
    {
      "id": "math.num.ni04_polynomial_interpolation_existence",
      "short_code": "NI04",
      "kind": "theorem_formula",
      "title": "多項式補間の存在と一意性（ファンデルモンド行列式）",
      "summary": "相異なる n+1 個の節点 x_0, ..., x_n と任意の値 y_0, ..., y_n に対し、すべての節点で P(x_i) = y_i を満たす n 次以下の多項式 P(x) はただ1つ存在する。",
      "canonical_latex": "x_i\\neq x_j\\,(i\\neq j) \\implies \\det V = \\prod_{0\\le j < i\\le n}(x_i - x_j)\\neq 0 \\implies \\exists!\\, P\\in\\mathcal{P}_n\\text{ s.t. } P(x_i)=y_i\\;(i=0,\\dots,n)",
      "aliases_latex": [
        "V\\mathbf{a} = \\mathbf{y},\\quad V_{ij} = x_i^j"
      ],
      "keywords": [
        "多項式補間",
        "一意性",
        "ファンデルモンド行列式"
      ],
      "domain_tags": [
        "mathematics",
        "numerical_analysis"
      ]
    },
    {
      "id": "math.num.ni05_lagrange_interpolation_formula",
      "short_code": "NI05",
      "kind": "theorem_formula",
      "title": "ラグランジュ補間多項式とラグランジュ基底多項式",
      "summary": "各節点でのみ 1、他の節点で 0 となる n 次基底多項式 l_j(x) の線形結合により、一意な n 次補間多項式を陽的に構成する公式。",
      "canonical_latex": "P_n(x) = \\sum_{j=0}^{n} y_j\\ell_j(x),\\qquad \\ell_j(x) := \\prod_{\\substack{m=0\\\\m\\neq j}}^{n}\\frac{x - x_m}{x_j - x_m}",
      "aliases_latex": [
        "\\ell_j(x_i) = \\delta_{ij}"
      ],
      "keywords": [
        "ラグランジュ補間",
        "ラグランジュ基底",
        "多項式補間"
      ],
      "domain_tags": [
        "mathematics",
        "numerical_analysis"
      ]
    },
    {
      "id": "math.num.ni06_interpolation_error_theorem",
      "short_code": "NI06",
      "kind": "theorem_formula",
      "title": "多項式補間の誤差定理（剰余項公式）",
      "summary": "f が C^{n+1} 級のとき、n 次補間多項式 P_n(x) の補間誤差は n+1 階導関数と節点多項式 omega_{n+1}(x) の積に比例する。",
      "canonical_latex": "f(x) - P_n(x) = \\frac{f^{(n+1)}(\\xi)}{(n+1)!}\\omega_{n+1}(x),\\qquad \\omega_{n+1}(x) := \\prod_{i=0}^{n}(x - x_i)\\quad (\\xi\\in I)",
      "aliases_latex": [
        "|f(x) - P_n(x)| \\le \\frac{\\|f^{(n+1)}\\|_\\infty}{(n+1)!}|\\omega_{n+1}(x)|"
      ],
      "keywords": [
        "補間誤差",
        "節点多項式",
        "剰余項"
      ],
      "domain_tags": [
        "mathematics",
        "numerical_analysis"
      ]
    },
    {
      "id": "math.num.ni07_chebyshev_polynomials_nodes",
      "short_code": "NI07",
      "kind": "definition",
      "title": "第1種チェビシェフ多項式とチェビシェフ節点の定義",
      "summary": "T_n(cos theta) = cos(n theta) で定義される直交多項式 T_n(x) と、T_{n+1}(x) の零点として [-1, 1] 上に配置されるチェビシェフ節点。",
      "canonical_latex": "T_n(x) := \\cos(n\\arccos x)\\;(|x|\\le 1),\\qquad x_k = \\cos\\!\\left(\\frac{2k+1}{2(n+1)}\\pi\\right)\\quad (k=0,\\dots,n)",
      "aliases_latex": [
        "T_{n+1}(x) = 2xT_n(x) - T_{n-1}(x)"
      ],
      "keywords": [
        "チェビシェフ多項式",
