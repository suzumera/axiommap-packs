        "直交多項式"
      ],
      "domain_tags": [
        "mathematics",
        "numerical_analysis"
      ]
    },
    {
      "id": "math.num.ni08_chebyshev_minimax_optimality",
      "short_code": "NI08",
      "kind": "theorem_formula",
      "title": "チェビシェフ節点による節点多項式の最小最大最適性",
      "summary": "区間 [-1, 1] 上のすべての最高次係数 1 の (n+1) 次多項式の中で、最大ノルムを最小にするのはモニック・チェビシェフ多項式 2^{-n} T_{n+1}(x) であり、等間隔節点のルンゲ現象を抑制する。",
      "canonical_latex": "\\min_{x_0,\\dots,x_n\\in[-1,1]}\\max_{x\\in[-1,1]}\\left|\\prod_{i=0}^{n}(x - x_i)\\right| = \\max_{x\\in[-1,1]}\\left|\\frac{T_{n+1}(x)}{2^n}\\right| = \\frac{1}{2^n}",
      "aliases_latex": [
        "\\|\\tilde{T}_{n+1}\\|_\\infty = 2^{-n}"
      ],
      "keywords": [
        "チェビシェフ補間",
        "最小最大性",
        "ルンゲ現象"
      ],
      "domain_tags": [
        "mathematics",
        "numerical_analysis"
      ]
    },
    {
      "id": "math.num.ni09_cubic_spline_definition",
      "short_code": "NI09",
      "kind": "definition",
      "title": "3次スプライン補間と境界条件の定義",
      "summary": "各小区間 [x_j, x_{j+1}] 上で3次多項式となり、全区間 [x_0, x_n] で C^2 級かつ節点補間条件を満たす区分多項式 S(x) と、一意化のための自然・固定境界条件。",
      "canonical_latex": "S|_{[x_j,x_{j+1}]} = S_j \\in \\mathcal{P}_3,\\quad S\\in C^2([x_0,x_n]),\\quad S(x_j)=y_j,\\quad S''(x_0)=S''(x_n)=0\\text{ (natural)}",
      "aliases_latex": [
        "S'(x_0)=f'(x_0),\\; S'(x_n)=f'(x_n)\\text{ (clamped)}"
      ],
      "keywords": [
        "3次スプライン",
        "区分多項式",
        "自然スプライン"
      ],
      "domain_tags": [
        "mathematics",
        "numerical_analysis"
      ]
    },
    {
      "id": "math.num.ni10_cubic_spline_tridiagonal_system",
      "short_code": "NI10",
      "kind": "theorem_formula",
      "title": "3次スプライン補間のモーメント法と3重対角方程式系",
      "summary": "節点での2階導関数値（モーメント）M_j = S''(x_j) を未知数にとり、S_j''(x) の線形補間を2回積分して1階導関数の連続性を課すことで得られる狭義優対角な3重対角線形系。",
      "canonical_latex": "h_{j-1}M_{j-1} + 2(h_{j-1}+h_j)M_j + h_j M_{j+1} = 6\\left(\\frac{y_{j+1}-y_j}{h_j} - \\frac{y_j-y_{j-1}}{h_{j-1}}\\right)\\quad (h_j := x_{j+1}-x_j)",
      "aliases_latex": [
        "S_j(x) = \\frac{M_j(x_{j+1}-x)^3 + M_{j+1}(x-x_j)^3}{6h_j} + \\left(\\frac{y_j}{h_j}-\\frac{M_j h_j}{6}\\right)(x_{j+1}-x) + \\left(\\frac{y_{j+1}}{h_j}-\\frac{M_{j+1}h_j}{6}\\right)(x-x_j)"
      ],
      "keywords": [
        "3重対角行列",
        "スプライン補間",
        "モーメント法"
      ],
      "domain_tags": [
        "mathematics",
        "numerical_analysis"
      ]
    }
