        "variational principle",
        "free fall"
      ],
      "domain_tags": [
        "physics",
        "relativity",
        "general_relativity"
      ]
    },
    {
      "id": "phys.rel.gr04_curvature_einstein_tensor",
      "short_code": "GR04",
      "kind": "definition",
      "title": "リーマン曲率テンソル・リッチテンソルおよびアインシュタインテンソル",
      "summary": "共変微分の非可換性から定義されるリーマン曲率テンソル、その縮約であるリッチテンソルとスカラー曲率、および縮約ビアンキ恒等式により共変保存則を満たすアインシュタインテンソル。",
      "canonical_latex": "R^\\rho{}_{\\sigma\\mu\\nu} := \\partial_\\mu\\Gamma^\\rho_{\\nu\\sigma} - \\partial_\\nu\\Gamma^\\rho_{\\mu\\sigma} + \\Gamma^\\rho_{\\mu\\lambda}\\Gamma^\\lambda_{\\nu\\sigma} - \\Gamma^\\rho_{\\nu\\lambda}\\Gamma^\\lambda_{\\mu\\sigma},\\quad R_{\\mu\\nu} := R^\\rho{}_{\\mu\\rho\\nu},\\quad G_{\\mu\\nu} := R_{\\mu\\nu} - \\frac{1}{2}g_{\\mu\\nu}R",
      "aliases_latex": [
