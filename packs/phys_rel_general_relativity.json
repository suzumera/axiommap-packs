      "canonical_latex": "G_{\\mu\\nu} + \\Lambda g_{\\mu\\nu} = \\frac{8\\pi G}{c^4} T_{\\mu\\nu},\\qquad R_{\\mu\\nu} - \\frac{1}{2}g_{\\mu\\nu}R = \\frac{8\\pi G}{c^4} T_{\\mu\\nu}\\;(\\Lambda=0))",
      "aliases_latex": [
