      ],
      "domain_tags": [
        "physics",
        "relativity",
        "general_relativity"
      ],
      "intuition_oneliner": "質量が極限まで集中した時空の周りで、重力が強すぎて空間が引き裂かれ、光ですら脱出できなくなる境界（事象の地平面）を表す方程式です。",
      "diagram_svg": "<svg viewBox=\"0 0 600 260\" xmlns=\"http://www.w3.org/2000/svg\"><text x=\"50\" y=\"40\" fill=\"currentColor\" font-size=\"16\">シュヴァルツシルト計量とブラックホール</text><circle cx=\"300\" cy=\"140\" r=\"40\" fill=\"#000\" stroke=\"#f97316\" stroke-width=\"2\"/><text x=\"265\" y=\"145\" fill=\"#f97316\" font-size=\"14\">r = r_s</text><circle cx=\"300\" cy=\"140\" r=\"90\" fill=\"none\" stroke=\"#3b82f6\" stroke-dasharray=\"4\"/><text x=\"330\" y=\"75\" fill=\"#3b82f6\" font-size=\"14\">事象の地平面</text><path d=\"M 100 140 Q 200 120 260 138\" fill=\"none\" stroke=\"currentColor\"/><polygon points=\"255,133 265,138 255,143\" fill=\"currentColor\"/><text x=\"120\" y=\"120\" fill=\"currentColor\" font-size=\"14\">時空の歪み ds^2</text></svg>"
    },
