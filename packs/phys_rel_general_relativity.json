  "nodes": [
    {
      "id": "phys.rel.gr01_equivalence_principle",
      "short_code": "GR01",
      "kind": "axiom",
      "title": "等価原理（アインシュタインの等価原理）",
      "summary": "局所的な一様重力場と一様加速度系は物理的に区別できず、時空の任意の点の近傍で自由落下する局所慣性系が存在して特殊相対性理論の法則が成り立つという一般相対性理論の基本原理。",
      "canonical_latex": "m_i = m_g \\implies \\text{Local inertial frames exist in free fall where } g_{\\mu\\nu}(P)=\\eta_{\\mu\\nu},\\; \\partial_\\lambda g_{\\mu\\nu}(P)=0",
      "aliases_latex": [
        "g_{\\mu\\nu}(P) = \\eta_{\\mu\\nu},\\quad \\Gamma^\\lambda_{\\mu\\nu}(P) = 0"
      ],
      "keywords": [
        "equivalence principle",
        "local inertial frame",
        "free fall",
        "general relativity"
      ],
      "domain_tags": [
        "physics",
        "relativity",
        "general_relativity"
      ],
      "intuition_oneliner": "エレベーターの自由落下のように、重力と加速による力は局所的に完全に区別がつかないという原理です。",
      "diagram_svg": "<svg viewBox='0 0 600 260' xmlns='http://www.w3.org/2000/svg'><rect x='150' y='60' width='120' height='140' fill='none' stroke='currentColor' stroke-width='2'/><text x='210' y='40' fill='currentColor' font-size='14' text-anchor='middle'>自由落下 (無重力)</text><circle cx='210' cy='130' r='10' fill='#3b82f6'/><rect x='330' y='60' width='120' height='140' fill='none' stroke='currentColor' stroke-width='2'/><text x='390' y='40' fill='currentColor' font-size='14' text-anchor='middle'>一様加速度</text><circle cx='390' cy='130' r='10' fill='#f97316'/><path d='M370 170 L410 170' stroke='#10b981' stroke-width='2'/></svg>"
    },
    {
      "id": "phys.rel.gr02_curved_metric_christoffel",
      "short_code": "GR02",
      "kind": "definition",
      "title": "曲がった時空の計量テンソルとクリストッフェル記号",
      "summary": "一般座標系における時空間隔を定める計量テンソルと、局所慣性系からの座標変換および計量両立条件から定まるレビ＝チビタ接続（クリストッフェル記号）の定義。",
      "canonical_latex": "ds^2 = g_{\\mu\\nu}(x)\\,dx^\\mu dx^\\nu,\\qquad \\Gamma^\\lambda_{\\mu\\nu} := \\frac{1}{2}g^{\\lambda\\sigma}(\\partial_\\mu g_{\\nu\\sigma} + \\partial_\\nu g_{\\mu\\sigma} - \\partial_\\sigma g_{\\mu\\nu})",
      "aliases_latex": [
        "\\Gamma^\\lambda_{\\mu\\nu} = \\frac{1}{2}g^{\\lambda\\sigma}(g_{\\nu\\sigma,\\mu} + g_{\\mu\\sigma,\\nu} - g_{\\mu\\nu,\\sigma})"
      ],
      "keywords": [
        "metric tensor",
        "Christoffel symbols",
        "Levi-Civita connection",
        "curved spacetime"
      ],
      "domain_tags": [
        "physics",
        "relativity",
        "general_relativity"
      ]
    },
    {
      "id": "phys.rel.gr03_geodesic_equation",
      "short_code": "GR03",
      "kind": "theorem_formula",
      "title": "測地線方程式（固有時の停留原理と自由落下軌道）",
      "summary": "曲がった時空における固有時の変分原理（極値原理）から導かれる、重力のみを受けて自由運動する質点（および光線）の運動方程式。",
      "canonical_latex": "\\delta\\int \\sqrt{g_{\\mu\\nu}\\dot{x}^\\mu\\dot{x}^\\nu}\\,d\\lambda = 0 \\implies \\frac{d^2 x^\\lambda}{d\\tau^2} + \\Gamma^\\lambda_{\\mu\\nu}\\frac{dx^\\mu}{d\\tau}\\frac{dx^\\nu}{d\\tau} = 0",
      "aliases_latex": [
        "\\ddot{x}^\\lambda + \\Gamma^\\lambda_{\\mu\\nu}\\dot{x}^\\mu\\dot{x}^\\nu = 0",
        "u^\\mu\\nabla_\\mu u^\\lambda = 0"
