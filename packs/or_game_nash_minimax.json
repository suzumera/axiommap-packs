{
  "pack_meta": {
    "pack_id": "or.game.nash_minimax",
    "schema_version": "1.0.0",
    "pack_version": "0.1.0",
    "domain": "game_theory",
    "title": "ゲーム理論：混合戦略ナッシュ均衡・ミニマックス定理と進化安定戦略（ESS）",
    "language": "ja",
    "description": "期待利得の無差別条件から混合戦略ナッシュ均衡、線形計画法の双対定理からのフォン・ノイマンのミニマックス定理、レプリケーター方程式を導出する。"
  },
  "nodes": [
    {
      "id": "or.game.n01_normal_form_mixed_strategy",
      "short_code": "GM01",
      "kind": "definition",
      "title": "2人標準形ゲームと混合戦略・期待利得の定義",
      "summary": "有限個の純粋戦略を持つ2人標準形ゲームにおいて、混合戦略を確率単体上の確率分布として定義し、双線形な期待利得を定式化する。",
      "canonical_latex": "\\Delta_m := \\left\\{\\mathbf{x}\\in\\mathbb{R}^m \\;\\middle|\\; x_i \\ge 0,\\; \\sum_{i=1}^{m} x_i = 1\\right\\},\\quad u_1(\\mathbf{x},\\mathbf{y}) = \\mathbf{x}^\\top A \\mathbf{y},\\quad u_2(\\mathbf{x},\\mathbf{y}) = \\mathbf{x}^\\top B \\mathbf{y}",
      "aliases_latex": [
        "u_1(\\mathbf{x},\\mathbf{y}) = \\sum_{i=1}^{m}\\sum_{j=1}^{n} x_i A_{ij} y_j",
        "\\Delta_m = \\{\\mathbf{x}\\ge\\mathbf{0} : \\mathbf{1}_m^\\top \\mathbf{x} = 1\\}"
      ],
      "keywords": [
        "標準形ゲーム",
        "混合戦略",
        "確率単体",
        "期待利得",
        "利得行列"
      ],
