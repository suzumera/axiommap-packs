    {
      "id": "cs.sgt.n02_laplacian_quadratic_form",
      "short_code": "SGT02",
      "kind": "theorem_formula",
      "title": "グラフラプラシアンの2次形式と半正定値性・連結成分数の定理",
      "summary": "グラフラプラシアンの2次形式が辺上の差の2乗和に等しく非負（半正定値）であること、および固有値 0 の重複度がグラフの連結成分数に一致することを示す定理。",
      "canonical_latex": "\\mathbf{x}^\\top L \\mathbf{x} = \\frac{1}{2}\\sum_{i=1}^{N}\\sum_{j=1}^{N} A_{ij}(x_i - x_j)^2 \\ge 0,\\quad 0 = \\lambda_1 \\le \\lambda_2 \\le \\dots \\le \\lambda_N,\\quad \\dim\\ker(L) = \\#\\text{connected components}",
      "aliases_latex": [
