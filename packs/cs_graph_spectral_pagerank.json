      ]
    },
    {
      "id": "cs.sgt.n05_cheeger_inequality",
      "short_code": "SGT05",
      "kind": "theorem_formula",
      "title": "グラフのコンダクタンスとチーガー不等式（Cheeger's Inequality）",
      "summary": "グラフのボトルネックの指標であるコンダクタンス（チーガー定数）h(G) が、正規化ラプラシアンの第2最小固有値 ν_2 によって上下から評価されることを示す基本不等式。",
      "canonical_latex": "h(G) := \\min_{\\emptyset \\subsetneq S \\subsetneq V} \\frac{|\\partial S|}{\\min(\\mathrm{vol}(S), \\mathrm{vol}(V\\setminus S))},\\qquad \\frac{h(G)^2}{2} \\le \\nu_2(L_{\\mathrm{sym}}) \\le 2 h(G)",
      "aliases_latex": [
        "\\frac{\\nu_2}{2} \\le h(G) \\le \\sqrt{2\\nu_2}"
      ],
