    {
      "id": "cs.sgt.n08_personalized_pagerank_laplacian",
      "short_code": "SGT08",
      "kind": "theorem_formula",
      "title": "PageRank定常分布の線形方程式表現とテレポート付きランダムウォーク",
      "summary": "ダンピングファクタ d を伴う PageRank 定常分布が、線形方程式系 (I - dM)r = ((1-d)/N)1 の唯一解であり、ランダムウォークの再起動（ノイマン級数展開）と等価であることを示す定理。",
      "canonical_latex": "\\mathbf{r} = d M \\mathbf{r} + \\frac{1-d}{N}\\mathbf{1} \\iff (I - d M)\\mathbf{r} = \\frac{1-d}{N}\\mathbf{1} \\iff \\mathbf{r} = \\frac{1-d}{N}\\sum_{t=0}^{\\infty} (d M)^t \\mathbf{1}",
      "aliases_latex": [
