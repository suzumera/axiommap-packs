        "linear_algebra"
      ]
    },
    {
      "id": "cs.sgt.n03_normalized_laplacian",
      "short_code": "SGT03",
      "kind": "definition",
      "title": "対称正規化グラフラプラシアンとランダムウォーク正規化ラプラシアンの定義",
      "summary": "頂点次数の不均一性を補正するため次数行列 D で正規化した対称正規化ラプラシアン L_sym とランダムウォーク正規化ラプラシアン L_rw を定義し、両者が相似で固有値を [0, 2] に持つことを示す。",
      "canonical_latex": "L_{\\mathrm{sym}} := D^{-1/2} L D^{-1/2} = I - D^{-1/2} A D^{-1/2},\\quad L_{\\mathrm{rw}} := D^{-1} L = I - D^{-1} A,\\quad 0 = \\nu_1 \\le \\nu_2 \\le \\dots \\le \\nu_N \\le 2",
