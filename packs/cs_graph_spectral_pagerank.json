    {
      "id": "cs.sgt.n04_fiedler_value_connectivity",
      "short_code": "SGT04",
      "kind": "theorem_formula",
      "title": "代数的連結度（フィードラー値）のレイリー商変分表現",
      "summary": "グラフラプラシアンの第2最小固有値（代数的連結度・フィードラー値）が、全1ベクトルに直交する空間上でのレイリー商の最小値として変分的に特徴付けられることを示す定理。",
      "canonical_latex": "\\lambda_2(L) = \\min_{\\mathbf{x} \\neq \\mathbf{0},\\; \\mathbf{x} \\perp \\mathbf{1}} \\frac{\\mathbf{x}^\\top L \\mathbf{x}}{\\mathbf{x}^\\top \\mathbf{x}} = \\min_{\\mathbf{x} \\neq \\mathbf{0},\\; \\sum_i x_i = 0} \\frac{\\sum_{\\{i,j\\}\\in E} A_{ij}(x_i - x_j)^2}{\\sum_{i=1}^{N} x_i^2}",
      "aliases_latex": [
