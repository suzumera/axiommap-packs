  "nodes": [
    {
      "id": "math.geom.dg01_first_fundamental_form",
      "short_code": "DG01",
      "kind": "definition",
      "title": "曲面の第1基本形式とリーマン計量テンソル",
      "summary": "3次元ユークリッド空間内の滑らかな曲面上の接ベクトルの内積から誘導される第1基本形式と計量テンソル、および曲線に沿う弧長要素の定義。",
      "canonical_latex": "ds^2 = \\mathrm{I} = \\sum_{i,j=1}^{2} g_{ij}\\,du^i\\,du^j,\\quad g_{ij} := \\frac{\\partial\\mathbf{r}}{\\partial u^i}\\cdot\\frac{\\partial\\mathbf{r}}{\\partial u^j},\\quad L(\\gamma) = \\int_{t_1}^{t_2}\\sqrt{\\sum_{i,j=1}^{2}g_{ij}\\dot{u}^i\\dot{u}^j}\\,dt",
      "aliases_latex": [
        "\\mathrm{I} = E\\,du^2 + 2F\\,du\\,dv + G\\,dv^2",
        "ds^2 = g_{ij}\\,du^i\\,du^j"
      ],
      "keywords": [
        "第1基本形式",
        "計量テンソル",
        "リーマン計量",
        "弧長要素"
      ],
      "domain_tags": [
        "mathematics",
        "differential_geometry"
      ]
    },
    {
      "id": "math.geom.dg02_second_fundamental_form",
      "short_code": "DG02",
      "kind": "definition",
      "title": "単位法線ベクトルと第2基本形式",
      "summary": "向き付けられた曲面の単位法線ベクトル、および曲面の法線方向への曲がり具合を表す第2基本形式の定義。",
      "canonical_latex": "\\mathbf{n} := \\frac{\\mathbf{r}_1 \\times \\mathbf{r}_2}{\\|\\mathbf{r}_1 \\times \\mathbf{r}_2\\|},\\quad \\mathrm{II} = \\sum_{i,j=1}^{2} b_{ij}\\,du^i\\,du^j,\\quad b_{ij} := \\frac{\\partial^2\\mathbf{r}}{\\partial u^i\\partial u^j}\\cdot\\mathbf{n} = -\\frac{\\partial\\mathbf{r}}{\\partial u^i}\\cdot\\frac{\\partial\\mathbf{n}}{\\partial u^j} \\quad \\left(\\mathbf{r}_i := \\frac{\\partial\\mathbf{r}}{\\partial u^i}\\right)",
      "aliases_latex": [
        "\\mathrm{II} = L\\,du^2 + 2M\\,du\\,dv + N\\,dv^2",
        "b_{ij} = \\partial_i\\partial_j\\mathbf{r}\\cdot\\mathbf{n}"
      ],
      "keywords": [
        "第2基本形式",
        "単位法線ベクトル",
        "法曲率"
      ],
      "domain_tags": [
        "mathematics",
        "differential_geometry"
      ]
    },
    {
      "id": "math.geom.dg03_weingarten_gaussian_curvature",
      "short_code": "DG03",
      "kind": "theorem_formula",
      "title": "ワインガルテン方程式とガウス曲率・平均曲率",
      "summary": "単位法線ベクトルの偏微分を接基底で表すワインガルテン方程式（形作用素）と、その行列式・トレースとして与えられるガウス曲率および平均曲率の公式。",
      "canonical_latex": "\\frac{\\partial\\mathbf{n}}{\\partial u^i} = -\\sum_{j=1}^{2} S^j{}_{i}\\mathbf{r}_j,\\quad S^j{}_{i} = \\sum_{k=1}^{2} g^{jk}b_{ki},\\quad K = \\det(S) = \\frac{\\det(b_{ij})}{\\det(g_{ij})},\\quad H = \\frac{1}{2}\\operatorname{tr}(S) = \\frac{1}{2}\\sum_{i,j=1}^{2} g^{ij}b_{ij}",
      "aliases_latex": [
        "K = \\kappa_1\\kappa_2 = \\frac{LN-M^2}{EG-F^2}"
      ],
      "keywords": [
        "ワインガルテン方程式",
        "形作用素",
        "ガウス曲率",
        "平均曲率",
        "主曲率"
      ],
      "domain_tags": [
        "mathematics",
        "differential_geometry"
      ]
    },
    {
      "id": "math.geom.dg04_christoffel_symbols_metric",
      "short_code": "DG04",
      "kind": "theorem_formula",
      "title": "ガウス公式とクリストッフェル記号の計量表示",
      "summary": "接基底ベクトルの偏微分の接線成分（第2種クリストッフェル記号）が、捩率零条件と計量テンソルの偏微分のみによって一意に表される公式。",
      "canonical_latex": "\\frac{\\partial\\mathbf{r}_i}{\\partial u^j} = \\sum_{k=1}^{n}\\Gamma^k_{ij}\\mathbf{r}_k + b_{ij}\\mathbf{n},\\quad \\Gamma^k_{ij} = \\Gamma^k_{ji} = \\frac{1}{2}\\sum_{l=1}^{n} g^{kl}\\left(\\frac{\\partial g_{jl}}{\\partial u^i} + \\frac{\\partial g_{il}}{\\partial u^j} - \\frac{\\partial g_{ij}}{\\partial u^l}\\right)",
      "aliases_latex": [
        "\\Gamma^k_{ij} = \\frac{1}{2}g^{kl}(\\partial_i g_{jl} + \\partial_j g_{il} - \\partial_l g_{ij})"
      ],
      "keywords": [
        "クリストッフェル記号",
        "ガウス公式",
        "レヴィ＝チヴィタ接続",
        "捩率零"
      ],
      "domain_tags": [
        "mathematics",
        "differential_geometry"
      ]
    },
    {
      "id": "math.geom.dg05_covariant_derivative_parallel_transport",
      "short_code": "DG05",
      "kind": "definition",
      "title": "共変微分と曲線に沿う平行移動の定義",
      "summary": "クリストッフェル記号を用いて座標変換に対してテンソル性を保つ共変微分、および曲線に沿うベクトルの平行移動の定義。",
      "canonical_latex": "\\nabla_i V^k := \\frac{\\partial V^k}{\\partial u^i} + \\sum_{j=1}^{n}\\Gamma^k_{ij} V^j,\\quad \\nabla_i \\omega_j := \\frac{\\partial \\omega_j}{\\partial u^i} - \\sum_{k=1}^{n}\\Gamma^k_{ij}\\omega_k,\\quad \\frac{DV^k}{dt} := \\dot{V}^k + \\sum_{i,j=1}^{n}\\Gamma^k_{ij}\\dot{u}^i V^j = 0",
      "aliases_latex": [
        "\\nabla_X Y",
        "\\frac{DV}{dt} = 0"
      ],
      "keywords": [
        "共変微分",
        "平行移動",
        "接続"
      ],
      "domain_tags": [
        "mathematics",
        "differential_geometry"
      ]
    },
    {
      "id": "math.geom.dg06_metric_compatibility",
      "short_code": "DG06",
      "kind": "theorem_formula",
      "title": "計量両立条件（リッチの補題）",
      "summary": "計量テンソルから定まるクリストッフェル記号に基づく共変微分に対して、計量テンソルが共変定数（共変微分が恒等的に零）となり平行移動で内積が保存される定理。",
      "canonical_latex": "\\nabla_k g_{ij} = \\frac{\\partial g_{ij}}{\\partial u^k} - \\sum_{l=1}^{n}\\Gamma^l_{ki}g_{lj} - \\sum_{l=1}^{n}\\Gamma^l_{kj}g_{il} = 0,\\quad \\frac{d}{dt}\\left(\\sum_{i,j=1}^{n}g_{ij}U^i V^j\\right) = 0",
      "aliases_latex": [
        "\\nabla g = 0"
      ],
      "keywords": [
        "計量両立条件",
        "リッチの補題",
        "内積保存"
      ],
      "domain_tags": [
        "mathematics",
        "differential_geometry"
      ]
    },
    {
      "id": "math.geom.dg07_geodesic_equation_variational",
      "short_code": "DG07",
      "kind": "theorem_formula",
      "title": "変分原理による測地線方程式",
      "summary": "曲線エネルギー汎関数の停留条件（オイラー＝ラグランジュ方程式）から導かれる、アフィンパラメータに関する測地線方程式。",
      "canonical_latex": "\\delta \\int_{t_1}^{t_2} \\frac{1}{2}\\sum_{i,j=1}^{n} g_{ij}(u)\\dot{u}^i\\dot{u}^j\\,dt = 0 \\implies \\ddot{u}^k + \\sum_{i,j=1}^{n}\\Gamma^k_{ij}\\dot{u}^i\\dot{u}^j = 0",
      "aliases_latex": [
        "\\frac{d^2 u^k}{ds^2} + \\Gamma^k_{ij}\\frac{du^i}{ds}\\frac{du^j}{ds} = 0"
      ],
      "keywords": [
        "測地線方程式",
