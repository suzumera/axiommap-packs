    {
      "id": "math.geom.dg08_riemann_curvature_tensor",
      "short_code": "DG08",
      "kind": "theorem_formula",
      "title": "リーマン曲率テンソルの交換関係と成分公式",
      "summary": "共変微分の非可換性（交換子）として現れるリーマン曲率テンソルの定義およびクリストッフェル記号による明示公式。",
      "canonical_latex": "\\big([\\nabla_i, \\nabla_j]V\\big)^l = \\sum_{k=1}^{n} R^l{}_{kij} V^k,\\quad R^l{}_{kij} = \\frac{\\partial \\Gamma^l_{jk}}{\\partial u^i} - \\frac{\\partial \\Gamma^l_{ik}}{\\partial u^j} + \\sum_{m=1}^{n}\\left(\\Gamma^l_{im}\\Gamma^m_{jk} - \\Gamma^l_{jm}\\Gamma^m_{ik}\\right)",
      "aliases_latex": [
        "R(X,Y)Z = \\nabla_X\\nabla_Y Z - \\nabla_Y\\nabla_X Z - \\nabla_{[X,Y]}Z"
      ],
      "keywords": [
