    {
      "id": "math.geom.dg10_ricci_bianchi_identities",
      "short_code": "DG10",
      "kind": "theorem_formula",
      "title": "リッチテンソル・スカラー曲率と縮約ビアンキ恒等式",
      "summary": "リーマン曲率テンソルの縮約によるリッチテンソルとスカラー曲率の定義、第2ビアンキ恒等式、およびアインシュタインテンソルの発散零条件。",
      "canonical_latex": "R_{kj} := \\sum_{i=1}^{n} R^i{}_{kij},\\quad R := \\sum_{j,k=1}^{n} g^{jk}R_{jk},\\quad \\nabla_m R^l{}_{kij} + \\nabla_i R^l{}_{kjm} + \\nabla_j R^l{}_{kmi} = 0 \\implies \\sum_{i=1}^{n}\\nabla_i\\left(R^{ij} - \\frac{1}{2}g^{ij}R\\right) = 0",
      "aliases_latex": [
