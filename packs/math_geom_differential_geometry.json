    {
      "id": "math.geom.dg09_gauss_theorema_egregium",
      "short_code": "DG09",
      "kind": "theorem_formula",
      "title": "ガウス方程式と驚異定理（Theorema Egregium）",
      "summary": "曲面上のガウス＝ワインガルテン方程式の積分可能条件から導かれるガウス方程式、およびガウス曲率が第1基本形式のみ（内在的リーマン曲率）で決まる驚異定理。",
      "canonical_latex": "R_{ijkl} = b_{ik}b_{jl} - b_{il}b_{jk},\\quad K = \\frac{b_{11}b_{22} - b_{12}^2}{\\det(g_{ij})} = \\frac{R_{1212}}{\\det(g_{ij})}",
      "aliases_latex": [
