    "language": "ja",
    "description": "対数尤度とスコア関数からフィッシャー情報量、コーシー＝シュワルツの不等式を用いたクラメール＝ラオ下界、ネイマン＝ピアソンの補題を導出する。"
  },
  "nodes": [
    {
      "id": "ml.stat.n01_cauchy_schwarz_expectation",
      "short_code": "STAT01",
      "kind": "math_boundary",
      "title": "期待値内積と共分散に対するコーシー＝シュワルツの不等式",
      "summary": "2乗可積分な確率変数の積の期待値および共分散の絶対値の上界を与える基本不等式。内積空間におけるシュワルツの不等式の確率論的表現。",
      "canonical_latex": "\\big(\\mathbb{E}[XY]\\big)^2 \\le \\mathbb{E}[X^2]\\,\\mathbb{E}[Y^2],\\qquad \\big(\\operatorname{Cov}(X,Y)\\big)^2 \\le \\operatorname{Var}(X)\\operatorname{Var}(Y)",
      "aliases_latex": [
        "|\\operatorname{Cov}(X,Y)| \\le \\sqrt{\\operatorname{Var}(X)\\operatorname{Var}(Y)}"
      ],
      "keywords": [
        "コーシー＝シュワルツの不等式",
        "期待値",
        "共分散",
        "分散",
        "相関係数"
      ],
      "domain_tags": [
        "data_science",
        "statistics",
        "probability"
      ]
    },
    {
      "id": "ml.stat.n02_log_likelihood_score_def",
      "short_code": "STAT02",
      "kind": "definition",
      "title": "対数尤度関数とスコア関数の定義",
      "summary": "パラメトリック確率モデルの同時確率密度（または質量）関数の対数をとった対数尤度関数と、それをパラメータで偏微分したスコア関数の定義。",
      "canonical_latex": "\\ell(\\theta; \\mathbf{x}) := \\ln p(\\mathbf{x} \\mid \\theta),\\qquad S(\\theta; \\mathbf{x}) := \\frac{\\partial}{\\partial\\theta}\\ell(\\theta; \\mathbf{x}) = \\frac{1}{p(\\mathbf{x} \\mid \\theta)}\\frac{\\partial p(\\mathbf{x} \\mid \\theta)}{\\partial\\theta}",
      "aliases_latex": [
        "s(\\theta; \\mathbf{x}) = \\nabla_\\theta \\ln p(\\mathbf{x} \\mid \\theta)"
      ],
      "keywords": [
        "対数尤度",
        "スコア関数",
        "最尤推定",
        "パラメトリックモデル"
      ],
      "domain_tags": [
        "data_science",
        "statistics"
      ]
    },
    {
      "id": "ml.stat.n03_score_expectation_zero",
      "short_code": "STAT03",
      "kind": "theorem_formula",
      "title": "スコア関数の期待値ゼロ性",
      "summary": "正則条件（確率密度の台がパラメータに依存せず、微分と積分の順序交換が可能であること）のもとで、真のパラメータにおけるスコア関数の期待値が常に0になるという基本定理。",
      "canonical_latex": "\\mathbb{E}_\\theta\\big[S(\\theta; \\mathbf{X})\\big] = \\int S(\\theta; \\mathbf{x}) p(\\mathbf{x} \\mid \\theta)\\,d\\mathbf{x} = 0",
      "aliases_latex": [
        "\\mathbb{E}_\\theta\\left[\\frac{\\partial}{\\partial\\theta}\\ln p(\\mathbf{X}\\mid\\theta)\\right] = 0"
      ],
      "keywords": [
        "スコア関数",
        "期待値ゼロ",
        "正則条件",
        "微分と積分の順序交換"
      ],
      "domain_tags": [
        "data_science",
        "statistics"
      ]
    },
    {
      "id": "ml.stat.n04_fisher_information_def",
      "short_code": "STAT04",
      "kind": "definition",
      "title": "フィッシャー情報量の定義",
      "summary": "観測データが未知パラメータについて持つ情報量を、スコア関数の2乗期待値（期待値ゼロ性によりスコア関数の分散と一致）として定量化する定義。",
      "canonical_latex": "I(\\theta) := \\mathbb{E}_\\theta\\Big[\\big(S(\\theta; \\mathbf{X})\\big)^2\\Big] = \\operatorname{Var}_\\theta\\big(S(\\theta; \\mathbf{X})\\big)",
      "aliases_latex": [
        "I(\\theta) = \\mathbb{E}_\\theta\\left[\\left(\\frac{\\partial \\ln p(\\mathbf{X}\\mid\\theta)}{\\partial\\theta}\\right)^2\\right]"
      ],
      "keywords": [
        "フィッシャー情報量",
        "スコア関数",
        "分散",
        "情報量"
      ],
      "domain_tags": [
        "data_science",
        "statistics"
      ]
    },
    {
      "id": "ml.stat.n05_fisher_info_hessian_identity",
      "short_code": "STAT05",
      "kind": "theorem_formula",
      "title": "フィッシャー情報量の2階微分表現（バートレット恒等式）",
      "summary": "2階微分に関する正則条件のもとで、フィッシャー情報量が対数尤度の2階導関数の期待値に負号をつけたもの（期待ヘッセ行列の符号反転）に等しいことを示す恒等式。",
      "canonical_latex": "I(\\theta) = -\\mathbb{E}_\\theta\\left[\\frac{\\partial^2 \\ln p(\\mathbf{X} \\mid \\theta)}{\\partial\\theta^2}\\right]",
      "aliases_latex": [
        "I(\\theta) = -\\mathbb{E}_\\theta\\big[\\ell''(\\theta; \\mathbf{X})\\big]"
      ],
      "keywords": [
        "フィッシャー情報量",
        "バートレット恒等式",
        "2階微分",
        "ヘッセ行列"
      ],
      "domain_tags": [
        "data_science",
        "statistics"
      ]
    },
    {
      "id": "ml.stat.n07_hypothesis_test_lrt_def",
      "short_code": "STAT07",
      "kind": "definition",
      "title": "単純仮説検定と尤度比の定義",
      "summary": "2つの単純仮説の対立における検定関数、有意水準（第1種の過誤確率）、検出力（1マイナス第2種の過誤確率）、および尤度比の定義。",
      "canonical_latex": "\\alpha := \\mathbb{E}_{\\theta_0}[\\phi(\\mathbf{X})],\\quad 1-\\beta := \\mathbb{E}_{\\theta_1}[\\phi(\\mathbf{X})],\\quad \\Lambda(\\mathbf{x}) := \\frac{p(\\mathbf{x} \\mid \\theta_1)}{p(\\mathbf{x} \\mid \\theta_0)}\\quad (0 \\le \\phi(\\mathbf{x}) \\le 1)",
      "aliases_latex": [
        "H_0: \\theta=\\theta_0\\text{ vs }H_1: \\theta=\\theta_1,\\quad \\Lambda(\\mathbf{x}) = \\frac{L(\\theta_1;\\mathbf{x})}{L(\\theta_0;\\mathbf{x})}"
      ],
      "keywords": [
        "仮説検定",
        "有意水準",
        "検出力",
        "尤度比",
        "第1種の過誤"
      ],
      "domain_tags": [
        "data_science",
        "statistics"
      ]
    }
