  },
  "nodes": [
    {
      "id": "eng.robo.n01_se3_homogeneous_transform",
      "short_code": "ROBO01",
      "kind": "definition",
      "title": "3次元特殊ユークリッド群 SE(3) と同次変換行列の定義",
      "summary": "3次元回転行列 R ∈ SO(3) と並進ベクトル p ∈ R^3 を 4x4 ブロック行列に統合し、剛体変位を線形変換として表す同次変換行列と SE(3) を定義する。",
      "canonical_latex": "T = \\begin{pmatrix} R & \\mathbf{p} \\\\ \\mathbf{0}^\\top & 1 \\end{pmatrix} \\in \\mathrm{SE}(3),\\quad R \\in \\mathrm{SO}(3),\\; \\mathbf{p} \\in \\mathbb{R}^3,\\quad \\tilde{\\mathbf{r}}' = T\\tilde{\\mathbf{r}} = \\begin{pmatrix} R\\mathbf{r} + \\mathbf{p} \\\\ 1 \\end{pmatrix}",
      "aliases_latex": [
        "T = \\begin{bmatrix} R & p \\\\ 0 & 1 \\end{bmatrix} \\in \\mathrm{SE}(3)"
      ],
      "keywords": [
        "SE(3)",
        "同次変換行列",
        "剛体変換",
        "同次座標",
        "ロボット運動学"
      ],
      "domain_tags": [
        "robotics",
        "kinematics"
      ]
    },
    {
      "id": "eng.robo.n02_se3_composition_inverse",
      "short_code": "ROBO02",
      "kind": "theorem_formula",
      "title": "同次変換行列の合成則と逆変換公式",
      "summary": "連続する座標変換に対応する同次変換行列の積（合成）および R ∈ SO(3) の直交性を利用した逆変換行列の閉形式公式。",
      "canonical_latex": "T_1 T_2 = \\begin{pmatrix} R_1 R_2 & R_1\\mathbf{p}_2 + \\mathbf{p}_1 \\\\ \\mathbf{0}^\\top & 1 \\end{pmatrix},\\qquad T^{-1} = \\begin{pmatrix} R^\\top & -R^\\top \\mathbf{p} \\\\ \\mathbf{0}^\\top & 1 \\end{pmatrix}",
      "aliases_latex": [
        "{}^A T_C = {}^A T_B {}^B T_C,\\quad ({}^A T_B)^{-1} = {}^B T_A"
      ],
      "keywords": [
        "同次変換の合成",
        "逆同次変換",
        "座標系変換",
        "SE(3)"
      ],
      "domain_tags": [
        "robotics",
        "kinematics"
      ]
    },
    {
      "id": "eng.robo.n03_dh_parameters_link_transform",
      "short_code": "ROBO03",
      "kind": "definition",
      "title": "デナビット＝ハルテンベルグ（DH）パラメータと隣接リンク変換行列",
      "summary": "4つのDHパラメータ（θi, di, ai, αi）により隣接するリンク座標系 {i-1} から {i} への同次変換行列を一意にパラメータ化する標準記法。",
      "canonical_latex": "{}^{i-1}T_i(\\theta_i, d_i, a_i, \\alpha_i) = \\mathrm{Rot}_z(\\theta_i)\\,\\mathrm{Trans}_z(d_i)\\,\\mathrm{Trans}_x(a_i)\\,\\mathrm{Rot}_x(\\alpha_i) = \\begin{pmatrix} \\cos\\theta_i & -\\sin\\theta_i\\cos\\alpha_i & \\sin\\theta_i\\sin\\alpha_i & a_i\\cos\\theta_i \\\\ \\sin\\theta_i & \\cos\\theta_i\\cos\\alpha_i & -\\cos\\theta_i\\sin\\alpha_i & a_i\\sin\\theta_i \\\\ 0 & \\sin\\alpha_i & \\cos\\alpha_i & d_i \\\\ 0 & 0 & 0 & 1 \\end{pmatrix}",
      "aliases_latex": [
        "A_i(q_i) = \\mathrm{Rot}_z(\\theta_i)\\mathrm{Trans}_z(d_i)\\mathrm{Trans}_x(a_i)\\mathrm{Rot}_x(\\alpha_i)"
      ],
      "keywords": [
        "DHパラメータ",
        "デナビット＝ハルテンベルグ記法",
        "リンク変換行列",
        "リンク座標系"
      ],
      "domain_tags": [
        "robotics",
        "kinematics"
      ]
    },
    {
      "id": "eng.robo.n04_forward_kinematics_chain",
      "short_code": "ROBO04",
      "kind": "theorem_formula",
      "title": "DH法によるシリアルマニピュレータの順運動学",
      "summary": "関節変数ベクトル q からベース座標系に対するエンドエフェクタの位置・姿勢を隣接リンク変換行列の順次積として求める順運動学方程式。",
      "canonical_latex": "{}^0 T_n(\\mathbf{q}) = \\prod_{i=1}^{n} {}^{i-1}T_i(q_i) = \\begin{pmatrix} {}^0 R_n(\\mathbf{q}) & {}^0 \\mathbf{p}_n(\\mathbf{q}) \\\\ \\mathbf{0}^\\top & 1 \\end{pmatrix}",
      "aliases_latex": [
        "T_{0,n}(q) = A_1(q_1)A_2(q_2)\\cdots A_n(q_n)"
      ],
      "keywords": [
        "順運動学",
        "シリアルマニピュレータ",
        "運動学連鎖",
        "手先位置姿勢"
      ],
      "domain_tags": [
        "robotics",
        "kinematics"
      ]
    },
    {
      "id": "eng.robo.n05_geometric_jacobian_def",
      "short_code": "ROBO05",
      "kind": "definition",
      "title": "マニピュレータの速度ヤコビ行列（幾何ヤコビアン）の定義",
      "summary": "関節速度ベクトル q̇ とエンドエフェクタの並進速度・角速度（ツイスト）を線形関係で結びつける 6×n ヤコビ行列 J(q) の定義。",
      "canonical_latex": "\\mathbf{v}_e = \\begin{pmatrix} \\dot{\\mathbf{p}}_e \\\\ \\boldsymbol{\\omega}_e \\end{pmatrix} = J(\\mathbf{q})\\dot{\\mathbf{q}} = \\begin{pmatrix} J_v(\\mathbf{q}) \\\\ J_\\omega(\\mathbf{q}) \\end{pmatrix}\\dot{\\mathbf{q}},\\qquad J_v(\\mathbf{q}) = \\frac{\\partial \\mathbf{p}_e(\\mathbf{q})}{\\partial \\mathbf{q}} \\in \\mathbb{R}^{3\\times n}",
      "aliases_latex": [
        "\\boldsymbol{\\xi} = J(q)\\dot{q}"
      ],
      "keywords": [
        "ヤコビ行列",
        "幾何ヤコビアン",
        "微分運動学",
        "ツイスト"
      ],
      "domain_tags": [
        "robotics",
        "kinematics"
      ]
    },
    {
      "id": "eng.robo.n06_geometric_jacobian_formula",
      "short_code": "ROBO06",
      "kind": "theorem_formula",
      "title": "回転・直動関節に対する幾何ヤコビ行列の列ベクトル公式",
      "summary": "各関節の軸方向ベクトル z_{i-1} と関節原点位置 p_{i-1}、手先位置 p_e を用いて幾何ヤコビ行列の第 i 列を陽に構成する公式。",
      "canonical_latex": "J_i(\\mathbf{q}) = \\begin{cases} \\begin{pmatrix} \\mathbf{z}_{i-1} \\times (\\mathbf{p}_e - \\mathbf{p}_{i-1}) \\\\ \\mathbf{z}_{i-1} \\end{pmatrix} & (\\text{revolute joint}) \\\\ \\begin{pmatrix} \\mathbf{z}_{i-1} \\\\ \\mathbf{0} \\end{pmatrix} & (\\text{prismatic joint}) \\end{cases}",
      "aliases_latex": [
        "J_{v,i} = z_{i-1} \\times (p_e - p_{i-1}),\\; J_{\\omega,i} = z_{i-1}"
      ],
      "keywords": [
        "幾何ヤコビアン公式",
        "回転関節",
        "直動関節",
        "特異姿勢"
      ],
      "domain_tags": [
        "robotics",
        "kinematics"
      ]
    },
    {
      "id": "eng.robo.n07_statics_kinematics_duality",
      "short_code": "ROBO07",
      "kind": "theorem_formula",
      "title": "静力学と運動学の双対性（関節トルクと手先力の関係）",
      "summary": "仮想仕事の原理に基づき、手先に作用する静的レンチ（力・モーメント）F_e と釣合う関節トルク τ がヤコビ行列の転置によって τ = J^T F_e で与えられる双対関係。",
      "canonical_latex": "\\delta W = \\boldsymbol{\\tau}^\\top \\delta\\mathbf{q} - \\mathbf{F}_e^\\top \\delta\\mathbf{x}_e = 0,\\quad \\delta\\mathbf{x}_e = J(\\mathbf{q})\\delta\\mathbf{q} \\implies \\boldsymbol{\\tau} = J(\\mathbf{q})^\\top \\mathbf{F}_e",
      "aliases_latex": [
        "\\tau = J^T F"
      ],
      "keywords": [
        "静力学と運動学の双対性",
        "仮想仕事の原理",
        "関節トルク",
        "ヤコビアン転置"
      ],
      "domain_tags": [
        "robotics",
        "statics"
      ]
    },
    {
      "id": "eng.robo.n08_numerical_ik_newton_dls",
      "short_code": "ROBO08",
      "kind": "theorem_formula",
      "title": "ヤコビ行列の擬似逆行列・減衰最小二乗法（DLS）による数値逆運動学",
      "summary": "非線形順運動学方程式をヤコビ行列で1次線形化し、特異点近傍でも安定に反復解を求める減衰最小二乗法（Levenberg-Marquardt型）数値逆運動学アルゴリズム。",
      "canonical_latex": "\\Delta\\mathbf{q} = J^+ \\Delta\\mathbf{x}\\;\\big(J^+ = J^\\top(J J^\\top)^{-1}\\big),\\qquad \\Delta\\mathbf{q}_{\\mathrm{DLS}} = J^\\top (J J^\\top + \\lambda^2 I)^{-1}\\Delta\\mathbf{x}\\quad (\\lambda > 0)",
      "aliases_latex": [
        "q_{k+1} = q_k + J^\\top(JJ^\\top + \\lambda^2 I)^{-1}(x_d - f(q_k))"
      ],
      "keywords": [
        "逆運動学",
        "数値解法",
        "擬似逆行列",
        "減衰最小二乗法",
        "特異点回避"
      ],
      "domain_tags": [
        "robotics",
        "kinematics",
        "numerical_methods"
      ]
    }
  ],
