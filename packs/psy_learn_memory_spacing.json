      "canonical_latex": "\\frac{dR}{dt} = -\\frac{1}{S} R(t),\\quad R(0) = 1,\\qquad L_{\\mathrm{total}} = L_{\\mathrm{int}} + L_{\\mathrm{ext}} + L_{\\mathrm{ger}} \\le C_{\\mathrm{WM}}",
      "aliases_latex": [
        "\\dot{R}(t) = -\\lambda R(t),\\; R(0)=1,\\; L_{\\mathrm{total}} \\le C_{\\mathrm{WM}}"
      ],
