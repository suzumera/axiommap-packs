      "aliases_latex": [
        "S_{n+1} = \\gamma S_n"
      ],
      "keywords": [
        "記憶安定性",
        "間隔反復",
        "強化係数",
        "時定数"
      ],
      "domain_tags": [
        "psychology",
        "cognitive_science"
      ]
    },
    {
      "id": "psy.mem.n04_spacing_effect_optimal_interval",
      "short_code": "MEM04",
      "kind": "theorem_formula",
      "title": "間隔効果（Spaced Repetition）と最適復習間隔定理",
      "summary": "目標保持率 R_target を下回らない範囲で復習間隔を最大化（復習回数を最小化）する最適な復習間隔が、現在の記憶安定性 S_n に比例することを導く。",
      "canonical_latex": "\\Delta t_n^* = -S_n \\ln R_{\\mathrm{target}} = S_n \\ln\\!\\left(\\frac{1}{R_{\\mathrm{target}}}\\right)\\quad (0 < R_{\\mathrm{target}} < 1)",
      "aliases_latex": [
        "\\Delta t_n^* = -S_n \\ln R_{\\mathrm{target}}"
      ],
      "keywords": [
        "間隔効果",
