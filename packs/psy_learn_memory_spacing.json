    },
    {
      "id": "psy.mem.n02_ebbinghaus_forgetting_curve",
      "short_code": "MEM02",
      "kind": "theorem_formula",
      "title": "エビングハウスの忘却曲線（指数減衰モデル）",
      "summary": "一定の記憶安定性 S の下で、経過時間 t に伴う記憶保持率 R(t) が指数関数的に減衰することを示す基本法則。",
      "canonical_latex": "R(t) = \\exp\\!\\left(-\\frac{t}{S}\\right)",
