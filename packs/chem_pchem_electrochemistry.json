      "canonical_latex": "Q_{\\mathrm{elec}} = n F \\xi = I t,\\quad \\delta w_{\\mathrm{non\\text{-}exp,max}} = -E\\,dQ_{\\mathrm{elec}},\\quad \\Delta G_a^\\ddagger(\\eta) = \\Delta G_{a,0}^\\ddagger - (1-\\alpha)nF\\eta,\\quad \\Delta G_c^\\ddagger(\\eta) = \\Delta G_{c,0}^\\ddagger + \\alpha nF\\eta",
      "aliases_latex": [
        "F = N_A e,\\quad Q_{\\mathrm{elec}} = n_{\\mathrm{e}} F"
      ],
      "keywords": [
