    {
      "id": "cv.cg.n01_radiance_solid_angle",
      "short_code": "CG01",
      "kind": "definition",
      "title": "立体角と放射輝度（Radiance）の定義",
      "summary": "単位面積・投影面積・単位立体角あたりの放射束として放射輝度Lを定義し、幾何光学における光線に沿った不変量を記述する。",
      "canonical_latex": "d\\omega = \\sin\\theta\\,d\\theta\\,d\\varphi,\\qquad L(\\mathbf{x},\\boldsymbol{\\omega}) := \\frac{d^2\\Phi}{dA_{\\perp}\\,d\\omega} = \\frac{d^2\\Phi}{dA\\cos\\theta\\,d\\omega}",
      "aliases_latex": [
        "L = \\frac{d^2\\Phi}{\\cos\\theta\\,dA\\,d\\omega}"
      ],
      "keywords": [
        "立体角",
        "放射輝度",
        "放射束",
        "投影面積",
        "幾何光学"
      ],
      "domain_tags": [
        "graphics",
        "radiometry"
      ]
    },
    {
      "id": "cv.cg.n02_lambert_cosine_irradiance",
      "short_code": "CG02",
      "kind": "theorem_formula",
      "title": "ランバートの余弦則と放射照度（Irradiance）の積分表示",
      "summary": "面要素に入射する放射輝度を投影面積の余弦因子とともに上半球全体で積分し、放射照度Eおよび等方放射輝度時のpi倍関係を導く。",
      "canonical_latex": "E(\\mathbf{x}) = \\int_{\\Omega} L_i(\\mathbf{x},\\boldsymbol{\\omega}_i)\\cos\\theta_i\\,d\\omega_i,\\qquad L_i \\equiv L_0 \\implies E(\\mathbf{x}) = \\pi L_0",
      "aliases_latex": [
        "E(\\mathbf{x}) = \\int_{\\Omega} L_i(\\mathbf{x},\\boldsymbol{\\omega}_i)(\\boldsymbol{\\omega}_i\\cdot\\mathbf{n})\\,d\\omega_i"
      ],
      "keywords": [
        "ランバートの余弦則",
        "放射照度",
        "半球積分",
        "等方放射"
      ],
      "domain_tags": [
        "graphics",
        "radiometry"
      ]
    },
    {
      "id": "cv.cg.n03_brdf_energy_conservation",
      "short_code": "CG03",
      "kind": "definition",
      "title": "双方向反射率分布関数（BRDF）とヘルムホルツ相反性・エネルギー保存則",
      "summary": "入射放射照度の微小寄与に対する出射放射輝度の比としてBRDFを定義し、物理的妥当性条件（非負性・相反性・エネルギー保存）を定式化する。",
      "canonical_latex": "f_r(\\mathbf{x},\\boldsymbol{\\omega}_i,\\boldsymbol{\\omega}_o) := \\frac{dL_r(\\mathbf{x},\\boldsymbol{\\omega}_o)}{L_i(\\mathbf{x},\\boldsymbol{\\omega}_i)\\cos\\theta_i\\,d\\omega_i} \\ge 0,\\quad f_r(\\boldsymbol{\\omega}_i,\\boldsymbol{\\omega}_o)=f_r(\\boldsymbol{\\omega}_o,\\boldsymbol{\\omega}_i),\\quad \\int_{\\Omega} f_r(\\mathbf{x},\\boldsymbol{\\omega}_i,\\boldsymbol{\\omega}_o)\\cos\\theta_i\\,d\\omega_i \\le 1",
      "aliases_latex": [
        "f_r = \\frac{dL_o}{dE_i}"
      ],
      "keywords": [
        "BRDF",
        "ヘルムホルツ相反性",
        "エネルギー保存則",
        "反射モデル"
      ],
      "domain_tags": [
        "graphics",
        "radiometry"
      ]
    },
    {
      "id": "cv.cg.n04_kajiya_rendering_equation",
      "short_code": "CG04",
      "kind": "theorem_formula",
      "title": "カジアのレンダリング方程式（放射輸送の積分方程式）",
      "summary": "表面の自己放射輝度とBRDFによる半球反射積分を統合し、大域照明を支配する第2種フレドホルム型積分方程式を導出する。",
      "canonical_latex": "L_o(\\mathbf{x},\\boldsymbol{\\omega}_o) = L_e(\\mathbf{x},\\boldsymbol{\\omega}_o) + \\int_{\\Omega} f_r(\\mathbf{x},\\boldsymbol{\\omega}_i,\\boldsymbol{\\omega}_o)L_i(\\mathbf{x},\\boldsymbol{\\omega}_i)(\\boldsymbol{\\omega}_i\\cdot\\mathbf{n})\\,d\\omega_i",
      "aliases_latex": [
        "L_o = L_e + \\mathcal{T}L_o"
      ],
      "keywords": [
        "レンダリング方程式",
        "大域照明",
        "放射輸送",
        "フレドホルム積分方程式"
      ],
      "domain_tags": [
        "graphics",
        "rendering"
      ]
    },
    {
      "id": "cv.cg.n05_monte_carlo_unbiased_estimator",
      "short_code": "CG05",
      "kind": "theorem_formula",
      "title": "モンテカルロ積分の不偏推定量と重点サンプリング",
      "summary": "確率密度関数p(x)から独立同分布に抽出した標本による平均推定量が、真の積分値に対して不偏推定量となることを証明する。",
      "canonical_latex": "\\hat{I}_N := \\frac{1}{N}\\sum_{k=1}^{N}\\frac{g(X_k)}{p(X_k)}\\quad (X_k \\stackrel{\\mathrm{i.i.d.}}{\\sim} p) \\implies \\mathbb{E}[\\hat{I}_N] = \\int_{\\Omega} g(x)\\,dx = I",
      "aliases_latex": [
        "\\mathbb{E}\\left[\\frac{g(X)}{p(X)}\\right] = \\int_{\\Omega} g(x)\\,dx"
      ],
      "keywords": [
        "モンテカルロ積分",
        "不偏推定量",
        "重点サンプリング",
        "パストレーシング"
      ],
      "domain_tags": [
        "graphics",
        "probability",
        "numerical_methods"
      ]
    },
    {
      "id": "cv.cg.n06_spectral_radiance_cie_xyz",
      "short_code": "CG06",
      "kind": "definition",
      "title": "分光放射輝度と等色関数積分によるCIE XYZ三刺激値の定義",
      "summary": "波長ごとの分光放射輝度にCIE 1931標準観測者の等色関数を乗じて可視波長域で積分し、人間の色覚に対応するXYZ三刺激値を定義する。",
      "canonical_latex": "X = k\\int_{\\lambda_{\\min}}^{\\lambda_{\\max}} L_\\lambda(\\lambda)\\bar{x}(\\lambda)\\,d\\lambda,\\quad Y = k\\int_{\\lambda_{\\min}}^{\\lambda_{\\max}} L_\\lambda(\\lambda)\\bar{y}(\\lambda)\\,d\\lambda,\\quad Z = k\\int_{\\lambda_{\\min}}^{\\lambda_{\\max}} L_\\lambda(\\lambda)\\bar{z}(\\lambda)\\,d\\lambda",
      "aliases_latex": [
        "\\mathbf{T}_{XYZ} = k\\int L_\\lambda(\\lambda)\\bar{\\mathbf{t}}(\\lambda)\\,d\\lambda"
      ],
      "keywords": [
        "CIE XYZ",
        "三刺激値",
        "等色関数",
        "分光放射輝度"
      ],
      "domain_tags": [
        "graphics",
        "colorimetry"
      ]
    },
    {
      "id": "cv.cg.n07_cie_xy_chromaticity_coordinates",
      "short_code": "CG07",
      "kind": "theorem_formula",
      "title": "CIE xy色度座標の導出と輝度分離（xyY表現）",
      "summary": "XYZ三刺激値をその総和で正規化して輝度に依存しない色度座標(x,y)を導出し、逆に(x,y,Y)から(X,Y,Z)を一意に復元する公式を示す。",
      "canonical_latex": "x = \\frac{X}{X+Y+Z},\\quad y = \\frac{Y}{X+Y+Z},\\quad z = 1 - x - y,\\qquad X = \\frac{x}{y}Y,\\quad Z = \\frac{1-x-y}{y}Y",
      "aliases_latex": [
        "(X,Y,Z) = \\left(\\frac{x}{y}Y,\\; Y,\\; \\frac{1-x-y}{y}Y\\right)"
      ],
      "keywords": [
        "色度座標",
        "xyY表色系",
        "射影正規化",
        "色空間"
      ],
      "domain_tags": [
        "graphics",
        "colorimetry"
      ]
    }
