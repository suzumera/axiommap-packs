  "nodes": [
    {
      "id": "math.ode.sys01_linear_ode_system_def",
      "short_code": "SYS01",
      "kind": "definition",
      "title": "1階連立線形常微分方程式系と基本解行列の定義",
      "summary": "n次元ベクトル値関数に関する1階連立線形常微分方程式の標準形、および同次系の線形独立なn個の解を列に並べた基本解行列を定義する。",
      "canonical_latex": "\\dot{\\mathbf{x}}(t) = A(t)\\mathbf{x}(t) + \\mathbf{f}(t),\\quad \\mathbf{x}(t) \\in \\mathbb{R}^n,\\quad \\Phi(t) := \\big(\\mathbf{x}_1(t),\\dots,\\mathbf{x}_n(t)\\big),\\quad \\dot{\\Phi}(t) = A(t)\\Phi(t)\\;(\\det\\Phi(t)\\neq 0).",
      "aliases_latex": [
        "\\frac{d\\mathbf{x}}{dt} = A(t)\\mathbf{x} + \\mathbf{f}(t),\\quad \\Phi'(t) = A(t)\\Phi(t)"
      ],
      "keywords": [
        "linear ODE system",
        "fundamental matrix",
        "homogeneous system",
        "nonhomogeneous system"
      ],
      "domain_tags": [
        "mathematics",
        "ode",
        "linear_algebra"
      ]
    },
    {
      "id": "math.ode.sys02_wronskian_liouville",
      "short_code": "SYS02",
      "kind": "theorem_formula",
      "title": "ロンスキアンとアベル＝リウヴィルの公式",
      "summary": "解行列の行列式として定義されるロンスキアンが、係数行列のトレースを係数とする1階線形微分方程式に従い、任意の時刻で非零性または恒等零性を保つことを示す。",
      "canonical_latex": "W(t) := \\det\\Phi(t),\\quad \\frac{dW}{dt} = \\operatorname{tr}\\big(A(t)\\big)\\,W(t) \\implies W(t) = W(t_0)\\exp\\!\\left(\\int_{t_0}^{t}\\operatorname{tr}\\big(A(s)\\big)\\,ds\\right).",
      "aliases_latex": [
        "W(t) = W(t_0)\\exp\\!\\left(\\int_{t_0}^{t}\\operatorname{tr}(A(s))\\,ds\\right)"
      ],
      "keywords": [
        "Wronskian",
        "Abel-Liouville formula",
        "trace",
        "determinant"
      ],
      "domain_tags": [
        "mathematics",
        "ode",
        "linear_algebra"
      ]
    },
    {
      "id": "math.ode.sys03_matrix_exponential_def",
      "short_code": "SYS03",
      "kind": "definition",
      "title": "行列指数関数 exp(At) の定義と基本性質",
      "summary": "正方行列Aに対するべき級数として行列指数関数を定義し、その微分公式、可換性、指数法則および逆行列公式を与える。",
      "canonical_latex": "e^{At} := \\sum_{k=0}^{\\infty}\\frac{(At)^k}{k!} = I_n + At + \\frac{A^2 t^2}{2!} + \\cdots,\\quad \\frac{d}{dt}e^{At} = A e^{At} = e^{At} A,\\quad e^{A(t+s)} = e^{At}e^{As},\\quad (e^{At})^{-1} = e^{-At}.",
      "aliases_latex": [
        "\\exp(At) = \\sum_{k=0}^{\\infty}\\frac{t^k}{k!}A^k"
      ],
      "keywords": [
        "matrix exponential",
        "power series",
        "exponential law"
      ],
      "domain_tags": [
        "mathematics",
        "ode",
        "linear_algebra"
      ]
    },
    {
      "id": "math.ode.sys04_homogeneous_ivp_matrix_exp",
      "short_code": "SYS04",
      "kind": "theorem_formula",
      "title": "定数係数同次連立線形系の初期値問題と一意解",
      "summary": "定数係数同次連立線形常微分方程式の初期値問題の解が、行列指数関数 e^{A(t-t_0)} を初期値に作用させることで一意に与えられることを示す。",
      "canonical_latex": "\\dot{\\mathbf{x}}(t) = A\\mathbf{x}(t),\\; \\mathbf{x}(t_0) = \\mathbf{x}_0 \\implies \\mathbf{x}(t) = e^{A(t-t_0)}\\mathbf{x}_0\\;(\\text{unique}).",
      "aliases_latex": [
        "\\mathbf{x}(t) = \\exp(A(t-t_0))\\mathbf{x}_0"
      ],
      "keywords": [
        "initial value problem",
        "constant coefficient system",
        "matrix exponential",
        "uniqueness"
      ],
      "domain_tags": [
        "mathematics",
        "ode",
        "linear_algebra"
      ]
    },
    {
      "id": "math.ode.sys05_variation_of_parameters_system",
      "short_code": "SYS05",
      "kind": "theorem_formula",
      "title": "非同次連立線形系の定数変化法（デュアメルの原理）",
      "summary": "基本解行列と定数変化法を用いて非同次連立線形常微分方程式の一般解（状態遷移表現）を導出し、定数係数系におけるデュアメルの畳み込み公式を得る。",
      "canonical_latex": "\\dot{\\mathbf{x}} = A(t)\\mathbf{x} + \\mathbf{f}(t) \\implies \\mathbf{x}(t) = \\Phi(t)\\Phi(t_0)^{-1}\\mathbf{x}_0 + \\int_{t_0}^{t}\\Phi(t)\\Phi(s)^{-1}\\mathbf{f}(s)\\,ds;\\quad A=\\text{const.} \\implies \\mathbf{x}(t) = e^{A(t-t_0)}\\mathbf{x}_0 + \\int_{t_0}^{t}e^{A(t-s)}\\mathbf{f}(s)\\,ds.",
      "aliases_latex": [
        "\\mathbf{x}(t) = e^{At}\\mathbf{x}_0 + \\int_{0}^{t}e^{A(t-s)}\\mathbf{f}(s)\\,ds"
      ],
      "keywords": [
