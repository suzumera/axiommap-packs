  "nodes": [
    {
      "id": "ml.igeom.n01_statistical_manifold_score",
      "short_code": "IG01",
      "kind": "definition",
      "title": "統計多様体とスコア関数の定義",
      "summary": "パラメータ空間で滑らかに特徴づけられた確率分布族を統計多様体とみなし、対数尤度のパラメータ勾配としてスコア関数を定義する。",
      "canonical_latex": "\\mathcal{S} = \\{p(x;\\boldsymbol{\\theta}) \\mid \\boldsymbol{\\theta} \\in \\Theta \\subset \\mathbb{R}^d\\},\\quad \\mathbf{s}(x;\\boldsymbol{\\theta}) := \\nabla_{\\boldsymbol{\\theta}} \\ln p(x;\\boldsymbol{\\theta}),\\quad \\mathbb{E}_{p(\\cdot;\\boldsymbol{\\theta})}\\big[\\mathbf{s}(X;\\boldsymbol{\\theta})\\big] = \\mathbf{0}",
      "aliases_latex": [
        "\\mathbf{s}(\\boldsymbol{\\theta}) = \\partial_{\\boldsymbol{\\theta}} \\ln p(x;\\boldsymbol{\\theta})"
      ],
      "keywords": [
        "統計多様体",
        "スコア関数",
        "対数尤度勾配",
        "正則条件"
      ],
      "domain_tags": [
        "machine_learning",
        "information_geometry"
      ],
      "intuition_oneliner": "要するに、確率分布のパラメータの動きやすさを測る空間（多様体）と、その確率分布が最も敏感に変化する方向を示す指標（スコア関数）のことです。",
      "diagram_svg": "<svg viewBox='0 0 600 260' xmlns='http://www.w3.org/2000/svg'><path d='M100 180 Q300 100 500 180' fill='none' stroke='currentColor' stroke-width='2'/><circle cx='300' cy='120' r='6' fill='#3b82f6'/><path d='M300 120 L380 90' fill='none' stroke='#f97316' stroke-width='2' marker-end='url(#arrow)'/><text x='310' y='110' fill='currentColor' font-size='14'>Θ (夒数理畀)</text><text x='390' y='90' fill='#f97316' font-size='14'>スコア</text></svg>"
    },
    {
      "id": "ml.igeom.n02_fisher_information_matrix",
      "short_code": "IG02",
      "kind": "definition",
      "title": "フィッシャー情報行列（フィッシャー情報計量）の定義",
      "summary": "スコア関数の共分散行列としてフィッシャー情報行列を定義し、統計多様体上のリーマン計量テンソル（フィッシャー情報計量）を与える。",
      "canonical_latex": "G(\\boldsymbol{\\theta}) := \\mathbb{E}_{p(\\cdot;\\boldsymbol{\\theta})}\\!\\big[\\mathbf{s}(X;\\boldsymbol{\\theta})\\mathbf{s}(X;\\boldsymbol{\\theta})^\\top\\big],\\qquad g_{ij}(\\boldsymbol{\\theta}) = \\mathbb{E}_{p(\\cdot;\\boldsymbol{\\theta})}\\!\\left[\\frac{\\partial \\ln p(X;\\boldsymbol{\\theta})}{\\partial \\theta_i}\\frac{\\partial \\ln p(X;\\boldsymbol{\\theta})}{\\partial \\theta_j}\\right]",
      "aliases_latex": [
        "I(\\boldsymbol{\\theta}) = \\mathbb{E}[\\nabla \\ln p(X;\\boldsymbol{\\theta}) \\nabla \\ln p(X;\\boldsymbol{\\theta})^\\top]"
      ],
      "keywords": [
        "フィッシャー情報行列",
        "フィッシャー情報計量",
        "リーマン計量",
        "スコア共分散"
      ],
      "domain_tags": [
        "machine_learning",
        "information_geometry"
      ],
      "intuition_oneliner": "要するに何？: 確率モデルのパラメータがデータの変化に対してどれだけ敏感か測ることで、確率の空間に「距離」を定義する行列です。",
      "diagram_svg": "<svg viewBox=\"0 0 600 260\" xmlns=\"http://www.w3.org/2000/svg\"><ellipse cx=\"300\" cy=\"130\" rx=\"160\" ry=\"70\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><path d=\"M 200 130 L 400 130\" stroke=\"#3b82f6\" stroke-width=\"2\"/><path d=\"M 300 60 L 300 200\" stroke=\"#f97316\" stroke-width=\"2\"/><text x=\"410\" y=\"135\" fill=\"currentColor\" font-size=\"14\">統計多様体</text><text x=\"310\" y=\"80\" fill=\"#f97316\" font-size=\"14\">Fisher情報行列</text></svg>"
    },
    {
      "id": "ml.igeom.n03_kl_quadratic_fisher_metric",
      "short_code": "IG03",
      "kind": "theorem_formula",
      "title": "KLダイバージェンスの2次展開とフィッシャー情報計量",
      "summary": "微小変位に対するKLダイバージェンスの2次テイラー展開がフィッシャー情報計量による2次形式に一致し、負の対数尤度ヘッシアン期待値と等価であることを示す。",
      "canonical_latex": "D_{\\mathrm{KL}}\\big(p(\\cdot;\\boldsymbol{\\theta}) \\,\\|\\, p(\\cdot;\\boldsymbol{\\theta}+d\\boldsymbol{\\theta})\\big) = \\frac{1}{2} d\\boldsymbol{\\theta}^\\top G(\\boldsymbol{\\theta})\\, d\\boldsymbol{\\theta} + \\mathcal{O}\\big(\\|d\\boldsymbol{\\theta}\\|^3\\big),\\qquad G(\\boldsymbol{\\theta}) = -\\mathbb{E}_{p(\\cdot;\\boldsymbol{\\theta})}\\!\\left[\\nabla_{\\boldsymbol{\\theta}}^2 \\ln p(X;\\boldsymbol{\\theta})\\right]",
      "aliases_latex": [
        "ds^2 = 2 D_{\\mathrm{KL}}(p(\\boldsymbol{\\theta}) \\| p(\\boldsymbol{\\theta}+d\\boldsymbol{\\theta})) = \\sum_{i,j} g_{ij}(\\boldsymbol{\\theta}) d\\theta_i d\\theta_j"
      ],
      "keywords": [
        "KLダイバージェンス",
        "2次展開",
        "フィッシャー情報計量",
        "ヘッシアン期待値"
      ],
      "domain_tags": [
        "machine_learning",
        "information_geometry"
      ]
    },
    {
      "id": "ml.igeom.n04_cramer_rao_bound",
      "short_code": "IG04",
      "kind": "theorem_formula",
      "title": "クラメール＝ラオの不等式（推定精度の限界）",
      "summary": "任意の不偏推定量の共分散行列がフィッシャー情報行列の逆行列を下界とすることを示し、情報幾何学的な計量が統計的推定の究極精度を規定することを示す。",
      "canonical_latex": "\\mathbb{E}[\\hat{\\boldsymbol{\\theta}}(X)] = \\boldsymbol{\\theta} \\implies \\operatorname{Cov}\\big(\\hat{\\boldsymbol{\\theta}}(X)\\big) \\succeq G(\\boldsymbol{\\theta})^{-1}",
      "aliases_latex": [
        "\\operatorname{Var}(\\hat{\\theta}) \\ge \\frac{1}{I(\\theta)}"
      ],
      "keywords": [
        "クラメール＝ラオの不等式",
        "不偏推定量",
        "共分散行列",
        "有効推定量"
      ],
      "domain_tags": [
        "machine_learning",
        "information_geometry"
      ]
    },
    {
      "id": "ml.igeom.n05_exponential_family_duality",
      "short_code": "IG05",
      "kind": "definition",
      "title": "指数型分布族の自然座標（e座標）と期待値座標（m座標）",
      "summary": "指数型分布族における自然パラメータ（e座標）と、キュムラント母関数の勾配で与えられる期待値パラメータ（m座標）を定義する。",
      "canonical_latex": "p(x;\\boldsymbol{\\theta}) = \\exp\\!\\big(\\boldsymbol{\\theta}^\\top \\mathbf{T}(x) - \\psi(\\boldsymbol{\\theta}) + k(x)\\big),\\qquad \\boldsymbol{\\eta}(\\boldsymbol{\\theta}) := \\mathbb{E}_{p(\\cdot;\\boldsymbol{\\theta})}\\big[\\mathbf{T}(X)\\big] = \\nabla_{\\boldsymbol{\\theta}} \\psi(\\boldsymbol{\\theta})",
      "aliases_latex": [
        "p(x;\\boldsymbol{\\theta}) = h(x)\\exp(\\boldsymbol{\\theta}^\\top \\mathbf{T}(x) - A(\\boldsymbol{\\theta}))"
      ],
      "keywords": [
        "指数型分布族",
        "自然パラメータ",
        "期待値パラメータ",
        "キュムラント母関数"
      ],
      "domain_tags": [
        "machine_learning",
        "information_geometry"
      ]
    },
    {
      "id": "ml.igeom.n06_dual_flat_legendre_bregman",
      "short_code": "IG06",
      "kind": "theorem_formula",
      "title": "指数型分布族のルジャンドル双対性とブレグマンダイバージェンス",
      "summary": "キュムラント母関数とそのルジャンドル共役関数のヘッシアンが互いに逆行列の関係にあるフィッシャー計量を与え、KLダイバージェンスがブレグマンダイバージェンスとして表されることを示す。",
      "canonical_latex": "\\varphi(\\boldsymbol{\\eta}) := \\boldsymbol{\\theta}^\\top \\boldsymbol{\\eta} - \\psi(\\boldsymbol{\\theta}),\\quad G(\\boldsymbol{\\theta}) = \\nabla_{\\boldsymbol{\\theta}}^2 \\psi(\\boldsymbol{\\theta}) = \\big(\\nabla_{\\boldsymbol{\\eta}}^2 \\varphi(\\boldsymbol{\\eta})\\big)^{-1},\\quad D_{\\mathrm{KL}}\\big(p(\\cdot;\\boldsymbol{\\theta}_1) \\,\\|\\, p(\\cdot;\\boldsymbol{\\theta}_2)\\big) = \\psi(\\boldsymbol{\\theta}_2) + \\varphi(\\boldsymbol{\\eta}_1) - \\boldsymbol{\\theta}_2^\\top \\boldsymbol{\\eta}_1",
      "aliases_latex": [
        "D_{\\mathrm{KL}}(p_1 \\| p_2) = D_{\\psi}(\\boldsymbol{\\theta}_2 \\| \\boldsymbol{\\theta}_1) = D_{\\varphi}(\\boldsymbol{\\eta}_1 \\| \\boldsymbol{\\eta}_2)"
      ],
      "keywords": [
        "ルジャンドル変換",
        "双対ポテンシャル",
        "ブレグマンダイバージェンス",
        "双対平坦空間"
      ],
      "domain_tags": [
        "machine_learning",
        "information_geometry"
      ]
    },
    {
      "id": "ml.igeom.n07_dual_connections_em_flatness",
      "short_code": "IG07",
      "kind": "theorem_formula",
      "title": "双対アフィン接続（e接続・m接続）と一般化ピタゴラスの定理",
      "summary": "指数型分布族がe座標系で平坦なe接続とm座標系で平坦なm接続という互いに双対なアフィン接続を持ち、e測地線とm測地線の直交性によりKLダイバージェンスのピタゴラスの定理が成立することを示す。",
      "canonical_latex": "\\partial_k g_{ij} = \\Gamma_{ijk}^{(e)} + \\Gamma_{ikj}^{(m)},\\quad \\Gamma_{ijk}^{(e)}(\\boldsymbol{\\theta}) = 0,\\quad \\Gamma_{ijk}^{(m)}(\\boldsymbol{\\eta}) = 0,\\qquad (\\boldsymbol{\\eta}_P - \\boldsymbol{\\eta}_Q)^\\top (\\boldsymbol{\\theta}_Q - \\boldsymbol{\\theta}_R) = 0 \\implies D_{\\mathrm{KL}}(P \\| R) = D_{\\mathrm{KL}}(P \\| Q) + D_{\\mathrm{KL}}(Q \\| R)",
      "aliases_latex": [
        "\\nabla^{(e)},\\; \\nabla^{(m)},\\quad D_{\\mathrm{KL}}(P \\| R) = D_{\\mathrm{KL}}(P \\| Q) + D_{\\mathrm{KL}}(Q \\| R)"
      ],
      "keywords": [
        "双対接続",
        "e接続",
        "m接続",
        "一般化ピタゴラスの定理"
      ],
      "domain_tags": [
        "machine_learning",
        "information_geometry"
      ]
    },
    {
      "id": "ml.igeom.n08_natural_gradient_descent",
      "short_code": "IG08",
      "kind": "theorem_formula",
      "title": "自然勾配法（Natural Gradient Descent）の導出",
      "summary": "パラメータ空間のユークリッド距離ではなく統計多様体上のフィッシャー情報計量（KLダイバージェンス）を制約とした最急降下方向を解くことで、パラメータ再標数化に不変な自然勾配更新則を導出する。",
      "canonical_latex": "\\tilde{\\nabla}_{\\boldsymbol{\\theta}} \\mathcal{L}(\\boldsymbol{\\theta}) := G(\\boldsymbol{\\theta})^{-1} \\nabla_{\\boldsymbol{\\theta}} \\mathcal{L}(\\boldsymbol{\\theta}),\\qquad \\boldsymbol{\\theta}_{t+1} = \\boldsymbol{\\theta}_t - \\eta\\, G(\\boldsymbol{\\theta}_t)^{-1} \\nabla_{\\boldsymbol{\\theta}} \\mathcal{L}(\\boldsymbol{\\theta}_t)",
      "aliases_latex": [
        "\\boldsymbol{\\theta}_{t+1} = \\boldsymbol{\\theta}_t - \\eta\\, \\tilde{\\nabla} \\mathcal{L}(\\boldsymbol{\\theta}_t)"
      ],
      "keywords": [
        "自然勾配法",
        "パラメータ不変性",
        "フィッシャー情報行列",
        "最急降下方向"
      ],
      "domain_tags": [
        "machine_learning",
        "information_geometry"
      ]
    }
