    "title": "状態空間モデル：線形ガウス状態空間からのカルマンフィルタ予測・更新式とカルマンゲイン",
    "language": "ja",
    "description": "多変量正規分布の条件付き分布と最小平均二乗誤差（MMSE）から、カルマンフィルタの予測ステップ、最適カルマンゲインK、誤差共分散更新式を導出する。"
  },
  "nodes": [
    {
      "id": "ml.kf.n01_linear_gaussian_ssm_def",
      "short_code": "KF01",
      "kind": "definition",
      "title": "線形ガウス状態空間モデル（LGSSM）の定義",
      "summary": "線形な状態遷移方程式と観測方程式、および互いに独立なガウス性プロセス雑音・観測雑音から構成される確率的状態空間モデルの定義。",
      "canonical_latex": "\\mathbf{x}_k = F_k \\mathbf{x}_{k-1} + \\mathbf{w}_k\\;(\\mathbf{w}_k \\sim \\mathcal{N}(\\mathbf{0}, Q_k)),\\quad \\mathbf{y}_k = H_k \\mathbf{x}_k + \\mathbf{v}_k\\;(\\mathbf{v}_k \\sim \\mathcal{N}(\\mathbf{0}, R_k)),\\quad \\mathbf{x}_0 \\sim \\mathcal{N}(\\hat{\\mathbf{x}}_{0|0}, P_{0|0})",
      "aliases_latex": [
        "p(\\mathbf{x}_k \\mid \\mathbf{x}_{k-1}) = \\mathcal{N}(\\mathbf{x}_k; F_k\\mathbf{x}_{k-1}, Q_k),\\quad p(\\mathbf{y}_k \\mid \\mathbf{x}_k) = \\mathcal{N}(\\mathbf{y}_k; H_k\\mathbf{x}_k, R_k)"
      ],
      "keywords": [
        "状態空間モデル",
        "線形ガウスモデル",
        "マルコフ性",
        "状態遷移行列",
        "観測行列"
      ],
      "domain_tags": [
        "machine_learning",
        "control_theory",
        "statistics"
      ]
    },
    {
      "id": "ml.kf.n02_mmse_conditional_expectation",
      "short_code": "KF02",
      "kind": "theorem_formula",
      "title": "最小平均二乗誤差（MMSE）推定量と条件付き期待値の一致",
      "summary": "観測値に基づく任意の推定関数のうち、平均二乗誤差（MSE）を最小化する最適推定量（MMSE推定量）が事後条件付き期待値に一致することを示す定理。",
      "canonical_latex": "\\hat{\\mathbf{x}}_{\\mathrm{MMSE}}(\\mathbf{y}) := \\arg\\min_{\\hat{\\mathbf{x}}(\\mathbf{y})} \\mathbb{E}\\big[\\|\\mathbf{x} - \\hat{\\mathbf{x}}(\\mathbf{y})\\|_2^2\\big] = \\mathbb{E}[\\mathbf{x} \\mid \\mathbf{y}]",
      "aliases_latex": [
        "\\min_{\\hat{\\mathbf{x}}} \\operatorname{tr}\\mathbb{E}[(\\mathbf{x}-\\hat{\\mathbf{x}})(\\mathbf{x}-\\hat{\\mathbf{x}})^\\top] \\implies \\hat{\\mathbf{x}}^* = \\mathbb{E}[\\mathbf{x}\\mid\\mathbf{y}]"
      ],
      "keywords": [
        "MMSE",
        "最小平均二乗誤差",
        "条件付き期待値",
        "ベイズ推定",
        "直交原理"
      ],
      "domain_tags": [
        "machine_learning",
        "statistics",
        "signal_processing"
      ]
    },
    {
      "id": "ml.kf.n03_multivariate_gaussian_conditional",
      "short_code": "KF03",
      "kind": "theorem_formula",
      "title": "多変量正規分布の条件付き分布（シュア補元による平均と共分散）",
      "summary": "同時多変量正規分布に従う2つの確率ベクトルについて、一方を観測したときの他方の条件付き分布が再び正規分布となり、その平均と共分散がシュア補元で与えられる公式。",
      "canonical_latex": "\\begin{pmatrix}\\mathbf{x}\\\\\\mathbf{y}\\end{pmatrix} \\sim \\mathcal{N}\\!\\left(\\begin{pmatrix}\\boldsymbol{\\mu}_x\\\\\\boldsymbol{\\mu}_y\\end{pmatrix}, \\begin{pmatrix}\\Sigma_{xx} & \\Sigma_{xy}\\\\\\Sigma_{yx} & \\Sigma_{yy}\\end{pmatrix}\\right) \\implies \\mathbf{x}\\mid\\mathbf{y} \\sim \\mathcal{N}\\!\\left(\\boldsymbol{\\mu}_x + \\Sigma_{xy}\\Sigma_{yy}^{-1}(\\mathbf{y}-\\boldsymbol{\\mu}_y),\\; \\Sigma_{xx} - \\Sigma_{xy}\\Sigma_{yy}^{-1}\\Sigma_{yx}\\right)",
      "aliases_latex": [
        "\\boldsymbol{\\mu}_{x|y} = \\boldsymbol{\\mu}_x + \\Sigma_{xy}\\Sigma_{yy}^{-1}(\\mathbf{y}-\\boldsymbol{\\mu}_y),\\quad \\Sigma_{x|y} = \\Sigma_{xx} - \\Sigma_{xy}\\Sigma_{yy}^{-1}\\Sigma_{yx}"
      ],
      "keywords": [
        "多変量正規分布",
        "条件付き分布",
        "シュア補元",
        "ガウス過程"
      ],
      "domain_tags": [
        "machine_learning",
        "statistics"
      ]
    },
    {
      "id": "ml.kf.n04_kf_prediction_step",
      "short_code": "KF04",
      "kind": "theorem_formula",
      "title": "カルマンフィルタの予測ステップ（事前状態推定と事前誤差共分散）",
      "summary": "時刻k-1までの観測に基づく事後分布から、状態遷移方程式を用いて時刻kの事前状態推定値（予測平均）と事前誤差共分散行列を導出する時間更新式。",
      "canonical_latex": "\\hat{\\mathbf{x}}_{k|k-1} = F_k \\hat{\\mathbf{x}}_{k-1|k-1},\\qquad P_{k|k-1} = F_k P_{k-1|k-1} F_k^\\top + Q_k",
      "aliases_latex": [
        "\\mathbf{x}_k \\mid \\mathbf{y}_{1:k-1} \\sim \\mathcal{N}(F_k\\hat{\\mathbf{x}}_{k-1|k-1},\\; F_k P_{k-1|k-1} F_k^\\top + Q_k)"
      ],
      "keywords": [
        "カルマンフィルタ",
        "予測ステップ",
        "時間更新",
        "事前誤差共分散"
      ],
      "domain_tags": [
        "machine_learning",
        "control_theory"
      ]
    },
    {
      "id": "ml.kf.n05_innovation_joint_gaussian",
      "short_code": "KF05",
      "kind": "theorem_formula",
      "title": "イノベーション（観測残差）と状態・観測の同時条件付き分布",
      "summary": "観測予測誤差（イノベーション）の定義と、時刻k-1までの観測を与えたもとでのイノベーション共分散および状態・観測間の相互共分散を与える公式。",
      "canonical_latex": "\\tilde{\\mathbf{y}}_k := \\mathbf{y}_k - H_k\\hat{\\mathbf{x}}_{k|k-1},\\quad S_k := \\operatorname{Cov}(\\tilde{\\mathbf{y}}_k \\mid \\mathbf{y}_{1:k-1}) = H_k P_{k|k-1} H_k^\\top + R_k,\\quad \\operatorname{Cov}(\\mathbf{x}_k, \\mathbf{y}_k \\mid \\mathbf{y}_{1:k-1}) = P_{k|k-1} H_k^\\top",
      "aliases_latex": [
        "\\tilde{\\mathbf{y}}_k \\mid \\mathbf{y}_{1:k-1} \\sim \\mathcal{N}(\\mathbf{0}, H_k P_{k|k-1} H_k^\\top + R_k)"
      ],
      "keywords": [
        "イノベーション",
        "観測残差",
        "イノベーション共分散",
        "相互共分散"
      ],
      "domain_tags": [
        "machine_learning",
        "control_theory",
        "signal_processing"
      ]
    },
    {
      "id": "ml.kf.n06_optimal_kalman_gain",
      "short_code": "KF06",
      "kind": "theorem_formula",
      "title": "最適カルマンゲインと状態推定の観測更新式",
      "summary": "状態と観測の同時正規分布に対する条件付き期待値（MMSE推定量）から導かれる最適カルマンゲイン行列K_kと、イノベーションを用いた事後状態推定の更新式。",
      "canonical_latex": "K_k = P_{k|k-1} H_k^\\top S_k^{-1} = P_{k|k-1} H_k^\\top (H_k P_{k|k-1} H_k^\\top + R_k)^{-1},\\qquad \\hat{\\mathbf{x}}_{k|k} = \\hat{\\mathbf{x}}_{k|k-1} + K_k(\\mathbf{y}_k - H_k\\hat{\\mathbf{x}}_{k|k-1})",
      "aliases_latex": [
        "\\hat{\\mathbf{x}}_{k|k} = \\hat{\\mathbf{x}}_{k|k-1} + K_k\\tilde{\\mathbf{y}}_k,\\quad K_k S_k = P_{k|k-1} H_k^\\top"
      ],
      "keywords": [
        "カルマンゲイン",
        "観測更新",
        "MMSE",
        "事後推定"
      ],
      "domain_tags": [
        "machine_learning",
        "control_theory",
        "signal_processing"
      ]
    },
    {
      "id": "ml.kf.n07_covariance_update_joseph_form",
      "short_code": "KF07",
      "kind": "theorem_formula",
      "title": "事後誤差共分散の更新式とジョセフ形式（Joseph Form）",
      "summary": "任意のゲインに対する対称性と半正定値性を保つジョセフ形式の誤差共分散更新式、および最適カルマンゲインを代入して得られる簡略化された事後誤差共分散更新式。",
      "canonical_latex": "P_{k|k} = (I - K_k H_k) P_{k|k-1} (I - K_k H_k)^\\top + K_k R_k K_k^\\top = (I - K_k H_k) P_{k|k-1}",
      "aliases_latex": [
        "P_{k|k} = P_{k|k-1} - K_k S_k K_k^\\top = P_{k|k-1} - K_k H_k P_{k|k-1}"
      ],
      "keywords": [
        "事後誤差共分散",
        "ジョセフ形式",
        "半正定値性",
        "数値安定性"
      ],
      "domain_tags": [
        "machine_learning",
        "control_theory"
      ]
    }
  ],
