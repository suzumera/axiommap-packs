    {
      "id": "bio.pop.n02_logistic_ode_def",
      "short_code": "POP02",
      "kind": "definition",
      "title": "ロジスティック微分方程式の定義",
      "summary": "環境収容力 K と内的自然増加率 r を持つ単一種個体群の密度依存成長を記述する非線形1階常微分方程式。",
      "canonical_latex": "\\frac{dN}{dt} = r N\\left(1 - \\frac{N}{K}\\right),\\quad N(0) = N_0 > 0\\quad (r > 0,\\; K > 0)",
