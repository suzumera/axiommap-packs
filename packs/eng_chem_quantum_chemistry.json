    {
      "id": "eng.qchem.n03_variational_principle_qm",
      "short_code": "QC03",
      "kind": "theorem_formula",
      "title": "量子力学の変分原理とレイリー＝リッツ法（永年方程式）",
      "summary": "任意の試行波動関数に対するハミルトニアンの期待値（レイリー商）が厳密な基底状態エネルギーの上界を与えることを示し、基底展開と停留条件から一般化固有値問題（永年方程式）を導く。",
      "canonical_latex": "E[\\tilde{\\psi}] := \\frac{\\langle \\tilde{\\psi} | \\hat{H}_e | \\tilde{\\psi} \\rangle}{\\langle \\tilde{\\psi} | \\tilde{\\psi} \\rangle} \\ge E_0,\\qquad \\sum_{\\nu} (H_{\\mu\\nu} - E S_{\\mu\\nu}) c_\\nu = 0,\\quad \\det(\\mathbf{H} - E\\mathbf{S}) = 0",
      "aliases_latex": [
        "\\mathbf{H}\\mathbf{c} = E\\mathbf{S}\\mathbf{c},\\quad \\delta E[\\tilde{\\psi}] = 0"
      ],
      "keywords": [
        "variational principle",
        "Rayleigh-Ritz method",
        "secular equation",
        "upper bound"
      ],
      "domain_tags": [
        "chemistry",
        "quantum_chemistry"
      ],
      "intuition_oneliner": "適当な試行関数で計算したエネルギーは必ず本当の基底状態エネルギー以上になり、最小値を与えます。",
      "diagram_svg": "<svg viewBox='0 0 600 260' xmlns='http://www.w3.org/2000/svg'><path d='M100 200 Q 300 50 500 200' fill='none' stroke='currentColor' stroke-width='2'/><circle cx='300' cy='120' r='6' fill='#f97316'/><path d='M250 160 L350 160' stroke='#3b82f6' stroke-width='2' stroke-dasharray='4'/><text x='310' y='125' fill='#f97316' font-size='14'>真のエネルギー</text><text x='360' y='155' fill='#3b82f6' font-size='14'>試行エネルギー (上界)</text></svg>"
    },
    {
      "id": "eng.qchem.n04_lcao_mo_ansatz",
      "short_code": "QC04",
      "kind": "definition",
      "title": "LCAO-MO近似と水素分子イオン（H2+）の試行波動関数",
      "summary": "分子軌道を各原子に局在した原子軌道の線形結合（LCAO）で表現する試行関数を定義し、H2+に対する重なり積分・クーロン積分・共鳴積分の行列表記を構成する。",
      "canonical_latex": "\\psi_{\\mathrm{MO}} = c_A \\phi_A + c_B \\phi_B,\\quad S_{AB} := \\langle \\phi_A | \\phi_B \\rangle,\\quad H_{AA} := \\langle \\phi_A | \\hat{H}_e | \\phi_A \\rangle,\\quad H_{AB} := \\langle \\phi_A | \\hat{H}_e | \\phi_B \\rangle",
      "aliases_latex": [
        "\\psi_{\\mathrm{MO}} = \\sum_{\\mu} c_\\mu \\phi_\\mu,\\quad \\alpha = H_{AA},\\quad \\beta = H_{AB}"
      ],
      "keywords": [
