  "nodes": [
    {
      "id": "math.prob.pr01_kolmogorov_axioms",
      "short_code": "PR01",
      "kind": "axiom",
      "title": "コルモゴロフの確率公理系（確率空間の定義）",
      "summary": "標本空間、事象族（完全加法族）、および非負性・正規化・可算加法性の3公理を満たす確率測度からなる確率空間の公理的定義。",
      "canonical_latex": "(\\Omega, \\mathcal{F}, P),\\quad P(A) \\ge 0,\\quad P(\\Omega) = 1,\\quad A_i \\cap A_j = \\emptyset\\,(i \\neq j) \\implies P\\!\\left(\\bigcup_{i=1}^{\\infty} A_i\\right) = \\sum_{i=1}^{\\infty} P(A_i)",
      "aliases_latex": [
        "P(A^c) = 1 - P(A),\\quad P(A \\cup B) = P(A) + P(B) - P(A \\cap B)"
      ],
      "keywords": [
        "Kolmogorov axioms",
        "probability space",
        "sigma-algebra",
        "countable additivity",
        "コルモゴロフの公理",
        "確率空間"
      ],
      "domain_tags": [
        "mathematics",
        "probability"
      ]
    },
    {
      "id": "math.prob.pr02_conditional_bayes_theorem",
      "short_code": "PR02",
      "kind": "theorem_formula",
      "title": "条件付き確率・全確率の法則・ベイズの定理",
      "summary": "事象 B の生起を条件とする事象 A の条件付き確率の定義と、標本空間の分割に基づく全確率の法則および事後確率を求めるベイズの定理。",
      "canonical_latex": "P(A \\mid B) := \\frac{P(A \\cap B)}{P(B)}\\,(P(B)>0),\\quad P(A_i \\mid B) = \\frac{P(B \\mid A_i)P(A_i)}{\\sum_{j} P(B \\mid A_j)P(A_j)}",
      "aliases_latex": [
        "P(A \\cap B) = P(B \\mid A)P(A) = P(A \\mid B)P(B)"
      ],
      "keywords": [
        "conditional probability",
        "Bayes theorem",
        "law of total probability",
        "条件付き確率",
        "ベイズの定理",
        "全確率の法則"
      ],
      "domain_tags": [
        "mathematics",
        "probability"
      ]
    },
    {
      "id": "math.prob.pr03_random_variable_expectation",
      "short_code": "PR03",
      "kind": "definition",
      "title": "確率変数・期待値・分散・独立性の定義",
      "summary": "確率変数とその分布に対する期待値（1次モーメント）および分散（2次中心モーメント）の定義、ならびに確率変数の独立性と線形性・分散の加法性。",
      "canonical_latex": "\\mathbb{E}[g(X)] := \\int_{-\\infty}^{\\infty} g(x)\\,f_X(x)\\,dx,\\quad \\mu := \\mathbb{E}[X],\\quad \\operatorname{Var}(X) := \\mathbb{E}\\big[(X - \\mu)^2\\big] = \\mathbb{E}[X^2] - (\\mathbb{E}[X])^2",
      "aliases_latex": [
        "\\mathbb{E}[aX+bY] = a\\mathbb{E}[X]+b\\mathbb{E}[Y],\\quad X \\perp Y \\implies \\operatorname{Var}(X+Y)=\\operatorname{Var}(X)+\\operatorname{Var}(Y)"
      ],
      "keywords": [
        "random variable",
        "expectation",
        "variance",
        "independence",
        "確率変数",
        "期待値",
        "分散"
      ],
      "domain_tags": [
        "mathematics",
        "probability"
      ]
    },
    {
      "id": "math.prob.pr04_markov_inequality",
      "short_code": "PR04",
      "kind": "theorem_formula",
      "title": "マルコフの不等式",
      "summary": "非負の確率変数 X が正の閾値 a 以上となる上側裾確率を、その期待値 E[X] と a の比によって上から抑える基本的不等式。",
      "canonical_latex": "X \\ge 0 \\land a > 0 \\implies P(X \\ge a) \\le \\frac{\\mathbb{E}[X]}{a}",
      "aliases_latex": [
        "P(X \\ge a) \\le a^{-1}\\mathbb{E}[X]"
      ],
      "keywords": [
        "Markov inequality",
        "tail bound",
        "nonnegative random variable",
        "マルコフの不等式"
      ],
      "domain_tags": [
        "mathematics",
        "probability"
      ]
    },
    {
      "id": "math.prob.pr05_chebyshev_inequality",
      "short_code": "PR05",
      "kind": "theorem_formula",
      "title": "チェビシェフの不等式",
      "summary": "有限の分散を持つ確率変数が平均から ε 以上離れる確率を、分散と ε の2乗の比によって評価する集中不等式。",
      "canonical_latex": "\\operatorname{Var}(X) = \\sigma^2 < \\infty \\land \\varepsilon > 0 \\implies P(|X - \\mu| \\ge \\varepsilon) \\le \\frac{\\sigma^2}{\\varepsilon^2}",
