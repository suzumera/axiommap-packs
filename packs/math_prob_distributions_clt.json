        "P(|X - \\mu| \\ge k\\sigma) \\le \\frac{1}{k^2}"
      ],
      "keywords": [
        "Chebyshev inequality",
        "concentration inequality",
        "variance",
        "チェビシェフの不等式"
      ],
      "domain_tags": [
        "mathematics",
        "probability"
      ]
    },
    {
      "id": "math.prob.pr06_weak_law_large_numbers",
      "short_code": "PR06",
      "kind": "theorem_formula",
      "title": "大数の弱法則（WLLN）",
      "summary": "独立同分布（i.i.d.）で有限平均・有限分散を持つ確率変数列の標本平均が、サンプル数の増大とともに母平均へ確率収束することを保証する定理。",
      "canonical_latex": "\\bar{X}_n := \\frac{1}{n}\\sum_{i=1}^{n} X_i,\\quad \\forall \\varepsilon > 0,\\; \\lim_{n \\to \\infty} P(|\\bar{X}_n - \\mu| \\ge \\varepsilon) = 0\\quad (\\bar{X}_n \\xrightarrow{P} \\mu)",
      "aliases_latex": [
        "\\lim_{n \\to \\infty} P\\!\\left(\\left|\\frac{1}{n}\\sum_{i=1}^{n}X_i - \\mu\\right| \\ge \\varepsilon\\right) = 0"
      ],
      "keywords": [
