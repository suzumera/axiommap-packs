  "nodes": [
    {
      "id": "aerosp.rocket.tsiolkovsky_rocket_equation",
      "short_code": "RKT01",
      "kind": "theorem_formula",
      "title": "ツィオルコフスキーのロケット方程式",
      "summary": "重力や大気抵抗等の外力が無視できる理想的な直進加速において、燃料噴射による質量減少と獲得速度増分を結ぶ基礎方程式。【適用限界】外力（重力損失・大気抵抗損失）が存在する実軌道上昇では付加損失項の積分補正が必要となる。",
      "canonical_latex": "\\Delta v = c_{\\mathrm{eff}} \\ln\\left(\\frac{m_0}{m_f}\\right) = I_{\\mathrm{sp}} g_0 \\ln\\left(\\frac{m_0}{m_f}\\right)",
      "aliases_latex": [
        "v - v_0 = c \\ln\\frac{m_0}{m}",
        "\\frac{m_0}{m_f} = \\exp\\left(\\frac{\\Delta v}{c_{\\mathrm{eff}}}\\right)"
      ],
      "keywords": [
        "ロケット方程式",
        "ツィオルコフスキー",
        "質量比",
        "有効排気速度",
        "比推力"
      ],
      "domain_tags": [
        "aerospace_engineering",
        "orbital_mechanics",
        "propulsion"
      ]
    },
    {
      "id": "aerosp.rocket.stage_mass_parameters",
      "short_code": "RKT02",
      "kind": "definition",
      "title": "ロケット各段の質量パラメータと構造比・ペイロード比の定義",
      "summary": "多段ロケットの各段における推進剤質量、構造質量、段ペイロード質量を無次元化した段質量比 R_i、構造比（構造係数）\\epsilon_i、段ペイロード比 \\lambda_i の幾何学的・工学的定義。",
      "canonical_latex": "R_i := \\frac{m_{0,i}}{m_{f,i}} = \\frac{1 + \\lambda_i}{\\epsilon_i + \\lambda_i},\\quad \\epsilon_i := \\frac{m_{s,i}}{m_{s,i} + m_{p,i}},\\quad \\lambda_i := \\frac{m_{0,i+1}}{m_{0,i} - m_{0,i+1}}",
      "aliases_latex": [
        "R_i = \\frac{m_{p,i} + m_{s,i} + m_{\\mathrm{pl},i}}{m_{s,i} + m_{\\mathrm{pl},i}}"
      ],
      "keywords": [
        "構造比",
        "段ペイロード比",
        "段質量比",
        "質量配分"
      ],
      "domain_tags": [
        "aerospace_engineering",
        "rocket_staging"
      ]
    },
    {
      "id": "aerosp.rocket.ssto_feasibility_limit",
      "short_code": "RKT03",
      "kind": "theorem_formula",
      "title": "単段式宇宙往還機（SSTO）の構造成立限界条件",
      "summary": "単段ロケットによって地球低軌道到達速度（約9.2 km/s）を達成するために要求される構造比の上限不等式。【適用限界】比推力や構造材料強度の技術的ブレークスルーがない限り、ペイロード比がゼロまたは負となり成立不可能となる。",
      "canonical_latex": "\\epsilon_{\\mathrm{SSTO}} < \\exp\\!\\left(-\\frac{\\Delta v_{\\mathrm{req}}}{I_{\\mathrm{sp}} g_0}\\right) - \\lambda_{\\mathrm{pl}}",
      "aliases_latex": [
        "\\frac{m_s}{m_0} \\le \\exp\\left(-\\frac{\\Delta v}{c_{\\mathrm{eff}}}\\right) - \\frac{m_{\\mathrm{pl}}}{m_0}"
      ],
      "keywords": [
        "SSTO",
        "単段式宇宙往還機",
        "構造限界",
        "ペイロード比限界"
      ],
      "domain_tags": [
        "aerospace_engineering",
        "propulsion_limits"
      ]
    },
    {
      "id": "aerosp.rocket.multistage_velocity_summation",
      "short_code": "RKT04",
      "kind": "theorem_formula",
      "title": "直列N段ロケットの総速度増分公式",
      "summary": "直列に段を投棄していく多段ロケットにおいて、各段の燃焼と死重投棄によって累積される総合速度増分の関係式。【適用限界】各段の燃焼が完全に直列的（燃焼終了・投棄後に次段点火）であると仮定しており、同時燃焼を行う並列段には修正を要する。",
      "canonical_latex": "\\Delta v_{\\mathrm{tot}} = \\sum_{i=1}^N c_i \\ln R_i = \\sum_{i=1}^N c_i \\ln\\!\\left(\\frac{1 + \\lambda_i}{\\epsilon_i + \\lambda_i}\\right)",
      "aliases_latex": [
        "\\Delta v = \\sum_{i=1}^N I_{\\mathrm{sp},i} g_0 \\ln\\left(\\frac{1 + \\lambda_i}{\\epsilon_i + \\lambda_i}\\right)"
      ],
      "keywords": [
        "多段ロケット",
        "直列ステージング",
        "総速度増分",
        "質量比積算"
      ],
      "domain_tags": [
        "aerospace_engineering",
        "rocket_staging"
      ]
    },
    {
      "id": "aerosp.rocket.lagrange_equal_exhaust_opt",
      "short_code": "RKT05",
      "kind": "theorem_formula",
      "title": "等比推力・等構造比多段ロケットのラグランジュ最適等配分則",
      "summary": "全段で比推力および構造比が一定である理想多段ロケットにおいて、全初期質量を最小化（または全ペイロード比を最大化）する条件は各段の速度増分および段質量比が均等配分されることであるとする定理。【適用限界】全段で同一推進系・同一構造効率を仮定しているため、大気圏内の第1段と真空専用の上段で比推力が大きく異なる実機ではそのまま適用できない。",
      "canonical_latex": "\\Delta v_i^* = \\frac{\\Delta v_{\\mathrm{tot}}}{N},\\quad R_i^* = R_{\\mathrm{tot}}^{1/N},\\quad \\lambda_i^* = \\lambda^*",
      "aliases_latex": [
        "R_1 = R_2 = \\dots = R_N = \\exp\\left(\\frac{\\Delta v_{\\mathrm{tot}}}{N c}\\right)"
      ],
      "keywords": [
        "等速度配分",
        "ラグランジュ乗数法",
        "多段最適化",
        "質量最小化"
      ],
      "domain_tags": [
        "aerospace_engineering",
        "optimization"
      ]
    },
    {
      "id": "aerosp.rocket.general_stage_optimization_condition",
      "short_code": "RKT06",
      "kind": "theorem_formula",
      "title": "一般多段ロケットの最適段質量配分方程式（不均一推進系）",
      "summary": "段ごとに異なる比推力 c_i と異なる構造比 \\epsilon_i を持つ一般の直列多段ロケットにおいて、全発射質量最小化を与えるラグランジュ未定乗数に基づく極値条件式。【適用限界】連続変数としての極値計算であり、モータやタンクの離散的・型番的なハードウェア制約は別途整数計画問題等での考慮を要する。",
      "canonical_latex": "\\frac{c_i(1 - \\epsilon_i)}{(\\lambda_i + \\epsilon_i)(1 + \\lambda_i)} = \\Lambda = \\text{const.}\\quad (i = 1, 2, \\dots, N)",
      "aliases_latex": [
        "\\frac{\\partial \\ln R_i}{\\partial \\lambda_i}\\cdot c_i = \\Lambda \\frac{\\partial \\ln(m_0/m_{\\mathrm{pl}})}{\\partial \\lambda_i}"
      ],
      "keywords": [
        "最適段配分",
        "ラグランジュ未定乗数法",
        "不均一多段ロケット",
        "推進系最適化"
      ],
      "domain_tags": [
        "aerospace_engineering",
        "optimization"
      ]
    },
