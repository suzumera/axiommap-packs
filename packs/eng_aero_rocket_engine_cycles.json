      "canonical_latex": "\\dot{Q}_{reg} = \\dot{m}_f c_{p,f}(T_{t,in} - T_{c,in}) = \\frac{1}{\\eta_m\\eta_t\\left[1 - \\left(\\frac{p_{te}}{p_{0t}}\\right)^{\\frac{\\gamma-1}{\\gamma}}\\right]}\\sum_i \\frac{\\dot{m}_{p,i}\\Delta p_{p,i}}{\\rho_i\\eta_{p,i}}",
