        "turbomachinery"
      ]
    },
    {
      "id": "aerosp.npsh.n05_suction_specific_speed",
      "short_code": "NPSH05",
      "kind": "definition",
      "title": "吸込比速度 S_s の定義と無次元表示",
      "summary": "回転数・体積流量・必要吸込ヘッドから構成される、ポンプの耐キャビテーション吸込性能を評価するための特性指標。",
      "canonical_latex": "S_s := \\frac{N\\sqrt{Q}}{(\\mathrm{NPSH}_r)^{3/4}},\\qquad S_s^* := \\frac{\\omega\\sqrt{Q}}{(g\\,\\mathrm{NPSH}_r)^{3/4}}",
