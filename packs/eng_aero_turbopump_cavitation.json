      ]
    },
    {
      "id": "aerosp.npsh.n09_rotating_cavitation_onset",
      "short_code": "NPSH09",
      "kind": "theorem_formula",
      "title": "インデューサ旋回キャビテーションの発生条件と超同期伝播周波数",
      "summary": "キャビティ長が翼間ピッチに近づく際に隣接翼との干渉によって発生する旋回キャビテーションの臨界パラメータと、回転周波数よりわずかに高い超同期周波数則。",
      "canonical_latex": "\\frac{K}{2\\alpha} \\lesssim 1 + \\frac{1}{2}\\sigma_{\\mathrm{b}},\\qquad f_{rc} = Z_c \\left(1 + \\delta_{rc}\\right)f_n\\quad (\\delta_{rc} \\approx 0.1 \\sim 0.25)",
      "aliases_latex": [
