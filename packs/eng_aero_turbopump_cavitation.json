    {
      "id": "aerosp.npsh.n07_inducer_optimal_flow_coefficient",
      "short_code": "NPSH07",
      "kind": "theorem_formula",
      "title": "吸込比速度最大化によるインデューサ最適流量係数 \\phi_{\\mathrm{opt}}",
      "summary": "予旋回のない軸流入口において吸込比速度を最大化する流量係数と、そのときの最小必要吸込ヘッドを与える最適設計条件。",
      "canonical_latex": "\\phi_{\\mathrm{opt}} = \\sqrt{\\frac{\\lambda_c}{2(1 + \\lambda_c)}},\\qquad \\mathrm{NPSH}_{r,\\mathrm{opt}} = \\frac{3\\lambda_c}{2(1 + \\lambda_c)}\\frac{u_t^2}{2g}",
      "aliases_latex": [
        "\\phi_{\\mathrm{opt}} = \\left(\\frac{\\lambda_c}{2 + 2\\lambda_c}\\right)^{1/2}"
      ],
      "keywords": [
        "最適流量係数",
        "吸込比速度最大化",
        "インデューサ設計",
        "最適吸込性能"
      ],
      "domain_tags": [
        "aerospace_engineering",
        "fluid_mechanics",
        "turbomachinery"
      ]
    },
    {
      "id": "aerosp.npsh.n08_cavitation_surge_compliance",
      "short_code": "NPSH08",
      "kind": "theorem_formula",
      "title": "キャビテーションコンプライアンスとサージ固有振動数",
      "summary": "インデューサ内キャビティ体積の圧力依存性（コンプライアンス）と吸込管路の流体イナータンスが結合して生じる軸方向サージ振動の固有角振動数。",
      "canonical_latex": "\\omega_{\\mathrm{surge}} = \\frac{1}{\\sqrt{L_{\\mathrm{in}} C_c}},\\qquad C_c := -\\frac{\\partial V_c}{\\partial p_1},\\qquad L_{\\mathrm{in}} := \\frac{\\rho l_{\\mathrm{in}}}{A_{\\mathrm{in}}}",
      "aliases_latex": [
        "f_{\\mathrm{surge}} = \\frac{1}{2\\pi\\sqrt{L_{\\mathrm{in}} C_c}}"
      ],
      "keywords": [
        "キャビテーションサージ",
        "キャビテーションコンプライアンス",
