  },
  "nodes": [
    {
      "id": "aerosp.npsh.n01_euler_turbomachinery_head",
      "short_code": "NPSH01",
      "kind": "theorem_formula",
      "title": "オイラーのターボ機械方程式と理論揚程",
      "summary": "インペラやインデューサなどの回転翼列を通過する流体の角運動量変化から、理論揚程と軸動力を与える基本方程式。",
      "canonical_latex": "H_{\\mathrm{th}} = \\frac{u_2 c_{u2} - u_1 c_{u1}}{g},\\qquad P_{\\mathrm{shaft}} = \\dot{m}(u_2 c_{u2} - u_1 c_{u1})",
      "aliases_latex": [
        "\\Delta h_0 = u_2 c_{u2} - u_1 c_{u1}"
      ],
      "keywords": [
