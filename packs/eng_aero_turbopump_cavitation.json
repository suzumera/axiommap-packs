    {
      "id": "aerosp.npsh.n06_inducer_cavitation_number",
      "short_code": "NPSH06",
      "kind": "definition",
      "title": "インデューサのキャビテーション数 K と流量係数 \\phi の定義",
      "summary": "インデューサ先端周速の動圧を基準としたキャビテーション数と、軸流速度と周速の比である流量係数の定義。",
      "canonical_latex": "K := \\frac{p_1 - p_v}{\\frac{1}{2}\\rho u_t^2} = \\frac{2g\\,\\mathrm{NPSH}_a - c_1^2}{u_t^2},\\qquad \\phi := \\frac{c_{m1}}{u_t}",
      "aliases_latex": [
