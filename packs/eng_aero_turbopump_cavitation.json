        "turbomachinery"
      ]
    },
    {
      "id": "aerosp.npsh.n02_npsh_available_definition",
      "short_code": "NPSH02",
      "kind": "definition",
      "title": "有効吸込ヘッド（NPSHa）の定義",
      "summary": "ポンプ吸込口における流体の全圧と飽和蒸気圧との差を液柱高さ（ヘッド）で表した、キャビテーションに対する圧力余裕の指標。",
      "canonical_latex": "\\mathrm{NPSH}_a := \\frac{p_{s0}}{\\rho g} + \\frac{c_0^2}{2g} - \\frac{p_v}{\\rho g} = \\frac{p_{t0} - p_v}{\\rho g}",
      "aliases_latex": [
        "H_{sv} = \\frac{p_{t0} - p_v}{\\rho g}"
      ],
      "keywords": [
        "有効吸込ヘッド",
        "NPSHa",
        "飽和蒸気圧",
        "キャビテーション"
      ],
      "domain_tags": [
        "aerospace_engineering",
        "fluid_mechanics",
        "turbomachinery"
      ]
    },
    {
      "id": "aerosp.npsh.n03_npsh_required_blade_drop",
      "short_code": "NPSH03",
      "kind": "theorem_formula",
      "title": "必要吸込ヘッド（NPSHr）と翼面局所圧力低下の関係",
      "summary": "羽根車入口の動圧および翼負圧面での局所的な相対速度加速による圧力降下から定まる、キャビテーション抑止に必要な最小吸込ヘッド。",
      "canonical_latex": "\\mathrm{NPSH}_r = \\frac{c_1^2}{2g} + \\lambda_c \\frac{w_1^2}{2g},\\qquad \\mathrm{NPSH}_a \\ge \\mathrm{NPSH}_r",
      "aliases_latex": [
        "\\mathrm{NPSH}_r = \\frac{c_1^2}{2g} + \\sigma_b \\frac{w_1^2}{2g}"
      ],
      "keywords": [
        "必要吸込ヘッド",
        "NPSHr",
        "局所圧力低下",
        "キャビテーション発生限界"
      ],
      "domain_tags": [
        "aerospace_engineering",
        "fluid_mechanics",
        "turbomachinery"
      ]
    },
    {
      "id": "aerosp.npsh.n04_thoma_cavitation_number",
