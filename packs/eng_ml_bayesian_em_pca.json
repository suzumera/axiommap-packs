  "nodes": [
    {
      "id": "eng.ml3.n01_sample_covariance_def",
      "short_code": "ML3_01",
      "kind": "definition",
      "title": "標本平均と標本共分散行列の定義",
      "summary": "D次元データ集合に対する標本平均ベクトルおよび中心化データから構成される標本共分散行列の定義。",
      "canonical_latex": "\\bar{\\mathbf{x}} := \\frac{1}{N}\\sum_{n=1}^{N}\\mathbf{x}_n,\\quad \\mathbf{S} := \\frac{1}{N}\\sum_{n=1}^{N}(\\mathbf{x}_n - \\bar{\\mathbf{x}})(\\mathbf{x}_n - \\bar{\\mathbf{x}})^\\top",
      "aliases_latex": [
        "\\mathbf{S} = \\frac{1}{N}\\tilde{\\mathbf{X}}\\tilde{\\mathbf{X}}^\\top"
      ],
      "keywords": [
        "sample mean",
        "covariance matrix",
        "centering",
        "PCA"
      ],
      "domain_tags": [
        "machine_learning",
        "statistics",
        "linear_algebra"
      ]
    },
    {
      "id": "eng.ml3.n02_pca_variance_maximization",
      "short_code": "ML3_02",
      "kind": "theorem_formula",
      "title": "主成分分析（PCA）の分散最大化と固有値問題",
      "summary": "射影後の分散を単位ノルム制約の下で最大化する問題が、標本共分散行列の固有値問題に帰着することを示す定理。",
      "canonical_latex": "\\max_{\\|\\mathbf{u}_1\\|_2=1} \\mathbf{u}_1^\\top \\mathbf{S}\\mathbf{u}_1 \\iff \\mathbf{S}\\mathbf{u}_1 = \\lambda_1 \\mathbf{u}_1,\\quad \\max \\mathrm{Var} = \\lambda_1",
      "aliases_latex": [
        "\\mathbf{S}\\mathbf{u}_i = \\lambda_i\\mathbf{u}_i"
      ],
      "keywords": [
        "PCA",
        "principal component analysis",
        "variance maximization",
        "eigenvalue problem"
      ],
      "domain_tags": [
        "machine_learning",
        "linear_algebra",
        "optimization"
      ]
    },
    {
      "id": "eng.ml3.n03_pca_reconstruction_error",
      "short_code": "ML3_03",
      "kind": "theorem_formula",
      "title": "PCAにおける再構成誤差最小化と分散最大化の等価性",
      "summary": "M次元正規直交部分空間への射影による平均二乗再構成誤差の最小化が、上位M個の固有値に対応する主成分の選択と等価であるという定理。",
      "canonical_latex": "\\min_{\\mathbf{U}_M^\\top\\mathbf{U}_M=I_M} \\frac{1}{N}\\sum_{n=1}^{N}\\|\\tilde{\\mathbf{x}}_n - \\mathbf{U}_M\\mathbf{U}_M^\\top\\tilde{\\mathbf{x}}_n\\|_2^2 = \\operatorname{tr}(\\mathbf{S}) - \\max \\operatorname{tr}(\\mathbf{U}_M^\\top\\mathbf{S}\\mathbf{U}_M) = \\sum_{i=M+1}^{D}\\lambda_i",
      "aliases_latex": [
        "J_{\\mathrm{rec}}(\\mathbf{U}_M) = \\sum_{i=M+1}^{D}\\lambda_i"
      ],
      "keywords": [
        "reconstruction error",
        "orthogonal projection",
        "PCA",
        "Frobenius norm"
      ],
      "domain_tags": [
        "machine_learning",
        "linear_algebra"
      ]
    },
    {
      "id": "eng.ml3.n04_gmm_latent_variable_def",
      "short_code": "ML3_04",
      "kind": "definition",
      "title": "混合ガウスモデル（GMM）と潜在変数による周辺尤度の定義",
      "summary": "K個の正規分布の混合としてデータを生成する確率モデルと、1-of-K表現の潜在変数を用いた同時分布および周辺尤度の定義。",
      "canonical_latex": "p(\\mathbf{x} \\mid \\boldsymbol{\\theta}) = \\sum_{\\mathbf{z}} p(\\mathbf{z})p(\\mathbf{x}\\mid\\mathbf{z}) = \\sum_{k=1}^{K}\\pi_k \\mathcal{N}(\\mathbf{x} \\mid \\boldsymbol{\\mu}_k, \\boldsymbol{\\Sigma}_k),\\quad \\sum_{k=1}^{K}\\pi_k = 1,\\; \\pi_k \\ge 0",
      "aliases_latex": [
        "p(\\mathbf{x},\\mathbf{z}) = \\prod_{k=1}^{K}[\\pi_k \\mathcal{N}(\\mathbf{x}\\mid\\boldsymbol{\\mu}_k,\\boldsymbol{\\Sigma}_k)]^{z_k}"
      ],
      "keywords": [
        "Gaussian mixture model",
        "GMM",
        "latent variable",
        "marginal likelihood"
      ],
      "domain_tags": [
        "machine_learning",
        "probability"
      ]
    },
    {
      "id": "eng.ml3.n05_jensen_inequality_concave",
      "short_code": "ML3_05",
      "kind": "math_boundary",
      "title": "凹関数に対するイェンセンの不等式",
      "summary": "凹関数（特に対数関数）に対して、期待値の関数値が関数値の期待値以上となる基本的凸解析・確率論の不等式。",
      "canonical_latex": "f\\text{ concave} \\implies f(\\mathbb{E}[Y]) \\ge \\mathbb{E}[f(Y)],\\quad \\ln\\left(\\sum_k q_k y_k\\right) \\ge \\sum_k q_k \\ln y_k\\;\\left(\\sum_k q_k = 1,\\; q_k \\ge 0\\right) ",
      "aliases_latex": [
        "\\ln \\mathbb{E}[Y] \\ge \\mathbb{E}[\\ln Y]"
      ],
      "keywords": [
        "Jensen inequality",
        "concave function",
        "logarithm",
        "variational inference"
      ],
      "domain_tags": [
        "machine_learning",
        "probability",
        "convex_analysis"
      ]
    },
    {
      "id": "eng.ml3.n06_elbo_kl_decomposition",
      "short_code": "ML3_06",
      "kind": "theorem_formula",
      "title": "対数周辺尤度の変分下界（ELBO）とKLダイバージェンス分解",
      "summary": "任意の潜在変数分布q(Z)に対して、対数周辺尤度が変分下界（ELBO）と事後分布とのKLダイバージェンスの和に分解される基本恒等式。",
      "canonical_latex": "\\ln p(\\mathbf{X} \\mid \\boldsymbol{\\theta}) = \\mathcal{L}(q, \\boldsymbol{\theta}) + \\mathrm{KL}\\big(q(\\mathbf{Z}) \\,\\|\\, p(\\mathbf{Z} \\mid \\mathbf{X}, \\boldsymbol{\\theta})\\big),\\quad \\mathcal{L}(q, \\boldsymbol{\\theta}) := \\sum_{\\mathbf{Z}} q(\\mathbf{Z}) \\ln \\frac{p(\\mathbf{X}, \\mathbf{Z} \\mid \\boldsymbol{\\theta})}{q(\\mathbf{Z})}",
      "aliases_latex": [
        "\\ln p(\\mathbf{X}\\mid\\boldsymbol{\\theta}) \\ge \\mathcal{L}(q, \\boldsymbol{\\theta})"
      ],
      "keywords": [
        "ELBO",
        "evidence lower bound",
        "KL divergence",
        "variational inference"
      ],
      "domain_tags": [
        "machine_learning",
        "probability"
      ]
    },
    {
      "id": "eng.ml3.n07_em_algorithm_general",
      "short_code": "ML3_07",
      "kind": "theorem_formula",
      "title": "一般のEMアルゴリズム（Eステップ・Mステップと単調増加性）",
      "summary": "ELBOをqとパラメータについて交互に最大化することで、対数周辺尤度を単調非減少に改善する反復最適化アルゴリズム。",
      "canonical_latex": "\\text{E-step: } q^{(t+1)}(\\mathbf{Z}) = p(\\mathbf{Z} \\mid \\mathbf{X}, \\boldsymbol{\\theta}^{(t)}),\\quad \\text{M-step: } \\boldsymbol{\\theta}^{(t+1)} = \\arg\\max_{\\boldsymbol{\\theta}} \\mathcal{Q}(\\boldsymbol{\theta}, \\boldsymbol{\\theta}^{(t)}),\\quad \\ln p(\\mathbf{X}\\mid\\boldsymbol{\\theta}^{(t+1)}) \\ge \\ln p(\\mathbf{X}\\mid\\boldsymbol{\\theta}^{(t)})",
      "aliases_latex": [
        "\\mathcal{Q}(\\boldsymbol{\theta}, \\boldsymbol{\\theta}^{(t)}) = \\mathbb{E}_{p(\\mathbf{Z}\\mid\\mathbf{X},\\boldsymbol{\\theta}^{(t)})}[\\ln p(\\mathbf{X},\\mathbf{Z}\\mid\\boldsymbol{\\theta})]"
      ],
      "keywords": [
        "EM algorithm",
        "expectation maximization",
        "monotonicity",
        "Q-function"
      ],
      "domain_tags": [
        "machine_learning",
        "optimization",
        "probability"
      ]
    },
    {
      "id": "eng.ml3.n08_gmm_e_step_responsibility",
      "short_code": "ML3_08",
      "kind": "theorem_formula",
      "title": "混合ガウスモデル（GMM）のEステップ（負担率の計算）",
      "summary": "現在のパラメータの下で各データ点が各混合要素に属する事後確率（負担率）をベイズの定理により評価する更新式。",
      "canonical_latex": "\\gamma(z_{nk}) := p(z_{nk}=1 \\mid \\mathbf{x}_n, \\boldsymbol{\\theta}^{(t)}) = \\frac{\\pi_k^{(t)} \\mathcal{N}(\\mathbf{x}_n \\mid \\boldsymbol{\\mu}_k^{(t)}, \\boldsymbol{\\Sigma}_k^{(t)})}{\\sum_{j=1}^{K}\\pi_j^{(t)} \\mathcal{N}(\\mathbf{x}_n \\mid \\boldsymbol{\\mu}_j^{(t)}, \\boldsymbol{\\Sigma}_j^{(t)})} ",
      "aliases_latex": [
        "\\gamma_{nk} = p(z_{nk}=1 \\mid \\mathbf{x}_n)"
      ],
      "keywords": [
        "GMM",
        "E-step",
        "responsibility",
        "posterior probability"
      ],
      "domain_tags": [
        "machine_learning",
        "probability"
      ]
    },
    {
      "id": "eng.ml3.n09_gmm_m_step_updates",
      "short_code": "ML3_09",
      "kind": "theorem_formula",
      "title": "混合ガウスモデル（GMM）のMステップ（パラメータ更新則）",
      "summary": "Eステップで求めた負担率を用いて完全データ対数尤度の期待値Qを最大化する、平均・共分散行列・混合係数の閉形式更新式。",
      "canonical_latex": "N_k = \\sum_{n=1}^{N}\\gamma(z_{nk}),\\quad \\boldsymbol{\\mu}_k^{(t+1)} = \\frac{1}{N_k}\\sum_{n=1}^{N}\\gamma(z_{nk})\\mathbf{x}_n,\\quad \\boldsymbol{\\Sigma}_k^{(t+1)} = \\frac{1}{N_k}\\sum_{n=1}^{N}\\gamma(z_{nk})(\\mathbf{x}_n-\\boldsymbol{\\mu}_k^{(t+1)})(\\mathbf{x}_n-\\boldsymbol{\\mu}_k^{(t+1)})^\\top,\\quad \\pi_k^{(t+1)} = \\frac{N_k}{N} ",
      "aliases_latex": [
        "\\boldsymbol{\\theta}^{(t+1)} = \\arg\\max_{\\boldsymbol{\\theta}}\\mathcal{Q}(\\boldsymbol{\\theta},\\boldsymbol{\\theta}^{(t)})"
      ],
      "keywords": [
        "GMM",
        "M-step",
        "parameter update",
        "maximum likelihood"
      ],
      "domain_tags": [
        "machine_learning",
        "optimization",
        "probability"
      ]
    }
  ],
