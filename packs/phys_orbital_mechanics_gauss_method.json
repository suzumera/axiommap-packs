    {
      "id": "phys.orbit.g04_lagrange_fg_series",
      "short_code": "G04",
      "kind": "theorem_formula",
      "title": "ラグランジュの f, g 級数展開",
      "summary": "中央の観測時刻 t_2 における位置 r_2 と速度 v_2 を基底として、前後時刻 t_1, t_3 の位置ベクトル r_i (i=1,3) を時間差 τ_i = t_i - t_2 のテイラー級数と2体運動方程式から近似展開した公式。",
      "canonical_latex": "\\mathbf{r}_i = f_i\\mathbf{r}_2 + g_i\\mathbf{v}_2,\\quad f_i \\approx 1 - \\frac{\\mu}{2r_2^3}\\tau_i^2,\\quad g_i \\approx \\tau_i - \\frac{\\mu}{6r_2^3}\\tau_i^3\\quad (\\tau_i = t_i - t_2)",
      "aliases_latex": [
        "f(\\tau) = 1 - \\frac{1}{2}u\\tau^2 + \\mathcal{O}(\\tau^3),\\; g(\\tau) = \\tau - \\frac{1}{6}u\\tau^3 + \\mathcal{O}(\\tau^4)"
      ],
      "keywords": [
        "Lagrange f and g series",
        "f, g級数",
        "ケプラー運動の級数展開"
      ],
      "domain_tags": [
        "orbital_mechanics"
      ]
