      "kind": "theorem_formula",
      "title": "M/M/c待ち行列の定常確率分布と空き状態確率 P_0",
      "summary": "並列するc個の同一窓口を持つM/M/c待ち行列において、稼働窓口数に応じたサービス率から導かれる定常確率分布とP_0の表現。",
      "canonical_latex": "P_n = \\begin{cases} \\frac{(c\\rho)^n}{n!} P_0 & (0 \\le n < c) \\\\ \\frac{c^c \\rho^n}{c!} P_0 & (n \\ge c) \\end{cases},\\quad P_0 = \\left[\\sum_{n=0}^{c-1}\\frac{(c\\rho)^n}{n!} + \\frac{(c\\rho)^c}{c!(1 - \\rho)}\\right]^{-1}\\quad \\left(\\rho := \\frac{\\lambda}{c\\mu} < 1\\right)",
      "aliases_latex": [
        "P_n = \\frac{a^n}{n!} P_0\\;(n < c),\\quad P_n = \\frac{a^n}{c!\\,c^{n-c}} P_0\\;(n \\ge c)\\;\\left(a=\\frac{\\lambda}{\\mu}\\right)"
      ],
      "keywords": [
        "M/M/c",
        "複数窓口",
        "定常確率分布",
        "出生死滅過程"
      ],
      "domain_tags": [
        "operations_research",
        "queueing_theory"
      ]
    },
    {
      "id": "or.q.n08_erlang_c_formula",
      "short_code": "Q08",
      "kind": "theorem_formula",
      "title": "アーランC公式（M/M/cの待ち確率）と平均待ち人数",
      "summary": "M/M/c待ち行列において到着した客が全窓口使用中のため待たされる確率（アーランC公式）と、それを用いた平均待ち人数L_q。",
      "canonical_latex": "C(c, a) = \\frac{\\frac{a^c}{c!(1 - \\rho)}}{\\sum_{n=0}^{c-1}\\frac{a^n}{n!} + \\frac{a^c}{c!(1 - \\rho)}},\\qquad L_q = C(c, a)\\frac{\\rho}{1 - \\rho}\\quad \\left(a = \\frac{\\lambda}{\\mu} = c\\rho\\right)",
      "aliases_latex": [
        "P(\\text{wait}) = \\sum_{n=c}^{\\infty} P_n = C(c, a)"
      ],
