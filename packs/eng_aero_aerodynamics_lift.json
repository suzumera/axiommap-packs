        "fluid_mechanics"
      ]
    },
    {
      "id": "eng.aero.n02_complex_velocity_potential",
      "short_code": "AE02",
      "kind": "definition",
      "title": "2次元ポテンシャル流の複素速度ポテンシャルと複素速度",
      "summary": "2次元非圧縮渦なし流れでは速度ポテンシャルと流れ関数がコーシー＝リーマンの関係式を満たし、正則な複素速度ポテンシャルを定義できる。",
      "canonical_latex": "w(z) := \\phi(x,y) + i\\psi(x,y),\\quad z = x + iy,\\quad \\frac{dw}{dz} = u - iv,\\quad u = \\frac{\\partial\\phi}{\\partial x} = \\frac{\\partial\\psi}{\\partial y},\\quad v = \\frac{\\partial\\phi}{\\partial y} = -\\frac{\\partial\\psi}{\\partial x},\\quad \\nabla^2\\phi = \\nabla^2\\psi = 0",
      "aliases_latex": [
        "w'(z) = u - iv"
      ],
      "keywords": [
        "複素速度ポテンシャル",
