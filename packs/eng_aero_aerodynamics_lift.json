    {
      "id": "eng.aero.n05_kutta_joukowski_theorem",
      "short_code": "AE05",
      "kind": "theorem_formula",
      "title": "クッタ＝ジュコフスキーの揚力定理",
      "summary": "任意形状の2次元翼周りに循環 Γ が存在するとき、単位スパンあたりの揚力は L' = ρ U_∞ Γ となり、2次元ポテンシャル流中の抗力は零となる。",
      "canonical_latex": "F_x - i F_y = -i\\rho U_\\infty e^{-i\\alpha}\\Gamma \\implies L' = \\rho U_\\infty \\Gamma,\\quad D' = 0",
      "aliases_latex": [
        "L' = \\rho U_\\infty \\Gamma"
      ],
      "keywords": [
        "クッタ＝ジュコフスキーの定理",
        "揚力",
        "循環",
        "ダランベールのパラドックス"
      ],
      "domain_tags": [
        "aerospace_engineering",
        "fluid_mechanics"
      ],
      "intuition_oneliner": "要するに、翼の周りを空気がぐるぐる回る循環（うず）があると、飛行機を浮き上がらせる揚力が生まれ、抵抗はゼロになるという定理です。",
      "diagram_svg": "<svg viewBox=\"0 0 600 260\" xmlns=\"http://www.w3.org/2000/svg\"><text x=\"50\" y=\"40\" fill=\"currentColor\" font-size=\"16\" font-weight=\"bold\">クッタ＝ジュコフスキーの揚力定理</text><path d=\"M 150 130 Q 300 80 450 130 Q 300 180 150 130\" fill=\"#3b82f6\" opacity=\"0.2\" stroke=\"#3b82f6\" stroke-width=\"2\"/><path d=\"M 300 130 m -30 0 a 30 30 0 1 1 60 0\" fill=\"none\" stroke=\"#f97316\" stroke-width=\"2\" stroke-dasharray=\"4,4\"/><text x=\"270\" y=\"90\" fill=\"#f97316\">循環 Γ</text><line x1=\"50\" y1=\"200\" x2=\"550\" y2=\"200\" stroke=\"currentColor\" stroke-width=\"2\" marker-end=\"url(#arrow)\"/><text x=\"480\" y=\"225\" fill=\"currentColor\">揚力 L' = ρ U ∞ Γ</text></svg>"
    },
    {
      "id": "eng.aero.n06_kutta_condition_thin_airfoil",
      "short_code": "AE06",
      "kind": "definition",
      "title": "クッタの条件と薄翼理論の渦層積分方程式",
      "summary": "後縁での流速発散を防ぐクッタの条件を課し、中心線上に分布させた渦度分布 γ(ξ) に対する薄翼理論の基本積分方程式を定式化する。",
      "canonical_latex": "\\gamma(c) = 0\\;\\text{(Kutta condition)},\\qquad \\frac{1}{2\\pi}\\int_{0}^{c} \\frac{\\gamma(\\xi)}{x - \\xi}\\,d\\xi = U_\\infty\\left(\\alpha - \\frac{dz_c}{dx}\\right)\\quad (0 < x < c);\\quad \\Gamma = \\int_{0}^{c}\\gamma(\\xi)\\,d\\xi",
      "aliases_latex": [
        "\\frac{1}{2\\pi}\\int_0^c \\frac{\\gamma(\\xi)}{x-\\xi}d\\xi = U_\\infty(\\alpha - dz_c/dx)"
      ],
      "keywords": [
        "クッタの条件",
        "薄翼理論",
        "渦層分布",
        "中心線",
        "特異積分方程式"
      ],
      "domain_tags": [
        "aerospace_engineering",
        "fluid_mechanics"
      ]
    },
    {
      "id": "eng.aero.n07_thin_airfoil_glauert_solution",
      "short_code": "AE07",
      "kind": "theorem_formula",
      "title": "薄翼理論のグラウエルト解と揚力傾斜 2π",
      "summary": "変数変換 x = (c/2)(1 - cos θ) とフーリエ正弦級数展開により薄翼積分方程式を解き、揚力係数 c_l = 2π(α - α_{L=0}) および揚力傾斜 2π を得る。",
      "canonical_latex": "\\gamma(\\theta) = 2U_\\infty\\left(A_0\\frac{1+\\cos\\theta}{\\sin\\theta} + \\sum_{n=1}^{\\infty}A_n\\sin n\\theta\\right),\\quad c_l = 2\\pi\\left(A_0 + \\frac{A_1}{2}\\right) = 2\\pi(\\alpha - \\alpha_{L=0}),\\quad \\frac{dc_l}{d\\alpha} = 2\\pi",
      "aliases_latex": [
        "c_l = 2\\pi(\\alpha - \\alpha_{L=0})"
      ],
      "keywords": [
        "グラウエルト解",
        "揚力係数",
        "揚力傾斜",
        "ゼロ揚力迎角",
        "フーリエ級数"
      ],
      "domain_tags": [
        "aerospace_engineering",
        "fluid_mechanics"
      ]
    },
