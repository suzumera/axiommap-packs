    "title": "金融工学2：マーコウィッツの平均・分散ポートフォリオ最適化、シャープレシオとCAPM",
    "language": "ja",
    "description": "ラグランジュ未定乗数法による分散最小化から効率的フロンティア、接点ポートフォリオ、資本市場線（CML）および資本資産価格モデル（CAPM: E[Ri]=Rf+βi(E[Rm]-Rf)）を導出する。"
  },
  "nodes": [
    {
      "id": "fin.capm.n01_portfolio_return_variance_def",
      "short_code": "CAPM01",
      "kind": "definition",
      "title": "ポートフォリオの期待収益率と分散（平均・分散モデルの基本定義）",
      "summary": "N個のリスク資産への投資比率ベクトルwに対し、ポートフォリオの期待収益率を線形結合、分散を共分散行列Σの2次形式として定義する。",
      "canonical_latex": "\\mu_p = \\mathbf{w}^\\top \\boldsymbol{\\mu},\\quad \\sigma_p^2 = \\mathbf{w}^\\top \\Sigma \\mathbf{w},\\quad \\mathbf{w}^\\top \\mathbf{1} = 1\\quad (\\boldsymbol{\\mu} = \\mathbb{E}[\\mathbf{R}],\\; \\Sigma = \\operatorname{Cov}(\\mathbf{R}) \\succ 0))",
      "aliases_latex": [
        "R_p = \\sum_{i=1}^N w_i R_i,\\quad \\operatorname{Var}(R_p) = \\sum_{i,j=1}^N w_i w_j \\sigma_{ij}"
      ],
      "keywords": [
        "ポートフォリオ",
        "期待収益率",
        "共分散行列",
        "平均・分散モデル"
      ],
      "domain_tags": [
        "finance",
        "portfolio_theory",
        "statistics"
      ]
    },
    {
      "id": "fin.capm.n02_markowitz_mvp_problem",
      "short_code": "CAPM02",
      "kind": "definition",
      "title": "マーコウィッツの平均・分散最適化問題（最小分散ポートフォリオの定式化）",
      "summary": "目標期待収益率μ_pと予算制約w^T 1 = 1の下で、ポートフォリオ分散（1/2 w^T Σ w）を最小化する2次計画問題として定式化する。",
      "canonical_latex": "\\min_{\\mathbf{w} \\in \\mathbb{R}^N} \\frac{1}{2}\\mathbf{w}^\\top \\Sigma \\mathbf{w} \\quad \\text{s.t.} \\quad \\mathbf{w}^\\top \\boldsymbol{\\mu} = \\mu_p,\\quad \\mathbf{w}^\\top \\mathbf{1} = 1",
      "aliases_latex": [
        "\\min_{\\mathbf{w}} \\mathbf{w}^\\top \\Sigma \\mathbf{w} \\text{ s.t. } \\mathbf{w}^\\top \\boldsymbol{\\mu} = \\mu_p,\\; \\mathbf{w}^\\top \\mathbf{1} = 1"
      ],
      "keywords": [
        "マーコウィッツ",
        "最小分散ポートフォリオ",
        "2次計画問題",
        "等式制約"
      ],
      "domain_tags": [
        "finance",
        "portfolio_theory",
        "optimization"
      ]
    },
    {
      "id": "fin.capm.n03_efficient_frontier_hyperbola",
      "short_code": "CAPM03",
      "kind": "theorem_formula",
      "title": "効率的フロンティアと最小分散境界（双曲線方程式）",
      "summary": "ラグランジュ未定乗数法により最小分散ポートフォリオの最適ウェイトを解析的に解き、期待収益率μ_pと標準偏差σ_pの関係が双曲線（分散については放物線）を描くことを示す。",
      "canonical_latex": "\\mathbf{w}^*(\\mu_p) = \\Sigma^{-1}(\\lambda_1 \\boldsymbol{\\mu} + \\lambda_2 \\mathbf{1}),\\quad \\sigma_p^2 = \\frac{A - 2B\\mu_p + C\\mu_p^2}{AC - B^2}\\quad (A=\\boldsymbol{\\mu}^\\top\\Sigma^{-1}\\boldsymbol{\\mu},\\; B=\\boldsymbol{\\mu}^\\top\\Sigma^{-1}\\mathbf{1},\\; C=\\mathbf{1}^\\top\\Sigma^{-1}\\mathbf{1})",
      "aliases_latex": [
        "\\frac{\\sigma_p^2}{1/C} - \\frac{(\\mu_p - B/C)^2}{(AC-B^2)/C^2} = 1"
      ],
      "keywords": [
        "効率的フロンティア",
        "最小分散境界",
        "ラグランジュ未定乗数法",
        "双曲線"
      ],
      "domain_tags": [
        "finance",
        "portfolio_theory",
        "optimization"
      ]
    },
    {
      "id": "fin.capm.n04_sharpe_ratio_tangency_def",
      "short_code": "CAPM04",
      "kind": "definition",
      "title": "無リスク資産・シャープレシオおよび接点ポートフォリオの定義",
      "summary": "無リスク利子率R_fを導入し、超過リターンを標準偏差で割ったリスク調整後指標（シャープレシオ）と、それを最大化する接点ポートフォリオを定義する。",
      "canonical_latex": "\\mathrm{SR}(\\mathbf{w}) := \\frac{\\mathbb{E}[R_p] - R_f}{\\sigma_p} = \\frac{\\mathbf{w}^\\top(\\boldsymbol{\\mu} - R_f\\mathbf{1})}{\\sqrt{\\mathbf{w}^\\top \\Sigma \\mathbf{w}}},\\qquad \\mathbf{w}_T := \\arg\\max_{\\mathbf{w}^\\top\\mathbf{1}=1} \\mathrm{SR}(\\mathbf{w})",
      "aliases_latex": [
        "S_p = \\frac{\\mu_p - R_f}{\\sigma_p}"
      ],
      "keywords": [
        "シャープレシオ",
        "無リスク資産",
        "接点ポートフォリオ",
        "超過収益率"
      ],
      "domain_tags": [
        "finance",
        "portfolio_theory"
      ]
    },
    {
      "id": "fin.capm.n05_tangency_portfolio_weights",
      "short_code": "CAPM05",
      "kind": "theorem_formula",
      "title": "接点ポートフォリオの最適ウェイト公式（トービンの分離定理）",
      "summary": "シャープレシオ最大化の1階条件から、投資家のリスク回避度に依存しないリスク資産の最適構成比（接点ポートフォリオ）が解析的に一意に定まることを導出する。",
      "canonical_latex": "\\mathbf{w}_T = \\frac{\\Sigma^{-1}(\\boldsymbol{\\mu} - R_f \\mathbf{1})}{\\mathbf{1}^\\top \\Sigma^{-1}(\\boldsymbol{\\mu} - R_f \\mathbf{1})}",
      "aliases_latex": [
        "\\mathbf{w}_T \\propto \\Sigma^{-1}(\\boldsymbol{\\mu} - R_f\\mathbf{1})"
      ],
      "keywords": [
        "接点ポートフォリオ",
        "分離定理",
        "シャープレシオ最大化",
        "最適ウェイト"
      ],
      "domain_tags": [
        "finance",
        "portfolio_theory",
        "optimization"
      ]
    },
    {
      "id": "fin.capm.n06_capital_market_line",
      "short_code": "CAPM06",
      "kind": "theorem_formula",
      "title": "資本市場線（CML）の導出",
      "summary": "無リスク資産と接点ポートフォリオを組み合わせた効率的ポートフォリオの期待収益率と標準偏差が、無リスク金利を切片とし最大シャープレシオを傾きとする直線（資本市場線）上に乗ることを示す。",
      "canonical_latex": "\\mathbb{E}[R_p] = R_f + \\frac{\\mathbb{E}[R_T] - R_f}{\\sigma_T}\\,\\sigma_p = R_f + \\mathrm{SR}(\\mathbf{w}_T)\\,\\sigma_p",
      "aliases_latex": [
        "\\mu_p = R_f + \\frac{\\mu_T - R_f}{\\sigma_T}\\sigma_p"
      ],
      "keywords": [
        "資本市場線",
        "CML",
        "効率的ポートフォリオ",
        "リスク・リターン線形関係"
      ],
      "domain_tags": [
        "finance",
        "portfolio_theory",
        "asset_pricing"
      ]
    },
    {
      "id": "fin.capm.n07_market_equilibrium_beta_def",
      "short_code": "CAPM07",
      "kind": "definition",
      "title": "市場均衡と市場ポートフォリオ・ベータ（系統的リスク感応度）の定義",
      "summary": "すべての投資家が同質的期待を持つ市場均衡において接点ポートフォリオが市場ポートフォリオw_Mに一致することを確認し、個別資産iの市場全体に対する感応度ベータを定義する。",
      "canonical_latex": "\\mathbf{w}_M = \\mathbf{w}_T,\\qquad \\beta_i := \\frac{\\operatorname{Cov}(R_i, R_M)}{\\operatorname{Var}(R_M)} = \\frac{(\\Sigma \\mathbf{w}_M)_i}{\\mathbf{w}_M^\\top \\Sigma \\mathbf{w}_M}\\quad (\\mathbf{1}^\\top \\mathbf{w}_M = 1,\\; \\sigma_M^2 = \\mathbf{w}_M^\\top \\Sigma \\mathbf{w}_M > 0))",
      "aliases_latex": [
        "\\beta_i = \\frac{\\sigma_{iM}}{\\sigma_M^2}"
      ],
      "keywords": [
        "市場均衡",
        "市場ポートフォリオ",
        "ベータ",
        "系統的リスク"
      ],
      "domain_tags": [
        "finance",
        "asset_pricing"
      ]
    },
    {
      "id": "fin.capm.n08_capm_sml_theorem",
      "short_code": "CAPM08",
      "kind": "theorem_formula",
      "title": "資本資産価格モデル（CAPM）と証券市場線（SML）",
      "summary": "市場ポートフォリオが接点ポートフォリオに一致する均衡条件から、個別資産の期待超過収益率が市場リスクプレミアムとベータの積に比例するCAPM基本公式（証券市場線）を導出する。",
      "canonical_latex": "\\mathbb{E}[R_i] = R_f + \\beta_i\\big(\\mathbb{E}[R_M] - R_f\\big),\\qquad \\beta_i = \\frac{\\operatorname{Cov}(R_i, R_M)}{\\sigma_M^2}\\quad (i = 1,\\dots,N))",
      "aliases_latex": [
        "\\mu_i - R_f = \\beta_i(\\mu_M - R_f)"
      ],
      "keywords": [
        "CAPM",
        "資本資産価格モデル",
        "証券市場線",
        "SML",
        "リスクプレミアム"
      ],
      "domain_tags": [
        "finance",
        "asset_pricing"
      ]
    }
  ],
