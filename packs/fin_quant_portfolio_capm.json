{
  "pack_meta": {
    "pack_id": "fin.quant.portfolio_capm",
    "schema_version": "1.0.0",
    "pack_version": "0.1.0",
    "domain": "finance",
    "title": "金融工学2：マーコウィッツの平均・分散ポートフォリオ最適化、シャープレシオとCAPM",
    "language": "ja",
    "description": "ラグランジュ未定乗数法による分散最小化から効率的フロンティア、接点ポートフォリオ、資本市場線（CML）および資本資産価格モデル（CAPM: E[Ri]=Rf+βi(E[Rm]-Rf)）を導出する。"
  },
  "nodes": [
    {
      "id": "fin.capm.n01_portfolio_mean_variance_def",
      "short_code": "CAPM01",
      "kind": "definition",
      "title": "リスク資産ポートフォリオの期待リターンと分散の定義",
      "summary": "N個のリスク資産のウェイトベクトル、期待リターンベクトル、および正定値共分散行列を用いてポートフォリオの期待リターンと分散を定義する。",
      "canonical_latex": "\\mu_p := \\mathbb{E}[R_p] = \\mathbf{w}^\\top \\boldsymbol{\\mu},\\quad \\sigma_p^2 := \\operatorname{Var}(R_p) = \\mathbf{w}^\\top \\Sigma \\mathbf{w},\\quad \\mathbf{w}^\\top \\mathbf{1} = 1\\;(\\Sigma \\succ 0)",
      "aliases_latex": [
        "\\mathbb{E}[R_p] = \\sum_{i=1}^{N} w_i \\mu_i,\\quad \\operatorname{Var}(R_p) = \\sum_{i=1}^{N}\\sum_{j=1}^{N} w_i w_j \\sigma_{ij}"
      ],
      "keywords": [
        "ポートフォリオ",
        "期待リターン",
        "分散",
        "共分散行列",
        "マーコウィッツ"
      ],
