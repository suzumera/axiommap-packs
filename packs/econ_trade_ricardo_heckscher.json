    "language": "ja",
    "description": "労働生産性差と機会費用からの比較優位、2財2要素モデルの要素賦存比率、ヘクシャー＝オリーン定理と要素価格均等化を導出する。"
  },
  "nodes": [
    {
      "id": "econ.trd.n01_ricardo_ppf_opportunity_cost",
      "short_code": "TRD01",
      "kind": "definition",
      "title": "リカードモデルの生産可能性フロンティアと機会費用",
      "summary": "労働のみを生産要素とする2財経済において、単位労働投入量と総労働賦存量から生産可能性フロンティア（PPF）および財の機会費用を定義する。",
      "canonical_latex": "a_{LX} Q_X + a_{LY} Q_Y \\le L,\\qquad \\mathrm{MRT}_{X,Y} = \\frac{a_{LX}}{a_{LY}}",
      "aliases_latex": [
        "Q_Y \\le \\frac{L}{a_{LY}} - \\frac{a_{LX}}{a_{LY}} Q_X",
        "c_X = a_{LX} w,\\; c_Y = a_{LY} w"
      ],
      "keywords": [
        "リカードモデル",
        "生産可能性フロンティア",
        "機会費用",
        "単位労働投入量"
      ],
      "domain_tags": [
        "economics",
        "international_trade"
      ]
    },
    {
      "id": "econ.trd.n02_comparative_advantage_trade_gain",
      "short_code": "TRD02",
      "kind": "theorem_formula",
      "title": "比較優位の原理と国際貿易による特化・利益",
      "summary": "2国間の機会費用の差から比較優位財が定まり、国際相対価格が両国の閉鎖経済価格の間に収まることで完全特化と貿易の利益が生じることを示す。",
      "canonical_latex": "\\frac{a_{LX}}{a_{LY}} < \\frac{a_{LX}^*}{a_{LY}^*} \\implies \\frac{a_{LX}}{a_{LY}} \\le \\frac{p_X}{p_Y} \\le \\frac{a_{LX}^*}{a_{LY}^*},\\quad \\frac{w}{w^*} \\in \\left[\\frac{a_{LY}^*}{a_{LY}}, \\frac{a_{LX}^*}{a_{LX}}\\right]",
      "aliases_latex": [
        "\\frac{p_X}{p_Y} > \\frac{a_{LX}}{a_{LY}} \\implies Q_X = \\frac{L}{a_{LX}},\\; Q_Y = 0"
      ],
      "keywords": [
        "比較優位",
        "完全特化",
        "貿易の利益",
        "国際相対価格"
      ],
      "domain_tags": [
        "economics",
        "international_trade"
      ]
    },
    {
      "id": "econ.trd.n03_ho_2x2_zero_profit_factor_market",
      "short_code": "TRD03",
      "kind": "definition",
      "title": "2財2要素モデル（ヘクシャー＝オリーン）の競争均衡条件",
      "summary": "労働と資本の2要素・規模に関して収穫一定の2財経済において、単位費用関数を用いたゼロ利潤条件と要素市場の完全雇用均衡を定式化する。",
      "canonical_latex": "p_i = c_i(w, r) = a_{Li}(w, r)w + a_{Ki}(w, r)r\\;(i=1,2),\\quad a_{L1}Q_1 + a_{L2}Q_2 = L,\\quad a_{K1}Q_1 + a_{K2}Q_2 = K",
      "aliases_latex": [
        "c_i(w, r) = \\min_{a_{Li}, a_{Ki}} \\{w a_{Li} + r a_{Ki} \\mid F_i(a_{Ki}, a_{Li}) \\ge 1\\}"
      ],
      "keywords": [
        "ヘクシャー＝オリーンモデル",
        "ゼロ利潤条件",
        "要素市場均衡",
        "単位投入係数"
      ],
      "domain_tags": [
        "economics",
        "international_trade"
      ]
    },
    {
      "id": "econ.trd.n04_jones_hat_algebra",
      "short_code": "TRD04",
      "kind": "theorem_formula",
      "title": "ジョーンズの変化率方程式（ハット代数）",
      "summary": "2財2要素モデルのゼロ利潤条件と要素市場均衡を対数微分し、費用分配シェアと要素配分シェアを用いた変化率の線形方程式系を導出する。",
      "canonical_latex": "\\hat{p}_i = \\theta_{Li}\\hat{w} + \\theta_{Ki}\\hat{r}\\;(i=1,2),\\qquad \\hat{L} = \\lambda_{L1}\\hat{Q}_1 + \\lambda_{L2}\\hat{Q}_2 + \\lambda_{L1}\\hat{a}_{L1} + \\lambda_{L2}\\hat{a}_{L2},\\quad \\hat{K} = \\lambda_{K1}\\hat{Q}_1 + \\lambda_{K2}\\hat{Q}_2 + \\lambda_{K1}\\hat{a}_{K1} + \\lambda_{K2}\\hat{a}_{K2}",
      "aliases_latex": [
        "\\hat{x} := \\frac{dx}{x},\\; \\theta_{Li} := \\frac{w a_{Li}}{p_i},\\; \\lambda_{Li} := \\frac{a_{Li} Q_i}{L}"
      ],
      "keywords": [
        "ジョーンズ方程式",
        "ハット代数",
        "費用分配シェア",
        "要素配分シェア"
      ],
      "domain_tags": [
        "economics",
        "international_trade"
      ]
    },
    {
      "id": "econ.trd.n05_stolper_samuelson_theorem",
      "short_code": "TRD05",
      "kind": "theorem_formula",
      "title": "ストルパー＝サミュエルソンの定理と拡大効果",
      "summary": "ある財の相対価格が上昇すると、その財に集約的に用いられる要素の実質報酬が財価格の上昇率以上に上昇し、他方の要素の実質報酬が低下することを示す。",
      "canonical_latex": "\\theta_{L1} > \\theta_{L2} \\land \\hat{p}_1 > \\hat{p}_2 \\implies \\hat{w} > \\hat{p}_1 > \\hat{p}_2 > \\hat{r},\\qquad \\hat{w} - \\hat{r} = \\frac{\\hat{p}_1 - \\hat{p}_2}{|\\theta|}\\;\\big(|\\theta| := \\theta_{L1} - \\theta_{L2} > 0\\big)",
      "aliases_latex": [
        "\\hat{w} = \\frac{\\theta_{K2}\\hat{p}_1 - \\theta_{K1}\\hat{p}_2}{|\\theta|}"
      ],
      "keywords": [
        "ストルパー＝サミュエルソン定理",
        "拡大効果",
        "実質賃金",
        "所得分配"
      ],
      "domain_tags": [
        "economics",
        "international_trade"
      ]
    },
    {
      "id": "econ.trd.n06_rybczynski_theorem",
      "short_code": "TRD06",
      "kind": "theorem_formula",
      "title": "リブチンスキーの定理",
      "summary": "財価格一定の下で一方の要素賦存量が増加すると、その要素を集約的に使用する財の生産量が要素増加率以上に拡大し、他方の財の生産量が縮小することを示す。",
      "canonical_latex": "\\hat{p}_1 = \\hat{p}_2 = 0 \\land \\lambda_{L1} > \\lambda_{K1} \\land \\hat{L} > \\hat{K} \\implies \\hat{Q}_1 > \\hat{L} > \\hat{K} > \\hat{Q}_2,\\qquad \\hat{Q}_1 - \\hat{Q}_2 = \\frac{\\hat{L} - \\hat{K}}{|\\lambda|}\\;\\big(|\\lambda| := \\lambda_{L1} - \\lambda_{K1} > 0\\big)",
      "aliases_latex": [
        "\\hat{p}_i = 0 \\implies \\hat{w} = \\hat{r} = 0 \\implies \\hat{a}_{ij} = 0"
      ],
      "keywords": [
        "リブチンスキーの定理",
        "要素賦存量",
        "生産拡大効果",
        "不完全特化"
      ],
      "domain_tags": [
        "economics",
        "international_trade"
      ]
    },
    {
      "id": "econ.trd.n07_factor_price_equalization",
      "short_code": "TRD07",
      "kind": "theorem_formula",
      "title": "要素価格均等化定理（FPE定理）",
      "summary": "自由貿易により財価格が一致し、同一技術・不完全特化・要素集約度逆転なしが満たされるとき、要素の国際移動がなくとも両国の要素価格が均等化することを示す。",
      "canonical_latex": "p_i = p_i^* = c_i(w, r) = c_i(w^*, r^*)\\;(i=1,2) \\land \\det\\!\\left(\\frac{\\partial c}{\\partial (w,r)}\\right) \\neq 0 \\implies (w, r) = (w^*, r^*)",
      "aliases_latex": [
        "\\frac{w}{r} = \\frac{w^*}{r^*} \\quad \\text{if } (K/L), (K^*/L^*) \\in \\text{diversification cone}"
      ],
      "keywords": [
        "要素価格均等化定理",
        "FPE",
        "多様化コーン",
        "ゼロ利潤条件"
      ],
      "domain_tags": [
        "economics",
        "international_trade"
      ]
    },
    {
      "id": "econ.trd.n08_heckscher_ohlin_theorem",
      "short_code": "TRD08",
      "kind": "theorem_formula",
      "title": "ヘクシャー＝オリーンの定理（要素賦存比率と貿易パターン）",
      "summary": "同一技術・同一相似拡大的選好を持つ2国間で、相対的に労働豊富な国は労働集約財を輸出し資本集約財を輸入することを示す。",
      "canonical_latex": "\\frac{L}{K} > \\frac{L^*}{K^*} \\land \\frac{a_{L1}}{a_{K1}} > \\frac{a_{L2}}{a_{K2}} \\implies \\left(\\frac{p_1}{p_2}\\right)^A < \\left(\\frac{p_1}{p_2}\\right)^{A*} \\implies \\text{Home exports Good 1, imports Good 2}",
      "aliases_latex": [
        "(Q_1 - C_1) > 0,\\; (Q_2 - C_2) < 0\\text{ for } L/K > L^*/K^*"
      ],
      "keywords": [
        "ヘクシャー＝オリーンの定理",
        "要素賦存",
        "要素集約度",
        "貿易パターン"
      ],
      "domain_tags": [
        "economics",
        "international_trade"
      ]
    }
