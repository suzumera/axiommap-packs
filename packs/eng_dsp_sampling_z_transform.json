    "title": "デジタル信号処理1：標本化定理・DTFT・DFT/FFTとZ変換",
    "language": "ja",
    "description": "くし型関数のフーリエ変換からナイキスト＝シャノンの標本化定理、エイリアシング、Z変換と収束領域(ROC)、バタフライ演算(FFT)を導出する。"
  },
  "nodes": [
    {
      "id": "eng.dsp1.n01_dirac_comb_ft",
      "short_code": "DSP01",
      "kind": "theorem_formula",
      "title": "くし型関数（ディラックのくし）とフーリエ変換",
      "summary": "周期 T_s のインパルス列（くし型関数）は複素フーリエ級数展開を経て、周波数領域でも周期 2π/T_s のインパルス列に変換される（ポアソン和公式の基盤）。",
      "canonical_latex": "\\mathrm{III}_{T_s}(t) := \\sum_{n=-\\infty}^{\\infty}\\delta(t-nT_s),\\quad \\mathcal{F}[\\mathrm{III}_{T_s}](\\Omega) = \\frac{2\\pi}{T_s}\\sum_{k=-\\infty}^{\\infty}\\delta\\left(\\Omega - \\frac{2\\pi k}{T_s}\\right) ",
      "aliases_latex": [
        "\\sum_{n=-\\infty}^{\\infty}\\delta(t-nT_s) \\xleftrightarrow{\\mathcal{F}} \\Omega_s\\sum_{k=-\\infty}^{\\infty}\\delta(\\Omega - k\\Omega_s)"
      ],
      "keywords": [
        "くし型関数",
        "ディラックのくし",
        "ポアソン和公式",
        "インパルス列"
      ],
      "domain_tags": [
        "signal_processing",
        "fourier_analysis"
      ]
    },
    {
      "id": "eng.dsp1.n02_impulse_sampling_aliasing",
      "short_code": "DSP02",
      "kind": "theorem_formula",
      "title": "理想標本化信号のスペクトルとエイリアシング（折り返し雑音）",
      "summary": "連続時間信号 x(t) にくし型関数を乗じて標本化すると、周波数領域では元のスペクトル X(Ω) がサンプリング角周波数 Ω_s ごとに周期的に複製・重畳され、帯域が重なる場合にエイリアシングが生じる。",
      "canonical_latex": "x_s(t) := x(t)\\mathrm{III}_{T_s}(t) = \\sum_{n=-\\infty}^{\\infty}x(nT_s)\\delta(t-nT_s),\\quad X_s(\\Omega) = \\frac{1}{T_s}\\sum_{k=-\\infty}^{\\infty}X(\\Omega - k\\Omega_s)\\;\\left(\\Omega_s = \\frac{2\\pi}{T_s}\\right) ",
      "aliases_latex": [
        "X_s(\\Omega) = \\frac{1}{T_s}\\sum_{k=-\\infty}^{\\infty}X\\left(\\Omega - \\frac{2\\pi k}{T_s}\\right)"
      ],
      "keywords": [
        "理想標本化",
        "エイリアシング",
        "折り返し雑音",
        "スペクトル複製"
      ],
      "domain_tags": [
        "signal_processing"
      ]
    },
    {
      "id": "eng.dsp1.n03_nyquist_shannon_sampling",
      "short_code": "DSP03",
      "kind": "theorem_formula",
      "title": "ナイキスト＝シャノンの標本化定理とsinc補間再構成",
      "summary": "最大角周波数 Ω_M に帯域制限された信号は、サンプリング角周波数 Ω_s > 2Ω_M（ナイキスト周波数条件）を満たせば、理想ローパスフィルタによる sinc 関数の畳み込みで原信号を完全に再構成できる。",
      "canonical_latex": "X(\\Omega)=0\\;( |\\Omega|\\ge \\Omega_M ),\\; \\Omega_s > 2\\Omega_M \\implies X(\\Omega) = T_s\\operatorname{rect}\\left(\\frac{\\Omega}{\\Omega_s}\\right)X_s(\\Omega),\\quad x(t) = \\sum_{n=-\\infty}^{\\infty} x(nT_s)\\operatorname{sinc}\\left(\\frac{t - nT_s}{T_s}\\right) ",
      "aliases_latex": [
        "x(t) = \\sum_{n=-\\infty}^{\\infty} x[n]\\frac{\\sin(\\pi(t/T_s - n))}{\\pi(t/T_s - n)}"
      ],
      "keywords": [
        "標本化定理",
        "ナイキスト周波数",
        "シャノン",
        "sinc補間",
        "信号再構成"
      ],
      "domain_tags": [
        "signal_processing"
      ]
    },
    {
      "id": "eng.dsp1.n04_dtft_definition",
      "short_code": "DSP04",
      "kind": "definition",
      "title": "離散時間フーリエ変換（DTFT）と逆DTFTの定義",
      "summary": "標本列 x[n]=x(nT_s) に対し正規化角周波数 ω=ΩT_s を導入することで得られる 2π 周期の連続スペクトル表現と、その逆変換公式。",
      "canonical_latex": "X(e^{j\\omega}) := \\sum_{n=-\\infty}^{\\infty} x[n] e^{-j\\omega n},\\qquad x[n] = \\frac{1}{2\\pi}\\int_{-\\pi}^{\\pi} X(e^{j\\omega}) e^{j\\omega n}\\,d\\omega\\quad (\\omega = \\Omega T_s) ",
      "aliases_latex": [
        "X(\\omega) = \\sum_{n=-\\infty}^{\\infty} x[n]e^{-j\\omega n}"
      ],
      "keywords": [
        "DTFT",
        "離散時間フーリエ変換",
        "正規化角周波数",
        "周期スペクトル"
      ],
      "domain_tags": [
        "signal_processing",
        "fourier_analysis"
      ]
    },
    {
      "id": "eng.dsp1.n05_z_transform_roc",
      "short_code": "DSP05",
      "kind": "definition",
      "title": "両側Z変換と収束領域（ROC）の定義",
      "summary": "DTFT を複素変数 z = r e^{jω} に拡張した離散時間信号のローラン級数表現であり、絶対収束する円環領域（ROC）の指定と対にして定義される。",
      "canonical_latex": "X(z) = \\mathcal{Z}\\{x[n]\\} := \\sum_{n=-\\infty}^{\\infty} x[n] z^{-n},\\qquad \\mathrm{ROC} := \\left\\{z\\in\\mathbb{C} \\;\\middle|\\; \\sum_{n=-\\infty}^{\\infty} |x[n]||z|^{-n} < \\infty\\right\\} = \\{z\\in\\mathbb{C}\\mid R_- < |z| < R_+\\} ",
      "aliases_latex": [
        "X(z) = \\sum_{n=-\\infty}^{\\infty} x[n]z^{-n}",
        "\\mathcal{Z}\\{x[n]\\} = \\sum_{n=-\\infty}^{\\infty} x[n] z^{-n}",
        "X(z) := \\sum_{n=-\\infty}^{\\infty} x[n] z^{-n},\\quad \\mathrm{ROC} = \\left\\{z \\in \\mathbb{C} \\;\\middle|\\; \\sum_{n=-\\infty}^{\\infty} |x[n] z^{-n}| < \\infty\\right\\}"
      ],
      "keywords": [
        "Z変換",
        "収束領域",
        "ROC",
        "ローラン級数",
        "Z-transform",
        "region of convergence",
        "discrete-time signal",
        "Laurent series"
      ],
      "domain_tags": [
        "signal_processing",
        "complex_analysis"
      ]
    },
    {
      "id": "eng.dsp1.n06_z_inverse_residue_convolution",
      "short_code": "DSP06",
      "kind": "theorem_formula",
      "title": "逆Z変換の留数公式とZ領域畳み込み定理",
      "summary": "ROC 内の閉曲線に沿う周回積分とコーシーの留数定理による逆Z変換の明示公式、および離散畳み込みがZ領域での積に変換される性質。",
      "canonical_latex": "x[n] = \\frac{1}{2\\pi j}\\oint_{C} X(z) z^{n-1}\\,dz = \\sum_{z_k\\in\\operatorname{int}(C)}\\operatorname{Res}\\!\\big(X(z)z^{n-1}, z_k\\big),\\qquad \\mathcal{Z}\\{x * h\\}(z) = X(z)H(z) ",
      "aliases_latex": [
        "x[n] = \\frac{1}{2\\pi i}\\oint_C X(z)z^{n-1}dz"
      ],
      "keywords": [
        "逆Z変換",
        "留数定理",
        "伝達関数",
        "畳み込み定理"
      ],
      "domain_tags": [
        "signal_processing",
        "complex_analysis"
      ]
    },
    {
      "id": "eng.dsp1.n07_dft_definition",
      "short_code": "DSP07",
      "kind": "definition",
      "title": "離散フーリエ変換（DFT）と逆DFTの定義",
      "summary": "有限長 N の離散時間信号に対し、DTFT を単位円上の等間隔 N 点 ω_k = 2πk/N で標本化して得られる離散スペクトル変換とその逆変換。",
      "canonical_latex": "X[k] := \\sum_{n=0}^{N-1} x[n] W_N^{kn},\\quad x[n] = \\frac{1}{N}\\sum_{k=0}^{N-1} X[k] W_N^{-kn}\\quad \\left(W_N := e^{-j\\frac{2\\pi}{N}}\\right) ",
      "aliases_latex": [
        "X[k] = \\sum_{n=0}^{N-1} x[n] e^{-j\\frac{2\\pi kn}{N}}"
      ],
      "keywords": [
        "DFT",
        "離散フーリエ変換",
        "回転因子",
        "逆DFT"
      ],
      "domain_tags": [
        "signal_processing",
        "fourier_analysis"
      ]
    },
    {
      "id": "eng.dsp1.n08_fft_cooley_tukey_butterfly",
      "short_code": "DSP08",
      "kind": "theorem_formula",
      "title": "Cooley-Tukey型基数2 FFTとバタフライ演算",
      "summary": "信号長 N=2^M の DFT を偶数番目と奇数番目の長さ N/2 の DFT に再帰分割し、回転因子の対称性を用いてバタフライ演算を行うことで計算量を O(N^2) から O(N log_2 N) へ削減する。",
      "canonical_latex": "X[k] = E[k] + W_N^k O[k],\\quad X\\left[k + \\frac{N}{2}\\right] = E[k] - W_N^k O[k]\\quad \\left(0 \\le k < \\frac{N}{2},\\; T(N) = 2T(N/2) + \\mathcal{O}(N) = \\mathcal{O}(N\\log_2 N)\\right) ",
      "aliases_latex": [
        "X[k+N/2] = E[k] - W_N^k O[k]"
      ],
      "keywords": [
        "FFT",
        "高速フーリエ変換",
        "Cooley-Tukey",
        "バタフライ演算",
        "時間間引き"
      ],
      "domain_tags": [
        "signal_processing",
        "algorithms"
      ]
    }
  ],
