  "nodes": [
    {
      "id": "phys.mech.vib01_damped_oscillator_eom",
      "short_code": "VIB01",
      "kind": "definition",
      "title": "減衰調和振動子の運動方程式と減衰パラメータ",
      "summary": "線形粘性減衰力と線形復元力が働く1自由度振動子の運動方程式を質量で規格化し、固有角振動数・減衰係数・減衰比を定義する。",
      "canonical_latex": "m\\ddot{x} + c\\dot{x} + kx = 0 \\iff \\ddot{x} + 2\\gamma\\dot{x} + \\omega_0^2 x = 0\\quad\\left(\\gamma := \\frac{c}{2m},\\; \\omega_0 := \\sqrt{\\frac{k}{m}},\\; \\zeta := \\frac{\\gamma}{\\omega_0} = \\frac{c}{2\\sqrt{mk}}\\right)\\",
      "aliases_latex": [
        "\\ddot{x} + 2\\zeta\\omega_0\\dot{x} + \\omega_0^2 x = 0"
      ],
      "keywords": [
        "damped oscillator",
        "damping ratio",
        "natural frequency",
        "viscous damping"
      ],
      "domain_tags": [
        "physics",
        "mechanics",
        "oscillation"
      ]
    },
    {
      "id": "phys.mech.vib02_damping_three_regimes",
      "short_code": "VIB02",
      "kind": "theorem_formula",
      "title": "減衰振動の3分類（不足減衰・臨界減衰・過減衰）と一般解",
      "summary": "減衰調和振動子の特性方程式の判別式により、運動を不足減衰・臨界減衰・過減衰の3様式に分類し、各々の実一般解を与える。",
      "canonical_latex": "x(t) = \\begin{cases} e^{-\\gamma t}\\big(C_1\\cos\\omega_d t + C_2\\sin\\omega_d t\\big),\\; \\omega_d = \\sqrt{\\omega_0^2 - \\gamma^2} & (\\zeta < 1:\\; \\text{underdamped}) \\\\ (C_1 + C_2 t)e^{-\\omega_0 t} & (\\zeta = 1:\\; \\text{critically damped}) \\\\ C_1 e^{-(\\gamma - \\beta)t} + C_2 e^{-(\\gamma + \\beta)t},\\; \\beta = \\sqrt{\\gamma^2 - \\omega_0^2} & (\\zeta > 1:\\; \\text{overdamped}) \\end{cases}\\",
      "aliases_latex": [
        "x(t) = A e^{-\\gamma t}\\cos(\\omega_d t + \\phi)\\;(\\gamma < \\omega_0)"
      ],
      "keywords": [
        "underdamped",
        "critically damped",
        "overdamped",
        "characteristic equation"
      ],
      "domain_tags": [
        "physics",
        "mechanics",
        "oscillation"
      ]
    },
    {
      "id": "phys.mech.vib03_forced_oscillator_eom",
      "short_code": "VIB03",
      "kind": "definition",
      "title": "周期的外力による強制減衰振動の運動方程式と複素化",
      "summary": "調和周期外力を受ける減衰振動子の非同次線形運動方程式を定式化し、解析のために対応する複素微分方程式を導入する。",
      "canonical_latex": "\\ddot{x} + 2\\gamma\\dot{x} + \\omega_0^2 x = \\frac{F_0}{m}\\cos(\\omega t),\\qquad \\ddot{z} + 2\\gamma\\dot{z} + \\omega_0^2 z = \\frac{F_0}{m}e^{i\\omega t}\\quad\\big(x(t) = \\operatorname{Re} z(t)\\big)\\",
      "aliases_latex": [
        "m\\ddot{x} + c\\dot{x} + kx = F_0\\cos(\\omega t)"
      ],
      "keywords": [
        "forced oscillation",
        "harmonic excitation",
        "complexification"
      ],
      "domain_tags": [
        "physics",
        "mechanics",
        "oscillation"
      ]
    },
    {
      "id": "phys.mech.vib04_steady_state_amp_phase",
      "short_code": "VIB04",
      "kind": "theorem_formula",
      "title": "強制振動の定常応答（振幅倍率と位相遅れ）",
      "summary": "過渡解が減衰した後の定常特解を求め、駆動角振動数に依存する定常振幅と外力に対する位相遅れを導出する。",
      "canonical_latex": "x_{\\text{st}}(t) = A(\\omega)\\cos\\big(\\omega t - \\delta(\\omega)\\big),\\quad A(\\omega) = \\frac{F_0/m}{\\sqrt{(\\omega_0^2 - \\omega^2)^2 + (2\\gamma\\omega)^2}},\\quad \\tan\\delta(\\omega) = \\frac{2\\gamma\\omega}{\\omega_0^2 - \\omega^2}\\",
      "aliases_latex": [
        "A(\\omega) = \\frac{F_0/k}{\\sqrt{(1 - (\\omega/\\omega_0)^2)^2 + (2\\zeta\\omega/\\omega_0)^2}}"
      ],
      "keywords": [
        "steady-state response",
        "amplitude response",
        "phase lag",
        "frequency response"
      ],
      "domain_tags": [
        "physics",
        "mechanics",
        "oscillation"
      ]
    },
    {
      "id": "phys.mech.vib05_resonance_q_factor",
      "short_code": "VIB05",
      "kind": "theorem_formula",
      "title": "共振周波数・半値幅および Q 値（品質係数）",
      "summary": "振幅が極大となる共振角振動数と Q 値（品質係数）を導出し、弱減衰極限における共振倍率およびエネルギー半値幅との関係を定式化する。",
      "canonical_latex": "\\omega_r = \\sqrt{\\omega_0^2 - 2\\gamma^2}\\;\\Big(\\gamma < \\frac{\\omega_0}{\\sqrt{2}}\\Big),\\quad Q := \\frac{\\omega_0}{2\\gamma} = \\frac{1}{2\\zeta},\\quad \\frac{A(\\omega_0)}{A(0)} = Q,\\quad \\frac{\\omega_0}{\\Delta\\omega_{\\text{FWHM}}} \\approx Q\\;\\big(Q \\gg 1,\\; \\Delta\\omega_{\\text{FWHM}} \\approx 2\\gamma\\big)\\",
      "aliases_latex": [
        "A_{\\max} = A(\\omega_r) = \\frac{F_0/m}{2\\gamma\\sqrt{\\omega_0^2 - \\gamma^2}}"
      ],
      "keywords": [
        "resonance",
        "Q factor",
        "quality factor",
        "bandwidth",
        "FWHM"
      ],
      "domain_tags": [
        "physics",
        "mechanics",
        "oscillation"
      ]
    },
    {
      "id": "phys.mech.vib06_coupled_lagrangian_small_osc",
      "short_code": "VIB06",
      "kind": "definition",
      "title": "多自由度微小振動のラグランジアンと質量行列・剛性行列",
      "summary": "安定平衡点近傍の2次近似により、多自由度系の運動エネルギーとポテンシャルエネルギーを対称正定値な質量行列および剛性行列の2次形式で表す。",
      "canonical_latex": "L(\\mathbf{q},\\dot{\\mathbf{q}}) = \\frac{1}{2}\\dot{\\mathbf{q}}^\\top M\\dot{\\mathbf{q}} - \\frac{1}{2}\\mathbf{q}^\\top K\\mathbf{q},\\quad M_{ij} = \\left.\\frac{\\partial^2 T}{\\partial \\dot{q}_i\\partial \\dot{q}_j}\\right|_{\\mathbf{0}}\\;(M^\\top = M \\succ 0),\\quad K_{ij} = \\frac{\\partial^2 V}{\\partial q_i\\partial q_j}(\\mathbf{0})\\;(K^\\top = K \\succ 0)\\",
      "aliases_latex": [
        "T = \\frac{1}{2}\\sum_{i,j}M_{ij}\\dot{q}_i\\dot{q}_j,\\; V = \\frac{1}{2}\\sum_{i,j}K_{ij}q_i q_j"
      ],
      "keywords": [
        "coupled oscillation",
        "mass matrix",
        "stiffness matrix",
        "small oscillation"
      ],
      "domain_tags": [
        "physics",
        "mechanics",
        "analytical_mechanics"
      ]
    },
    {
      "id": "phys.mech.vib07_coupled_matrix_eom",
      "short_code": "VIB07",
      "kind": "theorem_formula",
      "title": "多自由度連成振動の行列運動方程式",
      "summary": "微小振動のラグランジアンにオイラー＝ラグランジュ方程式を適用し、n自由度連成振動の行列形式運動方程式を導出する。",
      "canonical_latex": "M\\ddot{\\mathbf{q}} + K\\mathbf{q} = \\mathbf{0}\\quad \\left(\\sum_{j=1}^{n} M_{ij}\\ddot{q}_j + \\sum_{j=1}^{n} K_{ij}q_j = 0,\\; i = 1,\\dots,n\\right)\\",
      "aliases_latex": [
        "\\ddot{\\mathbf{q}} + M^{-1}K\\mathbf{q} = \\mathbf{0}"
      ],
      "keywords": [
        "matrix equation of motion",
        "coupled system",
        "Euler-Lagrange"
      ],
      "domain_tags": [
        "physics",
        "mechanics",
        "analytical_mechanics"
      ]
    },
    {
      "id": "phys.mech.vib08_generalized_eigenvalue_modes",
      "short_code": "VIB08",
      "kind": "theorem_formula",
      "title": "基準振動数の一般化固有値問題と基準モードの直交性",
      "summary": "単調和振動の仮設から質量・剛性行列の一般化固有値問題を導き、質量重み付き対称化によって固有振動数の実正値性と基準モードの M-直交・K-直交性を証明する。",
      "canonical_latex": "(K - \\omega_\\alpha^2 M)\\mathbf{u}_\\alpha = \\mathbf{0},\\quad \\det(K - \\omega^2 M) = 0,\\quad \\mathbf{u}_\\alpha^\\top M\\mathbf{u}_\\beta = \\delta_{\\alpha\\beta},\\quad \\mathbf{u}_\\alpha^\\top K\\mathbf{u}_\\beta = \\omega_\\alpha^2 \\delta_{\\alpha\\beta}\\",
      "aliases_latex": [
        "K U = M U \\Omega^2,\\; U^\\top M U = I_n,\\; U^\\top K U = \\Omega^2"
      ],
      "keywords": [
        "generalized eigenvalue problem",
        "normal modes",
        "modal orthogonality",
        "eigenfrequency"
      ],
      "domain_tags": [
        "physics",
        "mechanics",
        "linear_algebra"
      ]
    },
    {
      "id": "phys.mech.vib09_normal_coordinates_decoupling",
      "short_code": "VIB09",
      "kind": "theorem_formula",
      "title": "基準座標変換による運動方程式の非連成化と一般解",
      "summary": "基準モード行列による座標変換（基準座標）を用いて連成運動方程式を n 個の独立な単振動方程式へ分解し、重ね合わせとして一般解を構成する。",
      "canonical_latex": "\\mathbf{q}(t) = U\\boldsymbol{\\eta}(t) = \\sum_{\\alpha=1}^{n} \\eta_\\alpha(t)\\mathbf{u}_\\alpha \\implies \\ddot{\\eta}_\\alpha + \\omega_\\alpha^2 \\eta_\\alpha = 0,\\quad \\mathbf{q}(t) = \\sum_{\\alpha=1}^{n} C_\\alpha \\mathbf{u}_\\alpha \\cos(\\omega_\\alpha t + \\phi_\\alpha)\\",
      "aliases_latex": [
        "\\ddot{\\boldsymbol{\\eta}} + \\Omega^2\\boldsymbol{\\eta} = \\mathbf{0}"
      ],
      "keywords": [
