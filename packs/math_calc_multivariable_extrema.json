  "nodes": [
    {
      "id": "math.calc.e01_hessian_matrix_def",
      "short_code": "E01",
      "kind": "definition",
      "title": "ヘッセ行列と2次形式の定義（シュワルツの対称性）",
      "summary": "多変数スカラー関数の全2階偏導関数を並べたヘッセ行列とそれに対応する2次形式を定義する。C2級関数ではシュワルツの定理によりヘッセ行列は対称行列となる。",
      "canonical_latex": "H_f(\\mathbf{x}) := \\left(\\frac{\\partial^2 f}{\\partial x_i \\partial x_j}(\\mathbf{x})\\right)_{1\\le i,j\\le n},\\quad f \\in C^2 \\implies H_f(\\mathbf{x})^\\top = H_f(\\mathbf{x}),\\quad Q(\\mathbf{h}) = \\mathbf{h}^\\top H_f(\\mathbf{x})\\mathbf{h}",
      "aliases_latex": [
        "\\nabla^2 f(\\mathbf{x}) = \\left[\\frac{\\partial^2 f}{\\partial x_i \\partial x_j}(\\mathbf{x})\\right]"
      ],
      "keywords": [
        "ヘッセ行列",
        "2階偏導関数",
        "シュワルツの定理",
        "対称行列",
        "2次形式"
      ],
      "domain_tags": [
        "mathematics",
        "calculus"
      ],
      "intuition_oneliner": "多変数関数の「曲がり具合（曲率）」を、あらゆる方向の組み合わせで一覧表にした行列です。滑らかな関数なら表は対称になり、2次形式を使うと特定の方向にどれだけ曲がっているかを調べられます。",
      "diagram_svg": "<svg viewBox=\"0 0 600 260\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M 80 180 Q 170 60 260 180\" fill=\"none\" stroke=\"#3b82f6\" stroke-width=\"3\"/><path d=\"M 110 150 Q 170 210 230 150\" fill=\"none\" stroke=\"#f97316\" stroke-width=\"3\"/><circle cx=\"170\" cy=\"120\" r=\"5\" fill=\"#10b981\"/><text x=\"170\" y=\"225\" fill=\"currentColor\" font-size=\"14\" text-anchor=\"middle\">方向ごとの曲がり具合</text><line x1=\"295\" y1=\"130\" x2=\"345\" y2=\"130\" stroke=\"currentColor\" stroke-width=\"2\"/><polygon points=\"345,125 355,130 345,135\" fill=\"currentColor\"/><rect x=\"380\" y=\"65\" width=\"150\" height=\"130\" rx=\"8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><text x=\"455\" y=\"105\" fill=\"#3b82f6\" font-size=\"16\" text-anchor=\"middle\">f_xx   f_xy</text><text x=\"455\" y=\"155\" fill=\"#f97316\" font-size=\"16\" text-anchor=\"middle\">f_yx   f_yy</text><line x1=\"395\" y1=\"175\" x2=\"515\" y2=\"85\" stroke=\"#10b981\" stroke-width=\"1.5\" stroke-dasharray=\"4,4\"/><text x=\"455\" y=\"225\" fill=\"currentColor\" font-size=\"14\" text-anchor=\"middle\">対称行列 (f_xy = f_yx)</text></svg>"
    },
    {
      "id": "math.calc.e02_multivariable_taylor_2nd",
      "short_code": "E02",
      "kind": "theorem_formula",
      "title": "多変数関数の2次テイラー展開（ラグランジュ・ペアノ剰余項）",
      "summary": "C2級多変数スカラー関数を点aの近傍で勾配ベクトルとヘッセ行列を用いて2次まで展開する定理。",
      "canonical_latex": "f(\\mathbf{a}+\\mathbf{h}) = f(\\mathbf{a}) + \\nabla f(\\mathbf{a})\\cdot\\mathbf{h} + \\frac{1}{2}\\mathbf{h}^\\top H_f(\\mathbf{a}+\\theta\\mathbf{h})\\mathbf{h} = f(\\mathbf{a}) + \\nabla f(\\mathbf{a})\\cdot\\mathbf{h} + \\frac{1}{2}\\mathbf{h}^\\top H_f(\\mathbf{a})\\mathbf{h} + o(\\|\\mathbf{h}\\|^2)\\quad (0<\\theta<1)",
      "aliases_latex": [
        "f(\\mathbf{x}) = f(\\mathbf{a}) + \\nabla f(\\mathbf{a})^\\top (\\mathbf{x}-\\mathbf{a}) + \\frac{1}{2}(\\mathbf{x}-\\mathbf{a})^\\top H_f(\\mathbf{a})(\\mathbf{x}-\\mathbf{a}) + o(\\|\\mathbf{x}-\\mathbf{a}\\|^2)"
      ],
      "keywords": [
        "多変数テイラー展開",
        "2次近似",
        "勾配",
        "ヘッセ行列",
        "ペアノ剰余項"
      ],
      "domain_tags": [
        "mathematics",
        "calculus"
      ]
    },
    {
      "id": "math.calc.e03_stationary_point_condition",
      "short_code": "E03",
      "kind": "theorem_formula",
      "title": "多変数関数の極値の1階必要条件（停留点条件）",
      "summary": "開集合上の微分可能な多変数関数が内点aで極大または極小をとるならば、点aにおける全偏微分係数が零となり勾配ベクトルが零ベクトルになる。",
      "canonical_latex": "\\mathbf{a} \\in \\operatorname{int}(D)\\text{ is a local extremum of } f \\implies \\nabla f(\\mathbf{a}) = \\mathbf{0}\\;\\left(\\frac{\\partial f}{\\partial x_i}(\\mathbf{a}) = 0,\\; \\forall i=1,\\dots,n\\right)",
      "aliases_latex": [
        "df_{\\mathbf{a}} = 0 \\iff \\nabla f(\\mathbf{a}) = \\mathbf{0}"
      ],
      "keywords": [
        "停留点",
        "臨界点",
        "1階必要条件",
        "極値",
        "フェルマーの定理"
      ],
      "domain_tags": [
        "mathematics",
        "calculus"
      ],
      "intuition_oneliner": "山の頂上や谷の底では、どの方向に進もうとしても一瞬だけ地面が平ら（傾きがゼロ）になります。多変数関数の極値も、すべての方向の傾き（勾配）がゼロになる点に現れます。",
      "diagram_svg": "<svg viewBox='0 0 600 260' xmlns='http://www.w3.org/2000/svg'><path d='M 80 210 Q 300 -10 520 210' fill='#3b82f6' fill-opacity='0.15' stroke='#3b82f6' stroke-width='4'/><line x1='190' y1='100' x2='410' y2='100' stroke='#f97316' stroke-width='3'/><circle cx='300' cy='100' r='7' fill='#f97316'/><line x1='300' y1='100' x2='300' y2='220' stroke='currentColor' stroke-width='1.5' stroke-dasharray='5,5'/><text x='300' y='242' fill='currentColor' font-size='18' text-anchor='middle' font-weight='bold'>点 a (極大)</text><text x='300' y='75' fill='#f97316' font-size='18' text-anchor='middle' font-weight='bold'>どの方向も平ら: ∇f(a) = 0</text></svg>"
    },
    {
      "id": "math.calc.e04_quadratic_form_definiteness",
      "short_code": "E04",
      "kind": "math_boundary",
      "title": "実対称行列の定値性とシルベスターの判定条件",
      "summary": "実対称行列Aに対応する2次形式の正定値・負定値・不定値性を、全固有値の符号および主小行列式（シルベスターの判定法）によって特徴づける線形代数の境界知識。",
      "canonical_latex": "A \\succ 0 \\iff \\forall \\mathbf{h}\\neq\\mathbf{0},\\; \\mathbf{h}^\\top A\\mathbf{h} > 0 \\iff \\forall i,\\; \\lambda_i(A) > 0 \\iff \\forall k=1,\\dots,n,\\; \\Delta_k(A) > 0",
      "aliases_latex": [
        "A \\prec 0 \\iff (-1)^k \\Delta_k(A) > 0\\ (k=1,\\dots,n)"
      ],
      "keywords": [
        "正定値行列",
        "負定値行列",
        "不定値",
        "シルベスターの判定法",
        "固有値"
      ],
      "domain_tags": [
        "mathematics",
        "linear_algebra"
      ]
    },
    {
      "id": "math.calc.e05_hessian_extremum_test",
      "short_code": "E05",
      "kind": "theorem_formula",
      "title": "ヘッセ行列による2階極値判定法（極小・極大・鞍点）",
      "summary": "停留点におけるヘッセ行列が正定値なら狭義極小、負定値なら狭義極大、不定値なら鞍点（極値でない）となる2階判定条件。",
      "canonical_latex": "\\nabla f(\\mathbf{a}) = \\mathbf{0} \\implies \\begin{cases} H_f(\\mathbf{a}) \\succ 0 \\implies \\text{strict local minimum}, \\\\ H_f(\\mathbf{a}) \\prec 0 \\implies \\text{strict local maximum}, \\\\ H_f(\\mathbf{a}) \\text{ indefinite} \\implies \\text{saddle point} \\end{cases}",
      "aliases_latex": [
        "\\mathbf{h}^\\top H_f(\\mathbf{a})\\mathbf{h} > 0\\ (\\mathbf{h}\\neq\\mathbf{0}) \\implies f(\\mathbf{a}+\\mathbf{h}) > f(\\mathbf{a})"
      ],
      "keywords": [
        "極値判定",
        "ヘッセ行列",
        "2階十分条件",
        "鞍点",
        "正定値"
      ],
      "domain_tags": [
        "mathematics",
        "calculus",
        "optimization"
      ]
    },
    {
      "id": "math.calc.e06_constrained_extremum_problem",
      "short_code": "E06",
      "kind": "definition",
      "title": "等式制約付き最適化問題と正則点（制約想定）の定義",
      "summary": "m本の等式制約g(x)=0の下で目的関数f(x)の極値を求める問題と、制約勾配ベクトルが線形独立となる正則条件（LICQ）を定義する。",
      "canonical_latex": "\\min/\\max_{\\mathbf{x}\\in\\mathbb{R}^n} f(\\mathbf{x})\\;\\text{ s.t. }\\mathbf{g}(\\mathbf{x}) = (g_1(\\mathbf{x}),\\dots,g_m(\\mathbf{x}))^\\top = \\mathbf{0},\\quad \\operatorname{rank}\\!\\left(D\\mathbf{g}(\\mathbf{a})\\right) = m\\;(m < n)",
      "aliases_latex": [
        "\\{\\nabla g_1(\\mathbf{a}),\\dots,\\nabla g_m(\\mathbf{a})\\}\\text{ linearly independent}"
      ],
      "keywords": [
        "制約付き最適化",
        "等式制約",
        "正則点",
        "制約想定",
        "ヤコビ行列"
      ],
      "domain_tags": [
        "mathematics",
        "optimization"
      ]
    },
    {
      "id": "math.calc.e07_lagrange_multiplier_theorem",
      "short_code": "E07",
      "kind": "theorem_formula",
      "title": "ラグランジュの未定乗数法（1階必要条件）",
      "summary": "正則な等式制約g(x)=0の下でfが点aにおいて局所極値をとるならば、ラグランジュ関数L(x,λ)の勾配が零となる未定乗数λが存在する。",
      "canonical_latex": "\\mathcal{L}(\\mathbf{x},\\boldsymbol{\\lambda}) := f(\\mathbf{x}) + \\sum_{j=1}^{m}\\lambda_j g_j(\\mathbf{x}),\\quad \\nabla_{\\mathbf{x}}\\mathcal{L}(\\mathbf{a},\\boldsymbol{\\lambda}) = \\nabla f(\\mathbf{a}) + \\sum_{j=1}^{m}\\lambda_j \\nabla g_j(\\mathbf{a}) = \\mathbf{0},\\quad \\nabla_{\\boldsymbol{\\lambda}}\\mathcal{L}(\\mathbf{a},\\boldsymbol{\\lambda}) = \\mathbf{g}(\\mathbf{a}) = \\mathbf{0}",
      "aliases_latex": [
        "\\nabla f(\\mathbf{a}) = -\\sum_{j=1}^{m}\\lambda_j \\nabla g_j(\\mathbf{a})",
        "\\nabla f(\\mathbf{a}) = \\sum_{j=1}^{m}\\mu_j \\nabla g_j(\\mathbf{a})"
      ],
      "keywords": [
        "ラグランジュの未定乗数法",
        "ラグランジアン",
        "未定乗数",
        "制約付き極値",
        "1階必要条件"
      ],
      "domain_tags": [
        "mathematics",
        "calculus",
        "optimization"
      ]
    },
    {
      "id": "math.calc.e08_constrained_hessian_2nd_order",
      "short_code": "E08",
      "kind": "theorem_formula",
      "title": "制約付き極値の2階十分条件（接空間上のラグランジアン・ヘッセ行列）",
      "summary": "ラグランジュの未定乗数条件を満たす点において、制約多様体の接空間T = ker(Dg(a))に制限したラグランジアンのヘッセ行列が正定値（負定値）であれば、制約付き狭義極小（極大）となる。",
      "canonical_latex": "\\nabla_{\\mathbf{x}}\\mathcal{L}(\\mathbf{a},\\boldsymbol{\\lambda})=\\mathbf{0} \\land \\forall \\mathbf{h}\\in\\ker(D\\mathbf{g}(\\mathbf{a}))\\setminus\\{\\mathbf{0}\\},\\; \\mathbf{h}^\\top \\nabla_{\\mathbf{x}\\mathbf{x}}^2\\mathcal{L}(\\mathbf{a},\\boldsymbol{\\lambda})\\mathbf{h} > 0 \\implies \\mathbf{a}\\text{ is a strict constrained local minimum}",
      "aliases_latex": [
        "D\\mathbf{g}(\\mathbf{a})\\mathbf{h} = \\mathbf{0}\\ (\\mathbf{h}\\neq\\mathbf{0}) \\implies \\mathbf{h}^\\top H_{\\mathbf{x}}\\mathcal{L}(\\mathbf{a},\\boldsymbol{\\lambda})\\mathbf{h} > 0"
      ],
      "keywords": [
        "制約付き2階十分条件",
        "接空間",
        "縁付きヘッセ行列",
        "ラグランジアン",
        "極値判定"
      ],
      "domain_tags": [
        "mathematics",
        "calculus",
        "optimization"
      ]
    }
