  "nodes": [
    {
      "id": "phys.statmech.qs01_grand_canonical_distribution",
      "short_code": "QS01",
      "kind": "theorem_formula",
      "title": "グランドカノニカル分布（大正準分布）と大分配関数",
      "summary": "熱浴および粒子浴と接する開放平衡系において、粒子数 N と微視的状態 r の出現確率および大分配関数（大状態和）を定める基本分布則。",
      "canonical_latex": "P_{N,r} = \\frac{e^{-\\beta(E_{N,r} - \\mu N)}}{\\Xi},\\qquad \\Xi(T,V,\\mu) := \\sum_{N=0}^{\\infty}\\sum_{r} e^{-\\beta(E_{N,r} - \\mu N)} = \\sum_{N=0}^{\\infty} z^N Z(T,V,N)\\quad \\left(z := e^{\\beta\\mu},\\; \\beta = \\frac{1}{k_{\\mathrm{B}}T}\\right)",
      "aliases_latex": [
        "P_{N,r} = \\frac{z^N e^{-\\beta E_{N,r}}}{\\Xi(T,V,\\mu)}"
      ],
      "keywords": [
        "グランドカノニカル分布",
        "大正準集団",
        "大分配関数",
        "化学ポテンシャル",
        "フガシティ"
      ],
      "domain_tags": [
        "physics",
        "statistical_mechanics"
      ]
    },
    {
