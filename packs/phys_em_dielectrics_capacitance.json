        "electromagnetism",
        "conductors"
      ]
    },
    {
      "id": "phys.em.dc02_method_of_images_plane",
      "short_code": "DIEL02",
      "kind": "theorem_formula",
      "title": "鏡像法（接地無限導体平面と点電荷）",
      "summary": "接地された無限平面導体 z=0 の上方 z=d に点電荷 q を置いたとき、反対側の鏡像位置 z=-d に仮想電荷 -q を配置することで z>=0 のポアソン方程式と境界条件 φ(x,y,0)=0 を満たす一意解を構成でき、表面誘導電荷密度と静電引力が導かれる。",
      "canonical_latex": "\\phi(\\mathbf{r}) = \\frac{q}{4\\pi\\varepsilon_0}\\left(\\frac{1}{\\sqrt{\\rho^2 + (z-d)^2}} - \\frac{1}{\\sqrt{\\rho^2 + (z+d)^2}}\\right)\\;(z\\ge 0),\\quad \\sigma(\\rho) = -\\frac{qd}{2\\pi(\\rho^2 + d^2)^{3/2}},\\quad F_z = -\\frac{q^2}{16\\pi\\varepsilon_0 d^2}",
      "aliases_latex": [
        "\\sigma(\\rho) = -\\frac{qd}{2\\pi(\\rho^2+d^2)^{3/2}}"
      ],
      "keywords": [
        "鏡像法",
        "接地導体平面",
        "誘導電荷",
        "静電引力"
      ],
      "domain_tags": [
        "physics",
        "electromagnetism",
        "conductors"
      ]
    },
    {
      "id": "phys.em.dc03_capacitance_energy",
      "short_code": "DIEL03",
      "kind": "definition",
      "title": "静電容量（キャパシタンス）とコンデンサの静電エネルギー",
      "summary": "導体間の電位差が蓄積電荷量に比例する線形性から静電容量 C = Q/V を定義し、充電仕事または静電エネルギーの公式から U_e = (1/2)QV = (1/2)CV^2 = Q^2/(2C) を得る。平行平板コンデンサでは C = ε0 S/d となる。",
      "canonical_latex": "C := \\frac{Q}{V},\\qquad U_e = \\frac{1}{2}QV = \\frac{1}{2}CV^2 = \\frac{Q^2}{2C},\\qquad C_{\\mathrm{parallel}} = \\frac{\\varepsilon_0 S}{d}",
      "aliases_latex": [
        "Q = CV,\\; U = \\frac{1}{2}CV^2"
      ],
      "keywords": [
        "静電容量",
        "キャパシタンス",
        "コンデンサ",
        "静電エネルギー"
      ],
      "domain_tags": [
        "physics",
        "electromagnetism",
        "capacitance"
      ]
    },
    {
      "id": "phys.em.dc04_electric_dipole_potential_field",
      "short_code": "DIEL04",
      "kind": "theorem_formula",
      "title": "電気双極子モーメントと双極子ポテンシャル・電場",
      "summary": "総電荷が零の局在電荷分布または正負の対電荷に対し電気双極子モーメント p を定義し、遠方展開（|r'| << r）の1次項として双極子ポテンシャルと双極子電場を導出する。",
      "canonical_latex": "\\mathbf{p} := \\iiint_V \\mathbf{r}'\\rho(\\mathbf{r}')\\,dV'\\;\\big(= q\\mathbf{d}\\big),\\quad \\phi_{\\mathrm{dip}}(\\mathbf{r}) = \\frac{\\mathbf{p}\\cdot\\hat{\\mathbf{r}}}{4\\pi\\varepsilon_0 r^2},\\quad \\mathbf{E}_{\\mathrm{dip}}(\\mathbf{r}) = \\frac{1}{4\\pi\\varepsilon_0 r^3}\\big[3(\\mathbf{p}\\cdot\\hat{\\mathbf{r}})\\hat{\\mathbf{r}} - \\mathbf{p}\\big]",
      "aliases_latex": [
        "\\mathbf{p} = q\\mathbf{d},\\; \\phi_{\\mathrm{dip}} = \\frac{\\mathbf{p}\\cdot\\mathbf{r}}{4\\pi\\varepsilon_0 r^3}"
      ],
      "keywords": [
        "電気双極子",
        "双極子モーメント",
        "多重極展開",
        "双極子電場"
      ],
      "domain_tags": [
        "physics",
        "electromagnetism",
        "dielectrics"
      ]
    },
    {
      "id": "phys.em.dc05_polarization_bound_charges",
      "short_code": "DIEL05",
      "kind": "theorem_formula",
      "title": "分極ベクトル P と束縛電荷密度（体積・表面束縛電荷）",
      "summary": "誘電体中の単位体積あたり電気双極子モーメントとして分極ベクトル P を導入し、双極子ポテンシャルの体積積分を部分積分（発散の積法則とガウスの発散定理）で変形することで、体積束縛電荷密度 ρb = -∇·P および表面束縛電荷密度 σb = P·n を導出する。",
      "canonical_latex": "\\mathbf{P}(\\mathbf{r}) := \\frac{d\\mathbf{p}}{dV},\\qquad \\rho_b(\\mathbf{r}) = -\\nabla\\cdot\\mathbf{P}(\\mathbf{r}),\\qquad \\sigma_b(\\mathbf{r}) = \\mathbf{P}(\\mathbf{r})\\cdot\\mathbf{n}",
      "aliases_latex": [
        "\\rho_b = -\\operatorname{div}\\mathbf{P},\\; \\sigma_b = \\mathbf{P}\\cdot\\mathbf{n}"
      ],
      "keywords": [
        "分極ベクトル",
        "束縛電荷",
        "誘電体",
        "分極電荷"
      ],
      "domain_tags": [
        "physics",
        "electromagnetism",
        "dielectrics"
      ],
      "intuition_oneliner": "要するに、誘電体内部が分極したとき、そのミクロな双極子のズレをマクロな「束縛電荷（体積と表面）」の密度に置き換えて表す法則です。",
      "diagram_svg": "<svg viewBox=\"0 0 600 260\" xmlns=\"http://www.w3.org/2000/svg\"><rect width=\"600\" height=\"260\" fill=\"none\"/><text x=\"50\" y=\"40\" fill=\"currentColor\" font-size=\"16\" font-weight=\"bold\">分極ベクトル P と束縛電荷</text><rect x=\"100\" y=\"70\" width=\"200\" height=\"120\" fill=\"none\" stroke=\"#3b82f6\" stroke-width=\"2\" stroke-dasharray=\"5,5\"/><text x=\"130\" y=\"135\" fill=\"#3b82f6\" font-size=\"16\">分極 P の流れ</text><text x=\"350\" y=\"100\" fill=\"#f97316\" font-size=\"16\">体積: ρ_b = -∇·P</text><text x=\"350\" y=\"150\" fill=\"#10b981\" font-size=\"16\">表面: σ_b = P·n</text></svg>"
    },
    {
      "id": "phys.em.dc06_electric_displacement_gauss_law",
      "short_code": "DIEL06",
      "kind": "theorem_formula",
      "title": "電束密度 D の定義と誘電体中のガウスの法則",
      "summary": "全電荷密度を自由電荷密度 ρf と束縛電荷密度 ρb = -∇·P に分解して真空中のガウスの法則に代入し、電束密度 D := ε0 E + P を定義することで、自由電荷のみを源とする微分形 ∇·D = ρf および積分形ガウスの法則を得る。",
      "canonical_latex": "\\mathbf{D}(\\mathbf{r}) := \\varepsilon_0 \\mathbf{E}(\\mathbf{r}) + \\mathbf{P}(\\mathbf{r}),\\qquad \\nabla\\cdot\\mathbf{D}(\\mathbf{r}) = \\rho_f(\\mathbf{r}),\\qquad \\oiint_{\\partial V} \\mathbf{D}\\cdot\\mathbf{n}\\,dS = Q_{f,\\mathrm{enc}}",
      "aliases_latex": [
        "\\operatorname{div}\\mathbf{D} = \\rho_f"
      ],
      "keywords": [
        "電束密度",
        "誘電体中のガウスの法則",
        "自由電荷",
        "真電荷"
      ],
      "domain_tags": [
        "physics",
        "electromagnetism",
        "dielectrics"
      ],
      "intuition_oneliner": "物質中の分極（束縛電荷）の影響を電束密度 D にまとめることで、私たちが制御しやすい「自由電荷」だけを見てガウスの法則を使えるようにする便利な書き換えです。",
      "diagram_svg": "<svg viewBox='0 0 600 260' xmlns='http://www.w3.org/2000/svg'><rect x='140' y='50' width='320' height='160' rx='12' fill='none' stroke='currentColor' stroke-width='2' stroke-dasharray='6 4'/><circle cx='240' cy='130' r='18' fill='#f97316' opacity='0.2' stroke='#f97316' stroke-width='2'/><text x='240' y='136' text-anchor='middle' font-size='18' font-weight='bold' fill='#f97316'>+ρf</text><line x1='270' y1='130' x2='390' y2='130' stroke='#3b82f6' stroke-width='4'/><polygon points='390,123 405,130 390,137' fill='#3b82f6'/><text x='335' y='115' text-anchor='middle' font-size='16' font-weight='bold' fill='#3b82f6'>D = ε₀E + P</text><text x='300' y='35' text-anchor='middle' font-size='14' fill='currentColor'>ガウス面 ∂V（内部の自由電荷 Qf のみをカウント）</text><text x='300' y='235' text-anchor='middle' font-size='15' font-weight='bold' fill='currentColor'>∇·D = ρf （分極 P は D に吸収）</text></svg>"
    },
    {
      "id": "phys.em.dc07_linear_dielectric_permittivity",
      "short_code": "DIEL07",
      "kind": "definition",
      "title": "線形等方誘電体の構成関係と誘電率・比誘電率",
      "summary": "線形等方誘電体では分極ベクトルが電場に比例する構成則 P = ε0 χe E が成り立ち、D = ε E（誘電率 ε = ε0(1+χe) = ε0 εr）が得られる。これにより誘電体を充填したコンデンサの静電容量は比誘電率 εr 倍となる。",
      "canonical_latex": "\\mathbf{P} = \\varepsilon_0 \\chi_e \\mathbf{E},\\qquad \\mathbf{D} = \\varepsilon\\mathbf{E},\\qquad \\varepsilon = \\varepsilon_0(1 + \\chi_e) = \\varepsilon_0\\varepsilon_r,\\qquad C = \\varepsilon_r C_0",
      "aliases_latex": [
        "\\mathbf{D} = \\varepsilon_0\\varepsilon_r\\mathbf{E}"
      ],
      "keywords": [
        "線形誘電体",
        "電気感受率",
        "誘電率",
        "比誘電率"
      ],
      "domain_tags": [
