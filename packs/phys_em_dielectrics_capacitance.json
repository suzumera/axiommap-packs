        "electromagnetism",
        "dielectrics"
      ]
    },
    {
      "id": "phys.em.dc08_dielectric_boundary_conditions",
      "short_code": "DIEL08",
      "kind": "theorem_formula",
      "title": "境界面における電場 E と電束密度 D の境界条件",
      "summary": "媒質1・2の境界面を跨ぐ微小円筒に電束密度 D のガウスの法則を、微小長方形閉路に静電場 E の保存則（渦なし条件）を適用することで、法線成分の跳び D2n - D1n = σf と接線成分の連続性 E2t = E1t を導出する。",
      "canonical_latex": "(\\mathbf{D}_2 - \\mathbf{D}_1)\\cdot\\mathbf{n}_{12} = \\sigma_f,\\qquad \\mathbf{n}_{12}\\times(\\mathbf{E}_2 - \\mathbf{E}_1) = \\mathbf{0}\\quad \\big(D_{2n} - D_{1n} = \\sigma_f,\\; \\mathbf{E}_{2t} = \\mathbf{E}_{1t}\\big)",
      "aliases_latex": [
        "D_{2n}-D_{1n}=\\sigma_f,\\; E_{2t}=E_{1t}"
      ],
      "keywords": [
        "境界条件",
        "電束密度",
        "接線成分連続",
        "法線成分"
      ],
      "domain_tags": [
        "physics",
        "electromagnetism",
        "dielectrics"
      ],
      "intuition_oneliner": "要するに、異なる2つの物質の境界面をまたぐとき、電場の接線成分は連続で、電束密度は自由電荷の分だけ法線成分がジャンプ（跳び）するという境界のルールです。",
      "diagram_svg": "<svg viewBox=\"0 0 600 260\" xmlns=\"http://www.w3.org/2000/svg\"><rect width=\"600\" height=\"260\" fill=\"none\"/><text x=\"50\" y=\"40\" fill=\"currentColor\" font-size=\"16\" font-weight=\"bold\">境界面における電場と電束密度の条件</text><line x1=\"50\" y1=\"140\" x2=\"550\" y2=\"140\" stroke=\"currentColor\" stroke-width=\"2\"/><text x=\"80\" y=\"100\" fill=\"#3b82f6\" font-size=\"16\">媒質 1 (E1, D1)</text><text x=\"80\" y=\"190\" fill=\"#10b981\" font-size=\"16\">媒質 2 (E2, D2)</text><text x=\"350\" y=\"90\" fill=\"currentColor\" font-size=\"14\">接線: E1t = E2t (連続)</text><text x=\"350\" y=\"190\" fill=\"#f97316\" font-size=\"14\">法線: D2n - D1n = σ_f</text></svg>"
    },
    {
      "id": "phys.em.dc09_dielectric_electrostatic_energy",
      "short_code": "DIEL09",
      "kind": "theorem_formula",
      "title": "誘電体中の静電エネルギーとエネルギー密度",
      "summary": "自由電荷の微小変化 δρf に伴う仕事 δUe = ∫ φ δρf dV に ∇·δD = δρf と発散定理を適用して一般のエネルギー変分 δUe = ∫ E·δD dV を導き、線形誘電体における静電エネルギー密度 u_e = (1/2) E·D = (1/2) ε |E|^2 を得る。",
      "canonical_latex": "\\delta U_e = \\iiint_{\\mathbb{R}^3} \\mathbf{E}\\cdot\\delta\\mathbf{D}\\,dV,\\qquad U_e = \\frac{1}{2}\\iiint_{\\mathbb{R}^3} \\mathbf{E}\\cdot\\mathbf{D}\\,dV,\\qquad u_e(\\mathbf{r}) = \\frac{1}{2}\\mathbf{E}(\\mathbf{r})\\cdot\\mathbf{D}(\\mathbf{r}) = \\frac{1}{2}\\varepsilon|\\mathbf{E}(\\mathbf{r})|^2",
      "aliases_latex": [
        "u_e = \\frac{1}{2}\\mathbf{E}\\cdot\\mathbf{D}"
      ],
      "keywords": [
