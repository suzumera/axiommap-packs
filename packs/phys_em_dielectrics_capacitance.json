  "nodes": [
    {
      "id": "phys.em.dc01_conductor_electrostatic_shielding",
      "short_code": "DIEL01",
      "kind": "theorem_formula",
      "title": "導体の静電平衡条件・静電遮蔽と表面電荷",
      "summary": "静電平衡にある導体内部では自由電荷の移動が止まるため電場が零かつ等電位となり、余剰電荷はすべて導体表面に集まり表面直外の電場は法線方向で大きさ σ/ε0 となる。また内部に電荷のない空洞を持つ導体では空洞内電場も零となる（静電遮蔽）。",
      "canonical_latex": "\\mathbf{E}_{\\mathrm{in}} = \\mathbf{0},\\quad \\phi|_{\\Omega_{\\mathrm{cond}}} = \\text{const.},\\quad \\rho_{\\mathrm{in}} = 0,\\quad \\mathbf{E}_{\\mathrm{surf}} = \\frac{\\sigma}{\\varepsilon_0}\\mathbf{n},\\quad \\mathbf{E}_{\\mathrm{cav}} = \\mathbf{0}",
      "aliases_latex": [
        "E_{\\mathrm{in}}=0,\\; E_n=\\sigma/\\varepsilon_0"
      ],
      "keywords": [
        "導体",
        "静電平衡",
        "静電遮蔽",
        "表面電荷密度",
        "等電位"
      ],
