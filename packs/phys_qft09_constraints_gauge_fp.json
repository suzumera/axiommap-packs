  "nodes": [
    {
      "id": "phys.qft09.n01_proca_lagrangian_eom",
      "short_code": "QFT09_01",
      "kind": "definition",
      "title": "プロカ場（有限質量ベクトル場）のラグランジアンと運動方程式",
      "summary": "質量 m を持つスピン1の相対論的ベクトル場（プロカ場）のラグランジアン密度とオイラー＝ラグランジュ方程式を定義する。質量項によりゲージ不変性は破れ、運動方程式の発散からローレンツ条件が自動的に導かれる。",
      "canonical_latex": "\\mathcal{L}_{\\mathrm{Proca}} = -\\frac{1}{4}F_{\\mu\\nu}F^{\\mu\\nu} - \\frac{1}{2}m^2 A_\\mu A^\\mu,\\qquad \\partial_\\mu F^{\\mu\\nu} - m^2 A^\\nu = 0,\\qquad \\partial_\\mu A^\\mu = 0",
      "aliases_latex": [
        "(\\Box - m^2)A^\\nu = 0,\\; \\partial_\\mu A^\\mu = 0"
      ],
      "keywords": [
        "プロカ場",
        "有限質量ベクトル場",
        "ローレンツ条件",
        "ゲージ対称性の破れ"
      ],
      "domain_tags": [
        "physics",
        "qft"
      ]
    },
    {
      "id": "phys.qft09.n02_proca_polarization_propagator",
      "short_code": "QFT09_02",
      "kind": "theorem_formula",
      "title": "プロカ場の偏極完全性関係と伝播関数",
      "summary": "有限質量ベクトル場の3つの物理的偏極ベクトルが満たす完全性関係と、運動量空間におけるファインマン伝播関数を導く。質量ゼロ極限で縦波成分に発散が生じる。",
      "canonical_latex": "\\sum_{\\lambda=1}^{3} \\epsilon_\\mu^{(\\lambda)}(p)\\epsilon_\\nu^{(\\lambda)*}(p) = \\eta_{\\mu\\nu} + \\frac{p_\\mu p_\\nu}{m^2},\\qquad \\tilde{D}_{\\mu\\nu}(p) = \\frac{-i\\left(\\eta_{\\mu\\nu} + \\frac{p_\\mu p_\\nu}{m^2}\\right)}{p^2 + m^2 - i\\epsilon}",
      "aliases_latex": [
        "\\tilde{D}_{\\mu\\nu}(p) = -i\\frac{\\eta_{\\mu\\nu} + p_\\mu p_\\nu / m^2}{p^2 + m^2 - i\\epsilon}"
      ],
      "keywords": [
        "偏極ベクトル",
        "完全性関係",
        "プロカ伝播関数",
        "3自由度"
      ],
      "domain_tags": [
        "physics",
        "qft"
      ]
    },
    {
      "id": "phys.qft09.n03_primary_secondary_constraints",
      "short_code": "QFT09_03",
      "kind": "definition",
      "title": "特異ラグランジアンと一次拘束・二次拘束条件",
      "summary": "速度に関するヘッセ行列が特異な系ではすべての正準運動量を独立に解けず、位相空間上に一次拘束条件が現れる。その時間発展の整合性条件から二次以降の拘束条件が定まる。",
      "canonical_latex": "\\det\\left(\\frac{\\partial^2 L}{\\partial \\dot{q}_i \\partial \\dot{q}_j}\\right) = 0,\\qquad \\phi_m(q,p) \\approx 0,\\qquad \\dot{\\phi}_m \\approx \\{\\phi_m, H_T\\} \\approx 0",
      "aliases_latex": [
        "H_T = H_c + u_m\\phi_m,\\; \\{\\phi_m, H_T\\} \\approx 0"
      ],
      "keywords": [
        "特異ラグランジアン",
        "一次拘束",
        "二次拘束",
        "弱等式",
        "ディラック＝ベルグマン法"
      ],
      "domain_tags": [
        "physics",
        "mechanics",
        "qft"
      ]
    },
    {
      "id": "phys.qft09.n04_first_second_class_constraints",
      "short_code": "QFT09_04",
      "kind": "definition",
      "title": "第1類拘束条件と第2類拘束条件の分類",
      "summary": "すべての拘束条件とのポアソン括弧が弱くゼロになるものを第1類拘束（ゲージ変換の生成子）、それ以外でポアソン括弧行列が正則な部分系を第2類拘束として分類する。",
      "canonical_latex": "\\text{第1類: } \\{\\chi_a, \\phi_m\\} \\approx 0\\;(\\forall m),\\qquad \\text{第2類: } \\det\\big(\\{\\theta_\\alpha, \\theta_\\beta\\}\\big) \\not\\approx 0",
      "aliases_latex": [
        "C_{\\alpha\\beta} := \\{\\theta_\\alpha, \\theta_\\beta\\},\\; \\det C \\not\\approx 0"
      ],
      "keywords": [
        "第1類拘束",
        "第2類拘束",
        "ゲージ対称性",
        "ポアソン括弧"
      ],
      "domain_tags": [
        "physics",
        "mechanics",
        "qft"
      ]
    },
    {
      "id": "phys.qft09.n05_dirac_bracket_quantization",
      "short_code": "QFT09_05",
      "kind": "theorem_formula",
      "title": "ディラック括弧と第2類拘束系の正準量子化",
      "summary": "第2類拘束条件の時間不変性から未定乗数を決定することでディラック括弧を導出し、拘束条件を強等式として扱える交換関係による正準量子化則を定式化する。",
      "canonical_latex": "\\{f, g\\}_D := \\{f, g\\} - \\{f, \\theta_\\alpha\\} C_{\\alpha\\beta}^{-1} \\{\\theta_\\beta, g\\}\\;\\big(C_{\\alpha\\beta} := \\{\\theta_\\alpha, \\theta_\\beta\\}\\big),\\qquad [\\hat{f}, \\hat{g}] = i\\{f, g\\}_D",
      "aliases_latex": [
        "\\{f, \\theta_\\gamma\\}_D = 0,\\; [\\hat{f}, \\hat{g}] = i\\hbar\\{f, g\\}_D"
      ],
      "keywords": [
        "ディラック括弧",
        "第2類拘束",
        "正準量子化",
        "拘束面の幾何"
      ],
      "domain_tags": [
        "physics",
        "qft"
      ]
    },
    {
      "id": "phys.qft09.n06_maxwell_gauss_constraint_first_class",
      "short_code": "QFT09_06",
      "kind": "theorem_formula",
      "title": "自由電磁場の正準形式とガウス拘束条件",
      "summary": "マクスウェル・ラグランジアンの正準運動量を構成し、一次拘束と二次拘束としてのガウス拘束条件を導く。両者のポアソン括弧は恒等的にゼロであり第1類拘束を成す。",
      "canonical_latex": "\\pi^0 \\approx 0,\\quad \\pi^i = \\dot{A}_i - \\partial_i A_0 = -E_i,\\quad \\nabla\\cdot\\boldsymbol{\\pi} = -\\nabla\\cdot\\mathbf{E} \\approx 0,\\quad \\{\\pi^0(\\mathbf{x}), \\nabla\\cdot\\boldsymbol{\\pi}(\\mathbf{y})\\} = 0",
      "aliases_latex": [
        "\\Phi_1 = \\pi^0 \\approx 0,\\; \\Phi_2 = \\nabla\\cdot\\boldsymbol{\\pi} \\approx 0"
      ],
      "keywords": [
        "ガウス拘束条件",
