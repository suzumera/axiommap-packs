    {
      "id": "phys.qft09.n08_faddeev_popov_path_integral",
      "short_code": "QFT09_08",
      "kind": "theorem_formula",
      "title": "ファデーエフ＝ポポフ法と共変ゲージ固定経路積分",
      "summary": "ゲージ場経路積分におけるゲージ軌道方向の無限大発散をファデーエフ＝ポポフ恒等式で分離し、共変ゲージ固定項とゴースト場を含む有効ラグランジアンを導く。",
      "canonical_latex": "Z = \\int \\mathcal{D}A\\,\\det\\left(\\frac{\\delta G(A^\\alpha)}{\\delta \\alpha}\\right)\\delta[G(A)]\\,\\exp(i S[A]) = \\int \\mathcal{D}A\\,\\mathcal{D}\\bar{c}\\,\\mathcal{D}c\\,\\exp\\!\\left(i\\int d^4x\\left[\\mathcal{L} - \\frac{1}{2\\xi}(\\partial_\\mu A^\\mu)^2 + \\mathcal{L}_{\\mathrm{ghost}}\\right]\\right)",
