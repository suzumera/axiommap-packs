    {
      "id": "phys.qft09.n07_coulomb_gauge_quantization",
      "short_code": "QFT09_07",
      "kind": "theorem_formula",
      "title": "クーロンゲージ固定と横波光子の正準量子化",
      "summary": "自由電磁場の第1類拘束にクーロンゲージ固定条件を付加して第2類拘束系へ変換し、ディラック括弧を計算することで横波射影された正準交換関係（2自由度）を導く。",
      "canonical_latex": "\\nabla\\cdot\\mathbf{A} = 0,\\quad A_0 = 0,\\quad [\\hat{A}_i(\\mathbf{x},t), \\hat{\\pi}^j(\\mathbf{y},t)] = i\\left(\\delta_{ij} - \\frac{\\partial_i\\partial_j}{\\nabla^2}\\right)\\delta^{(3)}(\\mathbf{x}-\\mathbf{y})",
      "aliases_latex": [
        "\\{A_i(\\mathbf{x}), \\pi^j(\\mathbf{y})\\}_D = \\delta_{ij}^{\\perp}(\\mathbf{x}-\\mathbf{y})"
