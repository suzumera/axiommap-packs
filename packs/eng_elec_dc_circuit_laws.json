  "nodes": [
    {
      "id": "eng.dc.dc01_kcl_kvl_lumped_axioms",
      "short_code": "DC01",
      "kind": "axiom",
      "title": "キルヒホッフの電流則・電圧則（KCL/KVL）および集中定数素子の構成則",
      "summary": "集中定数電気回路の基本公理。任意の節点における電流の代数和が零となる電荷保存則（KCL）、任意の閉路における電圧の代数和が零となる保存電場則（KVL）、および線形受動素子（R・L・C）の電圧-電流関係を定める。",
      "canonical_latex": "\\sum_{k\\in\\text{node}} i_k(t) = 0,\\quad \\sum_{k\\in\\text{loop}} v_k(t) = 0,\\quad v_R = R i,\\quad v_L = L\\frac{di}{dt},\\quad i_C = C\\frac{dv}{dt}",
      "aliases_latex": [
        "\\sum i_k = 0,\\; \\sum v_k = 0,\\; v = Ri"
      ],
      "keywords": [
        "KCL",
        "KVL",
        "キルヒホッフの法則",
        "オームの法則",
        "集中定数回路"
      ],
      "domain_tags": [
        "electrical_engineering",
        "circuit_theory"
      ],
      "intuition_oneliner": "電気回路の2大基本ルールで、枝分かれ点に出入りする電流の合計はゼロ（KCL）、回路を1周したときの電圧の合計もゼロ（KVL）になります。",
      "diagram_svg": "<svg viewBox=\"0 0 600 260\" xmlns=\"http://www.w3.org/2000/svg\"><text x=\"110\" y=\"35\" fill=\"currentColor\" font-size=\"16\">KCL (電流の保存)</text><circle cx=\"160\" cy=\"130\" r=\"7\" fill=\"#f97316\"/><line x1=\"60\" y1=\"130\" x2=\"153\" y2=\"130\" stroke=\"#3b82f6\" stroke-width=\"3\"/><line x1=\"165\" y1=\"125\" x2=\"240\" y2=\"75\" stroke=\"#10b981\" stroke-width=\"3\"/><line x1=\"165\" y1=\"135\" x2=\"240\" y2=\"185\" stroke=\"#10b981\" stroke-width=\"3\"/><text x=\"80\" y=\"118\" fill=\"#3b82f6\" font-size=\"15\">i1</text><text x=\"205\" y=\"75\" fill=\"#10b981\" font-size=\"15\">i2</text><text x=\"205\" y=\"195\" fill=\"#10b981\" font-size=\"15\">i3</text><text x=\"100\" y=\"230\" fill=\"currentColor\" font-size=\"15\">i1 = i2 + i3</text><text x=\"380\" y=\"35\" fill=\"currentColor\" font-size=\"16\">KVL (電圧の保存)</text><rect x=\"360\" y=\"70\" width=\"160\" height=\"110\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><rect x=\"415\" y=\"58\" width=\"50\" height=\"24\" fill=\"#3b82f6\"/><text x=\"428\" y=\"75\" fill=\"#ffffff\" font-size=\"14\">R,L,C</text><circle cx=\"360\" cy=\"125\" r=\"16\" fill=\"#f97316\"/><text x=\"352\" y=\"130\" fill=\"#ffffff\" font-size=\"15\">V</text><text x=\"385\" y=\"230\" fill=\"currentColor\" font-size=\"15\">1周の電圧和 = 0</text></svg>"
    },
    {
      "id": "eng.dc.dc02_series_parallel_resistance",
      "short_code": "DC02",
      "kind": "theorem_formula",
      "title": "抵抗の直列・並列合成と分圧・分流則",
      "summary": "KCL・KVLとオームの法則から導かれる抵抗の直列合成抵抗・並列合成抵抗の公式、ならびに分圧則・分流則。",
      "canonical_latex": "R_{\\text{ser}} = \\sum_{k=1}^{n} R_k,\\quad \\frac{1}{R_{\\text{par}}} = \\sum_{k=1}^{n} \\frac{1}{R_k},\\quad v_k = \\frac{R_k}{R_{\\text{ser}}}V,\\quad i_k = \\frac{R_{\\text{par}}}{R_k}I",
      "aliases_latex": [
        "R_{\\text{par}} = \\left(\\sum_{k=1}^{n} R_k^{-1}\\right)^{-1}"
      ],
      "keywords": [
        "直列合成抵抗",
        "並列合成抵抗",
        "分圧則",
        "分流則"
      ],
      "domain_tags": [
        "electrical_engineering",
        "circuit_theory"
      ]
    },
    {
      "id": "eng.dc.dc03_superposition_theorem",
      "short_code": "DC03",
      "kind": "theorem_formula",
      "title": "線形回路における重ね合わせの理",
      "summary": "複数の独立電源を含む線形回路の応答（節点電圧・枝電流）は、各独立電源を単独で残し他の独立電源を零化（電圧源短絡・電流源開放）したときの応答の線形和に等しい。",
      "canonical_latex": "A\\mathbf{x} = \\sum_{m=1}^{M} \\mathbf{b}_m \\implies \\mathbf{x} = \\sum_{m=1}^{M} \\mathbf{x}^{(m)},\\quad A\\mathbf{x}^{(m)} = \\mathbf{b}_m",
      "aliases_latex": [
        "\\mathbf{x} = \\sum_{m=1}^{M} \\mathbf{x}^{(m)}"
      ],
      "keywords": [
        "重ね合わせの理",
        "線形性",
        "独立電源"
      ],
      "domain_tags": [
        "electrical_engineering",
        "circuit_theory"
      ]
    },
    {
      "id": "eng.dc.dc04_thevenin_theorem",
      "short_code": "DC04",
      "kind": "theorem_formula",
      "title": "テブナンの定理（等価電圧源表現）",
      "summary": "任意の線形一端子対回路網は、端子開放電圧に等しい理想電圧源と、内部の独立電源を零化したときの端子間等価抵抗との直列回路に等価変換できる。",
      "canonical_latex": "V_{\\text{port}} = V_{\\text{th}} - R_{\\text{th}} I_{\\text{port}},\\quad V_{\\text{th}} = V_{\\text{oc}},\\quad R_{\\text{th}} = \\left.\\frac{V_{\\text{test}}}{I_{\\text{test}}}\\right|_{\\text{sources}=0}",
      "aliases_latex": [
        "I = \\frac{V_{\\text{th}}}{R_{\\text{th}} + R_L}"
      ],
      "keywords": [
        "テブナンの定理",
        "鳳・テブナンの定理",
        "等価電圧源",
        "開放電圧"
      ],
      "domain_tags": [
        "electrical_engineering",
        "circuit_theory"
      ]
    },
    {
      "id": "eng.dc.dc05_norton_theorem",
      "short_code": "DC05",
      "kind": "theorem_formula",
      "title": "ノートンの定理と電源変換（等価電流源表現）",
      "summary": "任意の線形一端子対回路網は、端子短絡電流に等しい理想電流源と等価抵抗の並列回路に等価変換でき、テブナン等価回路と双対な電源変換関係をなす。",
      "canonical_latex": "I_{\\text{port}} = I_{\\text{N}} - \\frac{V_{\\text{port}}}{R_{\\text{N}}},\\quad I_{\\text{N}} = I_{\\text{sc}} = \\frac{V_{\\text{th}}}{R_{\\text{th}}},\\quad R_{\\text{N}} = R_{\\text{th}}",
      "aliases_latex": [
        "I_{\\text{N}} = \\frac{V_{\\text{th}}}{R_{\\text{th}}},\\; R_{\\text{N}} = R_{\\text{th}}"
      ],
      "keywords": [
        "ノートンの定理",
        "等価電流源",
        "電源変換",
        "短絡電流"
      ],
      "domain_tags": [
        "electrical_engineering",
        "circuit_theory"
      ]
    },
    {
      "id": "eng.dc.dc06_rc_transient_response",
      "short_code": "DC06",
      "kind": "theorem_formula",
      "title": "RC直列回路の過渡応答と時定数",
      "summary": "直流電圧源に接続されたRC直列回路におけるキャパシタ電圧の1階線形微分方程式の解と、応答速度を特徴づける時定数。",
      "canonical_latex": "RC\\frac{dv_C}{dt} + v_C = V_0 \\implies v_C(t) = V_0\\left(1 - e^{-t/\\tau}\\right) + v_C(0)e^{-t/\\tau},\\quad \\tau = RC",
      "aliases_latex": [
        "v_C(t) = V_0(1 - e^{-t/(RC)})"
      ],
      "keywords": [
        "RC回路",
        "過渡応答",
        "時定数",
        "充電"
      ],
      "domain_tags": [
        "electrical_engineering",
        "circuit_theory"
      ]
    },
    {
      "id": "eng.dc.dc07_rl_transient_response",
      "short_code": "DC07",
      "kind": "theorem_formula",
      "title": "RL直列回路の過渡応答と時定数",
      "summary": "直流電圧源に接続されたRL直列回路における回路電流の1階線形微分方程式の解と、磁気エネルギー蓄積に伴う時定数。",
      "canonical_latex": "L\\frac{di}{dt} + R i = V_0 \\implies i(t) = \\frac{V_0}{R}\\left(1 - e^{-t/\\tau}\\right) + i(0)e^{-t/\\tau},\\quad \\tau = \\frac{L}{R}",
      "aliases_latex": [
        "i(t) = \\frac{V_0}{R}(1 - e^{-Rt/L})"
      ],
      "keywords": [
        "RL回路",
        "過渡応答",
        "時定数"
      ],
      "domain_tags": [
        "electrical_engineering",
        "circuit_theory"
      ]
    },
    {
      "id": "eng.dc.dc08_rlc_characteristic_ode",
      "short_code": "DC08",
      "kind": "theorem_formula",
      "title": "RLC直列回路の2階常微分方程式と減衰係数・固有角周波数",
      "summary": "RLC直列回路のKVLおよび素子構成則から導かれる標準形の2階線形常微分方程式と、減衰係数・無減衰固有角周波数・減衰比の定義。",
      "canonical_latex": "\\frac{d^2 v_C}{dt^2} + 2\\alpha\\frac{dv_C}{dt} + \\omega_0^2 v_C = \\omega_0^2 V_0,\\quad \\alpha := \\frac{R}{2L},\\quad \\omega_0 := \\frac{1}{\\sqrt{LC}},\\quad \\zeta := \\frac{\\alpha}{\\omega_0} = \\frac{R}{2}\\sqrt{\\frac{C}{L}}",
      "aliases_latex": [
        "LC\\ddot{v}_C + RC\\dot{v}_C + v_C = V_0"
      ],
      "keywords": [
        "RLC直列回路",
