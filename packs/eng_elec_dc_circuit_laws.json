      ]
    },
    {
      "id": "eng.dc.dc09_rlc_damping_regimes",
      "short_code": "DC09",
      "kind": "theorem_formula",
      "title": "RLC直列回路の過渡応答分類（過減衰・臨界減衰・不足減衰）",
      "summary": "特性方程式の判別式の符号に応じて分類されるRLC直列回路の3つの減衰形態（過減衰・臨界減衰・不足減衰）の一般解。",
      "canonical_latex": "s^2 + 2\\alpha s + \\omega_0^2 = 0,\\; s_{1,2} = -\\alpha \\pm \\sqrt{\\alpha^2 - \\omega_0^2} \\implies v_{C,h}(t) = \\begin{cases} A_1 e^{s_1 t} + A_2 e^{s_2 t} & (\\alpha > \\omega_0:\\text{ overdamped}) \\\\ (B_1 + B_2 t)e^{-\\alpha t} & (\\alpha = \\omega_0:\\text{ critically damped}) \\\\ e^{-\\alpha t}(C_1\\cos\\omega_d t + C_2\\sin\\omega_d t) & (\\alpha < \\omega_0,\\; \\omega_d=\\sqrt{\\omega_0^2-\\alpha^2}:\\text{ underdamped}) \\end{cases}",
      "aliases_latex": [
        "\\alpha = \\omega_0 \\iff R = 2\\sqrt{L/C}"
      ],
      "keywords": [
        "過減衰",
        "臨界減衰",
        "不足減衰",
        "特性方程式"
      ],
      "domain_tags": [
        "electrical_engineering",
        "circuit_theory"
      ]
    },
    {
      "id": "eng.dc.dc10_maximum_power_transfer",
      "short_code": "DC10",
      "kind": "theorem_formula",
      "title": "最大電力供給の定理（負荷整合条件）",
      "summary": "テブナン等価回路で表現された直流電源から可変負荷抵抗へ供給される電力が最大となる条件（負荷抵抗が電源の内部抵抗に等しい）とその最大電力値。",
      "canonical_latex": "P_L(R_L) = \\frac{V_{\\text{th}}^2 R_L}{(R_{\\text{th}} + R_L)^2},\\quad \\frac{dP_L}{dR_L} = 0 \\iff R_L = R_{\\text{th}} \\implies P_{L,\\max} = \\frac{V_{\\text{th}}^2}{4 R_{\\text{th}}}",
      "aliases_latex": [
