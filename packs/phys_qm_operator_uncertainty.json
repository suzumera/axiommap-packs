      "canonical_latex": "\\sigma_A^2\\sigma_B^2 \\ge \\left|\\frac{1}{2}\\langle \\{\\Delta\\hat{A}, \\Delta\\hat{B}\\} \\rangle\\right|^2 + \\left|\\frac{1}{2i}\\langle [\\hat{A}, \\hat{B}] \\rangle\\right|^2,\\quad \\sigma_x\\sigma_p \\ge \\frac{\\hbar}{2}",
