      "canonical_latex": "\\hat{a} := \\sqrt{\\frac{m\\omega}{2\\hbar}}\\left(\\hat{x} + \\frac{i}{m\\omega}\\hat{p}\\right),\\quad \\hat{a}^\\dagger := \\sqrt{\\frac{m\\omega}{2\\hbar}}\\left(\\hat{x} - \\frac{i}{m\\omega}\\hat{p}\\right),\\quad \\hat{N} := \\hat{a}^\\dagger\\hat{a}",
