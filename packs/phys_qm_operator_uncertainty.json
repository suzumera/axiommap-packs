    {
      "id": "phys.qm.op03_hermitian_spectral_theorem",
      "short_code": "OP03",
      "kind": "theorem_formula",
      "title": "エルミート演算子の固有値実数性と固有状態の正規直交完全性",
      "summary": "エルミート演算子の固有値はすべて実数であり、異なる固有値に属する固有状態は互いに直交し、固有状態全体が完全系をなす。",
      "canonical_latex": "a_n \\in \\mathbb{R},\\quad a_m \\neq a_n \\implies \\langle a_m | a_n \\rangle = 0,\\quad \\sum_n |a_n\\rangle\\langle a_n| = \\hat{I}",
