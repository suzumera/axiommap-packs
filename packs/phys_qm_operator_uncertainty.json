    {
      "id": "phys.qm.op05_ehrenfest_heisenberg_eom",
      "short_code": "OP05",
      "kind": "theorem_formula",
      "title": "エーレンフェストの定理とハイゼンベルクの運動方程式",
      "summary": "シュレーディンガー方程式から期待値の時間変化を与えるエーレンフェストの定理と、ハイゼンベルク描像における演算子の運動方程式を導く。",
      "canonical_latex": "\\frac{d}{dt}\\langle \\hat{A} \\rangle = \\frac{1}{i\\hbar}\\langle [\\hat{A}, \\hat{H}] \\rangle + \\left\\langle \\frac{\\partial \\hat{A}}{\\partial t} \\right\\rangle,\\quad \\frac{d\\hat{A}_H}{dt} = \\frac{1}{i\\hbar}[\\hat{A}_H, \\hat{H}_H] + \\frac{\\partial \\hat{A}_H}{\\partial t}",
