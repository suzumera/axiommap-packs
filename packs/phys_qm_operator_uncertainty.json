      "aliases_latex": [
        "\\langle \\phi | \\psi \\rangle = \\langle \\psi | \\phi \\rangle^*",
        "\\psi(\\mathbf{r}) = \\langle \\mathbf{r} | \\psi \\rangle"
      ],
      "keywords": [
