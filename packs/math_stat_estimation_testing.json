  "nodes": [
    {
      "id": "math.stat.st01_likelihood_def",
      "short_code": "ST01",
      "kind": "definition",
      "title": "パラメトリック統計モデルと尤度関数・対数尤度関数の定義",
      "summary": "未知母数 θ に依存する同時確率密度（または質量）関数をパラメータの関数とみなした尤度関数および対数尤度関数を定義する。",
      "canonical_latex": "L(\\theta;\\mathbf{x}) := f(\\mathbf{x};\\theta) = \\prod_{i=1}^{n} f(x_i;\\theta),\\quad \\ell(\\theta;\\mathbf{x}) := \\ln L(\\theta;\\mathbf{x}) = \\sum_{i=1}^{n} \\ln f(x_i;\\theta)\\quad (\\theta\\in\\Theta\\subseteq\\mathbb{R}^p,\\; X_1,\\dots,X_n\\stackrel{\\text{i.i.d.}}{\\sim} f(\\cdot;\\theta))",
      "aliases_latex": [
        "L(\\theta)=\\prod_{i=1}^{n}f(x_i;\\theta),\\; \\ell(\\theta)=\\sum_{i=1}^{n}\\ln f(x_i;\\theta)"
      ],
      "keywords": [
        "尤度関数",
        "対数尤度",
        "統計モデル",
        "パラメトリック",
        "i.i.d."
      ],
      "domain_tags": [
        "mathematics",
        "statistics"
      ]
    },
    {
      "id": "math.stat.st02_sufficient_statistic_def",
      "short_code": "ST02",
      "kind": "definition",
      "title": "十分統計量の定義",
      "summary": "統計量 T(X) が与えられたもとでの標本 X の条件付き分布が未知母数 θ に依存しないとき、T(X) を θ に対する十分統計量と定義する。",
      "canonical_latex": "T(\\mathbf{X})\\text{ is sufficient for }\\theta \\iff P_{\\theta}(\\mathbf{X}=\\mathbf{x}\\mid T(\\mathbf{X})=t)\\text{ does not depend on }\\theta\\quad(\\forall \\theta\\in\\Theta,\\; P_{\\theta}(T(\\mathbf{X})=t)>0\\text{ or a.e.})",
      "aliases_latex": [
        "f(\\mathbf{x}\\mid T(\\mathbf{x})=t;\\theta)=h(\\mathbf{x})"
      ],
      "keywords": [
        "十分統計量",
        "条件付き分布",
        "情報縮約"
      ],
      "domain_tags": [
        "mathematics",
        "statistics"
      ]
    },
    {
      "id": "math.stat.st03_factorization_theorem",
      "short_code": "ST03",
      "kind": "theorem_formula",
      "title": "フィッシャー＝ネイマンの分解定理",
      "summary": "統計量 T(X) が θ の十分統計量であるための必要十分条件は、同時確率関数が T(x) と θ のみに依存する因子と x のみに依存する因子の積に分解できることである。",
      "canonical_latex": "T(\\mathbf{X})\\text{ is sufficient for }\\theta \\iff \\exists g(\\cdot;\\theta)\\ge 0,\\; \\exists h(\\cdot)\\ge 0\\text{ s.t. } f(\\mathbf{x};\\theta) = g(T(\\mathbf{x});\\theta)\\,h(\\mathbf{x})",
      "aliases_latex": [
        "f(\\mathbf{x};\\theta)=g(T(\\mathbf{x}),\\theta)h(\\mathbf{x})"
      ],
      "keywords": [
        "分解定理",
        "十分統計量",
        "フィッシャー",
        "ネイマン"
      ],
      "domain_tags": [
        "mathematics",
        "statistics"
      ]
    },
    {
      "id": "math.stat.st04_mle_score_def",
      "short_code": "ST04",
      "kind": "definition",
      "title": "最尤推定量（MLE）とスコア関数の定義",
      "summary": "尤度関数（または対数尤度関数）を最大化するパラメータ値を最尤推定量、対数尤度関数のパラメータに関する勾配をスコア関数と定義する。",
      "canonical_latex": "\\hat{\\theta}_{\\mathrm{MLE}}(\\mathbf{x}) \\in \\arg\\max_{\\theta\\in\\Theta} L(\\theta;\\mathbf{x}) = \\arg\\max_{\\theta\\in\\Theta} \\ell(\\theta;\\mathbf{x}),\\quad \\mathbf{s}(\\theta;\\mathbf{x}) := \\nabla_{\\theta}\\ell(\\theta;\\mathbf{x}) = \\frac{\\nabla_{\\theta}f(\\mathbf{x};\\theta)}{f(\\mathbf{x};\\theta)}",
      "aliases_latex": [
        "s(\\theta;\\mathbf{X})=\\frac{\\partial}{\\partial\\theta}\\ln f(\\mathbf{X};\\theta)"
      ],
      "keywords": [
        "最尤推定量",
        "MLE",
        "スコア関数",
        "対数尤度"
      ],
      "domain_tags": [
        "mathematics",
        "statistics"
      ],
      "intuition_oneliner": "要するに何？：データが一番起きやすそうなパラメータを探すのが最尤推定で、その山の頂上（勾配ゼロ）を探すのがスコア関数です。",
      "diagram_svg": "<svg viewBox=\"0 0 600 260\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M100,220 Q300,20 500,220\" fill=\"none\" stroke=\"#3b82f6\" stroke-width=\"3\"/><line x1=\"300\" y1=\"20\" x2=\"300\" y2=\"220\" stroke=\"#f97316\" stroke-dasharray=\"4,4\" stroke-width=\"2\"/><text x=\"310\" y=\"40\" fill=\"#f97316\" font-size=\"14\">θ_MLE (傾き=0)</text></svg>"
    },
    {
      "id": "math.stat.st05_mle_score_equation",
      "short_code": "ST05",
      "kind": "theorem_formula",
      "title": "尤度方程式（1階最適性条件）とスコア期待値零の性質",
      "summary": "正則条件のもとで、内点における最尤推定量はスコア関数が零となる尤度方程式を満たし、真のパラメータにおけるスコア関数の期待値は零になる。",
      "canonical_latex": "\\hat{\\theta}_{\\mathrm{MLE}}\\in\\operatorname{int}(\\Theta) \\implies \\mathbf{s}(\\hat{\\theta}_{\\mathrm{MLE}};\\mathbf{x})=\\nabla_{\\theta}\\ell(\\hat{\\theta}_{\\mathrm{MLE}};\\mathbf{x})=\\mathbf{0},\\qquad \\mathbb{E}_{\\theta}[\\mathbf{s}(\\theta;\\mathbf{X})] = \\mathbf{0}\\quad(\\text{regularity conditions})",
      "aliases_latex": [
        "\\frac{\\partial \\ell}{\\partial \\theta}\\Big|_{\\theta=\\hat{\\theta}}=0,\\quad \\mathbb{E}_{\\theta}\\left[\\frac{\\partial \\ln f(\\mathbf{X};\\theta)}{\\partial\\theta}\\right]=0"
      ],
      "keywords": [
        "尤度方程式",
        "スコア期待値",
        "停留点",
        "最尤推定"
      ],
      "domain_tags": [
        "mathematics",
        "statistics"
      ]
    },
    {
      "id": "math.stat.st06_fisher_information",
      "short_code": "ST06",
      "kind": "theorem_formula",
      "title": "フィッシャー情報量とバートレットの2次恒等式",
      "summary": "スコア関数の分散（2次モーメント）として定義されるフィッシャー情報量は、正則条件のもとで対数尤度の2階微分の期待値に負号をつけたものに等しい。",
      "canonical_latex": "I(\\theta) := \\mathbb{E}_{\\theta}\\!\\left[\\left(\\frac{\\partial \\ell(\\theta;\\mathbf{X})}{\\partial \\theta}\\right)^2\\right] = \\operatorname{Var}_{\\theta}\\!\\left(\\frac{\\partial \\ell}{\\partial \\theta}\\right) = -\\mathbb{E}_{\\theta}\\!\\left[\\frac{\\partial^2 \\ell(\\theta;\\mathbf{X})}{\\partial \\theta^2}\\right],\\quad I_n(\\theta)=n\\,I_1(\\theta)\\text{ (i.i.d.)}",
      "aliases_latex": [
        "[I(\\theta)]_{jk} = \\mathbb{E}_{\\theta}[s_j s_k] = -\\mathbb{E}_{\\theta}\\left[\\frac{\\partial^2 \\ell}{\\partial\\theta_j\\partial\\theta_k}\\right]"
      ],
      "keywords": [
        "フィッシャー情報量",
        "バートレット恒等式",
        "情報行列",
        "分散"
      ],
      "domain_tags": [
        "mathematics",
        "statistics"
      ],
      "intuition_oneliner": "データからパラメータの真の値をどれだけ鋭く見分けられるかを示す指標で、尤度曲線の急峻さに比例します。",
      "diagram_svg": "<svg viewBox=\"0 0 600 260\" xmlns=\"http://www.w3.org/2000/svg\"><line x1=\"100\" y1=\"200\" x2=\"500\" y2=\"200\" stroke=\"currentColor\" stroke-width=\"2\"/><path d=\"M 200 180 Q 300 50 400 180\" fill=\"none\" stroke=\"#3b82f6\" stroke-width=\"3\"/><line x1=\"300\" y1=\"50\" x2=\"300\" y2=\"200\" stroke=\"currentColor\" stroke-dasharray=\"4\"/><text x=\"310\" y=\"70\" fill=\"currentColor\" font-size=\"14\">I(θ)</text><text x=\"300\" y=\"230\" fill=\"currentColor\" font-size=\"14\">θ</text></svg>"
    },
    {
      "id": "math.stat.st07_cramer_rao_inequality",
      "short_code": "ST07",
      "kind": "theorem_formula",
      "title": "クラメール＝ラオの不等式（情報不等式）",
      "summary": "正則条件のもとで、期待値が ψ(θ) である任意の推定量 T(X) の分散は (ψ'(θ))^2 / I(θ) 以上であり、特に不偏推定量の分散はフィッシャー情報量の逆数で下から抑えられる。",
      "canonical_latex": "\\mathbb{E}_{\\theta}[T(\\mathbf{X})]=\\psi(\\theta) \\implies \\operatorname{Var}_{\\theta}(T(\\mathbf{X})) \\ge \\frac{\\big(\\psi'(\\theta)\\big)^2}{I(\\theta)};\\quad \\psi(\\theta)=\\theta \\implies \\operatorname{Var}_{\\theta}(T(\\mathbf{X})) \\ge \\frac{1}{I(\\theta)}",
      "aliases_latex": [
        "\\operatorname{Var}_{\\theta}(\\hat{\\theta})\\ge \\frac{1}{n I_1(\\theta)}"
      ],
      "keywords": [
        "クラメール＝ラオ下限",
        "情報不等式",
        "有効推定量",
        "不偏推定量"
      ],
      "domain_tags": [
        "mathematics",
        "statistics"
      ]
    },
    {
      "id": "math.stat.st08_hypothesis_test_def",
      "short_code": "ST08",
      "kind": "definition",
      "title": "統計的仮説検定・過誤確率・検出力関数の定義",
      "summary": "帰無仮説 H0 と対立仮説 H1 に対する（確率化を含む）検定関数 φ(x)、有意水準（第1種の過誤確率の上限 α）、第2種の過誤確率、および検出力を定義する。",
      "canonical_latex": "\\phi:\\mathcal{X}\\to[0,1],\\quad \\alpha(\\phi):=\\mathbb{E}_{\\theta_0}[\\phi(\\mathbf{X})]=P_{\\theta_0}(\\text{reject }H_0)\\le\\alpha,\\quad \\beta(\\phi):=\\mathbb{E}_{\\theta_1}[\\phi(\\mathbf{X})]=1-P_{\\theta_1}(\\text{accept }H_0\\mid H_1\\text{ true})",
      "aliases_latex": [
        "P_{\\theta_0}(\\mathbf{X}\\in R)\\le\\alpha,\\quad \\text{Power}=P_{\\theta_1}(\\mathbf{X}\\in R)"
      ],
      "keywords": [
        "仮説検定",
        "有意水準",
        "第1種の過誤",
        "第2種の過誤",
        "検出力"
      ],
      "domain_tags": [
        "mathematics",
        "statistics"
      ]
    },
    {
      "id": "math.stat.st09_neyman_pearson_lemma",
      "short_code": "ST09",
      "kind": "theorem_formula",
      "title": "ネイマン＝ピアソンの基本補題（最強力検定）",
      "summary": "単純帰無仮説 H0: θ=θ0 と単純対立仮説 H1: θ=θ1 の検定において、尤度比 f(x;θ1)/f(x;θ0) に基づく閾値検定は同じ有意水準 α 以下のあらゆる検定の中で検出力を最大化する。",
      "canonical_latex": "\\phi^*(\\mathbf{x})=\\begin{cases}1 & f_1(\\mathbf{x})>k f_0(\\mathbf{x})\\\\\\gamma(\\mathbf{x}) & f_1(\\mathbf{x})=k f_0(\\mathbf{x})\\\\0 & f_1(\\mathbf{x})<k f_0(\\mathbf{x})\\end{cases},\\; \\mathbb{E}_{\\theta_0}[\\phi^*]=\\alpha \\implies \\forall\\phi\\;\\big(\\mathbb{E}_{\\theta_0}[\\phi]\\le\\alpha\\implies \\mathbb{E}_{\\theta_1}[\\phi^*]\\ge\\mathbb{E}_{\\theta_1}[\\phi]\\big)\\quad(k\\ge 0,\\; f_j=f(\\cdot;\\theta_j))",
      "aliases_latex": [
        "\\Lambda(\\mathbf{x})=\\frac{f(\\mathbf{x};\\theta_1)}{f(\\mathbf{x};\\theta_0)}>k"
      ],
      "keywords": [
        "ネイマン＝ピアソンの補題",
        "最強力検定",
        "尤度比検定",
        "仮説検定"
      ],
      "domain_tags": [
        "mathematics",
        "statistics"
      ]
    }
