    {
      "id": "astro.rad.n02_radiative_transfer_equation",
      "short_code": "RD02",
      "kind": "theorem_formula",
      "title": "放射輸送方程式と光学的深さ・ソース関数",
      "summary": "吸収係数 α_ν と放射係数 j_ν を用いた幾何経路に沿う放射輸送方程式から、光学的深さ dτ_ν = α_ν ds とソース関数 S_ν = j_ν/α_ν を導入して標準形 dI_ν/dτ_ν = -I_ν + S_ν を得る。",
      "canonical_latex": "\\frac{dI_{\\nu}}{d\\tau_{\\nu}} = -I_{\\nu} + S_{\\nu},\\quad d\\tau_{\\nu} := \\alpha_{\\nu}\\,ds,\\quad S_{\\nu} := \\frac{j_{\\nu}}{\\alpha_{\\nu}}",
      "aliases_latex": [
        "\\frac{dI_{\\nu}}{ds} = -\\alpha_{\\nu} I_{\\nu} + j_{\\nu}"
      ],
      "keywords": [
        "radiative transfer equation",
        "optical depth",
        "source function",
        "absorption",
        "emission"
      ],
      "domain_tags": [
        "astronomy",
        "astrophysics",
        "radiative_transfer"
      ]
    },
    {
      "id": "astro.rad.n03_formal_solution_rte",
      "short_code": "RD03",
      "kind": "theorem_formula",
      "title": "放射輸送方程式の形式解",
      "summary": "積分因子 e^τ を用いて1階線形常微分方程式としての放射輸送方程式を積分し、任意の光学的深さにおける比放射強度の形式解および一様ソース関数での解析解を導く。",
      "canonical_latex": "I_{\\nu}(\\tau_{\\nu}) = I_{\\nu}(0)e^{-\\tau_{\\nu}} + \\int_{0}^{\\tau_{\\nu}} S_{\\nu}(\\tau') e^{-(\\tau_{\\nu} - \\tau')}\\,d\\tau'",
      "aliases_latex": [
        "I_{\\nu}(\\tau_{\\nu}) = I_{\\nu}(0)e^{-\\tau_{\\nu}} + S_{\\nu}(1 - e^{-\\tau_{\\nu}})\\quad (S_{\\nu}=\\text{const.})"
      ],
      "keywords": [
        "formal solution",
        "integrating factor",
        "radiative transfer",
        "optical depth"
      ],
      "domain_tags": [
        "astronomy",
        "astrophysics",
        "radiative_transfer"
      ]
    },
    {
      "id": "astro.rad.n04_optically_thin_thick_limits",
      "short_code": "RD04",
      "kind": "theorem_formula",
      "title": "光学的に薄い極限と光学的に厚い極限",
      "summary": "形式解を τ_ν ≪ 1 と τ_ν ≫ 1 で漸近展開し、光学的に薄い場合の線形減衰・放射累積と、光学的に厚い場合に放射強度がソース関数へ漸近する性質を示す。",
      "canonical_latex": "I_{\\nu}(\\tau_{\\nu}) \\approx I_{\\nu}(0)(1 - \\tau_{\\nu}) + S_{\\nu}\\tau_{\\nu}\\;(\\tau_{\\nu}\\ll 1),\\qquad \\lim_{\\tau_{\\nu}\\to\\infty} I_{\\nu}(\\tau_{\\nu}) = S_{\\nu}\\;(\\tau_{\\nu}\\gg 1)",
      "aliases_latex": [
        "I_{\\nu} \\approx \\int j_{\\nu}\\,ds\\;(\\tau_{\\nu}\\ll 1,\\; I_{\\nu}(0)=0)"
      ],
      "keywords": [
