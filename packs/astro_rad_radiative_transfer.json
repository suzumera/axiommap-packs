    {
      "id": "astro.rad.n05_kirchhoff_law_lte",
      "short_code": "RD05",
      "kind": "theorem_formula",
      "title": "キルヒホッフの熱放射の法則と LTE ソース関数",
      "summary": "熱平衡における放射輸送の釣合と熱力学第2法則から、放射係数と吸収係数の比が普遍関数であるプランク関数 B_ν(T) に等しいこと（j_ν = α_ν B_ν(T)）および局所熱平衡（LTE）での S_ν = B_ν(T) を導く。",
      "canonical_latex": "j_{\\nu} = \\alpha_{\\nu} B_{\\nu}(T),\\quad S_{\\nu} = \\frac{j_{\\nu}}{\\alpha_{\\nu}} = B_{\\nu}(T)\\text{ (LTE)}",
      "aliases_latex": [
        "\\frac{j_{\\nu}}{\\alpha_{\\nu}} = B_{\\nu}(T)"
