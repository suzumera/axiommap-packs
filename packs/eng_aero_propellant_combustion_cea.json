    {
      "id": "aerosp.cea.n07_fuel_rich_optimal_of_ratio",
      "short_code": "CEA07",
      "kind": "theorem_formula",
      "title": "燃料過濃側への最適O/F混合比シフト則",
      "summary": "比推力のO/F比に対する停留条件から、高温下での平均分子量低下効果により最大比推力を与える最適O/F比が化学量論比より燃料過濃側に移動することを示す。",
      "canonical_latex": "\\frac{\\partial \\ln I_{\\mathrm{sp}}}{\\partial (\\mathrm{O/F})} = 0 \\iff \\frac{1}{T_c}\\frac{\\partial T_c}{\\partial (\\mathrm{O/F})} = \\frac{1}{\\overline{M}_w}\\frac{\\partial \\overline{M}_w}{\\partial (\\mathrm{O/F})} - \\frac{2}{\\eta_{\\mathrm{noz}}}\\frac{\\partial \\eta_{\\mathrm{noz}}}{\\partial (\\mathrm{O/F})} \\implies (\\mathrm{O/F})_{\\mathrm{opt}} < (\\mathrm{O/F})_{\\mathrm{st}}",
      "aliases_latex": [
        "\\phi_{\\mathrm{opt}} > 1"
      ],
      "keywords": [
        "最適混合比",
        "燃料過濃",
        "比推力最大化",
        "O/F比"
      ],
      "domain_tags": [
        "aerospace_engineering",
        "propulsion"
      ]
    },
    {
      "id": "aerosp.cea.n08_dissociation_endothermic_limit",
      "short_code": "CEA08",
      "kind": "theorem_formula",
      "title": "高温解離平衡による実効比熱増大と火炎温度抑制則",
      "summary": "高温燃焼域における吸熱解離反応の進行が平衡混合気体の実効比熱を増大させ、断熱火炎温度の上昇を抑制する機構を示す。",
      "canonical_latex": "\\frac{d\\ln K_p}{dT} = \\frac{\\Delta H_{\\mathrm{diss}}^\\circ}{R_u T^2} > 0,\\quad c_{p,\\mathrm{eff}} = c_{p,\\mathrm{fr}} + \\sum_{j=1}^{N_s} \\bar{h}_j \\left(\\frac{\\partial n_j^{\\mathrm{eq}}}{\\partial T}\\right)_p > c_{p,\\mathrm{fr}}",
