    {
      "id": "aerosp.cea.n02_gibbs_free_energy_minimization",
      "short_code": "CEA02",
      "kind": "theorem_formula",
      "title": "ギブズ自由エネルギー最小化と元素保存平衡条件",
      "summary": "定温・定圧下の多成分反応系において、元素数保存制約のもとでギブズ自由エネルギーを最小化する化学平衡組成の必要条件（CEAの基本方程式）を示す。",
      "canonical_latex": "G(T,p,\\mathbf{n}) = \\sum_{j=1}^{N_s} n_j \\mu_j,\\quad \\min_{\\mathbf{n} \\ge \\mathbf{0}} \\mathcal{L}(\\mathbf{n}, \\boldsymbol{\\lambda}) = \\sum_{j=1}^{N_s} n_j \\mu_j + \\sum_{i=1}^{N_e} \\lambda_i \\left(b_i^0 - \\sum_{j=1}^{N_s} a_{ij} n_j\\right) \\implies \\mu_j = \\sum_{i=1}^{N_e} \\lambda_i a_{ij}",
      "aliases_latex": [
        "\\mu_j - \\sum_{i=1}^{N_e} \\lambda_i a_{ij} = 0"
      ],
      "keywords": [
        "ギブズ自由エネルギー",
        "化学平衡",
        "CEA",
        "ラグランジュ未定乗数法",
        "元素保存"
      ],
      "domain_tags": [
        "aerospace_engineering",
        "thermodynamics",
        "chemical_equilibrium"
      ]
    },
    {
      "id": "aerosp.cea.n03_chemical_potential_equilibrium_constant",
      "short_code": "CEA03",
      "kind": "theorem_formula",
      "title": "理想気体混合物の化学ポテンシャルと平衡定数",
      "summary": "理想気体混合則に基づく化学ポテンシャル表現から、反応系の平衡定数と標準ギブズエネルギー変化の関係式を導く。",
      "canonical_latex": "\\mu_j(T,p,\\mathbf{n}) = \\mu_j^\\circ(T) + R_u T \\ln\\!\\left(\\frac{n_j}{n_{\\mathrm{tot}}}\\frac{p}{p^\\circ}\\right),\\quad \\Delta G^\\circ(T) = -R_u T \\ln K_p(T)",
      "aliases_latex": [
        "K_p(T) = \\prod_{j} \\left(\\frac{p_j}{p^\\circ}\\right)^{\\nu_j} = \\exp\\!\\left(-\\frac{\\Delta G^\\circ(T)}{R_u T}\\right)"
      ],
      "keywords": [
        "化学ポテンシャル",
        "平衡定数",
        "理想気体混合物",
        "質量作用の法則"
      ],
      "domain_tags": [
        "aerospace_engineering",
        "thermodynamics",
        "chemical_equilibrium"
      ]
    },
    {
      "id": "aerosp.cea.n04_adiabatic_flame_temperature",
      "short_code": "CEA04",
      "kind": "theorem_formula",
      "title": "定圧断熱火炎温度のエンタルピー保存方程式",
      "summary": "定圧断熱燃焼室における反応物と平衡生成物の絶対エンタルピー保存則から、燃焼室温度（断熱火炎温度）を決定する陰的方程式を示す。",
      "canonical_latex": "\\sum_{k \\in \\mathrm{react}} n_k \\bar{h}_k(T_{\\mathrm{in}}) = \\sum_{j=1}^{N_s} n_j^{\\mathrm{eq}}(T_c, p_c) \\bar{h}_j(T_c),\\quad \\bar{h}_j(T) = \\Delta_f \\bar{h}_j^\\circ(T_{\\mathrm{ref}}) + \\int_{T_{\\mathrm{ref}}}^{T} \\bar{c}_{p,j}(T')\\,dT'",
      "aliases_latex": [
        "H_{\\mathrm{react}}(T_{\\mathrm{in}}) = H_{\\mathrm{prod}}(T_c, p_c, \\mathbf{n}^{\\mathrm{eq}})"
      ],
      "keywords": [
        "断熱火炎温度",
        "エンタルピー保存",
        "生成エンタルピー",
        "燃焼室温度"
      ],
      "domain_tags": [
        "aerospace_engineering",
        "propulsion",
        "thermodynamics"
      ]
    },
    {
      "id": "aerosp.cea.n05_combustion_gas_molar_mass_tc_m",
      "short_code": "CEA05",
      "kind": "theorem_formula",
      "title": "燃焼ガス平均分子量と特性排気速度のTc/Mw支配則",
      "summary": "平衡組成から定まる燃焼ガスの平均分子量を用いて比気体定数を表し、特性排気速度が燃焼温度と平均分子量の比の平方根に比例することを示す。",
      "canonical_latex": "\\overline{M}_w = \\frac{\\sum_{j=1}^{N_s} n_j^{\\mathrm{eq}} M_j}{\\sum_{j=1}^{N_s} n_j^{\\mathrm{eq}}},\\quad R_{\\mathrm{sp}} = \\frac{R_u}{\\overline{M}_w},\\quad c^* = \\frac{1}{\\Gamma(\\gamma)}\\sqrt{\\frac{R_u T_c}{\\overline{M}_w}} \\propto \\sqrt{\\frac{T_c}{\\overline{M}_w}}",
      "aliases_latex": [
        "c^* = \\frac{\\sqrt{R_u T_c / \\overline{M}_w}}{\\Gamma(\\gamma)}"
      ],
      "keywords": [
