      ]
    },
    {
      "id": "aerosp.cea.n06_frozen_vs_equilibrium_nozzle_flow",
      "short_code": "CEA06",
      "kind": "theorem_formula",
      "title": "凍結流と平衡流のノズル膨張排気速度関係式",
      "summary": "等エントロピーノズル膨張において組成を固定する凍結流と局所平衡を保つ平衡流を定式化し、再結合発熱により平衡流排気速度が凍結流以上となることを示す。",
      "canonical_latex": "v_e^{\\mathrm{fr}} = \\sqrt{2\\big(h(T_c,\\mathbf{n}_c) - h(T_e^{\\mathrm{fr}},\\mathbf{n}_c)\\big)},\\quad v_e^{\\mathrm{eq}} = \\sqrt{2\\big(h(T_c,\\mathbf{n}_c) - h(T_e^{\\mathrm{eq}},\\mathbf{n}_e^{\\mathrm{eq}})\\big)} \\ge v_e^{\\mathrm{fr}}",
      "aliases_latex": [
        "I_{\\mathrm{sp}}^{\\mathrm{eq}} \\ge I_{\\mathrm{sp}}^{\\mathrm{fr}}"
