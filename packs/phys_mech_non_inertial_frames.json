      "canonical_latex": "\\left(\\frac{d\\mathbf{A}}{dt}\\right)_{\\mathrm{in}} = \\left(\\frac{d\\mathbf{A}}{dt}\\right)_{\\mathrm{rot}} + \\boldsymbol{\\omega} \\times \\mathbf{A}",
