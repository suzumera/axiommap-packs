    {
      "id": "phys.mech.nif09_foucault_precession_period",
      "short_code": "NIF09",
      "kind": "theorem_formula",
      "title": "フーコーの振り子の振動面回転角と歳差周期",
      "summary": "1恒星日あたりの振動面回転角 Δθ = -2π sin λ および振動面が1周する歳差周期 T_prec = T_sid / |sin λ| の公式。",
