    {
      "id": "phys.mech.nif03_rotating_velocity_acceleration",
      "short_code": "NIF03",
      "kind": "theorem_formula",
      "title": "非慣性回転座標系における速度と加速度の変換公式",
      "summary": "原点並進および回転を伴う座標系から観測した位置・速度・加速度と慣性系における絶対速度・絶対加速度との関係式。",
      "canonical_latex": "\\mathbf{v}_{\\mathrm{in}} = \\dot{\\mathbf{R}}_0 + \\mathbf{v}_{\\mathrm{rot}} + \\boldsymbol{\\omega}\\times\\mathbf{r},\\quad \\mathbf{a}_{\\mathrm{in}} = \\ddot{\\mathbf{R}}_0 + \\mathbf{a}_{\\mathrm{rot}} + 2\\boldsymbol{\\omega}\\times\\mathbf{v}_{\\mathrm{rot}} + \\dot{\\boldsymbol{\\omega}}\\times\\mathbf{r} + \\boldsymbol{\\omega}\\times(\\boldsymbol{\\omega}\\times\\mathbf{r})",
      "aliases_latex": [
        "\\ddot{\\mathbf{r}}_{\\mathrm{in}} = \\ddot{\\mathbf{R}}_0 + \\ddot{\\mathbf{r}}_{\\mathrm{rot}} + 2\\boldsymbol{\\omega}\\times\\dot{\\mathbf{r}}_{\\mathrm{rot}} + \\dot{\\boldsymbol{\\omega}}\\times\\mathbf{r} + \\boldsymbol{\\omega}\\times(\\boldsymbol{\\omega}\\times\\mathbf{r})"
      ],
      "keywords": [
