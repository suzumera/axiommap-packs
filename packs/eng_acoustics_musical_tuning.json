  "nodes": [
    {
      "id": "eng.mus.n01_string_wave_modes",
      "short_code": "MUS01",
      "kind": "theorem_formula",
      "title": "1次元弦の波動方程式と固定端境界条件による固有振動モード",
      "summary": "張力T・線密度μの一様な弦における1次元波動方程式を両端固定の境界条件のもとで変数分離して解くことで、基本周波数f1と整数倍の固有振動数fn=nf1（倍音列）が導かれる。",
      "canonical_latex": "\\mu \\frac{\\partial^2 y}{\\partial t^2} = T \\frac{\\partial^2 y}{\\partial x^2},\\quad y(0,t)=y(L,t)=0 \\implies f_n = \\frac{n}{2L}\\sqrt{\\frac{T}{\\mu}} = n f_1\\quad (n \\in \\mathbb{Z}_{\\ge 1})",
      "aliases_latex": [
        "f_n = \\frac{n c_{\\mathrm{str}}}{2L},\\quad c_{\\mathrm{str}} = \\sqrt{\\frac{T}{\\mu}}"
      ],
      "keywords": [
        "弦の固有振動",
        "1次元波動方程式",
        "固定端境界条件",
        "倍音列",
        "定在波"
      ],
