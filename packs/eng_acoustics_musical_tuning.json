    {
      "id": "eng.mus.n03_cent_logarithmic_pitch",
      "short_code": "MUS03",
      "kind": "definition",
      "title": "音程の対数尺度（セント値）の定義",
      "summary": "人間の音高知覚が周波数比の対数に従う性質（ヴェーバー＝フェヒナーの法則）に基づき、1オクターブ（周波数比2:1）を1200等分した無次元の対数音程尺度であるセント（cent）を定義する。",
      "canonical_latex": "\\Delta c(f_1, f_2) := 1200 \\log_2\\!\\left(\\frac{f_2}{f_1}\\right)\\;[\\mathrm{cent}]",
      "aliases_latex": [
