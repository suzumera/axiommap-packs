  "nodes": [
    {
      "id": "earth.seis.n01_cauchy_lame_boundary",
      "short_code": "SEIS01",
      "kind": "math_boundary",
      "title": "等方線形弾性体のコーシー運動方程式・ラメの構成則とヘルムホルツ分解",
      "summary": "連続体の運動方程式、等方線形弾性体のラメ定数による応力-ひずみ関係、および変位場のヘルムホルツ分解とベクトルラプラシアン恒等式をまとめた基礎境界。",
      "canonical_latex": "\\rho \\frac{\\partial^2 u_i}{\\partial t^2} = \\frac{\\partial \\sigma_{ij}}{\\partial x_j},\\quad \\sigma_{ij} = \\lambda \\delta_{ij} \\varepsilon_{kk} + 2\\mu \\varepsilon_{ij},\\quad \\varepsilon_{ij} = \\frac{1}{2}\\left(\\frac{\\partial u_i}{\\partial x_j} + \\frac{\\partial u_j}{\\partial x_i}\\right),\\quad \\mathbf{u} = \\nabla\\phi + \\nabla\\times\\boldsymbol{\\psi}\\;(\\nabla\\cdot\\boldsymbol{\\psi}=0),\\quad \\nabla^2\\mathbf{u} = \\nabla(\\nabla\\cdot\\mathbf{u}) - \\nabla\\times(\\nabla\\times\\mathbf{u})",
      "aliases_latex": [
        "\\rho \\ddot{\\mathbf{u}} = \\nabla\\cdot\\boldsymbol{\\sigma},\\quad \\boldsymbol{\\sigma} = \\lambda(\\nabla\\cdot\\mathbf{u})\\mathbf{I} + 2\\mu\\boldsymbol{\\varepsilon}"
      ],
      "keywords": [
        "Cauchy equation of motion",
        "Lame parameters",
        "isotropic elasticity",
        "Helmholtz decomposition"
      ],
      "domain_tags": [
        "geophysics",
        "seismology",
        "continuum_mechanics"
      ],
      "intuition_oneliner": "要するに、連続体の変形や波の伝わり方を、ニュートンの運動方程式と物質の硬さ（ラメ定数）を使って定式化した基本法則です。",
      "diagram_svg": "<svg viewBox=\"0 0 600 260\" xmlns=\"http://www.w3.org/2000/svg\"><rect x=\"80\" y=\"90\" width=\"130\" height=\"80\" rx=\"8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><text x=\"145\" y=\"135\" text-anchor=\"middle\" fill=\"currentColor\">運動方程式</text><rect x=\"235\" y=\"90\" width=\"130\" height=\"80\" rx=\"8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><text x=\"300\" y=\"135\" text-anchor=\"middle\" fill=\"currentColor\">ラメの構成則</text><rect x=\"390\" y=\"90\" width=\"130\" height=\"80\" rx=\"8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><text x=\"455\" y=\"135\" text-anchor=\"middle\" fill=\"currentColor\">ヘルムホルツ分解</text><path d=\"M 210 130 L 235 130\" fill=\"none\" stroke=\"#10b981\" stroke-width=\"2\"/><path d=\"M 365 130 L 390 130\" fill=\"none\" stroke=\"#10b981\" stroke-width=\"2\"/></svg>"
