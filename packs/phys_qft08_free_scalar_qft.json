      "canonical_latex": "[\\hat{\\phi}(t,\\mathbf{x}), \\hat{\\pi}(t,\\mathbf{y})] = i\\delta^{(3)}(\\mathbf{x}-\\mathbf{y}),\\qquad [\\hat{\\phi}(t,\\mathbf{x}), \\hat{\\phi}(t,\\mathbf{y})] = [\\hat{\\pi}(t,\\mathbf{x}), \\hat{\\pi}(t,\\mathbf{y})] = 0",
      "aliases_latex": [
