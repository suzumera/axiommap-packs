    {
      "id": "phys.qft08.n03_conjugate_momentum_hamiltonian_density",
      "short_code": "QFT08_03",
      "kind": "definition",
      "title": "場の正準共役運動量密度とハミルトニアン密度",
      "summary": "ラグランジアン密度の時間微分に対する偏導関数として正準共役運動量密度を定義し、ルジャンドル変換によりハミルトニアン密度を構成する。",
      "canonical_latex": "\\pi(x) := \\frac{\\partial\\mathcal{L}}{\\partial\\dot{\\phi}(x)} = \\dot{\\phi}(x),\\qquad \\mathcal{H} := \\pi\\dot{\\phi} - \\mathcal{L} = \\frac{1}{2}\\pi^2 + \\frac{1}{2}|\\nabla\\phi|^2 + \\frac{1}{2}m^2\\phi^2",
