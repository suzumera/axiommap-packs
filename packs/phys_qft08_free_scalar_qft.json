    {
      "id": "phys.qft08.n09_gaussian_path_integral_propagator_wick",
      "short_code": "QFT08_09",
      "kind": "theorem_formula",
      "title": "ガウス汎関数積分による母汎関数の評価とウィックの定理",
      "summary": "自由場の母汎関数を場のシフトによるガウス積分で厳密に評価し、外場源に関する汎関数微分から2点相関関数（ファインマン伝播関数）およびウィックの定理を導く。",
      "canonical_latex": "Z_0[J] = Z_0[0]\\exp\\!\\left(-\\frac{1}{2}\\int d^4x\\,d^4y\\,J(x)\\Delta_F(x-y)J(y)\\right),\\qquad \\langle 0|T\\{\\hat{\\phi}(x_1)\\hat{\\phi}(x_2)\\}|0\\rangle = \\left.\\frac{(-i)^2}{Z_0[0]}\\frac{\\delta^2 Z_0[J]}{\\delta J(x_1)\\delta J(x_2)}\\right|_{J=0} = \\Delta_F(x_1-x_2)",
      "aliases_latex": [
