    {
      "id": "phys.em.emr03_retarded_potentials",
      "short_code": "EMR03",
      "kind": "theorem_formula",
      "title": "遅延ポテンシャル（因果的グリーン関数解）",
      "summary": "自由空間における非斉次波動方程式を因果律を満たす遅延グリーン関数で解いた、時刻の遅れを伴う電磁ポテンシャルの積分表示。",
      "canonical_latex": "\\phi(\\mathbf{r},t)=\\frac{1}{4\\pi\\varepsilon_0}\\iiint_V\\frac{\\rho(\\mathbf{r}',t_{\\mathrm{ret}})}{|\\mathbf{r}-\\mathbf{r}'|}\\,dV',\\quad \\mathbf{A}(\\mathbf{r},t)=\\frac{\\mu_0}{4\\pi}\\iiint_V\\frac{\\mathbf{J}(\\mathbf{r}',t_{\\mathrm{ret}})}{|\\mathbf{r}-\\mathbf{r}'|}\\,dV'\\quad\\left(t_{\\mathrm{ret}}:=t-\\frac{|\\mathbf{r}-\\mathbf{r}'|}{c}\\right)",
      "aliases_latex": [
        "G_{\\mathrm{ret}}(\\mathbf{r}-\\mathbf{r}',t-t')=\\frac{\\delta(t-t'-|\\mathbf{r}-\\mathbf{r}'|/c)}{4\\pi|\\mathbf{r}-\\mathbf{r}'|}"
      ],
      "keywords": [
        "遅延ポテンシャル",
