      "canonical_latex": "\\nabla^2\\phi-\\frac{1}{c^2}\\frac{\\partial^2\\phi}{\\partial t^2}=-\\frac{\\rho}{\\varepsilon_0},\\qquad \\nabla^2\\mathbf{A}-\\frac{1}{c^2}\\frac{\\partial^2\\mathbf{A}}{\\partial t^2}=-\\mu_0\\mathbf{J}",
      "aliases_latex": [
        "\\Box\\phi=\\frac{\\rho}{\\varepsilon_0},\\quad \\Box\\mathbf{A}=\\mu_0\\mathbf{J}"
