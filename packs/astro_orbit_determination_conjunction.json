        "orbit_determination"
      ]
    },
    {
      "id": "orbita.od_stm_p.n02_stm_variational_equation",
      "short_code": "OD02",
      "kind": "theorem_formula",
      "title": "状態遷移行列（STM）の変分方程式",
      "summary": "参照軌道周りの微小摂動の時間発展を記述する状態遷移行列（STM）の定義と、ヤコビアン行列を用いた線形微分方程式（変分方程式）。",
      "canonical_latex": "\\Phi(t, t_0) := \\frac{\\partial \\mathbf{X}(t)}{\\partial \\mathbf{X}(t_0)},\\quad \\dot{\\Phi}(t, t_0) = A(t)\\Phi(t, t_0),\\quad \\Phi(t_0, t_0) = I_6,\\quad A(t) := \\left.\\frac{\\partial \\mathbf{f}(\\mathbf{X}, t)}{\\partial \\mathbf{X}}\\right|_{\\mathbf{X}^*(t)}",
      "aliases_latex": [
        "\\delta\\mathbf{X}(t) = \\Phi(t, t_0)\\delta\\mathbf{X}(t_0),\\quad \\dot{\\Phi} = A(t)\\Phi"
      ],
      "keywords": [
        "状態遷移行列",
        "STM",
        "変分方程式",
        "ヤコビアン"
      ],
      "domain_tags": [
        "orbital_mechanics",
        "orbit_determination"
      ]
    },
    {
