    {
      "id": "orbita.od_stm_p.n07_tca_and_b_plane_geometry",
      "short_code": "OD07",
      "kind": "definition",
      "title": "最接近時刻（TCA）条件とB平面（Encounter Plane）座標系",
      "summary": "2物体間の相対位置と相対速度が直交する最接近時刻（TCA）の定義と、相対速度に垂直な2次元B平面（Encounter Plane）の正規直交基底。",
      "canonical_latex": "\\mathbf{r}_{\\mathrm{rel}}(t_{\\mathrm{TCA}}) \\cdot \\mathbf{v}_{\\mathrm{rel}}(t_{\\mathrm{TCA}}) = 0,\\quad \\hat{\\boldsymbol{\\xi}}_B = \\frac{\\mathbf{v}_{\\mathrm{rel}} \\times \\mathbf{v}_p}{\\|\\mathbf{v}_{\\mathrm{rel}} \\times \\mathbf{v}_p\\|},\\quad \\hat{\\boldsymbol{\\eta}}_B = \\frac{\\mathbf{v}_{\\mathrm{rel}}}{\\|\\mathbf{v}_{\\mathrm{rel}}\\|},\\quad \\hat{\\boldsymbol{\\zeta}}_B = \\hat{\\boldsymbol{\\xi}}_B \\times \\hat{\\boldsymbol{\\eta}}_B",
