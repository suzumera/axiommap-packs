      "canonical_latex": "P_{\\mathrm{comb}} = P_{r,1}(t_{\\mathrm{TCA}}) + P_{r,2}(t_{\\mathrm{TCA}}),\\quad d_M^2 = \\mathbf{r}_{\\mathrm{rel}}^\\top P_{\\mathrm{comb}}^{-1} \\mathbf{r}_{\\mathrm{rel}}",
