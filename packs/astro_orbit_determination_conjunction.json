  "nodes": [
    {
      "id": "orbita.od_stm_p.n01_nonlinear_od_state_dynamics",
      "short_code": "OD01",
      "kind": "definition",
      "title": "精密軌道決定の状態空間モデルと観測方程式",
      "summary": "6次元状態ベクトル（位置・速度）、摂動を含む非線形軌道運動方程式、および観測局からの非線形観測モデルの定式化。",
      "canonical_latex": "\\mathbf{X}(t) = \\begin{pmatrix} \\mathbf{r}(t) \\\\ \\mathbf{v}(t) \\end{pmatrix} \\in \\mathbb{R}^6,\\quad \\dot{\\mathbf{X}}(t) = \\mathbf{f}(\\mathbf{X}(t), t),\\quad \\mathbf{y}_k = \\mathbf{h}(\\mathbf{X}(t_k), t_k) + \\boldsymbol{\\epsilon}_k",
      "aliases_latex": [
        "\\dot{\\mathbf{X}} = \\mathbf{f}(\\mathbf{X}, t),\\quad \\mathbf{y}_k = \\mathbf{h}(\\mathbf{X}_k) + \\boldsymbol{\\epsilon}_k"
      ],
      "keywords": [
