  "nodes": [
    {
      "id": "eng.cth.n01_gibbs_free_energy_def",
      "short_code": "CTH01",
      "kind": "definition",
      "title": "ギブズ自由エネルギーと閉鎖系の基本熱力学関係式",
      "summary": "内部エネルギー・エンタルピー・エントロピーのルジャンドル変換によりギブズ自由エネルギー G = U + pV - TS を定義し、閉鎖系の基本式と等温定圧下での自発変化条件を与える。",
      "canonical_latex": "G := U + pV - TS,\\qquad dG = -S\\,dT + V\\,dp\\;\\text{ (closed, reversible)},\\qquad dG \\le 0\\;\\text{ (const. }T,p\\text{)}",
      "aliases_latex": [
        "G = H - TS",
        "dG = V\\,dp - S\\,dT"
      ],
      "keywords": [
        "Gibbs free energy",
        "Legendre transform",
        "fundamental thermodynamic relation",
        "spontaneity"
      ],
      "domain_tags": [
        "chemical_engineering",
        "thermodynamics"
      ],
      "intuition_oneliner": "等温・定圧のもとで「変化や化学反応が自然に起きるか」を判定するエネルギーの指標です。Gが減少する向き（dG ≤ 0）へ変化が進み、最小値で平衡に達します。",
      "diagram_svg": "<svg viewBox=\"0 0 600 260\" xmlns=\"http://www.w3.org/2000/svg\"><line x1=\"80\" y1=\"210\" x2=\"520\" y2=\"210\" stroke=\"currentColor\" stroke-width=\"2\"/><line x1=\"80\" y1=\"30\" x2=\"80\" y2=\"210\" stroke=\"currentColor\" stroke-width=\"2\"/><text x=\"40\" y=\"50\" fill=\"currentColor\" font-size=\"18\">G</text><text x=\"460\" y=\"235\" fill=\"currentColor\" font-size=\"15\">変化の進行</text><path d=\"M 110 60 Q 220 80 320 180 T 480 120\" fill=\"none\" stroke=\"#3b82f6\" stroke-width=\"3\"/><path d=\"M 150 75 L 240 135\" stroke=\"#10b981\" stroke-width=\"3\"/><polygon points=\"245,138 232,137 238,127\" fill=\"#10b981\"/><text x=\"170\" y=\"70\" fill=\"#10b981\" font-size=\"15\">dG ≤ 0 (自発変化)</text><circle cx=\"320\" cy=\"180\" r=\"6\" fill=\"#f97316\"/><text x=\"285\" y=\"202\" fill=\"#f97316\" font-size=\"15\">平衡 (dG = 0)</text></svg>"
    },
    {
      "id": "eng.cth.n02_chemical_potential_open_system",
      "short_code": "CTH02",
      "kind": "definition",
      "title": "多成分開放系の化学ポテンシャルとギブズの基本式",
      "summary": "物質量 n_i が変化する多成分系において、ギブズエネルギーの偏微分係数として化学ポテンシャル mu_i を定義し、開放系の基本関係式を与える。",
      "canonical_latex": "\\mu_i := \\left(\\frac{\\partial G}{\\partial n_i}\\right)_{T,p,n_{j\\neq i}},\\qquad dG = -S\\,dT + V\\,dp + \\sum_{i=1}^{C} \\mu_i\\,dn_i",
      "aliases_latex": [
        "dG = -S\\,dT + V\\,dp + \\sum_i \\mu_i\\,dn_i"
      ],
      "keywords": [
        "chemical potential",
        "open system",
        "multicomponent",
        "partial molar Gibbs energy"
      ],
      "domain_tags": [
        "chemical_engineering",
        "thermodynamics"
      ],
      "intuition_oneliner": "物質の出入りがある開放系で、ある成分を1モルだけ足したときに全体のギブズエネルギーがどれだけ増えるかを表す「1モルあたりのエネルギー単価」が化学ポテンシャル。",
      "diagram_svg": "<svg viewBox=\"0 0 600 260\" xmlns=\"http://www.w3.org/2000/svg\"><rect x=\"180\" y=\"70\" width=\"240\" height=\"140\" rx=\"12\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><text x=\"300\" y=\"115\" text-anchor=\"middle\" fill=\"currentColor\" font-size=\"15\">開放系 (T, p 一定)</text><text x=\"300\" y=\"145\" text-anchor=\"middle\" fill=\"#3b82f6\" font-size=\"16\">G (ギブズエネルギー)</text><text x=\"300\" y=\"175\" text-anchor=\"middle\" fill=\"currentColor\" font-size=\"13\">成分 n1, n2, ...</text><line x1=\"60\" y1=\"140\" x2=\"170\" y2=\"140\" stroke=\"#f97316\" stroke-width=\"3\"/><polygon points=\"170,134 180,140 170,146\" fill=\"#f97316\"/><text x=\"115\" y=\"125\" text-anchor=\"middle\" fill=\"#f97316\" font-size=\"14\">+ dn_i</text><text x=\"300\" y=\"40\" text-anchor=\"middle\" fill=\"#10b981\" font-size=\"15\">μ_i = ∂G / ∂n_i (1モルあたりの増分)</text><line x1=\"420\" y1=\"140\" x2=\"530\" y2=\"140\" stroke=\"#10b981\" stroke-width=\"3\"/><polygon points=\"530,134 540,140 530,146\" fill=\"#10b981\"/><text x=\"480\" y=\"125\" text-anchor=\"middle\" fill=\"#10b981\" font-size=\"14\">dG = μ_i dn_i</text></svg>"
    },
    {
      "id": "eng.cth.n03_euler_gibbs_molar_relation",
      "short_code": "CTH03",
      "kind": "theorem_formula",
      "title": "示量性に基づくギブズエネルギーのオイラー積分式",
      "summary": "一定の温度・圧力におけるギブズエネルギーの1次同次性（示量性）から、G が各成分の物質量と化学ポテンシャルの積和で表されることを示す。",
      "canonical_latex": "G(T,p,\\lambda n_1,\\dots,\\lambda n_C) = \\lambda G(T,p,n_1,\\dots,n_C) \\implies G = \\sum_{i=1}^{C} n_i \\mu_i",
      "aliases_latex": [
        "G = \\sum_i n_i \\mu_i"
      ],
      "keywords": [
        "Euler homogeneous function",
        "extensive property",
        "chemical potential",
        "integral form"
      ],
      "domain_tags": [
        "chemical_engineering",
        "thermodynamics"
      ]
    },
    {
      "id": "eng.cth.n04_gibbs_duhem_equation",
      "short_code": "CTH04",
      "kind": "theorem_formula",
      "title": "ギブズ＝デュエムの式（Gibbs-Duhem Equation）",
      "summary": "オイラー積分式の全微分と開放系の基本式を比較することで、示強変数 T, p, mu_i 間の従属関係であるギブズ＝デュエムの式を導出する。",
      "canonical_latex": "S\\,dT - V\\,dp + \\sum_{i=1}^{C} n_i\\,d\\mu_i = 0,\\qquad \\sum_{i=1}^{C} x_i\\,d\\mu_i = 0\\;\\text{ (const. }T,p\\text{)}",
      "aliases_latex": [
        "\\sum_{i=1}^{C} n_i\\,d\\mu_i = -S\\,dT + V\\,dp"
      ],
      "keywords": [
        "Gibbs-Duhem equation",
        "intensive variables",
        "multicomponent thermodynamics"
      ],
      "domain_tags": [
        "chemical_engineering",
        "thermodynamics"
      ]
    },
    {
      "id": "eng.cth.n05_chemical_potential_ideal_activity",
      "short_code": "CTH05",
      "kind": "theorem_formula",
      "title": "理想気体・溶液における化学ポテンシャルの活量表示",
      "summary": "等温下での圧力積分と理想気体の状態方程式から、化学ポテンシャルの標準状態と分圧または活量を用いた対数表現を導出する。",
      "canonical_latex": "\\mu_i(T,p,\\{x_j\\}) = \\mu_i^\\circ(T) + RT\\ln a_i,\\qquad a_i^{\\mathrm{ideal\\ gas}} = \\frac{p_i}{p^\\circ}",
      "aliases_latex": [
        "\\mu_i = \\mu_i^\\circ + RT\\ln(p_i/p^\\circ)"
      ],
      "keywords": [
        "activity",
        "standard chemical potential",
        "ideal gas",
        "fugacity"
      ],
      "domain_tags": [
        "chemical_engineering",
        "thermodynamics"
      ]
    },
    {
      "id": "eng.cth.n06_reaction_gibbs_energy_extent",
      "short_code": "CTH06",
      "kind": "definition",
      "title": "反応進行度と反応ギブズエネルギー・反応商",
      "summary": "化学反応の反応進行度 xi に伴うギブズエネルギー変化率として反応ギブズエネルギーを定義し、標準反応ギブズエネルギーと反応商 Q による表現を得る。",
      "canonical_latex": "\\Delta_r G := \\left(\\frac{\\partial G}{\\partial \\xi}\\right)_{T,p} = \\sum_{i=1}^{C} \\nu_i \\mu_i = \\Delta_r G^\\circ(T) + RT\\ln Q,\\qquad Q := \\prod_{i=1}^{C} a_i^{\\nu_i}",
      "aliases_latex": [
        "\\Delta_r G = \\Delta_r G^\\circ + RT\\ln Q"
      ],
      "keywords": [
        "extent of reaction",
        "reaction Gibbs energy",
        "reaction quotient"
      ],
      "domain_tags": [
        "chemical_engineering",
        "reaction_engineering"
      ]
    },
    {
      "id": "eng.cth.n07_equilibrium_constant_gibbs",
      "short_code": "CTH07",
      "kind": "theorem_formula",
      "title": "化学平衡条件と平衡定数（ΔG° = -RT ln K）",
      "summary": "等温定圧下の化学平衡条件 ΔrG = 0 から、熱力学的平衡定数 K と標準反応ギブズエネルギーの関係式 ΔrG° = -RT ln K を導出する。",
      "canonical_latex": "\\Delta_r G = 0 \\implies \\Delta_r G^\\circ(T) = -RT \\ln K(T),\\qquad K(T) := \\left(\\prod_{i=1}^{C} a_i^{\\nu_i}\\right)_{\\mathrm{eq}}",
      "aliases_latex": [
        "\\Delta G^\\circ = -RT\\ln K"
      ],
      "keywords": [
        "chemical equilibrium",
        "equilibrium constant",
        "standard reaction Gibbs energy"
      ],
      "domain_tags": [
        "chemical_engineering",
        "reaction_engineering"
      ]
    },
    {
      "id": "eng.cth.n08_gibbs_helmholtz_equation",
      "short_code": "CTH08",
      "kind": "theorem_formula",
      "title": "ギブズ＝ヘルムホルツの式（Gibbs-Helmholtz Equation）",
      "summary": "G = H - TS と (∂G/∂T)_p = -S を用いて、G/T の温度微分がエンタルピーと結びつくギブズ＝ヘルムホルツの式を導出する。",
      "canonical_latex": "\\left(\\frac{\\partial (G/T)}{\\partial T}\\right)_p = -\\frac{H}{T^2},\\qquad \\frac{d(\\Delta_r G^\\circ / T)}{dT} = -\\frac{\\Delta_r H^\\circ}{T^2}",
      "aliases_latex": [
        "\\left(\\frac{\\partial (\\Delta G/T)}{\\partial T}\\right)_p = -\\frac{\\Delta H}{T^2}"
      ],
      "keywords": [
        "Gibbs-Helmholtz equation",
        "enthalpy",
        "temperature dependence"
      ],
      "domain_tags": [
        "chemical_engineering",
        "thermodynamics"
      ]
    },
    {
      "id": "eng.cth.n09_vant_hoff_equation",
      "short_code": "CTH09",
      "kind": "theorem_formula",
      "title": "ファントホッフの式（van 't Hoff Equation）と平衡定数の温度依存性",
      "summary": "平衡定数と標準反応ギブズエネルギーの関係にギブズ＝ヘルムホルツの式を適用し、平衡定数の温度依存性を記述するファントホッフの式を導出する。",
      "canonical_latex": "\\frac{d\\ln K}{dT} = \\frac{\\Delta_r H^\\circ(T)}{RT^2},\\qquad \\ln\\frac{K(T_2)}{K(T_1)} = -\\frac{\\Delta_r H^\\circ}{R}\\left(\\frac{1}{T_2} - \\frac{1}{T_1}\\right)\\;\\text{ (const. }\\Delta_r H^\\circ\\text{)}",
      "aliases_latex": [
        "\\frac{d\\ln K}{dT} = \\frac{\\Delta H^\\circ}{RT^2}"
      ],
      "keywords": [
        "van 't Hoff equation",
        "equilibrium constant",
        "reaction enthalpy"
      ],
      "domain_tags": [
        "chemical_engineering",
        "reaction_engineering"
      ]
    }
  ],
