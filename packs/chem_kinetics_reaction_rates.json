      "canonical_latex": "\\frac{d[I]}{dt} = r_{\\mathrm{form}}(I) - r_{\\mathrm{cons}}(I) \\approx 0 \\implies [I]_{\\mathrm{ss}} = \\frac{r_{\\mathrm{form}}(I)}{k_{\\mathrm{cons}}}",
      "aliases_latex": [
        "\\frac{d[I]}{dt} \\approx 0"
      ],
      "keywords": [
        "steady-state approximation",
        "reaction intermediate",
        "quasi-steady state"
      ],
      "domain_tags": [
        "physical_chemistry",
        "chemical_kinetics"
      ]
    },
    {
      "id": "chem.kin.n04_lindemann_hinshelwood_mechanism",
