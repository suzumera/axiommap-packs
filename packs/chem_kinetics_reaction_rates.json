      "diagram_svg": "<svg viewBox=\"0 0 600 260\" xmlns=\"http://www.w3.org/2000/svg\"><rect x=\"120\" y=\"100\" width=\"100\" height=\"60\" rx=\"5\" fill=\"none\" stroke=\"currentColor\" /><rect x=\"380\" y=\"100\" width=\"100\" height=\"60\" rx=\"5\" fill=\"none\" stroke=\"currentColor\" /><path d=\"M230 120 C280 90 320 90 370 120\" fill=\"none\" stroke=\"#3b82f6\" stroke-width=\"2\" /><path d=\"M370 140 C320 170 280 170 230 140\" fill=\"none\" stroke=\"#f97316\" stroke-width=\"2\" /><text x=\"290\" y=\"85\" fill=\"#3b82f6\" font-size=\"14\">kf</text><text x=\"290\" y=\"190\" fill=\"#f97316\" font-size=\"14\">kr</text><text x=\"150\" y=\"135\" fill=\"currentColor\" font-size=\"16\">反応物</text><text x=\"410\" y=\"135\" fill=\"currentColor\" font-size=\"16\">生成物</text></svg>"
