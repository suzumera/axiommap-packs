      "kind": "theorem_formula",
      "title": "リンデマン＝ヒンシェルウッド機構と単分子反応の圧力依存性",
      "summary": "衝突活性化と脱活性化および単分子分解の素反応に定常状態近似を適用して導かれる、単分子反応速度定数の高圧1次極限・低圧2次極限の表式。",
      "canonical_latex": "r = \\frac{k_1 k_2 [A][M]}{k_{-1}[M] + k_2},\\qquad r \\xrightarrow{[M]\\to\\infty} k_{\\infty}[A]\\;\\left(k_\\infty = \\frac{k_1 k_2}{k_{-1}}\\right),\\qquad r \\xrightarrow{[M]\\to 0} k_1[A][M]",
      "aliases_latex": [
        "k_{\\mathrm{uni}} = \\frac{k_1 k_2 [M]}{k_{-1}[M] + k_2}"
      ],
      "keywords": [
        "Lindemann-Hinshelwood mechanism",
        "unimolecular reaction",
        "falloff curve"
      ],
      "domain_tags": [
        "physical_chemistry",
        "chemical_kinetics"
      ]
    },
    {
      "id": "chem.kin.n05_reversible_first_order_kinetics",
      "short_code": "CK05",
      "kind": "theorem_formula",
      "title": "可逆1次反応の積分速度式と緩和時間",
      "summary": "正逆両方向に1次で進行する可逆反応において、平衡濃度への指数関数的緩和を記述する積分速度式と化学緩和時間。",
      "canonical_latex": "[A](t) = [A]_{\\mathrm{eq}} + \\big([A]_0 - [A]_{\\mathrm{eq}}\\big)e^{-(k_1 + k_{-1})t},\\qquad [A]_{\\mathrm{eq}} = \\frac{k_{-1}}{k_1 + k_{-1}}[A]_0,\\qquad \\tau = \\frac{1}{k_1 + k_{-1}}",
      "aliases_latex": [
        "\\frac{[A](t) - [A]_{\\mathrm{eq}}}{[A]_0 - [A]_{\\mathrm{eq}}} = e^{-(k_1+k_{-1})t}"
