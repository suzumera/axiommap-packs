    "language": "ja",
    "description": "β平面近似の渦度方程式からロスビー波の分散関係、エルテルのポテンシャル渦度保存、海洋表層のエクマン螺旋・エクマン輸送を導出する。"
  },
  "nodes": [
    {
      "id": "earth.rossby.n01_beta_plane_approx",
      "short_code": "RE01",
      "kind": "definition",
      "title": "β平面近似（コリオリパラメータの線形化）",
      "summary": "基準緯度 φ0 の近傍でコリオリパラメータ f(φ) を南北座標 y に関して1次までテイラー展開し、線形近似 f(y) ≈ f0 + βy を導入する。",
      "canonical_latex": "f(y) \\approx f_0 + \\beta y,\\quad f_0 := 2\\Omega\\sin\\varphi_0,\\quad \\beta := \\left.\\frac{df}{dy}\\right|_{\\varphi_0} = \\frac{2\\Omega\\cos\\varphi_0}{R_E}",
      "aliases_latex": [
        "f = f_0 + \\beta y"
      ],
      "keywords": [
        "beta-plane",
        "Coriolis parameter",
        "planetary vorticity gradient"
      ],
      "domain_tags": [
        "oceanography",
        "geophysical_fluid_dynamics"
      ]
    },
    {
      "id": "earth.rossby.n02_barotropic_vorticity_eq",
      "short_code": "RE02",
      "kind": "theorem_formula",
      "title": "順圧渦度方程式と絶対渦度保存",
      "summary": "水平運動方程式の鉛直成分回転をとることで圧力傾度力項を消去し、非発散順圧流における絶対渦度 ζ + f のラグランジュ保存を導く。",
      "canonical_latex": "\\zeta := \\mathbf{k}\\cdot(\\nabla_h\\times\\mathbf{u}_h) = \\frac{\\partial v}{\\partial x} - \\frac{\\partial u}{\\partial y},\\quad \\frac{D_h}{Dt}(\\zeta + f) + (\\zeta + f)\\nabla_h\\cdot\\mathbf{u}_h = 0,\\quad \\nabla_h\\cdot\\mathbf{u}_h = 0 \\implies \\frac{D_h}{Dt}(\\zeta + f) = 0",
      "aliases_latex": [
        "\\frac{D_h}{Dt}(\\zeta + f) = 0"
      ],
      "keywords": [
        "barotropic vorticity equation",
        "absolute vorticity",
        "relative vorticity"
      ],
      "domain_tags": [
        "oceanography",
        "geophysical_fluid_dynamics"
      ]
    },
    {
      "id": "earth.rossby.n03_quasigeostrophic_streamfunction",
      "short_code": "RE03",
      "kind": "definition",
      "title": "地衡流流線関数と準地衡風渦度",
      "summary": "基準コリオリパラメータ f0 を用いて圧力擾乱から地衡流流線関数 ψ を定義し、地衡流速と相対渦度を ψ の偏微分およびラプラシアンで表す。",
      "canonical_latex": "\\psi := \\frac{p'}{\\rho_0 f_0},\\quad u_g = -\\frac{\\partial\\psi}{\\partial y},\\quad v_g = \\frac{\\partial\\psi}{\\partial x},\\quad \\zeta_g = \\nabla_h^2\\psi",
      "aliases_latex": [
        "\\mathbf{u}_g = \\mathbf{k}\\times\\nabla_h\\psi"
      ],
      "keywords": [
        "geostrophic streamfunction",
        "quasi-geostrophic vorticity"
      ],
      "domain_tags": [
        "oceanography",
        "geophysical_fluid_dynamics"
      ]
    },
    {
      "id": "earth.rossby.n04_rossby_wave_dispersion",
      "short_code": "RE04",
      "kind": "theorem_formula",
      "title": "順圧ロスビー波の分散関係と西向き位相伝播",
      "summary": "β平面上の線形化順圧渦度方程式に平面波解を代入し、ロスビー波の分散関係および位相速度が常に西向き（負のx方向）であることを導く。",
      "canonical_latex": "\\frac{\\partial}{\\partial t}\\nabla_h^2\\psi + \\beta\\frac{\\partial\\psi}{\\partial x} = 0,\\quad \\psi = \\operatorname{Re}\\!\\left[\\hat{\\psi}e^{i(kx+ly-\\omega t)}\\right] \\implies \\omega = -\\frac{\\beta k}{k^2 + l^2},\\quad c_x = \\frac{\\omega}{k} = -\\frac{\\beta}{k^2+l^2} < 0",
      "aliases_latex": [
        "\\omega = -\\frac{\\beta k}{k^2 + l^2}"
      ],
      "keywords": [
        "Rossby wave",
        "dispersion relation",
        "westward phase propagation"
      ],
      "domain_tags": [
        "oceanography",
        "geophysical_fluid_dynamics"
      ]
    },
    {
      "id": "earth.rossby.n05_ertel_potential_vorticity",
      "short_code": "RE05",
      "kind": "theorem_formula",
      "title": "エルテルのポテンシャル渦度保存則",
      "summary": "非粘性断熱流体において保存される温位 θ と絶対渦度ベクトル ω_a の内積を密度 ρ で割ったエルテルのポテンシャル渦度 Π が流体粒子に沿って保存されることを示す。",
      "canonical_latex": "\\Pi := \\frac{\\boldsymbol{\\omega}_a\\cdot\\nabla\\theta}{\\rho},\\quad \\boldsymbol{\\omega}_a := \\nabla\\times\\mathbf{u} + 2\\boldsymbol{\\Omega},\\quad \\frac{D\\theta}{Dt} = 0 \\implies \\frac{D\\Pi}{Dt} = 0",
      "aliases_latex": [
        "q = \\frac{\\boldsymbol{\\omega}_a\\cdot\\nabla\\theta}{\\rho}"
      ],
      "keywords": [
        "Ertel potential vorticity",
        "baroclinic torque",
        "material conservation"
      ],
      "domain_tags": [
        "oceanography",
        "geophysical_fluid_dynamics"
      ]
    },
    {
      "id": "earth.rossby.n06_ekman_layer_equations",
      "short_code": "RE06",
      "kind": "theorem_formula",
      "title": "海洋表層エクマン層の定常運動方程式（コリオリ力と渦粘性の釣合い）",
      "summary": "海洋表層の定常水平運動方程式を地衡流とエクマン流に分解し、海面の風応力境界条件のもとでコリオリ力と鉛直渦粘性力の釣合いを定式化する。",
      "canonical_latex": "-f v_E = A_z\\frac{\\partial^2 u_E}{\\partial z^2},\\quad f u_E = A_z\\frac{\\partial^2 v_E}{\\partial z^2},\\quad \\mathbf{u}_E = \\mathbf{u}_h - \\mathbf{u}_g,\\quad \\left.\\rho_0 A_z\\frac{\\partial\\mathbf{u}_E}{\\partial z}\\right|_{z=0} = \\boldsymbol{\\tau}_w",
      "aliases_latex": [
        "f\\mathbf{k}\\times\\mathbf{u}_E = A_z\\frac{\\partial^2\\mathbf{u}_E}{\\partial z^2}"
      ],
      "keywords": [
        "Ekman layer",
        "eddy viscosity",
        "wind stress"
      ],
      "domain_tags": [
        "oceanography",
        "geophysical_fluid_dynamics"
      ]
    },
    {
      "id": "earth.rossby.n07_ekman_spiral",
      "short_code": "RE07",
      "kind": "theorem_formula",
      "title": "エクマン螺旋とエクマン層厚（表層45度偏向）",
      "summary": "複素速度 W = u_E + i v_E を用いてエクマン層方程式を解き、深度とともに指数減衰しながら回転するエクマン螺旋と表層流の45度偏向を導く。",
      "canonical_latex": "W(z) := u_E + i v_E = W_0 e^{(1+i)z/D_E},\\quad D_E := \\sqrt{\\frac{2A_z}{|f|}},\\quad \\boldsymbol{\\tau}_w = (\\tau_{wx}, 0) \\implies u_E(z) = V_0 e^{z/D_E}\\cos\\!\\left(\\frac{\\pi}{4}+\\frac{z}{D_E}\\right),\\; v_E(z) = V_0 e^{z/D_E}\\sin\\!\\left(\\frac{\\pi}{4}+\\frac{z}{D_E}\\right)",
      "aliases_latex": [
        "D_E = \\sqrt{\\frac{2A_z}{|f|}}"
      ],
      "keywords": [
        "Ekman spiral",
        "Ekman depth",
        "surface deflection"
      ],
      "domain_tags": [
        "oceanography",
        "geophysical_fluid_dynamics"
      ]
    },
    {
      "id": "earth.rossby.n08_ekman_transport",
      "short_code": "RE08",
      "kind": "theorem_formula",
      "title": "エクマン輸送量と風応力との直交関係",
      "summary": "エクマン層の運動方程式を海面から深層まで鉛直積分することで、正味の質量輸送量 M_E が風応力ベクトル τ_w と直交（北半球では右向き90度）することを導く。",
      "canonical_latex": "\\mathbf{M}_E := \\int_{-\\infty}^{0}\\rho_0\\mathbf{u}_E\\,dz = \\frac{\\boldsymbol{\\tau}_w\\times\\mathbf{k}}{f},\\quad M_{Ex} = \\frac{\\tau_{wy}}{f},\\quad M_{Ey} = -\\frac{\\tau_{wx}}{f}",
      "aliases_latex": [
        "\\mathbf{M}_E = \\frac{\\boldsymbol{\\tau}_w\\times\\mathbf{k}}{f}"
      ],
      "keywords": [
        "Ekman transport",
        "wind-driven circulation"
      ],
      "domain_tags": [
        "oceanography",
        "geophysical_fluid_dynamics"
      ]
    }
  ],
