{
  "pack_meta": {
    "pack_id": "or.opt.kkt_duality",
    "schema_version": "1.0.0",
    "pack_version": "0.1.0",
    "domain": "operations_research",
    "title": "数理最適化：凸最適化・ラグランジュ双対定理・弱/強双対性とKKT条件",
    "language": "ja",
    "description": "不等式制約付き最適化のラグランジュ関数から双対問題、弱双対性、スレーター条件とKKT条件（主実行可能性・双対実行可能性・相補性条件）を導出する。"
  },
  "nodes": [
    {
      "id": "or.kkt.n01_convex_optimization_problem",
      "short_code": "KKT01",
      "kind": "definition",
      "title": "凸最適化問題と実行可能領域の定義",
      "summary": "凸な目的関数および不等式制約関数とアフィンな等式制約関数から構成される標準形の凸最適化問題、ならびにその実行可能領域と最適値を定義する。",
      "canonical_latex": "\\min_{\\mathbf{x} \\in \\mathcal{D}} f_0(\\mathbf{x}) \\quad \\text{s.t.} \\quad f_i(\\mathbf{x}) \\le 0\\;(i=1,\\dots,m),\\quad h_j(\\mathbf{x}) = 0\\;(j=1,\\dots,p),\\quad \\mathcal{F} := \\{\\mathbf{x}\\in\\mathcal{D} \\mid f_i(\\mathbf{x})\\le 0,\\; h_j(\\mathbf{x})=0\\}",
      "aliases_latex": [
        "p^* := \\inf_{\\mathbf{x} \\in \\mathcal{F}} f_0(\\mathbf{x}),\\quad f_0, f_i \\text{ convex},\\; h_j(\\mathbf{x}) = \\mathbf{a}_j^\\top \\mathbf{x} - b_j"
      ],
      "keywords": [
        "凸最適化",
        "不等式制約",
        "実行可能領域",
        "主問題",
        "最適値"
      ],
      "domain_tags": [
        "operations_research",
        "convex_optimization"
      ]
    },
    {
      "id": "or.kkt.n02_lagrangian_inequality_def",
      "short_code": "KKT02",
      "kind": "definition",
      "title": "不等式・等式制約付き最適化のラグランジュ関数",
      "summary": "不等式制約に非負の双対変数（ラグランジュ乗数）を、等式制約に自由符号の双対変数を掛け合わせて目的関数に加えた拡張関数としてラグランジュ関数を定義する。",
      "canonical_latex": "\\mathcal{L}(\\mathbf{x}, \\boldsymbol{\\lambda}, \\boldsymbol{\\nu}) := f_0(\\mathbf{x}) + \\sum_{i=1}^{m} \\lambda_i f_i(\\mathbf{x}) + \\sum_{j=1}^{p} \\nu_j h_j(\\mathbf{x})\\quad (\\mathbf{x}\\in\\mathcal{D},\\; \\boldsymbol{\\lambda} \\ge \\mathbf{0},\\; \\boldsymbol{\\nu} \\in \\mathbb{R}^p)",
      "aliases_latex": [
        "\\mathcal{L}(\\mathbf{x}, \\boldsymbol{\\lambda}, \\boldsymbol{\\nu}) = f_0(\\mathbf{x}) + \\boldsymbol{\\lambda}^\\top \\mathbf{f}(\\mathbf{x}) + \\boldsymbol{\\nu}^\\top \\mathbf{h}(\\mathbf{x})"
      ],
      "keywords": [
        "ラグランジュ関数",
        "双対変数",
        "ラグランジュ乗数",
        "制約緩和"
      ],
      "domain_tags": [
        "operations_research",
        "convex_optimization"
      ]
    },
    {
      "id": "or.kkt.n03_lagrange_dual_function_problem",
      "short_code": "KKT03",
      "kind": "definition",
      "title": "ラグランジュ双対関数とラグランジュ双対問題の定義",
      "summary": "主変数に関するラグランジュ関数の下限（インフィマム）として定義される凹関数をラグランジュ双対関数とし、双対変数の非負制約のもとでこれを最大化する問題をラグランジュ双対問題と定義する。",
      "canonical_latex": "g(\\boldsymbol{\\lambda}, \\boldsymbol{\\nu}) := \\inf_{\\mathbf{x} \\in \\mathcal{D}} \\mathcal{L}(\\mathbf{x}, \\boldsymbol{\\lambda}, \\boldsymbol{\\nu}),\\qquad \\max_{\\boldsymbol{\\lambda}, \\boldsymbol{\\nu}} g(\\boldsymbol{\\lambda}, \\boldsymbol{\\nu}) \\quad \\text{s.t.} \\quad \\boldsymbol{\\lambda} \\ge \\mathbf{0}",
      "aliases_latex": [
        "d^* := \\sup_{\\boldsymbol{\\lambda} \\ge \\mathbf{0},\\; \\boldsymbol{\\nu} \\in \\mathbb{R}^p} g(\\boldsymbol{\\lambda}, \\boldsymbol{\\nu})"
      ],
      "keywords": [
        "ラグランジュ双対関数",
        "双対問題",
        "凹関数",
        "双対最適値"
      ],
      "domain_tags": [
        "operations_research",
        "convex_optimization"
      ]
    },
    {
      "id": "or.kkt.n04_weak_duality_theorem",
      "short_code": "KKT04",
      "kind": "theorem_formula",
      "title": "弱双対性定理（双対ギャップの非負性）",
      "summary": "問題の凸性によらず、任意の双対実行可能解における双対関数値は主実行可能解の目的関数値以下となり、双対最適値は主最適値の下界を与えることを示す。",
      "canonical_latex": "\\forall \\mathbf{x} \\in \\mathcal{F},\\; \\forall \\boldsymbol{\\lambda} \\ge \\mathbf{0},\\; \\forall \\boldsymbol{\\nu} \\in \\mathbb{R}^p:\\; g(\\boldsymbol{\\lambda}, \\boldsymbol{\\nu}) \\le f_0(\\mathbf{x}) \\implies d^* \\le p^*",
      "aliases_latex": [
        "p^* - d^* \\ge 0"
      ],
      "keywords": [
        "弱双対性",
        "双対ギャップ",
        "下界評価",
        "双対定理"
      ],
      "domain_tags": [
        "operations_research",
        "convex_optimization"
      ]
    },
    {
      "id": "or.kkt.n05_slater_condition_def",
      "short_code": "KKT05",
      "kind": "definition",
      "title": "スレーターの制約想定（強実行可能性条件）の定義",
      "summary": "凸最適化問題において、定義域の相対内点の中にすべての不等式制約を厳密に満たしかつ等式制約を満たす点が存在するという制約想定を定義する。",
      "canonical_latex": "\\exists \\tilde{\\mathbf{x}} \\in \\operatorname{relint}(\\mathcal{D})\\text{ s.t. } f_i(\\tilde{\\mathbf{x}}) < 0\\;(\\forall i=1,\\dots,m),\\quad h_j(\\tilde{\\mathbf{x}}) = 0\\;(\\forall j=1,\\dots,p)",
      "aliases_latex": [
        "\\exists \\tilde{\\mathbf{x}} \\in \\operatorname{relint}(\\mathcal{D}):\\; \\mathbf{f}(\\tilde{\\mathbf{x}}) < \\mathbf{0} \\land \\mathbf{h}(\\tilde{\\mathbf{x}}) = \\mathbf{0}"
      ],
      "keywords": [
        "スレーター条件",
        "制約想定",
        "強実行可能点",
        "相対内点"
      ],
      "domain_tags": [
        "operations_research",
        "convex_optimization"
      ]
    },
    {
      "id": "or.kkt.n06_strong_duality_slater",
      "short_code": "KKT06",
      "kind": "theorem_formula",
      "title": "強双対性定理（スレーター条件の下での双対ギャップ零）",
      "summary": "凸最適化問題においてスレーター条件が成り立つとき、分離超平面定理を通じて主最適値と双対最適値が一致し、双対最適解が存在することを示す。",
      "canonical_latex": "\\text{Convex problem} \\land \\text{Slater's condition} \\implies p^* = d^* = g(\\boldsymbol{\\lambda}^*, \\boldsymbol{\\nu}^*)\\quad (\\exists \\boldsymbol{\\lambda}^* \\ge \\mathbf{0},\\; \\boldsymbol{\\nu}^* \\in \\mathbb{R}^p)",
      "aliases_latex": [
        "p^* - d^* = 0"
      ],
      "keywords": [
        "強双対性",
        "スレーター条件",
        "双対ギャップ零",
        "分離超平面定理"
      ],
      "domain_tags": [
        "operations_research",
        "convex_optimization"
      ]
    },
    {
      "id": "or.kkt.n07_kkt_optimality_conditions",
      "short_code": "KKT07",
      "kind": "theorem_formula",
      "title": "KKT条件（カルーシュ＝クーン＝タッカー条件）の導出と最適性",
      "summary": "強双対性が成り立つ微分可能な最適化問題において、主最適解と双対最適解の組が満たすべき4つの条件（主実行可能性・双対実行可能性・相補性条件・停留性条件）を導出する。",
      "canonical_latex": "f_i(\\mathbf{x}^*) \\le 0,\\; h_j(\\mathbf{x}^*) = 0,\\; \\lambda_i^* \\ge 0,\\; \\lambda_i^* f_i(\\mathbf{x}^*) = 0,\\; \\nabla f_0(\\mathbf{x}^*) + \\sum_{i=1}^{m} \\lambda_i^* \\nabla f_i(\\mathbf{x}^*) + \\sum_{j=1}^{p} \\nu_j^* \\nabla h_j(\\mathbf{x}^*) = \\mathbf{0}",
      "aliases_latex": [
        "\\nabla_{\\mathbf{x}} \\mathcal{L}(\\mathbf{x}^*, \\boldsymbol{\\lambda}^*, \\boldsymbol{\\nu}^*) = \\mathbf{0},\\; \\lambda_i^* f_i(\\mathbf{x}^*) = 0"
      ],
      "keywords": [
        "KKT条件",
        "相補性条件",
        "主実行可能性",
        "双対実行可能性",
        "停留性条件"
      ],
      "domain_tags": [
        "operations_research",
        "convex_optimization"
      ]
    }
  ],
