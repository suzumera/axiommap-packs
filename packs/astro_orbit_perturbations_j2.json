        "RTN frame",
        "RSW frame",
        "osculating elements"
      ],
      "domain_tags": [
        "orbital_mechanics"
      ]
    },
    {
      "id": "astro.orbit.pj04_lagrange_planetary_equations",
      "short_code": "PJ04",
      "kind": "theorem_formula",
      "title": "ラグランジュの惑星方程式（擾乱関数 R による軌道要素の時間発展）",
      "summary": "保存力摂動（擾乱関数 R）に対し、ガウスの摂動方程式の加速度成分を軌道要素に関する偏微分へ変換してラグランジュの惑星方程式を得る。",
      "canonical_latex": "\\dot{a} = \\frac{2}{na}\\frac{\\partial R}{\\partial M},\\quad \\dot{e} = \\frac{1-e^2}{na^2 e}\\frac{\\partial R}{\\partial M} - \\frac{\\sqrt{1-e^2}}{na^2 e}\\frac{\\partial R}{\\partial \\omega},\\quad \\dot{i} = \\frac{\\cos i}{na^2\\sqrt{1-e^2}\\sin i}\\frac{\\partial R}{\\partial \\omega} - \\frac{1}{na^2\\sqrt{1-e^2}\\sin i}\\frac{\\partial R}{\\partial \\Omega},\\quad \\dot{\\Omega} = \\frac{1}{na^2\\sqrt{1-e^2}\\sin i}\\frac{\\partial R}{\\partial i},\\quad \\dot{\\omega} = -\\frac{\\cos i}{na^2\\sqrt{1-e^2}\\sin i}\\frac{\\partial R}{\\partial i} + \\frac{\\sqrt{1-e^2}}{na^2 e}\\frac{\\partial R}{\\partial e}",
      "aliases_latex": [
        "\\dot{\\Omega} = \\frac{1}{h\\sin i}\\frac{\\partial R}{\\partial i}"
      ],
      "keywords": [
        "Lagrange planetary equations",
        "disturbing function",
        "variation of parameters"
      ],
      "domain_tags": [
        "orbital_mechanics"
      ]
    },
    {
      "id": "astro.orbit.pj05_j2_orbit_averaged_potential",
      "short_code": "PJ05",
      "kind": "theorem_formula",
      "title": "J2 擾乱関数の1軌道平均（永年擾乱ポテンシャル）",
      "summary": "J2 擾乱関数を平均近点角 M について1周期にわたり積分平均し、短周期振動成分を除いた永年擾乱関数を導出する。",
