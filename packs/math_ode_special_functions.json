        "special_functions"
      ]
    },
    {
      "id": "math.ode.sf02_legendre_ode_polynomials",
      "short_code": "SF02",
      "kind": "theorem_formula",
      "title": "ルジャンドルの微分方程式とルジャンドル多項式 P_n(x) ",
      "summary": "区間 [-1, 1] の両端で有界となる条件から固有値 n(n+1) と多項式解として定まるルジャンドル多項式およびその明示式。",
      "canonical_latex": "(1 - x^2)y'' - 2xy' + n(n+1)y = 0,\\quad P_n(x) = \\sum_{k=0}^{\\lfloor n/2 \\rfloor} \\frac{(-1)^k (2n - 2k)!}{2^n k!(n - k)!(n - 2k)!} x^{n - 2k}\\quad (n \\in \\mathbb{Z}_{\\ge 0})",
      "aliases_latex": [
        "\\frac{d}{dx}\\left[(1 - x^2)\\frac{dy}{dx}\\right] + n(n+1)y = 0"
      ],
      "keywords": [
        "Legendre differential equation",
        "Legendre polynomials",
        "ルジャンドル微分方程式",
        "ルジャンドル多項式"
      ],
      "domain_tags": [
        "mathematics",
        "ode",
        "special_functions"
      ]
    },
    {
      "id": "math.ode.sf03_rodrigues_formula_legendre",
      "short_code": "SF03",
      "kind": "theorem_formula",
      "title": "ロドリゲスの公式とルジャンドル多項式の母関数",
      "summary": "ルジャンドル多項式 P_n(x) の n 階微分による表現（ロドリゲスの公式）および逆距離展開から生じる母関数表示。",
      "canonical_latex": "P_n(x) = \\frac{1}{2^n n!}\\frac{d^n}{dx^n}\\big[(x^2 - 1)^n\\big],\\quad \\frac{1}{\\sqrt{1 - 2xt + t^2}} = \\sum_{n=0}^{\\infty} P_n(x) t^n\\quad (|t| < 1,\\; |x| \\le 1)",
      "aliases_latex": [
        "G(x,t) = (1 - 2xt + t^2)^{-1/2} = \\sum_{n=0}^{\\infty} P_n(x) t^n"
      ],
      "keywords": [
        "Rodrigues formula",
        "generating function",
        "Legendre polynomials",
        "ロドリゲスの公式",
        "母関数"
      ],
      "domain_tags": [
        "mathematics",
