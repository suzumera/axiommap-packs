    {
      "id": "math.ode.sf04_legendre_orthogonality",
      "short_code": "SF04",
      "kind": "theorem_formula",
      "title": "ルジャンドル多項式の直交関係と L^2 ノルム",
      "summary": "区間 [-1, 1] 上での異なる次数のルジャンドル多項式間の直交性と、同次数に対する L^2 ノルム2乗の明示公式。",
      "canonical_latex": "\\int_{-1}^{1} P_m(x) P_n(x)\\,dx = \\frac{2}{2n + 1}\\delta_{mn}",
      "aliases_latex": [
        "\\langle P_m, P_n \\rangle_{L^2([-1,1])} = \\frac{2}{2n+1}\\delta_{mn}"
      ],
      "keywords": [
