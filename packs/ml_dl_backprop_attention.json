    {
      "id": "ml.dl.n08_residual_connection_gradient_highway",
      "short_code": "DL08",
      "kind": "theorem_formula",
      "title": "残差接続（Residual Connection）による勾配伝播の恒等写像項",
      "summary": "層間に入力の恒等写像を加算する残差接続により、逆伝播勾配に単位行列 I が加わり、深いネットワークでも勾配が直接下位層へ伝播することを導く。",
      "canonical_latex": "\\mathbf{x}_{l+1} = \\mathbf{x}_l + \\mathcal{F}(\\mathbf{x}_l, W_l) \\implies \\frac{\\partial \\mathcal{L}}{\\partial \\mathbf{x}_l} = \\frac{\\partial \\mathcal{L}}{\\partial \\mathbf{x}_L}\\left(I + \\frac{\\partial}{\\partial \\mathbf{x}_l}\\sum_{k=l}^{L-1}\\mathcal{F}(\\mathbf{x}_k, W_k)\\right)",
      "aliases_latex": [
        "\\frac{\\partial \\mathcal{L}}{\\partial \\mathbf{x}_l} = \\frac{\\partial \\mathcal{L}}{\\partial \\mathbf{x}_{l+1}}\\left(I + \\frac{\\partial \\mathcal{F}}{\\partial \\mathbf{x}_l}\\right)"
      ],
      "keywords": [
        "残差接続",
