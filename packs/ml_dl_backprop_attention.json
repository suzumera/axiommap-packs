        "トレース",
        "勾配"
      ],
      "domain_tags": [
        "machine_learning",
        "deep_learning",
        "matrix_calculus"
      ]
    },
    {
      "id": "ml.dl.n02_vjp_reverse_mode_ad",
      "short_code": "DL02",
      "kind": "theorem_formula",
      "title": "逆向き自動微分（VJP）の連鎖律と計算量構造",
      "summary": "合成関数のヤコビアン積を出力側の随伴ベクトルとの左からの積（Vector-Jacobian Product）として順次計算する逆向き自動微分の基本公式。",
      "canonical_latex": "\\mathbf{v}^\\top J_{g \\circ f}(\\mathbf{x}) = \\big(\\mathbf{v}^\\top J_g(\\mathbf{y})\\big) J_f(\\mathbf{x})\\quad (\\mathbf{y} = f(\\mathbf{x}))",
      "aliases_latex": [
        "\\frac{\\partial \\mathcal{L}}{\\partial \\mathbf{x}} = \\left(\\frac{\\partial \\mathbf{y}}{\\partial \\mathbf{x}}\\right)^\\top \\frac{\\partial \\mathcal{L}}{\\partial \\mathbf{y}}"
      ],
      "keywords": [
