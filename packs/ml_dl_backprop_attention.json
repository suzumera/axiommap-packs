    {
      "id": "ml.dl.n07_multihead_attention_def",
      "short_code": "DL07",
      "kind": "definition",
      "title": "Multi-Head Attention の定義と部分空間射影",
      "summary": "Query・Key・Value を複数の異なる線形射影により低次元部分空間へ写像し、並列に Scaled Dot-Product Attention を適用して結合する機構を定義する。",
      "canonical_latex": "\\operatorname{MHA}(Q,K,V) := \\operatorname{Concat}(\\mathrm{head}_1,\\dots,\\mathrm{head}_h)W^O,\\quad \\mathrm{head}_i := \\operatorname{Attention}(QW_i^Q, KW_i^K, VW_i^V)",
      "aliases_latex": [
