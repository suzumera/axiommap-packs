        "deep_learning",
        "automatic_differentiation"
      ]
    },
    {
      "id": "ml.dl.n03_vanishing_exploding_gradient",
      "short_code": "DL03",
      "kind": "theorem_formula",
      "title": "多層パーセプトロンにおける勾配消失・爆発のヤコビアン積評価",
      "summary": "誤差逆伝播における層間誤差信号の漸化式を繰り返し展開し、重み行列のスペクトルノルムと活性化導関数上界の積による勾配ノルム評価を与える。",
      "canonical_latex": "\\left\\|\\boldsymbol{\\delta}^{(l)}\\right\\|_2 \\le \\left(\\prod_{k=l}^{L-1} \\gamma_k \\left\\|W^{(k+1)}\\right\\|_2\\right)\\left\\|\\boldsymbol{\\delta}^{(L)}\\right\\|_2\\quad \\left(\\left|\\sigma'(z)\\right| \\le \\gamma_k\\right)",
      "aliases_latex": [
        "\\boldsymbol{\\delta}^{(l)} = \\left(\\prod_{k=l}^{L-1} \\operatorname{diag}(\\sigma'(\\mathbf{z}^{(k)}))(W^{(k+1)})^\\top\\right)\\boldsymbol{\\delta}^{(L)}"
      ],
      "keywords": [
        "勾配消失",
