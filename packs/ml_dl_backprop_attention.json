        "スペクトルノルム",
        "ヤコビアン積"
      ],
      "domain_tags": [
        "machine_learning",
        "deep_learning"
      ]
    },
    {
      "id": "ml.dl.n04_softmax_logsumexp_convexity",
      "short_code": "DL04",
      "kind": "theorem_formula",
      "title": "Log-Sum-Exp 関数のシフト不変性と Softmax 交差エントロピーの凸性",
      "summary": "Log-Sum-Exp 関数の最大値シフトによる数値安定化と、Softmax 交差エントロピー損失のロジットに関するヘッセ行列が半正定値（凸）であることを示す。",
      "canonical_latex": "\\operatorname{LSE}(\\mathbf{z}) := \\ln\\sum_{i=1}^{K} e^{z_i} = c + \\ln\\sum_{i=1}^{K} e^{z_i - c},\\qquad \\nabla_{\\mathbf{z}}^2 \\mathcal{L}_{\\mathrm{CE}}(\\mathbf{y},\\mathbf{p}) = \\operatorname{diag}(\\mathbf{p}) - \\mathbf{p}\\mathbf{p}^\\top \\succeq 0",
      "aliases_latex": [
        "\\mathbf{h}^\\top \\nabla_{\\mathbf{z}}^2 \\mathcal{L}_{\\mathrm{CE}} \\mathbf{h} = \\operatorname{Var}_{p}(h) \\ge 0"
      ],
      "keywords": [
        "Log-Sum-Exp",
        "Softmax",
        "交差エントロピー",
        "凸性"
      ],
      "domain_tags": [
        "machine_learning",
        "deep_learning",
        "optimization"
      ]
    },
    {
      "id": "ml.dl.n05_softmax_temperature_saturation",
      "short_code": "DL05",
      "kind": "theorem_formula",
      "title": "Softmax の低温極限（分散増大）による勾配飽和現象",
      "summary": "Softmax への入力ロジットのスケール（逆温度 1/τ）が増大すると出力分布が one-hot に近づき、ヤコビ行列が零行列へ漸近して勾配が消失する理由を与える。",
      "canonical_latex": "p_i(\\tau) = \\frac{e^{z_i/\\tau}}{\\sum_{j=1}^{K} e^{z_j/\\tau}} \\xrightarrow{\\tau \\to 0^+} \\mathbb{I}(i = i^*),\\qquad \\frac{\\partial \\mathbf{p}}{\\partial \\mathbf{z}} = \\frac{1}{\\tau}\\big(\\operatorname{diag}(\\mathbf{p}) - \\mathbf{p}\\mathbf{p}^\\top\\big) \\xrightarrow{\\tau \\to 0^+} O",
      "aliases_latex": [
        "\\lim_{\\tau \\to 0^+} J_{\\operatorname{softmax}}(\\mathbf{z}/\\tau) = O"
      ],
      "keywords": [
        "温度スケーリング",
        "勾配飽和",
        "Attentionスケーリング",
        "Softmax"
      ],
      "domain_tags": [
        "machine_learning",
        "deep_learning"
      ]
    },
    {
      "id": "ml.dl.n06_attention_key_value_gradients",
      "short_code": "DL06",
      "kind": "theorem_formula",
      "title": "Scaled Dot-Product Attention における Key 行列の勾配公式",
      "summary": "フロベニウス内積による行列微分を用いて、スコア行列の勾配から Key 行列 K に対する損失関数の勾配を導出する。",
      "canonical_latex": "\\frac{\\partial \\mathcal{L}}{\\partial K} = \\frac{1}{\\sqrt{d_k}} \\left(\\frac{\\partial \\mathcal{L}}{\\partial S}\\right)^\\top Q\\quad \\left(S = \\frac{QK^\\top}{\\sqrt{d_k}}\\right)",
      "aliases_latex": [
        "\\nabla_K \\mathcal{L} = \\frac{1}{\\sqrt{d_k}} (\\nabla_S \\mathcal{L})^\\top Q"
      ],
      "keywords": [
