  "nodes": [
    {
      "id": "ml.dl.n01_frobenius_matrix_differential",
      "short_code": "DL01",
      "kind": "definition",
      "title": "フロベニウス内積による行列微分と勾配の定義",
      "summary": "スカラー損失関数の行列パラメータに対する全微分を、トレースとフロベニウス内積を用いて表現し、行列勾配を定義する。",
      "canonical_latex": "d\\mathcal{L} = \\langle \\nabla_W \\mathcal{L}, dW \\rangle_F = \\operatorname{tr}\\!\\left((\\nabla_W \\mathcal{L})^\\top dW\\right)",
      "aliases_latex": [
        "d\\mathcal{L} = \\sum_{i,j} \\frac{\\partial \\mathcal{L}}{\\partial W_{ij}} dW_{ij}"
      ],
      "keywords": [
        "行列微分",
