      ]
    },
    {
      "id": "math.cat.n02_isomorphism_uniqueness",
      "short_code": "CAT02",
      "kind": "theorem_formula",
      "title": "同型射の定義と逆射の一意性定理",
      "summary": "両側逆射が存在する射を同型射といい、射の合成の結合律と恒等射の単位律から、同型射に対する逆射は存在すれば一意に定まる。",
      "canonical_latex": "g\\circ f = \\mathrm{id}_A \\land f\\circ g = \\mathrm{id}_B \\land h\\circ f = \\mathrm{id}_A \\land f\\circ h = \\mathrm{id}_B \\implies g = h",
      "aliases_latex": [
        "f^{-1} \\text{ is unique if } f\\in \\mathrm{Iso}(\\mathcal{C})"
      ],
      "keywords": [
        "同型射",
        "逆射",
        "一意性",
        "単位律"
      ],
      "domain_tags": [
        "category_theory",
        "mathematics"
      ]
    },
    {
      "id": "math.cat.n03_functor_definition",
      "short_code": "CAT03",
      "kind": "definition",
      "title": "関手（共変関手）と合成・恒等射の保存則",
      "summary": "2つの圏の間で対象と射を対応づけ、射の合成と恒等射を保存する構造保存写像としての共変関手の定義。",
      "canonical_latex": "F:\\mathcal{C}\\to\\mathcal{D}:\\; A\\mapsto F(A),\\; (f:A\\to B)\\mapsto (F(f):F(A)\\to F(B)),\\quad F(g\\circ f)=F(g)\\circ F(f),\\; F(\\mathrm{id}_A)=\\mathrm{id}_{F(A)}",
      "aliases_latex": [
        "F^{\\mathrm{op}}:\\mathcal{C}^{\\mathrm{op}}\\to\\mathcal{D},\\quad F(g\\circ f)=F(f)\\circ F(g)"
      ],
      "keywords": [
        "関手",
        "共変関手",
        "合成保存",
        "恒等射保存"
      ],
      "domain_tags": [
        "category_theory",
        "mathematics"
      ]
    },
    {
      "id": "math.cat.n04_natural_transformation",
      "short_code": "CAT04",
      "kind": "definition",
      "title": "自然変換と自然性の可換図式",
      "summary": "同じ始圏と終圏をもつ2つの関手の間の射として、各対象に割り当てられた射の族がすべての射に対して可換図式を満たすという自然変換の定義。",
      "canonical_latex": "\\alpha:F\\Rightarrow G:\\; \\forall A\\in\\mathrm{Ob}(\\mathcal{C}),\\; \\alpha_A:F(A)\\to G(A),\\quad \\forall f:A\\to B,\\; G(f)\\circ \\alpha_A = \\alpha_B\\circ F(f)",
      "aliases_latex": [
        "\\alpha\\in\\mathrm{Nat}(F,G)"
      ],
      "keywords": [
        "自然変換",
        "自然性",
        "可換図式",
