  "nodes": [
    {
      "id": "math.cat.n01_category_axioms",
      "short_code": "CAT01",
      "kind": "axiom",
      "title": "圏の公理（対象・射・合成の結合律と恒等射）",
      "summary": "対象の集まりと射の集まり、射の合成および各対象に対する恒等射からなり、合成の結合律と左右の単位律を満たす代数構造としての圏を定める公理系。",
      "canonical_latex": "\\forall f:A\\to B,\\; g:B\\to C,\\; h:C\\to D:\\; (h\\circ g)\\circ f = h\\circ (g\\circ f),\\quad \\exists!\\,\\mathrm{id}_A:A\\to A\\text{ s.t. } f\\circ \\mathrm{id}_A = f,\\; \\mathrm{id}_B\\circ f = f",
      "aliases_latex": [
        "\\mathcal{C} = (\\mathrm{Ob}(\\mathcal{C}), \\mathrm{Hom}_{\\mathcal{C}}, \\circ, \\mathrm{id})"
      ],
      "keywords": [
        "圏",
        "対象",
        "射",
        "結合律",
        "恒等射"
      ],
      "domain_tags": [
