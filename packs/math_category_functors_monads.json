    {
      "id": "math.cat.n06_adjunction_unit_counit",
      "short_code": "CAT06",
      "kind": "definition",
      "title": "随伴関手対（F ⊣ G）と単位・余単位の三角恒等式",
      "summary": "ホム集合の自然同型および単位自然変換・余単位自然変換と三角恒等式によって特徴づけられる随伴関手対の定義。",
      "canonical_latex": "F\\dashv G:\\; \\mathcal{D}(F(A),B)\\cong\\mathcal{C}(A,G(B)),\\quad \\eta:\\mathrm{Id}_{\\mathcal{C}}\\Rightarrow GF,\\; \\varepsilon:FG\\Rightarrow\\mathrm{Id}_{\\mathcal{D}},\\quad \\varepsilon_F\\circ F\\eta=\\mathrm{id}_F,\\; G\\varepsilon\\circ\\eta_G=\\mathrm{id}_G",
      "aliases_latex": [
        "(F,G,\\eta,\\varepsilon):\\mathcal{C}\\rightleftarrows\\mathcal{D}"
      ],
      "keywords": [
        "随伴関手",
        "単位",
        "余単位",
        "三角恒等式"
      ],
      "domain_tags": [
        "category_theory",
        "mathematics"
      ]
    },
    {
      "id": "math.cat.n07_monad_axioms_def",
      "short_code": "CAT07",
      "kind": "definition",
      "title": "モナド（自己関手・単位・乗法）とモナド則の定義",
      "summary": "圏上の自己関手と単位・乗法の2つの自然変換の組で、乗法の結合律と左右の単位律（モナド則）を満たす構造の定義。",
      "canonical_latex": "(T,\\eta,\\mu):\\; T:\\mathcal{C}\\to\\mathcal{C},\\; \\eta:\\mathrm{Id}_{\\mathcal{C}}\\Rightarrow T,\\; \\mu:T^2\\Rightarrow T,\\quad \\mu\\circ T\\mu = \\mu\\circ\\mu_T,\\quad \\mu\\circ T\\eta = \\mathrm{id}_T = \\mu\\circ\\eta_T",
      "aliases_latex": [
        "\\mu\\circ T\\mu = \\mu\\circ\\mu T"
      ],
      "keywords": [
        "モナド",
        "自己関手",
        "モナド則",
        "結合律",
        "単位律"
      ],
      "domain_tags": [
        "category_theory",
        "mathematics"
      ]
    },
    {
      "id": "math.cat.n08_monad_from_adjunction",
      "short_code": "CAT08",
      "kind": "theorem_formula",
      "title": "随伴関手対 F ⊣ G から誘導されるモナド則の導出定理",
      "summary": "随伴関手対の合成自己関手 T=GF に単位 η と乗法 μ=Gε_F を与えると、三角恒等式と自然性からモナド則が自動的に導かれることを示す定理。",
      "canonical_latex": "F\\dashv G,\\; T:=GF,\\; \\mu:=G\\varepsilon_F \\implies \\mu\\circ T\\mu = \\mu\\circ\\mu_T \\land \\mu\\circ T\\eta = \\mathrm{id}_T = \\mu\\circ\\eta_T",
      "aliases_latex": [
        "(GF, \\eta, G\\varepsilon_F) \\text{ is a monad on } \\mathcal{C}"
      ],
      "keywords": [
        "随伴からモナド",
        "モナド則",
        "三角恒等式",
        "自然性"
      ],
      "domain_tags": [
        "category_theory",
        "mathematics"
      ]
    }
