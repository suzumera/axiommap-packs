  "nodes": [
    {
      "id": "eng.acst.n01_fluid_adiabatic_boundary",
      "short_code": "ACST01",
      "kind": "math_boundary",
      "title": "圧縮性非粘性流体の基礎方程式と断熱状態関係",
      "summary": "音響学の出発点となる質量保存則（連続の式）、運動量保存則（オイラー方程式）、および音波伝搬における断熱状態変化の線形応答関係。",
      "canonical_latex": "\\frac{\\partial \\rho}{\\partial t} + \\nabla\\cdot(\\rho \\mathbf{u}) = 0,\\quad \\rho\\left(\\frac{\\partial \\mathbf{u}}{\\partial t} + (\\mathbf{u}\\cdot\\nabla)\\mathbf{u}\\right) = -\\nabla p,\\quad \\frac{dp}{d\\rho} = c^2 = \\frac{\\gamma p_0}{\\rho_0}",
      "aliases_latex": [
        "\\partial_t \\rho + \\nabla\\cdot(\\rho\\mathbf{u}) = 0,\\quad \\rho D_t\\mathbf{u} = -\\nabla p"
      ],
      "keywords": [
        "連続の式",
        "オイラー方程式",
        "断熱変化",
        "流体力学"
      ],
      "domain_tags": [
        "acoustics",
        "fluid_mechanics"
      ]
    },
    {
      "id": "eng.acst.n02_linearized_acoustic_wave_eq",
      "short_code": "ACST02",
      "kind": "theorem_formula",
      "title": "線形音響波動方程式と音速",
      "summary": "静止一様媒質周りの微小振幅摂動（音圧・密度変動・粒子速度）に対して流体方程式を線形化することで導かれる3次元スカラー波動方程式と音速の式。",
      "canonical_latex": "\\nabla^2 p' - \\frac{1}{c^2}\\frac{\\partial^2 p'}{\\partial t^2} = 0,\\quad c = \\sqrt{\\left(\\frac{\\partial p}{\\partial \\rho}\\right)_S} = \\sqrt{\\frac{\\gamma R T}{M}}",
      "aliases_latex": [
        "\\Box p' = 0,\\quad \\frac{\\partial^2 p'}{\\partial t^2} = c^2 \\nabla^2 p'"
      ],
      "keywords": [
        "波動方程式",
        "音速",
        "線形化",
        "音圧"
      ],
      "domain_tags": [
        "acoustics",
        "wave_physics"
      ]
    },
    {
