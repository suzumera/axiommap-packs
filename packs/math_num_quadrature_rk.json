    "language": "ja",
    "description": "台形則・シンプソン則、直交多項式によるガウス＝ルジャンドル求積、オイラー法と4次ルンゲ＝クッタ法・安定領域を導出する。"
  },
  "nodes": [
    {
      "id": "math.num.qr01_interpolatory_quadrature_def",
      "short_code": "QR01",
      "kind": "definition",
      "title": "補間型数値求積法と精度次数の定義",
      "summary": "重み付き定積分を節点での関数値の線形結合で近似する求積公式と、多項式に対する厳密積分次数（精度次数）を定義する。",
      "canonical_latex": "I_w[f] := \\int_{a}^{b} w(x)f(x)\\,dx \\approx Q_n[f] := \\sum_{i=0}^{n} w_i f(x_i),\\quad w_i := \\int_{a}^{b} w(x)\\ell_i(x)\\,dx,\\quad \\text{deg. exactness } d \\iff \\forall p \\in \\mathcal{P}_d,\\; Q_n[p] = I_w[p]",
      "aliases_latex": [
        "Q_n[f] = \\sum_{i=0}^{n} w_i f(x_i),\\quad E_n[p] = I_w[p] - Q_n[p] = 0\\;(\\forall p\\in\\mathcal{P}_d)"
      ],
      "keywords": [
        "numerical quadrature",
        "interpolatory quadrature",
        "degree of exactness",
        "quadrature weights"
      ],
      "domain_tags": [
        "mathematics",
        "numerical_analysis"
      ]
    },
    {
      "id": "math.num.qr02_trapezoidal_rule",
      "short_code": "QR02",
      "kind": "theorem_formula",
      "title": "台形則および複合台形則と誤差評価",
      "summary": "2点間の線形補間に基づく台形則と、区間分割による複合台形則の求積公式および2次収束誤差項を与える。",
      "canonical_latex": "\\int_{a}^{b} f(x)\\,dx = \\frac{b-a}{2}\\big(f(a)+f(b)\\big) - \\frac{(b-a)^3}{12}f''(\\xi),\\quad T_N(f) = h\\left(\\frac{f(x_0)}{2} + \\sum_{j=1}^{N-1} f(x_j) + \\frac{f(x_N)}{2}\\right),\\quad E_T = -\\frac{b-a}{12}h^2 f''(\\bar{\\xi})",
      "aliases_latex": [
        "\\int_{a}^{b} f(x)\\,dx \\approx \\frac{h}{2}\\sum_{j=0}^{N-1}\\big(f(x_j)+f(x_{j+1})\\big),\\quad h=\\frac{b-a}{N}"
      ],
      "keywords": [
        "trapezoidal rule",
        "composite trapezoidal rule",
        "Newton-Cotes",
        "quadrature error"
      ],
      "domain_tags": [
        "mathematics",
        "numerical_analysis"
      ]
    },
    {
      "id": "math.num.qr03_simpsons_rule",
      "short_code": "QR03",
      "kind": "theorem_formula",
      "title": "シンプソン則および複合シンプソン則と誤差評価",
      "summary": "3点の2次補間から導かれ、対称性により3次多項式まで厳密となるシンプソン則と、4次収束を示す複合シンプソン則の誤差評価を与える。",
      "canonical_latex": "\\int_{a}^{b} f(x)\\,dx = \\frac{h}{3}\\big(f(a) + 4f(m) + f(b)\\big) - \\frac{h^5}{90}f^{(4)}(\\xi)\\;\\left(h=\\frac{b-a}{2},\\; m=\\frac{a+b}{2}\\right),\\quad E_S = -\\frac{b-a}{180}h^4 f^{(4)}(\\bar{\\xi})",
      "aliases_latex": [
        "S_{2N}(f) = \\frac{h}{3}\\left(f(x_0) + 4\\sum_{j=1}^{N} f(x_{2j-1}) + 2\\sum_{j=1}^{N-1} f(x_{2j}) + f(x_{2N})\\right)"
      ],
      "keywords": [
        "Simpson's rule",
        "composite Simpson's rule",
        "Newton-Cotes",
        "fourth-order quadrature"
      ],
      "domain_tags": [
        "mathematics",
        "numerical_analysis"
      ]
    },
    {
      "id": "math.num.qr04_gauss_quadrature_orthogonality",
      "short_code": "QR04",
      "kind": "theorem_formula",
      "title": "直交多項式によるガウス求積法の最高精度次数定理",
      "summary": "n点求積公式が2n-1次の精度次数を持つための必要十分条件が、直交多項式の零点を節点とし補間型重みを選ぶことであるという基本定理。",
      "canonical_latex": "\\forall p \\in \\mathcal{P}_{2n-1},\\; \\sum_{i=1}^{n} w_i p(x_i) = \\int_{a}^{b} w(x)p(x)\\,dx \\iff \\Big(\\forall q \\in \\mathcal{P}_{n-1},\\; \\int_{a}^{b} w(x)\\omega_n(x)q(x)\\,dx = 0\\Big) \\land \\Big(w_i = \\int_{a}^{b} w(x)\\ell_i(x)\\,dx > 0\\Big)\\quad \\left(\\omega_n(x)=\\prod_{i=1}^{n}(x-x_i)\\right) ",
      "aliases_latex": [
        "\\text{deg. exactness } 2n-1 \\iff \\omega_n \\perp_w \\mathcal{P}_{n-1} \\text{ and } w_i = \\int_a^b w(x)\\ell_i(x)^2\\,dx > 0"
      ],
      "keywords": [
        "Gaussian quadrature",
        "orthogonal polynomials",
        "degree of exactness 2n-1",
        "positive weights"
      ],
      "domain_tags": [
        "mathematics",
        "numerical_analysis"
      ]
    },
    {
      "id": "math.num.qr05_gauss_legendre_quadrature",
      "short_code": "QR05",
      "kind": "theorem_formula",
      "title": "ガウス＝ルジャンドル求積公式（節点・重み・誤差評価）",
      "summary": "重み関数w(x)=1に対しルジャンドル多項式P_n(x)の零点を節点とするn点ガウス＝ルジャンドル求積公式の重み公式・一般区間変換・誤差表現を与える。",
      "canonical_latex": "\\int_{-1}^{1} f(x)\\,dx = \\sum_{i=1}^{n} w_i f(x_i) + \\frac{2^{2n+1}(n!)^4}{(2n+1)\\big[(2n)!\\big]^3}f^{(2n)}(\\xi),\\quad P_n(x_i)=0,\\quad w_i = \\frac{2}{(1-x_i^2)\\big[P_n'(x_i)\\big]^2} > 0",
      "aliases_latex": [
        "\\int_{a}^{b} f(x)\\,dx \\approx \\frac{b-a}{2}\\sum_{i=1}^{n} w_i f\\!\\left(\\frac{b-a}{2}x_i + \\frac{a+b}{2}\\right)"
      ],
      "keywords": [
        "Gauss-Legendre quadrature",
        "Legendre polynomial roots",
        "quadrature weights",
        "spectral accuracy"
      ],
      "domain_tags": [
        "mathematics",
        "numerical_analysis"
      ]
    },
    {
      "id": "math.num.qr06_ode_one_step_method_def",
      "short_code": "QR06",
      "kind": "definition",
      "title": "ODE初期値問題の1段階法と打切り誤差・収束次数の定義",
      "summary": "1階常微分方程式の初期値問題に対する陽的1段階法、局所打切り誤差（LTE）、大域誤差および整合性・収束次数を定義する。",
      "canonical_latex": "y_{n+1} = y_n + h\\Phi(t_n, y_n; h),\\quad \\tau_{n+1}(h) := \\frac{y(t_{n+1}) - y(t_n)}{h} - \\Phi\\big(t_n, y(t_n); h\\big),\\quad \\tau_{n+1}(h) = \\mathcal{O}(h^p)\\;(\\text{order } p),\\quad e_n := y(t_n) - y_n",
      "aliases_latex": [
        "y(t_{n+1}) - y(t_n) - h\\Phi(t_n, y(t_n); h) = h\\tau_{n+1}(h) = \\mathcal{O}(h^{p+1})"
      ],
      "keywords": [
        "one-step method",
        "local truncation error",
        "global error",
        "order of accuracy",
        "ODE numerical integration"
      ],
      "domain_tags": [
        "mathematics",
        "numerical_analysis"
      ]
    },
    {
      "id": "math.num.qr07_explicit_euler_method",
      "short_code": "QR07",
      "kind": "theorem_formula",
      "title": "陽的オイラー法（前進オイラー法）の公式と1次収束定理",
      "summary": "接線近似による陽的オイラー法の更新式を導き、リプシッツ連続性の下で局所打切り誤差O(h)から大域誤差O(h)の1次収束を評価する。",
      "canonical_latex": "y_{n+1} = y_n + h f(t_n, y_n),\\quad \\tau_{n+1}(h) = \\frac{h}{2}y''(\\xi_n) = \\mathcal{O}(h),\\quad |y(t_n) - y_n| \\le \\frac{M h}{2L}\\big(e^{L(t_n - t_0)} - 1\\big) = \\mathcal{O}(h)\\quad (|f_y|\\le L,\\; |y''|\\le M) ",
      "aliases_latex": [
        "y_{n+1} = y_n + h f(t_n, y_n),\\quad |e_n| \\le (1+hL)^n |e_0| + \\frac{Mh}{2L}\\big((1+hL)^n - 1\\big)"
      ],
      "keywords": [
        "explicit Euler method",
        "forward Euler",
        "Lipschitz condition",
        "first-order convergence"
      ],
      "domain_tags": [
        "mathematics",
        "numerical_analysis"
      ]
    },
    {
      "id": "math.num.qr08_rk_general_butcher_def",
      "short_code": "QR08",
      "kind": "definition",
      "title": "陽的ルンゲ＝クッタ法の一般形（ブッチャー配列）と2次RK法",
      "summary": "s段陽的ルンゲ＝クッタ法とブッチャー配列（a_ij, b_i, c_i）を定義し、整合性条件および2次法（ホイン法・中点法）の例を示す。",
      "canonical_latex": "y_{n+1} = y_n + h\\sum_{i=1}^{s} b_i k_i,\\quad k_i = f\\!\\left(t_n + c_i h,\\; y_n + h\\sum_{j=1}^{i-1} a_{ij} k_j\\right),\\quad c_i = \\sum_{j=1}^{i-1} a_{ij},\\quad \\sum_{i=1}^{s} b_i = 1",
      "aliases_latex": [
        "\\text{Heun (RK2): } y_{n+1} = y_n + \\frac{h}{2}(k_1 + k_2),\\; k_1=f(t_n,y_n),\\; k_2=f(t_n+h, y_n+hk_1)"
      ],
      "keywords": [
        "Runge-Kutta method",
        "Butcher tableau",
        "stages",
        "RK2",
        "Heun method"
      ],
      "domain_tags": [
        "mathematics",
        "numerical_analysis"
      ]
    },
    {
      "id": "math.num.qr09_classical_rk4_method",
      "short_code": "QR09",
      "kind": "theorem_formula",
      "title": "古典的4次ルンゲ＝クッタ法（RK4）の公式と4次精度定理",
      "summary": "4段評価の重み付き平均により4次までのテイラー展開と一致し、局所打切り誤差O(h^4)（1ステップ誤差O(h^5)）を達成する古典的RK4公式を与える。",
      "canonical_latex": "y_{n+1} = y_n + \\frac{h}{6}(k_1 + 2k_2 + 2k_3 + k_4),\\quad \\begin{cases} k_1 = f(t_n, y_n), \\\\ k_2 = f\\!\\left(t_n+\\frac{h}{2},\\, y_n+\\frac{h}{2}k_1\\right), \\\\ k_3 = f\\!\\left(t_n+\\frac{h}{2},\\, y_n+\\frac{h}{2}k_2\\right), \\\\ k_4 = f(t_n+h,\\, y_n+hk_3) \\end{cases},\\quad \\tau_{n+1}(h) = \\mathcal{O}(h^4) ",
      "aliases_latex": [
        "y(t_{n+1}) - \\big(y(t_n) + \\tfrac{h}{6}(k_1+2k_2+2k_3+k_4)\\big) = \\mathcal{O}(h^5)"
      ],
      "keywords": [
        "classical RK4",
        "fourth-order Runge-Kutta",
        "order conditions",
        "local truncation error"
      ],
      "domain_tags": [
        "mathematics",
        "numerical_analysis"
      ]
