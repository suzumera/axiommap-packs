    {
      "id": "math.num.qr10_absolute_stability_region",
      "short_code": "QR10",
      "kind": "theorem_formula",
      "title": "ダールキスト試験方程式による安定性関数と絶対安定領域",
      "summary": "線形試験方程式 y'=λy に対する安定性関数 R(z) (z=hλ) と絶対安定領域 |R(z)|<1 を導き、陽的オイラー法とRK4の安定領域を与える。",
      "canonical_latex": "y'=\\lambda y \\implies y_{n+1} = R(z)y_n\\;(z=h\\lambda),\\quad \\mathcal{S} := \\{z\\in\\mathbb{C} : |R(z)| < 1\\};\\quad R_{\\text{Euler}}(z) = 1+z,\\quad R_{\\text{RK4}}(z) = \\sum_{k=0}^{4} \\frac{z^k}{k!}",
      "aliases_latex": [
