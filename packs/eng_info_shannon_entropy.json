  "nodes": [
    {
      "id": "eng.info.n01_self_information_entropy",
      "short_code": "INFO01",
      "kind": "definition",
      "title": "自己情報量とシャノンエントロピーの定義",
      "summary": "離散確率変数の事象が持つ自己情報量 I(x) = -log2 p(x) と、その期待値として定義されるシャノンエントロピー H(X) の定義。",
      "canonical_latex": "I(x) := -\\log_2 p(x),\\qquad H(X) := \\mathbb{E}[I(X)] = -\\sum_{x\\in\\mathcal{X}} p(x)\\log_2 p(x)",
      "aliases_latex": [
        "H(X) = -\\sum_{i=1}^{n} p_i \\log_2 p_i",
        "H(p) = \\sum_{x} p(x)\\log_2\\frac{1}{p(x)}"
      ],
      "keywords": [
        "自己情報量",
        "シャノンエントロピー",
        "平均情報量",
        "ビット"
      ],
      "domain_tags": [
        "information_theory"
      ]
    },
    {
      "id": "eng.info.n02_joint_conditional_entropy",
      "short_code": "INFO02",
      "kind": "definition",
      "title": "結合エントロピー・条件付きエントロピーと連鎖律",
      "summary": "2つの離散確率変数 (X, Y) に対する結合エントロピー H(X,Y)、条件付きエントロピー H(Y|X)、およびエントロピーの連鎖律。",
      "canonical_latex": "H(X,Y) := -\\sum_{x,y} p(x,y)\\log_2 p(x,y),\\quad H(Y|X) := -\\sum_{x,y} p(x,y)\\log_2 p(y|x),\\quad H(X,Y) = H(X) + H(Y|X)",
      "aliases_latex": [
        "H(Y|X) = \\sum_{x} p(x) H(Y|X=x)",
        "H(X_1,\\dots,X_n) = \\sum_{i=1}^{n} H(X_i | X_1,\\dots,X_{i-1})"
      ],
      "keywords": [
        "結合エントロピー",
        "条件付きエントロピー",
        "連鎖律"
      ],
      "domain_tags": [
        "information_theory"
      ]
    },
    {
      "id": "eng.info.n03_kl_divergence_gibbs",
      "short_code": "INFO03",
      "kind": "theorem_formula",
      "title": "KLダイバージェンス（相対エントロピー）とギブスの不等式",
      "summary": "2つの確率分布 p, q の間のカルバック＝ライブラー・ダイバージェンス D_KL(p||q) の定義と、その非負性（ギブスの不等式）。",
      "canonical_latex": "D_{\\mathrm{KL}}(p\\|q) := \\sum_{x\\in\\mathcal{X}} p(x)\\log_2\\frac{p(x)}{q(x)} \\ge 0,\\qquad D_{\\mathrm{KL}}(p\\|q) = 0 \\iff p = q",
      "aliases_latex": [
        "D(p\\|q) = \\mathbb{E}_p\\left[\\log_2\\frac{p(X)}{q(X)}\\right] \\ge 0"
      ],
      "keywords": [
        "KLダイバージェンス",
        "相対エントロピー",
        "ギブスの不等式"
      ],
      "domain_tags": [
        "information_theory"
      ]
    },
    {
      "id": "eng.info.n04_mutual_information",
      "short_code": "INFO04",
      "kind": "definition",
      "title": "相互情報量の定義と非負性・エントロピー関係式",
      "summary": "同時分布と周辺分布の積の間のKLダイバージェンスとして定義される相互情報量 I(X;Y) と、エントロピーとの基本関係式。",
      "canonical_latex": "I(X;Y) := D_{\\mathrm{KL}}(p_{X,Y}\\|p_X p_Y) = \\sum_{x,y} p(x,y)\\log_2\\frac{p(x,y)}{p(x)p(y)} = H(X) - H(X|Y) = H(Y) - H(Y|X) \\ge 0",
      "aliases_latex": [
        "I(X;Y) = H(X) + H(Y) - H(X,Y)"
      ],
      "keywords": [
        "相互情報量",
        "条件付きエントロピー",
        "独立性"
      ],
      "domain_tags": [
        "information_theory"
      ]
    },
    {
      "id": "eng.info.n05_kraft_inequality",
      "short_code": "INFO05",
      "kind": "theorem_formula",
      "title": "クラフトの不等式（瞬時符号の符号長条件）",
      "summary": "D元アルファベット上の任意の語頭符号（瞬時符号）の符号長 l_1, ..., l_m が満たすべき必要十分条件。",
      "canonical_latex": "\\sum_{i=1}^{m} D^{-l_i} \\le 1",
      "aliases_latex": [
        "\\sum_{i=1}^{m} 2^{-l_i} \\le 1"
      ],
      "keywords": [
        "クラフトの不等式",
        "瞬時符号",
        "語頭符号"
      ],
      "domain_tags": [
        "information_theory"
      ]
    },
    {
      "id": "eng.info.n06_source_coding_huffman",
      "short_code": "INFO06",
      "kind": "theorem_formula",
      "title": "情報源符号化定理（シャノンの第1定理）とハフマン符号の最適性",
      "summary": "任意の瞬時符号の平均符号長 L がエントロピー H_D(X) 以上であるという下界、シャノン符号による上界、およびハフマン符号の最適性。",
      "canonical_latex": "H_D(X) \\le L = \\sum_{i=1}^{m} p_i l_i,\\qquad \\exists\\text{ prefix code: } H_D(X) \\le L_{\\mathrm{Huffman}} \\le L_{\\mathrm{Shannon}} < H_D(X) + 1",
      "aliases_latex": [
        "H(X) \\le \\mathbb{E}[l(X)] < H(X) + 1"
      ],
      "keywords": [
        "情報源符号化定理",
        "ハフマン符号",
        "平均符号長",
        "最適符号"
      ],
      "domain_tags": [
        "information_theory"
      ]
    },
    {
      "id": "eng.info.n07_differential_entropy_gaussian",
      "short_code": "INFO07",
      "kind": "theorem_formula",
      "title": "微分エントロピーとガウス分布の最大エントロピー性",
      "summary": "連続確率変数の微分エントロピー h(X) の定義、分散 sigma^2 のガウス分布の微分エントロピー、および分散固定下での最大エントロピー定理。",
      "canonical_latex": "h(X) := -\\int_{-\\infty}^{\\infty} f(x)\\log_2 f(x)\\,dx,\\qquad \\mathbb{E}[(X-\\mu)^2] = \\sigma^2 \\implies h(X) \\le \\frac{1}{2}\\log_2(2\\pi e \\sigma^2)",
      "aliases_latex": [
        "h(\\mathcal{N}(\\mu,\\sigma^2)) = \\frac{1}{2}\\log_2(2\\pi e \\sigma^2)"
      ],
      "keywords": [
        "微分エントロピー",
        "ガウス分布",
        "最大エントロピー原理"
      ],
      "domain_tags": [
        "information_theory"
      ]
    },
    {
      "id": "eng.info.n08_channel_capacity_def",
      "short_code": "INFO08",
      "kind": "definition",
      "title": "通信路容量（Channel Capacity）の定義",
      "summary": "離散無記憶通信路および電力制約付き連続通信路における、入力分布にわたる相互情報量の最大値としての通信路容量の定義。",
      "canonical_latex": "C := \\max_{p(x)} I(X;Y),\\qquad C_{\\mathrm{power}} := \\max_{f(x):\\,\\mathbb{E}[X^2]\\le S} I(X;Y)",
      "aliases_latex": [
        "C = \\sup_{p_X} I(X;Y)"
      ],
      "keywords": [
        "通信路容量",
        "相互情報量最大化",
        "電力制約"
      ],
      "domain_tags": [
        "information_theory"
      ]
    },
    {
      "id": "eng.info.n09_shannon_hartley_awgn",
      "short_code": "INFO09",
      "kind": "theorem_formula",
      "title": "AWGN通信路におけるシャノン＝ハートレーの通信路容量公式",
      "summary": "帯域幅 B、平均送信電力 S、加法性白色ガウス雑音（AWGN）電力 N を持つ連続時間通信路の通信路容量 C = B log2(1 + S/N)。",
      "canonical_latex": "C = B\\log_2\\left(1 + \\frac{S}{N}\\right)\\quad [\\text{bit/s}]",
      "aliases_latex": [
        "C = \\frac{1}{2}\\log_2\\left(1 + \\frac{S}{N}\\right)\\quad [\\text{bit/use}]",
        "C = B\\log_2\\left(1 + \\frac{S}{N_0 B}\\right)"
      ],
      "keywords": [
        "シャノン＝ハートレーの定理",
        "AWGN通信路",
        "通信路容量",
        "SN比"
      ],
      "domain_tags": [
        "information_theory"
      ]
    }
