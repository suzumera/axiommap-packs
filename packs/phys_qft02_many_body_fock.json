        "many_body_physics"
      ]
    },
    {
      "id": "phys.qft.mb02_fock_space_occupation_number",
      "short_code": "MB02",
      "kind": "definition",
      "title": "フォック空間と占有数表示（状態数表示）",
      "summary": "粒子数 N=0,1,2,... の対称化（または反対称化）N粒子ヒルベルト空間の直和としてフォック空間を定義し、各1粒子状態 k の占有数 n_k の組で基底を指定する。",
      "canonical_latex": "\\mathcal{F}_{\\pm} := \\bigoplus_{N=0}^{\\infty} \\mathcal{H}_{\\pm}^{(N)},\\quad |n_1,n_2,\\dots\\rangle \\in \\mathcal{F}_{\\pm}\\quad\\left(\\sum_k n_k = N,\\; n_k\\in\\mathbb{Z}_{\\ge 0}\\;(\\text{boson}),\\; n_k\\in\\{0,1\\}\\;(\\text{fermion})\\right),\\quad |\\mathrm{vac}\\rangle := |0,0,\\dots\\rangle",
      "aliases_latex": [
        "\\mathcal{F} = \\mathbb{C} \\oplus \\mathcal{H}^{(1)} \\oplus \\mathcal{H}_{\\pm}^{(2)} \\oplus \\cdots"
