  "nodes": [
    {
      "id": "phys.qft.mb01_identical_particles_symmetrization",
      "short_code": "MB01",
      "kind": "definition",
      "title": "同種多粒子系の置換対称性と対称化・反対称化状態",
      "summary": "同種多粒子系のヒルベルト空間において、粒子置換演算子の固有値 +1（ボゾン：全対称状態）および -1（フェルミオン：全反対称状態）に制限された状態空間を定義する。",
      "canonical_latex": "\\hat{P}_{ij}|\\Psi_{\\pm}\\rangle = \\pm|\\Psi_{\\pm}\\rangle,\\quad |\\alpha_1,\\dots,\\alpha_N\\rangle_{\\pm} := \\frac{1}{\\sqrt{N!\\prod_k n_k!}}\\sum_{P\\in S_N}(\\pm 1)^{\\operatorname{sgn}(P)}|\\alpha_{P(1)}\\rangle\\otimes\\cdots\\otimes|\\alpha_{P(N)}\\rangle",
      "aliases_latex": [
        "\\Psi_{\\pm}(x_1,\\dots,x_N) = \\frac{1}{\\sqrt{N!}}\\sum_{P\\in S_N}(\\pm 1)^{\\operatorname{sgn}(P)}\\prod_{i=1}^N \\phi_{\\alpha_{P(i)}}(x_i)"
      ],
      "keywords": [
        "同種粒子",
        "ボゾン",
        "フェルミオン",
        "対称化",
        "反対称化",
        "スレーター行列式"
      ],
