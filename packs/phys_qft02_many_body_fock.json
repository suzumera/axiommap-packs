      "canonical_latex": "\\hat{\\psi}(\\mathbf{x}) := \\sum_k \\phi_k(\\mathbf{x})\\hat{a}_k,\\quad \\hat{\\psi}^\\dagger(\\mathbf{x}) := \\sum_k \\phi_k^*(\\mathbf{x})\\hat{a}_k^\\dagger,\\quad [\\hat{\\psi}(\\mathbf{x}), \\hat{\\psi}^\\dagger(\\mathbf{y})]_{\\mp} = \\delta^{(3)}(\\mathbf{x}-\\mathbf{y})",
