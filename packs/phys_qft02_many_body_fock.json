    {
      "id": "phys.qft.mb05_number_operator_total",
      "short_code": "MB05",
      "kind": "theorem_formula",
      "title": "占有数演算子・全粒子数演算子と交換関係",
      "summary": "生成・消滅演算子から各モードの占有数演算子と全粒子数演算子を構成し、ボゾン・フェルミオン双方で成り立つ共通の交換関係を示す。",
      "canonical_latex": "\\hat{n}_k := \\hat{a}_k^\\dagger\\hat{a}_k,\\quad \\hat{N} := \\sum_k \\hat{n}_k,\\quad [\\hat{n}_k, \\hat{a}_l^\\dagger] = \\delta_{kl}\\hat{a}_l^\\dagger,\\quad [\\hat{n}_k, \\hat{a}_l] = -\\delta_{kl}\\hat{a}_l",
