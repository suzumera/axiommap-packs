      "canonical_latex": "\\{\\hat{c}_i, \\hat{c}_j^\\dagger\\} = \\delta_{ij},\\quad \\{\\hat{c}_i, \\hat{c}_j\\} = \\{\\hat{c}_i^\\dagger, \\hat{c}_j^\\dagger\\} = 0,\\quad (\\hat{c}_i^\\dagger)^2 = 0",
