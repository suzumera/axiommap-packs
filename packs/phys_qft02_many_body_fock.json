      ]
    },
    {
      "id": "phys.qft.mb03_bosonic_ladder_ccr",
      "short_code": "MB03",
      "kind": "theorem_formula",
      "title": "ボゾンの生成・消滅演算子と正準交換関係（CCR）",
      "summary": "ボゾンの占有数基底に作用する生成・消滅演算子を定義し、多モードの正準交換関係（CCR）と状態への昇降作用の係数を導出する。",
      "canonical_latex": "[\\hat{a}_k, \\hat{a}_l^\\dagger] = \\delta_{kl},\\quad [\\hat{a}_k, \\hat{a}_l] = [\\hat{a}_k^\\dagger, \\hat{a}_l^\\dagger] = 0,\\quad \\hat{a}_k^\\dagger|n_k\\rangle = \\sqrt{n_k+1}|n_k+1\\rangle,\\quad \\hat{a}_k|n_k\\rangle = \\sqrt{n_k}|n_k-1\\rangle",
      "aliases_latex": [
