  "nodes": [
    {
      "id": "math.laplace.lt01_laplace_transform_def",
      "short_code": "LT01",
      "kind": "definition",
      "title": "片側ラプラス変換の定義と収束座標軸（指数位数）",
      "summary": "因果関数 f(t) (t >= 0) に対する片側ラプラス変換 F(s) = L[f](s) と、絶対収束を保証する指数位数・収束座標軸 Re(s) > sigma_c を定義する。",
      "canonical_latex": "F(s) = \\mathcal{L}[f](s) := \\int_{0^-}^{\\infty} f(t) e^{-st}\\,dt \\quad (\\operatorname{Re}(s) > \\sigma_c),\\qquad |f(t)| \\le M e^{\\sigma_0 t}\\;(t \\ge 0) \\implies \\sigma_c \\le \\sigma_0",
      "aliases_latex": [
        "F(s) = \\int_{0}^{\\infty} f(t)e^{-st}\\,dt"
      ],
      "keywords": [
        "Laplace transform",
        "unilateral",
        "abscissa of convergence",
        "exponential order",
        "片側ラプラス変換",
        "収束座標軸"
      ],
      "domain_tags": [
        "mathematics",
        "laplace_transform",
        "complex_analysis"
      ]
    },
    {
      "id": "math.laplace.lt02_linearity_and_shifting",
      "short_code": "LT02",
      "kind": "theorem_formula",
      "title": "ラプラス変換の線形性と移動法則（s領域・時間領域）",
      "summary": "ラプラス変換の線形性、指数関数乗算による s 領域平行移動（第1移動定理）、および単位ステップ関数を伴う時間遅延（第2移動定理）を与える。",
      "canonical_latex": "\\mathcal{L}[\\alpha f + \\beta g](s) = \\alpha F(s) + \\beta G(s),\\quad \\mathcal{L}[e^{at}f(t)](s) = F(s-a),\\quad \\mathcal{L}[f(t-a)u(t-a)](s) = e^{-as}F(s)\\;(a>0),\\quad \\mathcal{L}[f(ct)](s) = \\frac{1}{c}F\\!\\left(\\frac{s}{c}\\right)\\;(c>0) ",
      "aliases_latex": [
        "\\mathcal{L}[e^{at}f(t)](s)=F(s-a)"
      ],
      "keywords": [
        "linearity",
        "frequency shifting",
        "time shifting",
        "Heaviside step",
        "線形性",
        "移動定理"
      ],
      "domain_tags": [
        "mathematics",
        "laplace_transform"
      ]
    },
    {
      "id": "math.laplace.lt03_elementary_transforms",
      "short_code": "LT03",
      "kind": "theorem_formula",
      "title": "基本関数のラプラス変換公式",
      "summary": "べき関数 t^n、指数関数 e^{at}、および三角関数 cos(omega t), sin(omega t) のラプラス変換の標準公式をまとめる。",
      "canonical_latex": "\\mathcal{L}[1](s) = \\frac{1}{s},\\quad \\mathcal{L}[t^n](s) = \\frac{n!}{s^{n+1}},\\quad \\mathcal{L}[e^{at}](s) = \\frac{1}{s-a},\\quad \\mathcal{L}[\\cos\\omega t](s) = \\frac{s}{s^2+\\omega^2},\\quad \\mathcal{L}[\\sin\\omega t](s) = \\frac{\\omega}{s^2+\\omega^2} ",
      "aliases_latex": [
        "\\mathcal{L}[t^n](s)=\\Gamma(n+1)/s^{n+1}"
      ],
      "keywords": [
        "elementary Laplace transforms",
        "power",
        "exponential",
        "trigonometric",
        "基本関数"
      ],
      "domain_tags": [
        "mathematics",
        "laplace_transform"
      ]
    },
    {
      "id": "math.laplace.lt04_derivative_integral_rules",
      "short_code": "LT04",
      "kind": "theorem_formula",
      "title": "ラプラス変換の微分法則と積分法則",
      "summary": "時間領域の高階微分を s の多項式と初期値に変換する微分法則、時間領域積分を 1/s 倍に対応させる積分法則、および s 領域微分法則を与える。",
      "canonical_latex": "\\mathcal{L}[f^{(n)}](s) = s^n F(s) - \\sum_{k=0}^{n-1} s^{n-1-k} f^{(k)}(0^-),\\quad \\mathcal{L}\\!\\left[\\int_{0^-}^{t} f(\\tau)\\,d\\tau\\right](s) = \\frac{F(s)}{s},\\quad \\mathcal{L}[t^n f(t)](s) = (-1)^n \\frac{d^n F}{ds^n}(s) ",
      "aliases_latex": [
        "\\mathcal{L}[f'(t)](s) = sF(s) - f(0^-)"
      ],
      "keywords": [
        "derivative rule",
        "integral rule",
        "frequency differentiation",
        "微分法則",
        "積分法則"
      ],
      "domain_tags": [
        "mathematics",
        "laplace_transform"
      ]
    },
    {
      "id": "math.laplace.lt05_causal_convolution_theorem",
      "short_code": "LT05",
      "kind": "theorem_formula",
      "title": "片側畳み込み積分とラプラス変換の畳み込み定理",
      "summary": "因果関数に対する片側畳み込み積分 (f*g)(t) を定義し、そのラプラス変換が各変換の積 F(s)G(s) に一致することを示す。",
      "canonical_latex": "(f * g)(t) := \\int_{0}^{t} f(\\tau)g(t - \\tau)\\,d\\tau \\implies \\mathcal{L}[f * g](s) = F(s)G(s)\\quad (\\operatorname{Re}(s) > \\max(\\sigma_f, \\sigma_g)) ",
      "aliases_latex": [
        "\\mathcal{L}\\!\\left[\\int_0^t f(\\tau)g(t-\\tau)\\,d\\tau\\right] = \\mathcal{L}[f]\\mathcal{L}[g]"
      ],
      "keywords": [
        "convolution theorem",
        "causal convolution",
        "Duhamel",
        "畳み込み定理"
      ],
      "domain_tags": [
        "mathematics",
        "laplace_transform"
      ]
    },
    {
      "id": "math.laplace.lt06_initial_value_theorem",
      "short_code": "LT06",
      "kind": "theorem_formula",
      "title": "ラプラス変換の初期値定理",
      "summary": "時間領域における t -> 0^+ の極限値 f(0^+) を、s 領域の s -> infinity における sF(s) の極限として求める初期値定理を与える。",
      "canonical_latex": "\\lim_{t \\to 0^+} f(t) = \\lim_{s \\to \\infty} s F(s) \\quad (f,\\, f' \\text{ piecewise continuous and of exponential order})",
      "aliases_latex": [
        "f(0^+) = \\lim_{s\\to\\infty} sF(s)"
      ],
      "keywords": [
        "initial value theorem",
        "IVT",
        "asymptotic",
        "初期値定理"
      ],
      "domain_tags": [
        "mathematics",
        "laplace_transform"
      ]
    },
    {
      "id": "math.laplace.lt07_final_value_theorem",
      "short_code": "LT07",
      "kind": "theorem_formula",
      "title": "ラプラス変換の最終値定理",
      "summary": "sF(s) のすべての極が複素左半平面 Re(s) < 0 に存在するとき、t -> infinity での定常値 f(infinity) が s -> 0 での sF(s) の極限に等しいことを示す。",
      "canonical_latex": "\\lim_{t \\to \\infty} f(t) = \\lim_{s \\to 0} s F(s) \\quad (\\text{all poles of } sF(s) \\text{ lie in } \\operatorname{Re}(s) < 0) ",
      "aliases_latex": [
        "f(\\infty) = \\lim_{s\\to 0} sF(s)"
      ],
      "keywords": [
        "final value theorem",
        "FVT",
        "steady state",
        "最終値定理"
      ],
      "domain_tags": [
        "mathematics",
        "laplace_transform"
      ]
    },
    {
      "id": "math.laplace.lt08_bromwich_inversion_integral",
      "short_code": "LT08",
      "kind": "theorem_formula",
      "title": "ブロムウィッチ積分（ラプラス逆変換公式）と留数評価",
      "summary": "フーリエ逆変換の複素化により導かれるブロムウィッチ線積分公式と、ジョルダンの補題・留数定理を用いた複素平面左半平面の極による逆変換評価を与える。",
      "canonical_latex": "f(t) = \\mathcal{L}^{-1}[F](t) = \\frac{1}{2\\pi i}\\lim_{T \\to \\infty}\\int_{\\gamma - iT}^{\\gamma + iT} F(s) e^{st}\\,ds = \\sum_{\\operatorname{Re}(s_k) < \\gamma} \\operatorname{Res}\\!\\big(F(s)e^{st},\\, s_k\\big)\\quad (t > 0,\\; \\gamma > \\sigma_c) ",
      "aliases_latex": [
        "f(t) = \\frac{1}{2\\pi i}\\int_{\\gamma-i\\infty}^{\\gamma+i\\infty} F(s)e^{st}\\,ds"
      ],
      "keywords": [
        "Bromwich integral",
        "inverse Laplace transform",
        "Mellin inversion",
        "residue",
        "ブロムウィッチ積分",
        "ラプラス逆変換"
      ],
      "domain_tags": [
        "mathematics",
        "laplace_transform",
        "complex_analysis"
      ]
    },
    {
      "id": "math.laplace.lt09_algebraic_ode_method",
      "short_code": "LT09",
      "kind": "theorem_formula",
      "title": "ラプラス変換による定数係数線形常微分方程式の代数解法",
      "summary": "初期値問題を伴う定数係数線形常微分方程式を s 領域の代数方程式（特性多項式と初期値多項式）へ変換し、逆変換によって一意解を得る手法を与える。",
      "canonical_latex": "\\sum_{k=0}^{n} a_k y^{(k)}(t) = g(t) \\implies P(s)Y(s) = G(s) + I_0(s),\\quad Y(s) = \\frac{G(s) + I_0(s)}{P(s)} \\implies y(t) = \\mathcal{L}^{-1}[Y](t) ",
      "aliases_latex": [
        "P(s)Y(s) = G(s) + I_0(s)"
      ],
      "keywords": [
        "linear ODE",
        "initial value problem",
        "transfer function",
        "algebraic method",
        "微分方程式の代数解法"
      ],
      "domain_tags": [
        "mathematics",
        "laplace_transform",
        "ode"
      ]
    }
