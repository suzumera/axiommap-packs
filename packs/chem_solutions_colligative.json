  "nodes": [
    {
      "id": "chem.sol.n01_phase_equilibrium_mu",
      "short_code": "SOL01",
      "kind": "theorem_formula",
      "title": "多相平衡における化学ポテンシャルの等値条件",
      "summary": "一定温度・圧力下の多相系においてギブズ自由エネルギーが極小となる物質移動平衡の条件（各成分の化学ポテンシャルが全相で等しい）。",
      "canonical_latex": "\\mu_i^{(\\alpha)}(T,p) = \\mu_i^{(\\beta)}(T,p)\\quad (\\forall i,\\;\\text{at equilibrium})",
      "aliases_latex": [
        "\\mu_i^{\\alpha} = \\mu_i^{\\beta}"
      ],
      "keywords": [
        "相平衡",
        "化学ポテンシャル",
        "ギブズ自由エネルギー",
        "物質平衡"
      ],
      "domain_tags": [
        "physical_chemistry",
        "thermodynamics"
      ],
      "intuition_oneliner": "要するに何？: 液体と気体などが混ざり合うとき、物質が移動し尽くして安定した状態では、どの相でも物質の「逃げやすさ（化学ポテンシャル）」が等しくなります。",
      "diagram_svg": "<svg viewBox=\"0 0 600 260\" xmlns=\"http://www.w3.org/2000/svg\"><rect width=\"600\" height=\"260\" fill=\"none\"/><rect x=\"100\" y=\"80\" width=\"150\" height=\"100\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><rect x=\"350\" y=\"80\" width=\"150\" height=\"100\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><text x=\"175\" y=\"135\" fill=\"#3b82f6\" font-size=\"20\" text-anchor=\"middle\">相 α</text><text x=\"425\" y=\"135\" fill=\"#f97316\" font-size=\"20\" text-anchor=\"middle\">相 β</text><path d=\"M260 120 H340\" stroke=\"currentColor\" stroke-width=\"2\"/><polygon points=\"340,115 350,120 340,125\" fill=\"currentColor\"/><polygon points=\"260,115 250,120 260,125\" fill=\"currentColor\"/><text x=\"300\" y=\"105\" fill=\"currentColor\" font-size=\"12\" text-anchor=\"middle\">μ平衡</text></svg>"
    },
    {
      "id": "chem.sol.n02_raoults_law",
      "short_code": "SOL02",
      "kind": "theorem_formula",
      "title": "理想溶液の化学ポテンシャルとラウールの法則",
      "summary": "理想溶液における液相成分の化学ポテンシャルと気液平衡条件から導かれるラウールの法則（各成分の分圧がモル分率に比例する）。",
      "canonical_latex": "\\mu_i^{\\mathrm{l}}(T,p) = \\mu_i^*(T,p) + RT\\ln x_i,\\qquad p_i = x_i p_i^*(T)",
      "aliases_latex": [
        "p_A = x_A p_A^*"
      ],
      "keywords": [
        "ラウールの法則",
        "理想溶液",
        "蒸気圧",
        "モル分率"
      ],
      "domain_tags": [
        "physical_chemistry",
        "solutions"
      ],
      "intuition_oneliner": "要するに何？: 液体に別の物質が溶けているとき、その液体の蒸発する勢い（蒸気圧）は、もともとの純粋な液体の勢いに、溶けている液体の割合（モル分率）を掛けたものに等しくなるという法則です。",
      "diagram_svg": "<svg viewBox=\"0 0 600 260\" xmlns=\"http://www.w3.org/2000/svg\"><rect width=\"600\" height=\"260\" fill=\"none\"/><line x1=\"100\" y1=\"200\" x2=\"500\" y2=\"200\" stroke=\"currentColor\" stroke-width=\"2\"/><line x1=\"100\" y1=\"200\" x2=\"100\" y2=\"50\" stroke=\"currentColor\" stroke-width=\"2\"/><path d=\"M100 200 L500 80\" stroke=\"#3b82f6\" stroke-width=\"3\"/><text x=\"300\" y=\"230\" fill=\"currentColor\" font-size=\"14\" text-anchor=\"middle\">モル分率 x_i</text><text x=\"70\" y=\"130\" fill=\"currentColor\" font-size=\"14\" text-anchor=\"middle\">分圧 p_i</text><text x=\"350\" y=\"120\" fill=\"#f97316\" font-size=\"14\" text-anchor=\"middle\">比例関係</text></svg>"
    },
    {
      "id": "chem.sol.n03_henrys_law",
      "short_code": "SOL03",
      "kind": "theorem_formula",
      "title": "希薄溶液における溶質のヘンリーの法則",
      "summary": "理想希薄溶液において溶媒がラウールの法則に従うとき、ギブズ＝デュエムの式と気液平衡条件から導かれる溶質の蒸気圧則。",
      "canonical_latex": "p_B = K_H(T) x_B \\quad (x_B \\ll 1)",
