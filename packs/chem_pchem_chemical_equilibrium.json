    "title": "物理化学1：化学ポテンシャル・ギブズ自由エネルギーと化学平衡（ファントホッフの式）",
    "language": "ja",
    "description": "熱力学ポテンシャル（G）から化学ポテンシャル、反応ギブズエネルギーΔG=ΔG°+RT ln Q、平衡定数K、ファントホッフの式を導出する。"
  },
  "nodes": [
    {
      "id": "chem.eq.n01_reaction_quotient_spontaneity_criterion",
      "short_code": "EQ01",
      "kind": "theorem_formula",
      "title": "反応商と平衡定数の比による反応自発性の判定則（Δ_r G = RT ln(Q/K)）",
      "summary": "反応ギブズエネルギーと平衡定数の関係式を結合し、反応商 Q と平衡定数 K の大小関係から定温定圧下での化学反応の自発的進行方向を判定する。",
      "canonical_latex": "\\Delta_r G = RT \\ln\\frac{Q}{K},\\qquad Q < K \\implies \\Delta_r G < 0\\;(\\text{forward}),\\quad Q > K \\implies \\Delta_r G > 0\\;(\\text{reverse})",
      "aliases_latex": [
        "\\Delta_r G = RT\\ln(Q/K)"
      ],
      "keywords": [
        "reaction_quotient",
        "equilibrium_constant",
        "spontaneity",
        "reaction_gibbs_energy"
      ],
      "domain_tags": [
        "physical_chemistry",
        "chemical_equilibrium"
      ]
    },
    {
      "id": "chem.eq.n02_standard_reaction_gibbs_formation",
      "short_code": "EQ02",
      "kind": "theorem_formula",
      "title": "標準反応ギブズエネルギーの標準生成ギブズエネルギー表示",
      "summary": "標準状態における化学反応の標準反応ギブズエネルギーを、各関与成分の標準生成ギブズエネルギーと化学量論係数の線形結合として表す関係式。",
      "canonical_latex": "\\Delta_r G^\\circ(T) = \\sum_{i=1}^{C} \\nu_i \\Delta_f G_i^\\circ(T)",
      "aliases_latex": [
        "\\Delta_r G^\\circ = \\sum \\nu_i \\Delta_f G_i^\\circ"
      ],
      "keywords": [
        "standard_reaction_gibbs_energy",
        "standard_gibbs_energy_of_formation",
        "stoichiometry"
      ],
      "domain_tags": [
        "physical_chemistry",
        "chemical_equilibrium"
      ]
    },
    {
      "id": "chem.eq.n03_kp_kc_kx_equilibrium_relations",
      "short_code": "EQ03",
      "kind": "theorem_formula",
      "title": "理想気体反応における圧平衡定数 K_p と K_c, K_x の関係式",
      "summary": "理想気体の状態方程式と活量の分圧表示を用いて、無次元熱力学平衡定数 K とモル濃度平衡定数 K_c、モル分率平衡定数 K_x を結びつける関係式。",
      "canonical_latex": "K = \\prod_{i=1}^{C} \\left(\\frac{p_i}{p^\\circ}\\right)^{\\nu_i} = K_c \\left(\\frac{RT}{p^\\circ}\\right)^{\\Delta \\nu} = K_x \\left(\\frac{p}{p^\\circ}\\right)^{\\Delta \\nu},\\qquad \\Delta\\nu := \\sum_{i=1}^{C} \\nu_i",
      "aliases_latex": [
        "K_p = K_c (RT)^{\\Delta \\nu}",
        "K_p = K_x p^{\\Delta \\nu}"
      ],
      "keywords": [
        "pressure_equilibrium_constant",
        "concentration_equilibrium_constant",
        "mole_fraction_equilibrium_constant",
        "ideal_gas_reaction"
      ],
      "domain_tags": [
        "physical_chemistry",
        "chemical_equilibrium"
      ]
    },
    {
      "id": "chem.eq.n04_le_chatelier_temperature_response",
      "short_code": "EQ04",
      "kind": "theorem_formula",
      "title": "温度変化に対するルシャトリエの原理（吸熱・発熱反応の平衡移動）",
      "summary": "ファントホッフの式に基づき、昇温時に吸熱反応（Δ_r H° > 0）では平衡定数 K が増大し、発熱反応（Δ_r H° < 0）では K が減少することを定式化する法則。",
      "canonical_latex": "\\Delta_r H^\\circ > 0 \\implies \\frac{d\\ln K}{dT} > 0\\;(\\text{endothermic}),\\qquad \\Delta_r H^\\circ < 0 \\implies \\frac{d\\ln K}{dT} < 0\\;(\\text{exothermic})",
      "aliases_latex": [
        "\\operatorname{sgn}(d\\ln K / dT) = \\operatorname{sgn}(\\Delta_r H^\\circ)"
      ],
      "keywords": [
        "le_chatelier_principle",
        "temperature_dependence",
        "endothermic",
        "exothermic"
      ],
      "domain_tags": [
        "physical_chemistry",
        "chemical_equilibrium"
      ]
    },
    {
      "id": "chem.eq.n05_le_chatelier_pressure_response",
      "short_code": "EQ05",
      "kind": "theorem_formula",
      "title": "圧力変化に対するルシャトリエの原理（K_x の圧力依存性）",
      "summary": "熱力学平衡定数 K が圧力に依存しないことと K = K_x (p/p°)^{Δν} から、定温加圧時に気体分子数が減少する方向（Δν < 0）へ平衡が移動することを導く関係式。",
      "canonical_latex": "\\left(\\frac{\\partial \\ln K_x}{\\partial p}\\right)_T = -\\frac{\\Delta \\nu}{p},\\qquad \\Delta\\nu < 0 \\implies \\left(\\frac{\\partial \\ln K_x}{\\partial p}\\right)_T > 0",
      "aliases_latex": [
        "(\\partial \\ln K_x / \\partial p)_T = -\\Delta \\nu / p"
      ],
      "keywords": [
        "le_chatelier_principle",
        "pressure_dependence",
        "mole_fraction_equilibrium_constant"
      ],
      "domain_tags": [
        "physical_chemistry",
        "chemical_equilibrium"
      ]
    },
    {
      "id": "chem.eq.n06_fugacity_nonideal_chemical_potential",
      "short_code": "EQ06",
      "kind": "definition",
      "title": "実在気体のフガシティーとフガシティー係数の定義",
      "summary": "理想気体の化学ポテンシャル表示を実在気体へ拡張するために導入される有効圧力（フガシティー f_i）および無次元補正係数（フガシティー係数 φ_i）の定義。",
      "canonical_latex": "\\mu_i(T,p) = \\mu_i^\\circ(T) + RT\\ln\\frac{f_i}{p^\\circ},\\qquad \\phi_i := \\frac{f_i}{p_i},\\qquad \\lim_{p\\to 0}\\phi_i = 1",
      "aliases_latex": [
        "f_i = \\phi_i p_i"
      ],
      "keywords": [
        "fugacity",
        "fugacity_coefficient",
        "real_gas",
        "chemical_potential"
      ],
      "domain_tags": [
        "physical_chemistry",
        "chemical_equilibrium"
      ]
    },
    {
      "id": "chem.eq.n07_clausius_clapeyron_phase_eq",
      "short_code": "EQ07",
      "kind": "theorem_formula",
      "title": "クラペイロンおよびクラウジウス＝クラペイロンの式（相平衡の共存曲線）",
      "summary": "2相共存条件とギブズ＝デュエムの式から導かれる相平衡曲線の傾き dp/dT の関係式、および気相を理想気体とみなした蒸気圧の温度依存式。",
      "canonical_latex": "\\frac{dp}{dT} = \\frac{\\Delta_{\\mathrm{trs}} H_m}{T\\,\\Delta_{\\mathrm{trs}} V_m},\\qquad \\frac{d\\ln p}{dT} = \\frac{\\Delta_{\\mathrm{vap}} H_m}{R T^2}\\;\\text{ (ideal vapor)}",
      "aliases_latex": [
