    "language": "ja",
    "description": "差分方程式とZ伝達関数H(z)、BIBO安定条件（単位円内極）、線形位相FIRフィルタ、双一次変換によるバターワースIIR設計を導出する。"
  },
  "nodes": [
    {
      "id": "eng.dsp2.n02_difference_eq_transfer_func",
      "short_code": "DSP2_02",
      "kind": "theorem_formula",
      "title": "線形定数係数差分方程式とZ伝達関数 H(z)",
      "summary": "離散時間LTIシステムを記述する線形定数係数差分方程式にZ変換を適用し、有理関数型の伝達関数と極零点表現を導出する。",
      "canonical_latex": "\\sum_{k=0}^{N} a_k y[n-k] = \\sum_{m=0}^{M} b_m x[n-m] \\implies H(z) = \\frac{Y(z)}{X(z)} = \\frac{\\sum_{m=0}^{M} b_m z^{-m}}{\\sum_{k=0}^{N} a_k z^{-k}} = \\frac{b_0}{a_0}\\frac{\\prod_{m=1}^{M}(1 - z_m z^{-1})}{\\prod_{k=1}^{N}(1 - p_k z^{-1})}",
      "aliases_latex": [
        "H(z) = \\frac{B(z)}{A(z)}"
      ],
      "keywords": [
        "difference equation",
        "transfer function",
        "poles and zeros",
        "LTI system"
      ],
      "domain_tags": [
        "signal_processing"
      ]
    },
    {
      "id": "eng.dsp2.n03_bibo_stability_unit_circle",
      "short_code": "DSP2_03",
      "kind": "theorem_formula",
      "title": "因果的LTIシステムのBIBO安定条件（単位円内極条件）",
      "summary": "有界入力有界出力（BIBO）安定性がインパルス応答の絶対総和可能性と同値であり、因果的LTIシステムではROCが単位円を含み全極が単位円内部に存在することを示す。",
      "canonical_latex": "\\sum_{n=0}^{\\infty} |h[n]| < \\infty \\iff \\mathrm{ROC} \\supset \\{z \\in \\mathbb{C} \\mid |z| \\ge 1\\} \\iff \\forall k,\\; |p_k| < 1",
      "aliases_latex": [
        "\\text{BIBO stable} \\iff \\max_k |p_k| < 1"
      ],
      "keywords": [
        "BIBO stability",
        "unit circle",
        "poles",
        "causal LTI system"
      ],
      "domain_tags": [
        "signal_processing"
      ]
    },
    {
      "id": "eng.dsp2.n04_dtft_frequency_response",
      "short_code": "DSP2_04",
      "kind": "theorem_formula",
      "title": "単位円上の周波数応答 H(e^{j\\omega}) と極零点による振幅・位相特性",
      "summary": "安定なシステムのZ伝達関数を単位円上に制限して離散時間周波数応答を得るとともに、極と零点からのベクトル距離・偏角による幾何学的解釈を与える。",
      "canonical_latex": "H(e^{j\\omega}) = H(z)\\big|_{z=e^{j\\omega}} = |H(e^{j\\omega})| e^{j\\angle H(e^{j\\omega})},\\quad |H(e^{j\\omega})| = \\left|\\frac{b_0}{a_0}\\right|\\frac{\\prod_{m=1}^{M}|e^{j\\omega} - z_m|}{\\prod_{k=1}^{N}|e^{j\\omega} - p_k|}",
      "aliases_latex": [
        "H(\\omega) = \\sum_{n=-\\infty}^{\\infty} h[n] e^{-j\\omega n}"
      ],
      "keywords": [
        "frequency response",
        "DTFT",
        "magnitude response",
        "phase response"
      ],
      "domain_tags": [
        "signal_processing"
      ]
    },
    {
      "id": "eng.dsp2.n05_fir_linear_phase_def",
      "short_code": "DSP2_05",
      "kind": "definition",
      "title": "FIRフィルタの定義と一般化線形位相条件",
      "summary": "非再帰的な有限インパルス応答（FIR）フィルタを定義し、全周波数帯域で群遅延が一定となる一般化線形位相条件を定式化する。",
      "canonical_latex": "H(z) = \\sum_{n=0}^{N-1} h[n] z^{-n},\\quad H(e^{j\\omega}) = A(\\omega) e^{-j\\alpha\\omega + j\\beta}\\; \\left(\\alpha = \\frac{N-1}{2},\\; \\beta \\in \\left\\{0, \\frac{\\pi}{2}\\right\\}\\right),\\quad \\tau_g(\\omega) := -\\frac{d}{d\\omega}\\angle H(e^{j\\omega}) = \\frac{N-1}{2}",
      "aliases_latex": [
        "y[n] = \\sum_{m=0}^{N-1} b_m x[n-m]"
      ],
      "keywords": [
        "FIR filter",
        "linear phase",
        "group delay",
        "non-recursive"
      ],
      "domain_tags": [
        "signal_processing"
      ]
    },
    {
      "id": "eng.dsp2.n06_fir_symmetry_types",
      "short_code": "DSP2_06",
      "kind": "theorem_formula",
      "title": "FIRフィルタの対称性による線形位相の実現と零点の鏡像対称性",
      "summary": "インパルス応答の偶対称・奇対称条件が一般化線形位相を保証し、伝達関数の零点が単位円に対して鏡像対称に配置されることを示す。",
      "canonical_latex": "h[n] = \\pm h[N-1-n] \\implies H(e^{j\\omega}) = \\begin{cases} e^{-j\\frac{N-1}{2}\\omega} A_{\\mathrm{even}}(\\omega) & (+) \\\\ j e^{-j\\frac{N-1}{2}\\omega} A_{\\mathrm{odd}}(\\omega) & (-) \\end{cases},\\quad H(z) = \\pm z^{-(N-1)} H(z^{-1})",
      "aliases_latex": [
        "h[n] = h[N-1-n] \\implies H(z) = z^{-(N-1)} H(z^{-1})"
      ],
      "keywords": [
        "FIR symmetry",
        "Type I-IV FIR",
        "mirror-image zeros",
        "linear phase"
      ],
      "domain_tags": [
        "signal_processing"
      ]
    },
    {
      "id": "eng.dsp2.n07_bilinear_transform_def",
      "short_code": "DSP2_07",
      "kind": "definition",
      "title": "双一次変換（Bilinear Transform）と周波数ワーピング",
      "summary": "連続時間s領域と離散時間z領域を結ぶ一次分数変換としての双一次変換と、アナログ・デジタル周波数間の非線形な周波数ワーピング関係を定義する。",
      "canonical_latex": "s = \\frac{2}{T}\\frac{1 - z^{-1}}{1 + z^{-1}},\\quad H(z) = H_a(s)\\Big|_{s = \\frac{2}{T}\\frac{1-z^{-1}}{1+z^{-1}}},\\quad \\Omega = \\frac{2}{T}\\tan\\left(\\frac{\\omega}{2}\\right)",
      "aliases_latex": [
        "s = \\frac{2}{T}\\frac{z-1}{z+1}"
      ],
      "keywords": [
        "bilinear transform",
        "frequency warping",
        "IIR filter design",
        "Tustin transform"
      ],
      "domain_tags": [
        "signal_processing"
      ]
    },
    {
      "id": "eng.dsp2.n08_bilinear_stability_preservation",
      "short_code": "DSP2_08",
      "kind": "theorem_formula",
      "title": "双一次変換による左半平面から単位円内への安定性保存写像",
      "summary": "双一次変換がs平面の開左半平面をz平面の単位円内部へ、虚軸を単位円周上へ1対1に写像し、アナログフィルタの安定性を完全に保存することを証明する。",
      "canonical_latex": "\\operatorname{Re}(s) < 0 \\iff |z| < 1,\\quad \\operatorname{Re}(s) = 0 \\iff |z| = 1\\quad \\left(z = \\frac{1 + \\frac{T}{2}s}{1 - \\frac{T}{2}s}\\right)",
      "aliases_latex": [
        "\\sigma < 0 \\iff |z| < 1"
      ],
      "keywords": [
        "stability preservation",
        "bilinear transform",
        "left half-plane",
        "unit disk"
      ],
      "domain_tags": [
        "signal_processing"
      ]
    },
    {
      "id": "eng.dsp2.n09_butterworth_iir_design",
      "short_code": "DSP2_09",
      "kind": "theorem_formula",
      "title": "バターワースアナログプロトタイプと双一次変換によるIIRフィルタ設計",
      "summary": "通過域で最大平坦特性を持つN次バターワースアナログフィルタの極配置を構成し、プリワーピングと双一次変換によって安定なデジタルIIRフィルタを設計する。",
      "canonical_latex": "|H_a(j\\Omega)|^2 = \\frac{1}{1 + (\\Omega / \\Omega_c)^{2N}},\\quad s_k = \\Omega_c e^{j\\pi\\left(\\frac{1}{2} + \\frac{2k+1}{2N}\\right)}\\;(k=0,\\dots,N-1),\\quad H(z) = H_a\\!\\left(\\frac{2}{T}\\frac{1-z^{-1}}{1+z^{-1}}\\right)",
      "aliases_latex": [
        "H_a(s) = \\frac{\\Omega_c^N}{\\prod_{k=0}^{N-1}(s - s_k)}"
      ],
      "keywords": [
        "Butterworth filter",
        "IIR filter",
        "maximally flat",
        "pre-warping"
      ],
      "domain_tags": [
        "signal_processing"
      ]
    }
  ],
