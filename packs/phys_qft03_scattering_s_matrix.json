      "canonical_latex": "S_{\\beta\\alpha} := \\langle\\beta;\\mathrm{out}|\\alpha;\\mathrm{in}\\rangle = \\langle\\beta;\\mathrm{in}|\\hat{S}|\\alpha;\\mathrm{in}\\rangle,\\qquad \\hat{S}^\\dagger\\hat{S} = \\hat{S}\\hat{S}^\\dagger = \\hat{I}",
      "aliases_latex": [
