      "canonical_latex": "|\\Omega\\rangle = \\lim_{\\epsilon\\to 0^+}\\frac{U_{I,\\epsilon}(0,-\\infty)|0\\rangle}{\\langle 0|U_{I,\\epsilon}(0,-\\infty)|0\\rangle},\\qquad \\langle\\Omega|T\\{\\phi(x_1)\\cdots\\phi(x_n)\\}|\\Omega\\rangle = \\lim_{\\epsilon\\to 0^+}\\frac{\\langle 0|T\\{\\phi_I(x_1)\\cdots\\phi_I(x_n)\\,\\exp[-i\\int dt\\,e^{-\\epsilon|t|}H_I(t)]\\}|0\\rangle}{\\langle 0|T\\{\\exp[-i\\int dt\\,e^{-\\epsilon|t|}H_I(t)]\\}|0\\rangle}",
