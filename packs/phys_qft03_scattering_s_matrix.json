      "canonical_latex": "\\hat{S} = \\hat{I} + i\\hat{T},\\qquad \\langle f | i\\hat{T} | i \\rangle = (2\\pi)^4\\delta^{(4)}(P_f - P_i)\\,i\\mathcal{M}_{fi}",
