      "id": "math.mfld.mfd01_smooth_manifold_atlas_def",
      "short_code": "MFD01",
      "kind": "definition",
      "title": "可微分多様体と座標近傍系の定義",
      "summary": "局所的にユークリッド空間と同相であり、重なり合う座標近傍間の座標変換写像がすべて滑らか（C∞級）であるハウスドルフ・第二可算位相空間として可微分多様体を定義する。",
      "canonical_latex": "M = \\bigcup_{\\alpha} U_\\alpha,\\quad \\varphi_\\alpha: U_\\alpha \\xrightarrow{\\sim} \\varphi_\\alpha(U_\\alpha) \\subseteq \\mathbb{R}^n,\\quad \\varphi_\\beta \\circ \\varphi_\\alpha^{-1} \\in C^\\infty\\big(\\varphi_\\alpha(U_\\alpha \\cap U_\\beta)\\big)\\;(\\forall \\alpha,\\beta:\\; U_\\alpha \\cap U_\\beta \\neq \\emptyset)",
      "aliases_latex": [
        "\\mathcal{A} = \\{(U_\\alpha, \\varphi_\\alpha)\\}_{\\alpha\\in A},\\quad \\psi_{\\beta\\alpha} := \\varphi_\\beta \\circ \\varphi_\\alpha^{-1} \\in C^\\infty"
      ],
      "keywords": [
        "可微分多様体",
        "座標近傍系",
        "アトラス",
        "座標変換写像",
        "C無限大級"
      ],
