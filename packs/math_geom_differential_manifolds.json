        "topology",
        "calculus_on_manifolds"
      ]
    },
    {
      "id": "math.mfld.mfd02_tangent_cotangent_spaces_def",
      "short_code": "MFD02",
      "kind": "definition",
      "title": "接空間・接ベクトルと余接空間の定義",
      "summary": "多様体上の点における滑らかな関数に対する方向微分作用素（導分）として接空間を定義し、その双対空間として全微分が張る余接空間を定義する。",
      "canonical_latex": "T_p M := \\{v: C^\\infty(M)\\to\\mathbb{R} \\mid v(\\alpha f+\\beta g)=\\alpha v(f)+\\beta v(g),\\; v(fg)=f(p)v(g)+g(p)v(f)\\} = \\operatorname{span}\\left\\{\\left.\\frac{\\partial}{\\partial x^i}\\right|_p\\right\\}_{i=1}^{n},\\quad T_p^* M := (T_p M)^* = \\operatorname{span}\\left\\{dx^i|_p\\right\\}_{i=1}^{n},\\text{ } dx^i|_p\\!\\left(\\left.\\frac{\\partial}{\\partial x^j}\\right|_p\\right)=\\delta^i_j",
      "aliases_latex": [
        "v = \\sum_{i=1}^{n} v^i \\left.\\frac{\\partial}{\\partial x^i}\\right|_p,\\quad \\omega = \\sum_{i=1}^{n} \\omega_i\\,dx^i|_p,\\quad \\langle \\omega, v \\rangle = \\sum_{i=1}^{n}\\omega_i v^i"
      ],
      "keywords": [
        "接空間",
        "接ベクトル",
        "余接空間",
        "双対基底",
        "導分"
      ],
      "domain_tags": [
        "mathematics",
        "differential_geometry",
        "manifolds",
        "linear_algebra"
      ]
    },
    {
      "id": "math.mfld.mfd03_differential_k_form_wedge_def",
      "short_code": "MFD03",
      "kind": "definition",
      "title": "ウェッジ積と k 次微分形式の定義",
      "summary": "余接空間上の交代多重線形形式の場として k 次微分形式を定義し、反対称化によって次数を加法的に結びつけるウェッジ積（外積）を定める。",
      "canonical_latex": "\\omega \\in \\Omega^k(M):\\; \\omega_p \\in \\Lambda^k(T_p^* M),\\quad (\\alpha \\wedge \\beta)(v_1,\\dots,v_{p+q}) := \\frac{1}{p!q!}\\sum_{\\sigma\\in S_{p+q}} \\operatorname{sgn}(\\sigma)\\,\\alpha(v_{\\sigma(1)},\\dots,v_{\\sigma(p)})\\beta(v_{\\sigma(p+1)},\\dots,v_{\\sigma(p+q)}),\\quad \\alpha\\wedge\\beta = (-1)^{pq}\\beta\\wedge\\alpha",
      "aliases_latex": [
        "\\omega = \\sum_{1\\le i_1<\\dots<i_k\\le n} \\omega_{i_1\\dots i_k}(x)\\,dx^{i_1}\\wedge\\dots\\wedge dx^{i_k}"
      ],
      "keywords": [
        "微分形式",
        "ウェッジ積",
        "外積代数",
        "交代テンソル場",
        "多重線形形式"
      ],
      "domain_tags": [
        "mathematics",
        "differential_geometry",
        "exterior_algebra",
        "manifolds"
      ]
    },
    {
      "id": "math.mfld.mfd04_exterior_derivative_def",
      "short_code": "MFD04",
      "kind": "definition",
      "title": "外微分作用素の定義と性質",
      "summary": "k 次微分形式を (k+1) 次微分形式へ写す座標不変な微分作用素として外微分を定義し、次数付きライプニッツ則や引き戻しとの可換性などの特徴付けを与える。",
      "canonical_latex": "d: \\Omega^k(M)\\to\\Omega^{k+1}(M),\\quad d\\!\\left(\\sum_I \\omega_I\\,dx^I\\right) := \\sum_I \\sum_{j=1}^{n}\\frac{\\partial\\omega_I}{\\partial x^j}\\,dx^j\\wedge dx^I,\\quad d(\\alpha\\wedge\\beta)=d\\alpha\\wedge\\beta + (-1)^{\\deg\\alpha}\\alpha\\wedge d\\beta",
      "aliases_latex": [
