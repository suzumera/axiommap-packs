    {
      "id": "eng.ecc.n01_gf2_vector_space",
      "short_code": "ECC01",
      "kind": "definition",
      "title": "GF(2)上のn次元ベクトル空間とハミング重み・ハミング距離の定義",
      "summary": "2元体GF(2)上の長さnのベクトル空間におけるXOR加算、非零成分数としてのハミング重み、および2ベクトル間のハミング距離を定義する。",
      "canonical_latex": "\\mathbb{F}_2 = \\{0,1\\},\\; w_H(\\mathbf{x}) := |\\{i \\mid x_i \\neq 0\\}|,\\; d_H(\\mathbf{x},\\mathbf{y}) := w_H(\\mathbf{x} \\oplus \\mathbf{y})",
      "aliases_latex": [
        "d_H(\\mathbf{x},\\mathbf{y}) = \\sum_{i=1}^{n} (x_i \\oplus y_i)"
      ],
      "keywords": [
        "GF(2)",
        "ハミング重み",
        "ハミング距離",
        "ベクトル空間"
      ],
      "domain_tags": [
        "communications",
        "coding_theory"
      ]
    },
    {
      "id": "eng.ecc.n02_linear_block_code_generator",
      "short_code": "ECC02",
      "kind": "definition",
      "title": "線形ブロック符号(n,k)と生成行列・組織符号の定義",
      "summary": "GF(2)^nのk次元部分空間としての線形ブロック符号、およびk×n生成行列Gと組織形[I_k | P]を定義する。",
      "canonical_latex": "\\mathcal{C} = \\{\\mathbf{u} G \\mid \\mathbf{u} \\in \\mathbb{F}_2^k\\} \\subseteq \\mathbb{F}_2^n,\\quad G \\in \\mathbb{F}_2^{k \\times n},\\quad G_{\\mathrm{sys}} = [I_k \\mid P]",
      "aliases_latex": [
        "\\mathbf{c} = \\mathbf{u} G"
      ],
      "keywords": [
        "線形ブロック符号",
        "生成行列",
        "組織符号",
        "符号化率"
      ],
      "domain_tags": [
        "communications",
        "coding_theory"
      ]
    },
    {
      "id": "eng.ecc.n03_parity_check_matrix",
      "short_code": "ECC03",
      "kind": "theorem_formula",
      "title": "パリティ検査行列Hと直交条件 GH^T = O",
      "summary": "線形ブロック符号Cの双対空間の基底から構成される(n-k)×nパリティ検査行列Hと、符号語判定条件cH^T=0および組織形H_sys=[P^T | I_{n-k}]を導出する。",
      "canonical_latex": "\\mathbf{c} \\in \\mathcal{C} \\iff \\mathbf{c} H^\\top = \\mathbf{0},\\quad G H^\\top = O_{k \\times (n-k)},\\quad H_{\\mathrm{sys}} = [P^\\top \\mid I_{n-k}]",
      "aliases_latex": [
        "\\mathcal{C} = \\ker(H)"
      ],
      "keywords": [
        "パリティ検査行列",
        "双対符号",
        "直交条件"
      ],
      "domain_tags": [
        "communications",
        "coding_theory"
      ]
    },
    {
      "id": "eng.ecc.n04_min_distance_weight_theorem",
      "short_code": "ECC04",
      "kind": "theorem_formula",
      "title": "線形符号の最小ハミング距離と最小重み・検査行列の線形従属性",
      "summary": "線形性により符号の最小ハミング距離が非零符号語の最小ハミング重みに一致し、さらに検査行列Hの線形従属な最小列数に等しいことを示す。",
      "canonical_latex": "d_{\\min}(\\mathcal{C}) = \\min_{\\mathbf{c} \\in \\mathcal{C}\\setminus\\{\\mathbf{0}\\}} w_H(\\mathbf{c}) = \\min \\{d \\mid \\exists d\\text{ linearly dependent columns of } H\\}",
      "aliases_latex": [
        "d_{\\min}(\\mathcal{C}) = w_{\\min}(\\mathcal{C})"
      ],
      "keywords": [
        "最小ハミング距離",
        "最小重み",
        "線形従属"
      ],
      "domain_tags": [
        "communications",
        "coding_theory"
      ]
    },
    {
      "id": "eng.ecc.n05_error_detection_correction_bound",
      "short_code": "ECC05",
      "kind": "theorem_formula",
      "title": "最小距離d_minによる誤り検出・訂正能力の限界定理",
      "summary": "ハミング空間上の三角不等式と球充填幾何から、最小距離d_minを持つ符号の最大誤り検出数d_min-1と最大誤り訂正数floor((d_min-1)/2)を導く。",
      "canonical_latex": "t_{\\mathrm{det}} = d_{\\min} - 1,\\qquad t_{\\mathrm{corr}} = \\left\\lfloor \\frac{d_{\\min} - 1}{2} \\right\\rfloor",
      "aliases_latex": [
        "2 t_{\\mathrm{corr}} + 1 \\le d_{\\min}"
      ],
      "keywords": [
        "誤り検出能力",
        "誤り訂正能力",
        "最小距離復号"
      ],
      "domain_tags": [
        "communications",
        "coding_theory"
      ]
    },
    {
      "id": "eng.ecc.n06_syndrome_decoding",
      "short_code": "ECC06",
      "kind": "theorem_formula",
      "title": "シンドロームの定義とコセットリーダーによる最尤復号原理",
      "summary": "受信語y=c+eに対するシンドロームs=yH^T=eH^Tが誤りベクトルの剰余類（コセット）のみに依存することを示し、最小重みコセットリーダーによる復号法を導出する。",
      "canonical_latex": "\\mathbf{y} = \\mathbf{c} \\oplus \\mathbf{e} \\implies \\mathbf{s} := \\mathbf{y} H^\\top = \\mathbf{e} H^\\top,\\quad \\hat{\\mathbf{e}} = \\arg\\min_{\\mathbf{e} H^\\top = \\mathbf{s}} w_H(\\mathbf{e}),\\quad \\hat{\\mathbf{c}} = \\mathbf{y} \\oplus \\hat{\\mathbf{e}}",
      "aliases_latex": [
        "\\mathbf{s} = \\mathbf{y} H^\\top"
      ],
      "keywords": [
        "シンドローム復号",
        "コセットリーダー",
        "剰余類",
        "最尤復号"
      ],
      "domain_tags": [
        "communications",
        "coding_theory"
      ]
    },
    {
      "id": "eng.ecc.n07_cyclic_code_polynomial",
      "short_code": "ECC07",
      "kind": "definition",
      "title": "巡回符号の多項式環表現と生成多項式g(x)",
      "summary": "巡回シフト不変な線形符号を剰余環GF(2)[x]/(x^n-1)のイデアルとして定式化し、x^n-1を割り切る生成多項式g(x)による符号化を表現する。",
      "canonical_latex": "\\mathbf{c} \\leftrightarrow c(x) \\in \\mathbb{F}_2[x]/(x^n - 1),\\quad g(x) \\mid (x^n - 1),\\quad c(x) = u(x) g(x) \\pmod{x^n - 1}",
      "aliases_latex": [
        "\\mathcal{C} = \\langle g(x) \\rangle \\subseteq \\mathbb{F}_2[x]/(x^n - 1)"
      ],
      "keywords": [
        "巡回符号",
        "生成多項式",
        "剰余環",
        "イデアル"
      ],
      "domain_tags": [
        "communications",
        "coding_theory"
      ]
    },
    {
      "id": "eng.ecc.n08_crc_error_detection",
      "short_code": "ECC08",
      "kind": "theorem_formula",
      "title": "CRC（巡回冗長検査）の組織符号化と誤り検出原理",
      "summary": "多項式除算の剰余r(x)=x^{n-k}u(x) mod g(x)を付加する組織的巡回符号化により、受信多項式のg(x)による剰余が誤り多項式のみに依存しバースト誤り等を検出できることを導出する。",
      "canonical_latex": "r(x) = x^{n-k} u(x) \\bmod g(x),\\quad c(x) = x^{n-k} u(x) + r(x),\\quad y(x) \\bmod g(x) = e(x) \\bmod g(x)",
      "aliases_latex": [
        "c(x) \\equiv 0 \\pmod{g(x)}"
      ],
      "keywords": [
        "CRC",
        "巡回冗長検査",
        "多項式除算",
        "バースト誤り検出"
      ],
      "domain_tags": [
        "communications",
        "coding_theory"
      ]
    },
    {
      "id": "eng.ecc.n09_convolutional_code_trellis",
      "short_code": "ECC09",
      "kind": "definition",
      "title": "畳み込み符号の多項式生成行列と状態遷移（トレリス）表現",
      "summary": "拘束長Mのシフトレジスタによる入力系列の畳み込み演算を遅延演算子Dの多項式積で記述し、有限状態機械と時間展開されたトレリス線図を定義する。",
      "canonical_latex": "c^{(j)}(D) = u(D) g^{(j)}(D)\\; (j=1,\\dots,n),\\quad s_{t+1} = \\delta(s_t, u_t),\\quad \\mathbf{c}_t = \\lambda(s_t, u_t)",
      "aliases_latex": [
        "\\mathbf{c}(D) = \\mathbf{u}(D) G(D)"
      ],
      "keywords": [
        "畳み込み符号",
        "生成多項式",
        "トレリス線図",
        "状態遷移"
      ],
      "domain_tags": [
        "communications",
        "coding_theory"
      ]
    },
    {
      "id": "eng.ecc.n10_viterbi_decoding_principle",
      "short_code": "ECC10",
      "kind": "theorem_formula",
      "title": "ビタビアルゴリズム（トレリス上の動的計画法による最尤系列復号）",
      "summary": "トレリス上の各状態に至る部分パスの累積ハミング距離（パスメトリック）を最小化する生き残りパスを逐次選択することで、最尤系列復号を線形時間計算量で実行する原理を導く。",
      "canonical_latex": "M_{t+1}(s') = \\min_{s \\to s'} \\Big( M_t(s) + d_H\\big(\\mathbf{y}_t, \\lambda(s, u_t)\\big) \\Big),\\quad \\hat{\\mathbf{u}} = \\arg\\min_{\\mathbf{u}} \\sum_{t} d_H(\\mathbf{y}_t, \\mathbf{c}_t(\\mathbf{u}))",
      "aliases_latex": [
        "M_{t+1}(s') = \\min_{s} (M_t(s) + \\gamma_t(s, s'))"
      ],
      "keywords": [
        "ビタビ復号",
        "動的計画法",
        "パスメトリック",
        "最尤系列復号"
      ],
      "domain_tags": [
