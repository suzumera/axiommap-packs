    {
      "id": "eng.rock.n06_characteristic_velocity_c_star",
      "short_code": "RK06",
      "kind": "definition",
      "title": "特性排気速度 c* の定義と燃焼室性能表示",
      "summary": "ノズル膨張形状に依存せず燃焼室圧力・スロート面積・質量流量のみから決まる推進剤と燃焼室の効率指標である特性排気速度の定義。",
      "canonical_latex": "c^* := \\frac{p_c A_t}{\\dot{m}} = \\frac{\\sqrt{R_{\\mathrm{sp}} T_c}}{\\Gamma(\\gamma)}",
      "aliases_latex": [
