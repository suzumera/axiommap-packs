      ],
      "keywords": [
        "characteristic velocity",
        "c-star",
        "combustion efficiency"
      ],
      "domain_tags": [
        "aerospace_engineering"
      ]
    },
    {
      "id": "eng.rock.n07_thrust_coefficient_cf",
      "short_code": "RK07",
      "kind": "definition",
      "title": "推力係数 C_F の定義と無次元表示",
      "summary": "推力を燃焼室圧力とスロート面積の積で無次元化したノズル膨張性能の指標であり、圧力比と開口比の関数として表される推力係数。",
      "canonical_latex": "C_F := \\frac{F}{p_c A_t} = \\frac{c_{\\mathrm{eff}}}{c^*} = \\Gamma(\\gamma)\\sqrt{\\frac{2\\gamma}{\\gamma - 1}\\left[1 - \\left(\\frac{p_e}{p_c}\\right)^{\\frac{\\gamma - 1}{\\gamma}}\\right]} + \\frac{p_e - p_a}{p_c}\\varepsilon",
      "aliases_latex": [
