    {
      "id": "math.pde.pde02_canonical_pde_types",
      "short_code": "PDE02",
      "kind": "theorem_formula",
      "title": "特性曲線による2階線形PDEの標準形への変換",
      "summary": "特性方程式の解を用いた変数変換により、2階線形PDEの主部を双曲型・放物型・楕円型の標準形へ簡約する定理。",
      "canonical_latex": "\\frac{dy}{dx} = \\frac{B \\pm \\sqrt{B^2 - AC}}{A} \\implies \\begin{cases} u_{\\xi\\eta} = \\Phi_1(\\xi,\\eta,u,u_\\xi,u_\\eta) & (\\Delta > 0), \\\\ u_{\\eta\\eta} = \\Phi_2(\\xi,\\eta,u,u_\\xi,u_\\eta) & (\\Delta = 0), \\\\ u_{\\alpha\\alpha} + u_{\\beta\\beta} = \\Phi_3(\\alpha,\\beta,u,u_\\alpha,u_\\beta) & (\\Delta < 0) \\end{cases}",
      "aliases_latex": [
        "u_{\\xi\\eta} = 0,\\quad u_{\\eta\\eta} = u_\\xi,\\quad u_{\\alpha\\alpha} + u_{\\beta\\beta} = 0"
      ],
      "keywords": [
