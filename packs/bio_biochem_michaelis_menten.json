{
  "pack_meta": {
    "pack_id": "bio.biochem.michaelis_menten",
    "schema_version": "1.0.0",
    "pack_version": "0.1.0",
    "domain": "biophysics",
    "title": "酵素反応速度論：ミカエリス＝メンテン式・ラインウィーバー＝バークとヒル方程式",
    "language": "ja",
    "description": "酵素-基質複合体の擬定常状態近似からミカエリス＝メンテン式、競争阻害、協同結合のヒル方程式を導出する。"
  },
  "nodes": [
    {
      "id": "bio.enz.n01_enzyme_substrate_ode",
      "short_code": "ENZ01",
      "kind": "definition",
      "title": "酵素-基質複合体反応系と総酵素保存則の定義",
      "summary": "酵素Eと基質Sの可逆的結合による複合体ESの形成、不可逆な生成物Pへの触媒段階、および総酵素濃度の保存則を常微分方程式系として定式化する。",
      "canonical_latex": "\\frac{d[ES]}{dt} = k_1[E][S] - (k_{-1} + k_2)[ES],\\quad v = \\frac{d[P]}{dt} = k_2[ES],\\quad [E]_T = [E] + [ES]",
      "aliases_latex": [
        "E + S \\underset{k_{-1}}{\\overset{k_1}{\\rightleftharpoons}} ES \\overset{k_2}{\\rightarrow} E + P"
      ],
      "keywords": [
        "enzyme-substrate complex",
        "mass action",
        "enzyme conservation",
        "reaction rate"
      ],
      "domain_tags": [
        "biophysics",
        "biochemistry",
        "chemical_kinetics"
      ]
    },
    {
      "id": "bio.enz.n02_qssa_michaelis_menten",
      "short_code": "ENZ02",
      "kind": "theorem_formula",
      "title": "擬定常状態近似（QSSA）とミカエリス＝メンテン式",
      "summary": "酵素-基質複合体濃度の時間変化を零とみなす擬定常状態近似（d[ES]/dt ≈ 0）の下で、初期反応速度vを基質濃度[S]の双曲線関数として導出する。",
      "canonical_latex": "v = \\frac{V_{\\max}[S]}{K_M + [S]},\\quad K_M := \\frac{k_{-1} + k_2}{k_1},\\quad V_{\\max} := k_2[E]_T",
      "aliases_latex": [
        "v_0 = \\frac{k_2[E]_T[S]}{K_M + [S]}"
      ],
      "keywords": [
        "Michaelis-Menten equation",
        "quasi-steady-state approximation",
        "QSSA",
        "Michaelis constant"
      ],
      "domain_tags": [
        "biophysics",
        "biochemistry"
      ]
    },
    {
      "id": "bio.enz.n03_catalytic_efficiency",
      "short_code": "ENZ03",
      "kind": "definition",
      "title": "代謝回転数 k_cat と触媒効率（特異性定数）",
      "summary": "最大反応速度を総酵素濃度で割った代謝回転数k_catと、低基質濃度極限における2次反応速度定数に相当する触媒効率k_cat/K_Mを定義する。",
      "canonical_latex": "k_{\\mathrm{cat}} := \\frac{V_{\\max}}{[E]_T} = k_2,\\quad \\eta_{\\mathrm{cat}} := \\frac{k_{\\mathrm{cat}}}{K_M},\\quad v \\approx \\frac{k_{\\mathrm{cat}}}{K_M}[E]_T[S]\\;([S]\\ll K_M)",
      "aliases_latex": [
        "v = \\frac{k_{\\mathrm{cat}}[E]_T[S]}{K_M + [S]}"
      ],
      "keywords": [
        "turnover number",
        "catalytic efficiency",
        "specificity constant",
        "kcat"
      ],
      "domain_tags": [
        "biophysics",
        "biochemistry"
      ]
    },
    {
      "id": "bio.enz.n04_lineweaver_burk_plot",
      "short_code": "ENZ04",
      "kind": "theorem_formula",
      "title": "ラインウィーバー＝バークの二重逆数式",
      "summary": "ミカエリス＝メンテン式の両辺の逆数をとることで、1/vを1/[S]の線形関数として表現し、実験データからV_maxとK_Mを線形回帰で決定する式を得る。",
      "canonical_latex": "\\frac{1}{v} = \\frac{K_M}{V_{\\max}}\\frac{1}{[S]} + \\frac{1}{V_{\\max}}",
      "aliases_latex": [
        "\\frac{1}{v_0} = \\frac{K_M}{V_{\\max}[S]} + \\frac{1}{V_{\\max}}"
      ],
      "keywords": [
        "Lineweaver-Burk plot",
        "double reciprocal plot",
        "enzyme kinetics linearization"
      ],
      "domain_tags": [
        "biophysics",
        "biochemistry"
      ]
    },
    {
      "id": "bio.enz.n05_competitive_inhibition",
      "short_code": "ENZ05",
      "kind": "theorem_formula",
      "title": "競争阻害のミカエリス＝メンテン式",
      "summary": "阻害剤Iが基質Sと遊離酵素Eの活性部位を競合して不活性複合体EIを形成する場合、最大速度V_maxは不変で見かけのミカエリス定数がαK_Mに増大する。",
      "canonical_latex": "v = \\frac{V_{\\max}[S]}{\\alpha K_M + [S]},\\quad \\alpha := 1 + \\frac{[I]}{K_I},\\quad K_I := \\frac{[E][I]}{[EI]}",
      "aliases_latex": [
        "K_M^{\\mathrm{app}} = \\left(1 + \\frac{[I]}{K_I}\\right)K_M"
      ],
      "keywords": [
        "competitive inhibition",
        "inhibitor constant",
        "apparent Km"
      ],
      "domain_tags": [
        "biophysics",
        "biochemistry",
        "pharmacology"
      ]
    },
    {
      "id": "bio.enz.n06_cooperative_binding_system",
      "short_code": "ENZ06",
      "kind": "definition",
      "title": "多座協同結合モデル（協調的n分子結合平衡）の定義",
      "summary": "n個の結合部位を持つ高分子Eに基質Sが極めて高い協同性で一斉に結合し中間体濃度が無視できる極限における質量作用平衡と総濃度保存則を定義する。",
      "canonical_latex": "K_d = \\frac{[E][S]^n}{[ES_n]} = K_{0.5}^n,\\quad [E]_T = [E] + [ES_n]",
      "aliases_latex": [
        "E + nS \\rightleftharpoons ES_n"
      ],
      "keywords": [
        "cooperative binding",
        "allosteric enzyme",
        "Adair-Hill limit"
      ],
      "domain_tags": [
        "biophysics",
        "biochemistry"
      ]
    },
    {
      "id": "bio.enz.n07_hill_equation",
      "short_code": "ENZ07",
      "kind": "theorem_formula",
      "title": "ヒル方程式とヒルプロット（協同性指数 n_H）",
      "summary": "協同結合モデルから結合飽和度θおよび反応速度vのシグモイド型依存性を導出し、対数比による線形化（ヒルプロット）でヒル係数n_Hを評価する。",
      "canonical_latex": "\\theta = \\frac{[S]^{n_H}}{K_{0.5}^{n_H} + [S]^{n_H}},\\quad v = \\frac{V_{\\max}[S]^{n_H}}{K_{0.5}^{n_H} + [S]^{n_H}},\\quad \\ln\\frac{\\theta}{1-\\theta} = n_H\\ln[S] - n_H\\ln K_{0.5}",
      "aliases_latex": [
        "\\log_{10}\\frac{v}{V_{\\max} - v} = n_H\\log_{10}[S] - n_H\\log_{10}K_{0.5}"
      ],
      "keywords": [
        "Hill equation",
        "Hill coefficient",
        "Hill plot",
        "cooperativity",
        "sigmoidal kinetics"
      ],
      "domain_tags": [
        "biophysics",
        "biochemistry",
        "systems_biology"
      ]
    }
  ],
