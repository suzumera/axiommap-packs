    {
      "id": "eng.opamp.n07_sallen_key_lpf",
      "short_code": "OP07",
      "kind": "theorem_formula",
      "title": "2次サレン・キー型アクティブローパスフィルタの伝達関数とQ値",
      "summary": "非反転増幅段を正帰還ループに用いた2次サレン・キー型ローパスフィルタの伝達関数、固有角周波数、および品質係数Q。",
      "canonical_latex": "H(s) = \\frac{K\\omega_0^2}{s^2 + \\frac{\\omega_0}{Q}s + \\omega_0^2},\\quad \\omega_0 = \\frac{1}{\\sqrt{R_1 R_2 C_1 C_2}},\\quad Q = \\frac{\\sqrt{R_1 R_2 C_1 C_2}}{C_2(R_1+R_2) + R_1 C_1(1-K)}",
      "aliases_latex": [
        "H(s) = \\frac{K}{s^2 R_1 R_2 C_1 C_2 + s\\big(C_2(R_1+R_2) + R_1 C_1(1-K)\\big) + 1}"
      ],
      "keywords": [
        "Sallen-Key filter",
        "active low-pass filter",
        "quality factor",
        "cutoff frequency"
      ],
      "domain_tags": [
        "electrical_engineering",
        "analog_circuits",
        "signal_processing"
      ]
    },
    {
