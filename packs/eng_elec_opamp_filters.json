  "nodes": [
    {
      "id": "eng.opamp.n01_ideal_opamp_kcl_model",
      "short_code": "OP01",
      "kind": "axiom",
      "title": "理想オペアンプとキルヒホッフ電流則・インピーダンスモデル",
      "summary": "無限大の開ループ利得・無限大の入力インピーダンス・零出力インピーダンスを持つ理想オペアンプのモデルと、節点におけるキルヒホッフ電流則およびs領域インピーダンス則。",
      "canonical_latex": "V_{\\text{out}} = A_{\\text{OL}}(V_+ - V_-),\\quad A_{\\text{OL}} \\to \\infty,\\quad I_+ = I_- = 0,\\quad \\sum_{k} I_k = 0,\\quad Z_R = R,\\quad Z_C(s) = \\frac{1}{sC}",
      "aliases_latex": [
        "I_+ = I_- = 0,\\; V_{\\text{out}} = A_{\\text{OL}}(V_+ - V_-)"
      ],
      "keywords": [
        "ideal op-amp",
        "KCL",
        "open-loop gain",
        "impedance"
      ],
      "domain_tags": [
        "electrical_engineering",
        "analog_circuits"
      ],
      "intuition_oneliner": "2つの入力の電圧差を無限に増幅する「理想オペアンプ」は、入力端子に電流が一切流れ込まず（I=0）、節点での電流の和がゼロになる便利な近似モデルです。",
      "diagram_svg": "<svg viewBox=\"0 0 600 260\" xmlns=\"http://www.w3.org/2000/svg\"><polygon points=\"220,50 220,210 380,130\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"4\"/><line x1=\"100\" y1=\"90\" x2=\"220\" y2=\"90\" stroke=\"#3b82f6\" stroke-width=\"3\"/><line x1=\"100\" y1=\"170\" x2=\"220\" y2=\"170\" stroke=\"#10b981\" stroke-width=\"3\"/><line x1=\"380\" y1=\"130\" x2=\"490\" y2=\"130\" stroke=\"#f97316\" stroke-width=\"3\"/><text x=\"235\" y=\"96\" fill=\"#3b82f6\" font-size=\"20\" font-weight=\"bold\">+</text><text x=\"235\" y=\"176\" fill=\"#10b981\" font-size=\"20\" font-weight=\"bold\">-</text><text x=\"80\" y=\"95\" text-anchor=\"end\" fill=\"#3b82f6\" font-size=\"16\">V+</text><text x=\"80\" y=\"175\" text-anchor=\"end\" fill=\"#10b981\" font-size=\"16\">V-</text><text x=\"160\" y=\"78\" text-anchor=\"middle\" fill=\"currentColor\" font-size=\"14\">I+ = 0</text><text x=\"160\" y=\"158\" text-anchor=\"middle\" fill=\"currentColor\" font-size=\"14\">I- = 0</text><text x=\"500\" y=\"135\" fill=\"#f97316\" font-size=\"18\" font-weight=\"bold\">Vout</text><text x=\"300\" y=\"240\" text-anchor=\"middle\" fill=\"currentColor\" font-size=\"15\">利得 A → ∞ / 入力電流ゼロ</text></svg>"
    },
    {
