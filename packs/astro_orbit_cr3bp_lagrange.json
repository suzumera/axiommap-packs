  "nodes": [
    {
      "id": "astro.orbit.cr01_cr3bp_dimensionless_setup",
      "short_code": "CR3B3B3B3B3B01",
      "kind": "definition",
      "title": "円制限3体問題（CR3BP）の無次元化設定と質量比パラメータ μ",
      "summary": "互いに共通重心の周りを円運動する2主星 m1, m2 と微小質量体 m3 からなる円制限3体問題において、総質量・主星間距離・平均運動を 1 に規格化した無次元座標と質量比 μ を定義する。",
      "canonical_latex": "\\mu := \\frac{m_2}{m_1 + m_2} \\in \\left(0, \\frac{1}{2}\\right],\\quad m_1^* = 1 - \\mu,\\quad m_2^* = \\mu,\\quad \\mathbf{r}_1 = (-\\mu, 0, 0)^\\top,\\quad \\mathbf{r}_2 = (1 - \\mu, 0, 0)^\\top,\\quad n = G^* = 1",
      "aliases_latex": [
        "\\mu = \\frac{m_2}{m_1+m_2},\\; r_{12}=1,\\; \\omega=1"
      ],
      "keywords": [
        "CR3BP",
        "mass ratio",
        "nondimensionalization",
        "circular restricted three-body problem"
      ],
      "domain_tags": [
        "orbital_mechanics"
      ]
    },
    {
      "id": "astro.orbit.cr02_synodic_rotating_frame_eom",
      "short_code": "CR3B3B3B3B3B02",
      "kind": "theorem_formula",
      "title": "共回転（シノディック）座標系における円制限3体問題の運動方程式",
      "summary": "2主星が x 軸上に固定される角速度 ω=1 の共回転座標系において、コリオリ力・遠心力および2主星からの万有引力を含む微小質量体の無次元運動方程式を与える。",
      "canonical_latex": "\\ddot{x} - 2\\dot{y} = x - \\frac{1-\\mu}{r_1^3}(x+\\mu) - \\frac{\\mu}{r_2^3}(x-1+\\mu),\\quad \\ddot{y} + 2\\dot{x} = y - \\left(\\frac{1-\\mu}{r_1^3} + \\frac{\\mu}{r_2^3}\\right)y,\\quad \\ddot{z} = -\\left(\\frac{1-\\mu}{r_1^3} + \\frac{\\mu}{r_2^3}\\right)z",
      "aliases_latex": [
        "r_1 = \\sqrt{(x+\\mu)^2+y^2+z^2},\\; r_2 = \\sqrt{(x-1+\\mu)^2+y^2+z^2}"
      ],
      "keywords": [
        "synodic frame",
        "Coriolis force",
        "centrifugal force",
        "CR3BP EOM"
      ],
      "domain_tags": [
        "orbital_mechanics"
      ]
    },
    {
      "id": "astro.orbit.cr03_effective_potential_def",
      "short_code": "CR3B3B3B3B3B03",
      "kind": "definition",
      "title": "擬ポテンシャル（有効ポテンシャル）Ω と勾配形式の運動方程式",
      "summary": "遠心力ポテンシャルと2主星の重力ポテンシャルを統合した擬ポテンシャル Ω(x,y,z) を定義し、共回転系の運動方程式を Ω の偏導関数で簡潔に表現する。",
      "canonical_latex": "\\Omega(x,y,z) := \\frac{1}{2}(x^2 + y^2) + \\frac{1-\\mu}{r_1} + \\frac{\\mu}{r_2},\\qquad \\ddot{x} - 2\\dot{y} = \\frac{\\partial\\Omega}{\\partial x},\\quad \\ddot{y} + 2\\dot{x} = \\frac{\\partial\\Omega}{\\partial y},\\quad \\ddot{z} = \\frac{\\partial\\Omega}{\\partial z} + 0",
      "aliases_latex": [
        "U_{\\mathrm{eff}} = -\\Omega(x,y,z)"
      ],
      "keywords": [
        "pseudo-potential",
        "effective potential",
        "gradient form"
      ],
      "domain_tags": [
        "orbital_mechanics"
      ],
      "intuition_oneliner": "要するに何？: 2つの星の重力と回転による遠心力を合算した「坂道」のポテンシャルを作り、宇宙船がどのように動くかをすっきり表す式です。",
      "diagram_svg": "<svg viewBox='0 0 600 260' xmlns='http://www.w3.org/2000/svg'><path d='M 50 200 Q 300 50, 550 200' fill='none' stroke='currentColor' stroke-width='2'/><path d='M 150 125 Q 300 220, 450 125' fill='none' stroke='#3b82f6' stroke-width='2'/><circle cx='150' cy='125' r='8' fill='#f97316'/><circle cx='450' cy='125' r='8' fill='#f97316'/><circle cx='300' cy='180' r='6' fill='#10b981'/><text x='140' y='105' fill='currentColor' font-size='14'>主星1</text><text x='440' y='105' fill='currentColor' font-size='14'>主星2</text><text x='315' y='185' fill='currentColor' font-size='14'>有効ポテンシャル</text></svg>"
    },
    {
      "id": "astro.orbit.cr04_jacobi_integral_constant",
      "short_code": "CR3B3B3B3B3B04",
      "kind": "theorem_formula",
      "title": "ヤコビ積分とヤコビ定数 C_J の保存則",
      "summary": "円制限3体問題の共回転系における唯一既知の自律的保存量であるヤコビ積分（ヤコビ定数 C_J）を与える。",
      "canonical_latex": "C_J := 2\\Omega(x,y,z) - (\\dot{x}^2 + \\dot{y}^2 + \\dot{z}^2) = x^2 + y^2 + \\frac{2(1-\\mu)}{r_1} + \\frac{2\\mu}{r_2} - v^2 = \\text{const.}",
      "aliases_latex": [
        "E_J = \\frac{1}{2}v^2 - \\Omega(x,y,z) = -\\frac{C_J}{2}"
      ],
      "keywords": [
        "Jacobi integral",
        "Jacobi constant",
        "conserved quantity"
      ],
      "domain_tags": [
        "orbital_mechanics"
      ]
    },
    {
      "id": "astro.orbit.cr05_zero_velocity_surfaces",
      "short_code": "CR3B3B3B3B3B05",
      "kind": "theorem_formula",
      "title": "ゼロ速度面・ゼロ速度曲線と運動可能領域（ヒル領域）",
      "summary": "ヤコビ定数 C_J が与えられたとき、運動速度の非負条件 v^2 >= 0 から導かれる運動可能領域（ヒル領域）とその境界であるゼロ速度面（平面運動ではゼロ速度曲線）を規定する。",
      "canonical_latex": "v^2 = 2\\Omega(x,y,z) - C_J \\ge 0 \\implies \\Omega(x,y,z) \\ge \\frac{C_J}{2},\\qquad \\text{Zero-Velocity Surface: } 2\\Omega(x,y,z) = C_J",
      "aliases_latex": [
        "\\mathcal{M}(C_J) = \\{(x,y,z)\\in\\mathbb{R}^3 \\mid 2\\Omega(x,y,z) \\ge C_J\\}"
      ],
      "keywords": [
        "zero-velocity curve",
        "zero-velocity surface",
        "Hill region",
        "forbidden region"
      ],
      "domain_tags": [
        "orbital_mechanics"
      ]
    },
    {
