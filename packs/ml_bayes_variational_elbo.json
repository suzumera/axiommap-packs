  "nodes": [
    {
      "id": "ml.vi.n01_latent_generative_bayes_def",
      "short_code": "VI01",
      "kind": "definition",
      "title": "潜在変数生成モデルと変分事後近似の定義",
      "summary": "観測変数と潜在変数の同時分布から周辺尤度を定義し、積分計算が困難な真の事後分布をパラメータ化された変分分布で近似する変分ベイズ推論の枠組みを定義する。",
      "canonical_latex": "p_\\theta(\\mathbf{x}) = \\int p_\\theta(\\mathbf{x} \\mid \\mathbf{z}) p(\\mathbf{z})\\,d\\mathbf{z},\\quad p_\\theta(\\mathbf{z} \\mid \\mathbf{x}) = \\frac{p_\\theta(\\mathbf{x}, \\mathbf{z})}{p_\\theta(\\mathbf{x})} \\approx q_\\phi(\\mathbf{z} \\mid \\mathbf{x})",
      "aliases_latex": [
        "p_\\theta(\\mathbf{x}) = \\int p_\\theta(\\mathbf{x}, \\mathbf{z})\\,d\\mathbf{z}"
      ],
      "keywords": [
        "潜在変数モデル",
        "変分推論",
        "事後分布",
        "周辺尤度",
        "生成モデル"
      ],
      "domain_tags": [
        "machine_learning",
        "bayesian_inference"
      ]
    },
    {
      "id": "ml.vi.n02_elbo_recon_kl_form",
      "short_code": "VI02",
      "kind": "theorem_formula",
      "title": "変分下界（ELBO）のイェンセン導出と再構成・KL正則化分解",
      "summary": "イェンセンの不等式とKLダイバージェンスの非負性から対数周辺尤度の変分下界（ELBO）を導出し、期待対数尤度（再構成項）と事前分布へのKL正則化項の差として表現する。",
      "canonical_latex": "\\ln p_\\theta(\\mathbf{x}) \\ge \\mathcal{L}(\\theta, \\phi; \\mathbf{x}) = \\mathbb{E}_{q_\\phi(\\mathbf{z}\\mid\\mathbf{x})}\\big[\\ln p_\\theta(\\mathbf{x} \\mid \\mathbf{z})\\big] - D_{\\mathrm{KL}}\\big(q_\\phi(\\mathbf{z}\\mid\\mathbf{x}) \\,\\|\\, p(\\mathbf{z})\\big)",
      "aliases_latex": [
        "\\mathcal{L}(\\theta, \\phi; \\mathbf{x}) = \\mathbb{E}_{q_\\phi}[\\ln p_\\theta(\\mathbf{x},\\mathbf{z}) - \\ln q_\\phi(\\mathbf{z}\\mid\\mathbf{x})]"
      ],
      "keywords": [
        "ELBO",
        "変分下界",
        "イェンセンの不等式",
        "KLダイバージェンス",
        "再構成誤差"
      ],
      "domain_tags": [
        "machine_learning",
        "bayesian_inference"
      ]
    },
    {
      "id": "ml.vi.n03_em_free_energy_monotonicity",
      "short_code": "VI03",
      "kind": "theorem_formula",
      "title": "EMアルゴリズムの変分下界最大化と対数尤度の単調増加性",
      "summary": "EステップにおけるKLダイバージェンスのゼロ化とMステップにおけるELBOの最大化を組み合わせることで、EMアルゴリズムの各反復で対数周辺尤度が単調非減少であることを証明する。",
      "canonical_latex": "\\ln p(\\mathbf{X}\\mid\\boldsymbol{\\theta}^{(t+1)}) \\ge \\mathcal{L}(q^{(t+1)}, \\boldsymbol{\\theta}^{(t+1)}) \\ge \\mathcal{L}(q^{(t+1)}, \\boldsymbol{\\theta}^{(t)}) = \\ln p(\\mathbf{X}\\mid\\boldsymbol{\\theta}^{(t)})",
      "aliases_latex": [
        "\\ln p(\\mathbf{X}\\mid\\boldsymbol{\\theta}^{(t+1)}) - \\ln p(\\mathbf{X}\\mid\\boldsymbol{\\theta}^{(t)}) \\ge 0"
      ],
      "keywords": [
        "EMアルゴリズム",
        "単調増加性",
        "変分自由エネルギー",
        "Eステップ",
        "Mステップ"
      ],
      "domain_tags": [
        "machine_learning",
        "bayesian_inference"
      ]
    },
    {
      "id": "ml.vi.n04_mean_field_cavi_update",
      "short_code": "VI04",
      "kind": "theorem_formula",
      "title": "平均場変分推論（Mean-Field VI）の最適変分分布と座標上昇更新則",
      "summary": "変分分布が潜在変数の部分集合ごとに独立に因数分解されるという平均場近似のもとで、ELBOを最大化する各因子の最適分布が他変数の対数同時分布の期待値で与えられることを示す。",
      "canonical_latex": "q(\\mathbf{z}) = \\prod_{j=1}^{M} q_j(\\mathbf{z}_j) \\implies \\ln q_j^*(\\mathbf{z}_j) = \\mathbb{E}_{q_{-j}}\\big[\\ln p(\\mathbf{x}, \\mathbf{z})\\big] + \\mathrm{const.}",
      "aliases_latex": [
        "q_j^*(\\mathbf{z}_j) \\propto \\exp\\big(\\mathbb{E}_{q_{-j}}[\\ln p(\\mathbf{x}, \\mathbf{z})]\\big)"
      ],
      "keywords": [
        "平均場近似",
        "変分ベイズ",
        "CAVI",
        "座標上昇法",
        "因数分解"
      ],
      "domain_tags": [
        "machine_learning",
        "bayesian_inference"
      ]
    },
    {
      "id": "ml.vi.n05_vae_amortized_model_def",
      "short_code": "VI05",
      "kind": "definition",
      "title": "変分オートエンコーダ（VAE）の償却変分推論とガウスエンコーダ定義",
      "summary": "データ点ごとに変分パラメータを最適化する代わりに、ニューラルネットワーク（エンコーダ）で事後分布の平均と対角分散を出力する償却推論と、デコーダによる生成モデルを定義する。",
      "canonical_latex": "p(\\mathbf{z}) = \\mathcal{N}(\\mathbf{z}; \\mathbf{0}, I),\\quad q_\\phi(\\mathbf{z} \\mid \\mathbf{x}) = \\mathcal{N}\\big(\\mathbf{z}; \\boldsymbol{\\mu}_\\phi(\\mathbf{x}), \\operatorname{diag}(\\boldsymbol{\\sigma}_\\phi^2(\\mathbf{x}))\\big),\\quad p_\\theta(\\mathbf{x} \\mid \\mathbf{z}) = \\mathrm{Decoder}_\\theta(\\mathbf{z})",
      "aliases_latex": [
        "q_\\phi(\\mathbf{z}\\mid\\mathbf{x}) = \\prod_{j=1}^{d} \\mathcal{N}(z_j; \\mu_{\\phi,j}(\\mathbf{x}), \\sigma_{\\phi,j}^2(\\mathbf{x}))"
      ],
      "keywords": [
        "VAE",
        "変分オートエンコーダ",
        "償却推論",
        "エンコーダ",
        "デコーダ"
      ],
      "domain_tags": [
        "machine_learning",
        "deep_learning"
      ]
    },
    {
      "id": "ml.vi.n06_reparameterization_trick",
      "short_code": "VI06",
      "kind": "theorem_formula",
      "title": "再パラメータ化トリックによる変分パラメータ勾配のモンテカルロ推定",
      "summary": "確率変数からのサンプリングをパラメータに依存しない標準正規雑音と決定論的微分可能写像に分離することで、期待値に対する勾配演算を積分内部へ移動し低分散な誤差逆伝播を可能にする。",
      "canonical_latex": "\\mathbf{z} = g_\\phi(\\boldsymbol{\\epsilon}, \\mathbf{x}) = \\boldsymbol{\\mu}_\\phi(\\mathbf{x}) + \\boldsymbol{\\sigma}_\\phi(\\mathbf{x}) \\odot \\boldsymbol{\\epsilon}\\;(\\boldsymbol{\\epsilon} \\sim \\mathcal{N}(\\mathbf{0}, I)) \\implies \\nabla_\\phi \\mathbb{E}_{q_\\phi(\\mathbf{z}\\mid\\mathbf{x})}\\big[f(\\mathbf{z})\\big] = \\mathbb{E}_{p(\\boldsymbol{\\epsilon})}\\big[\\nabla_\\phi f(g_\\phi(\\boldsymbol{\\epsilon}, \\mathbf{x}))\\big]",
      "aliases_latex": [
        "\\nabla_\\phi \\mathbb{E}_{q_\\phi}[f(\\mathbf{z})] = \\mathbb{E}_{p(\\boldsymbol{\\epsilon})}[\\nabla_{\\mathbf{z}} f(\\mathbf{z}) \\nabla_\\phi g_\\phi(\\boldsymbol{\\epsilon},\\mathbf{x})]"
      ],
      "keywords": [
        "再パラメータ化トリック",
        "Pathwise勾配",
        "モンテカルロ推定",
        "誤差逆伝播"
      ],
      "domain_tags": [
        "machine_learning",
        "deep_learning"
      ]
    },
    {
      "id": "ml.vi.n07_gaussian_kl_closed_form",
      "short_code": "VI07",
      "kind": "theorem_formula",
      "title": "対角ガウス分布と標準正規事前分布間のKLダイバージェンス解析解",
      "summary": "エンコーダが出力する対角ガウス変分事後分布と標準正規事前分布の間のKLダイバージェンスを、微分エントロピーと2次モーメントを用いて閉じた解析式として導出する。",
      "canonical_latex": "D_{\\mathrm{KL}}\\Big(\\mathcal{N}\\big(\\boldsymbol{\\mu}, \\operatorname{diag}(\\boldsymbol{\\sigma}^2)\\big) \\,\\Big\\|\\, \\mathcal{N}(\\mathbf{0}, I_d)\\Big) = -\\frac{1}{2}\\sum_{j=1}^{d}\\Big(1 + \\ln(\\sigma_j^2) - \\mu_j^2 - \\sigma_j^2\\Big)",
      "aliases_latex": [
        "D_{\\mathrm{KL}}(q_\\phi(\\mathbf{z}\\mid\\mathbf{x}) \\| p(\\mathbf{z})) = \\frac{1}{2}\\sum_{j=1}^{d}(\\mu_j^2 + \\sigma_j^2 - 1 - \\ln\\sigma_j^2)"
      ],
      "keywords": [
        "KLダイバージェンス",
        "ガウス分布",
        "解析解",
        "微分エントロピー",
        "正則化"
      ],
      "domain_tags": [
        "machine_learning",
        "information_theory"
      ]
    },
    {
      "id": "ml.vi.n08_vae_loss_sgvb_objective",
      "short_code": "VI08",
      "kind": "theorem_formula",
      "title": "VAEの損失関数（負のELBO）と確率的勾配変分ベイズ（SGVB）推定量",
      "summary": "ELBOの符号反転に対して、再構成項に再パラメータ化トリックによるモンテカルロ推定、KL正則化項にガウス解析解を組み合わせることで、勾配降下法で同時最適化可能なVAEの損失関数を導出する。",
      "canonical_latex": "\\mathcal{L}_{\\mathrm{VAE}}(\\theta, \\phi; \\mathbf{x}) := -\\mathcal{L}(\\theta, \\phi; \\mathbf{x}) \\approx -\\frac{1}{L}\\sum_{l=1}^{L}\\ln p_\\theta\\big(\\mathbf{x} \\mid \\boldsymbol{\\mu}_\\phi(\\mathbf{x}) + \\boldsymbol{\\sigma}_\\phi(\\mathbf{x}) \\odot \\boldsymbol{\\epsilon}^{(l)}\\big) - \\frac{1}{2}\\sum_{j=1}^{d}\\Big(1 + \\ln \\sigma_{\\phi,j}^2(\\mathbf{x}) - \\mu_{\\phi,j}^2(\\mathbf{x}) - \\sigma_{\\phi,j}^2(\\mathbf{x})\\Big)",
      "aliases_latex": [
        "\\mathcal{L}_{\\mathrm{VAE}}(\\theta,\\phi;\\mathbf{x}) = -\\mathbb{E}_{p(\\boldsymbol{\\epsilon})}[\\ln p_\\theta(\\mathbf{x}\\mid g_\\phi(\\boldsymbol{\\epsilon},\\mathbf{x}))] + D_{\\mathrm{KL}}(q_\\phi(\\mathbf{z}\\mid\\mathbf{x})\\|p(\\mathbf{z}))"
      ],
      "keywords": [
        "VAE損失関数",
        "SGVB",
        "負のELBO",
        "再構成損失",
        "KL正則化"
      ],
      "domain_tags": [
        "machine_learning",
        "deep_learning"
      ]
    }
  ],
