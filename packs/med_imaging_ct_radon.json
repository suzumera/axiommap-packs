  "nodes": [
    {
      "id": "med.ct.n01_xray_attenuation_boundary",
      "short_code": "CT01",
      "kind": "math_boundary",
      "title": "X線減弱の微小法則（単色X線・散乱無視の境界）",
      "summary": "物質中を微小距離 dℓ だけ透過する単色X線の強度減少率が、局所的な線減弱係数 μ(x,y) に比例するという物理的境界条件。",
      "canonical_latex": "-\\frac{dI}{I} = \\mu(x,y)\\,d\\ell",
      "aliases_latex": [
        "dI = -\\mu(x,y) I\\,d\\ell"
      ],
      "keywords": [
        "X線減弱",
        "線減弱係数",
        "ランベルト＝ベール則",
        "CT"
      ],
      "domain_tags": [
        "medical_imaging",
        "physics",
        "optics"
      ]
    },
    {
      "id": "med.ct.n02_lambert_beer_projection",
      "short_code": "CT02",
      "kind": "theorem_formula",
      "title": "ランベルト＝ベール則と対数投影データ",
      "summary": "X線経路に沿った微小減弱則を積分して得られる透過強度と、線減弱係数の線積分として定義される対数投影データ p(θ,s) の関係式。",
      "canonical_latex": "I(\\theta,s) = I_0 \\exp\\!\\left(-\\int_{L(\\theta,s)} \\mu(x,y)\\,d\\ell\\right),\\quad p(\\theta,s) := -\\ln\\frac{I(\\theta,s)}{I_0} = \\int_{L(\\theta,s)} \\mu(x,y)\\,d\\ell",
      "aliases_latex": [
        "p(\\theta,s) = \\int_{L(\\theta,s)} \\mu(x,y)\\,d\\ell"
      ],
      "keywords": [
        "ランベルト＝ベール則",
        "投影データ",
        "線積分",
        "CT"
      ],
      "domain_tags": [
        "medical_imaging",
        "physics"
      ]
    },
    {
      "id": "med.ct.n03_radon_transform_def",
      "short_code": "CT03",
      "kind": "definition",
      "title": "2次元ラドン変換の定義",
      "summary": "平面上の関数 f(x,y) に対し、角度 θ と原点からの符号付き距離 s で指定される直線 x cosθ + y sinθ = s 上の線積分を対応づける積分変換。",
      "canonical_latex": "\\mathcal{R}\\{f\\}(\\theta,s) := \\int_{-\\infty}^{\\infty}\\int_{-\\infty}^{\\infty} f(x,y)\\,\\delta(x\\cos\\theta + y\\sin\\theta - s)\\,dx\\,dy",
      "aliases_latex": [
        "p(\\theta,s) = \\mathcal{R}\\{f\\}(\\theta,s)"
      ],
      "keywords": [
        "ラドン変換",
        "サイノグラム",
        "線積分",
        "CT"
      ],
      "domain_tags": [
        "medical_imaging",
        "applied_math"
      ]
    },
    {
      "id": "med.ct.n04_2d_fourier_transform_def",
      "short_code": "CT04",
      "kind": "definition",
      "title": "2次元フーリエ変換と逆変換の定義",
      "summary": "2次元実空間の関数 f(x,y) を空間周波数空間 (k_x, k_y) へ写像する2次元フーリエ変換とその逆変換の定義。",
      "canonical_latex": "F(k_x,k_y) := \\iint_{\\mathbb{R}^2} f(x,y) e^{-i(k_x x + k_y y)}\\,dx\\,dy,\\quad f(x,y) = \\frac{1}{(2\\pi)^2}\\iint_{\\mathbb{R}^2} F(k_x,k_y) e^{i(k_x x + k_y y)}\\,dk_x\\,dk_y",
      "aliases_latex": [
        "\\hat{f}(\\mathbf{k}) = \\mathcal{F}_{2\\mathrm{D}}[f](\\mathbf{k})"
      ],
      "keywords": [
        "2次元フーリエ変換",
        "空間周波数",
        "逆変換"
      ],
      "domain_tags": [
        "medical_imaging",
        "fourier_analysis"
      ],
      "intuition_oneliner": "要するに何？: 画像を「位置」の情報から、どのような「しま模様（周波数）」がどのくらい含まれているかの情報へ変換する仕組みです。",
      "diagram_svg": "<svg viewBox='0 0 600 260' xmlns='http://www.w3.org/2000/svg'><rect x='80' y='80' width='100' height='100' fill='none' stroke='#3b82f6' stroke-width='2'/><text x='105' y='135' fill='currentColor' font-size='14'>f(x,y)</text><path d='M 220 130 L 360 130' stroke='currentColor' stroke-width='2'/><text x='275' y='115' fill='currentColor' font-size='12'>2Dフーリエ変換</text><circle cx='460' cy='130' r='50' fill='none' stroke='#f97316' stroke-width='2'/><circle cx='460' cy='130' r='5' fill='#10b981'/><text x='435' y='135' fill='currentColor' font-size='14'>F(k)</text></svg>"
    },
    {
      "id": "med.ct.n05_fourier_slice_theorem",
      "short_code": "CT05",
      "kind": "theorem_formula",
      "title": "投影切断面定理（中央断面定理）",
      "summary": "角度 θ における投影データ（ラドン変換）の1次元フーリエ変換は、原画像の2次元フーリエ変換の原点を通る角度 θ の断面に一致するという定理。",
      "canonical_latex": "\\mathcal{F}_s[\\mathcal{R}\\{f\\}(\\theta,\\cdot)](\\omega) = F(\\omega\\cos\\theta,\\omega\\sin\\theta) = \\hat{p}(\\theta,\\omega)\\quad (\\theta \\in [0,\\pi),\\; \\omega \\in \\mathbb{R})",
      "aliases_latex": [
        "\\hat{p}(\\theta,\\omega) = F(\\omega\\cos\\theta,\\omega\\sin\\theta)"
      ],
      "keywords": [
        "投影切断面定理",
        "中央断面定理",
        "ラドン変換",
        "フーリエ変換"
      ],
      "domain_tags": [
        "medical_imaging",
        "fourier_analysis"
      ]
    },
    {
      "id": "med.ct.n06_backprojection_def",
      "short_code": "CT06",
      "kind": "definition",
      "title": "単純逆投影（Backprojection）作用素の定義",
      "summary": "各投影角度 θ の投影データ p(θ,s) を、その光線が通過したすべての点 (x,y) へ一様に塗り戻して角度方向に積分する作用素の定義。",
      "canonical_latex": "b(x,y) = \\mathcal{B}\\{p\\}(x,y) := \\int_{0}^{\\pi} p(\\theta, x\\cos\\theta + y\\sin\\theta)\\,d\\theta",
      "aliases_latex": [
        "\\mathcal{B}\\{p\\}(x,y) = \\int_{0}^{\\pi} p(\\theta, x\\cos\\theta + y\\sin\\theta)\\,d\\theta"
      ],
      "keywords": [
        "逆投影",
        "バックプロジェクション",
        "画像再構成"
      ],
      "domain_tags": [
        "medical_imaging",
        "applied_math"
      ]
    },
    {
      "id": "med.ct.n07_filtered_backprojection",
      "short_code": "CT07",
      "kind": "theorem_formula",
      "title": "フィルタ補正逆投影法（FBP）の再構成公式",
      "summary": "2次元逆フーリエ変換の極座標ヤコビアン |ω| をランプフィルタとして投影データに1次元畳み込みした上で逆投影することにより、原画像を厳密再構成する公式。",
      "canonical_latex": "f(x,y) = \\frac{1}{2\\pi}\\int_{0}^{\\pi} (p_\\theta * h_{\\mathrm{ramp}})(x\\cos\\theta + y\\sin\\theta)\\,d\\theta,\\quad \\hat{h}_{\\mathrm{ramp}}(\\omega) = |\\omega|",
      "aliases_latex": [
        "f(x,y) = \\frac{1}{2\\pi}\\mathcal{B}\\{p_\\theta * h_{\\mathrm{ramp}}\\}(x,y)"
      ],
      "keywords": [
        "FBP",
        "フィルタ補正逆投影法",
        "ランプフィルタ",
        "極座標ヤコビアン"
      ],
      "domain_tags": [
        "medical_imaging",
        "signal_processing"
      ]
    },
    {
      "id": "med.ct.n08_ram_lak_windowed_filter",
      "short_code": "CT08",
      "kind": "theorem_formula",
      "title": "帯域制限ランプフィルタ（Ram-Lakフィルタ）の空間核",
      "summary": "理想ランプフィルタ |ω| に最大周波数 ω_max の矩形窓を掛けて帯域制限した Ram-Lak フィルタの空間領域における畳み込み核の閉じた表式。",
      "canonical_latex": "\\hat{h}_{\\mathrm{RL}}(\\omega) = |\\omega|\\operatorname{rect}\\!\\left(\\frac{\\omega}{2\\omega_{\\max}}\\right) \\implies h_{\\mathrm{RL}}(s) = \\frac{\\omega_{\\max}\\sin(\\omega_{\\max} s)}{\\pi s} - \\frac{1 - \\cos(\\omega_{\\max} s)}{\\pi s^2}\\quad \\left(h_{\\mathrm{RL}}(0) = \\frac{\\omega_{\\max}^2}{2\\pi}\\right)",
      "aliases_latex": [
        "h_{\\mathrm{RL}}(s) = \\frac{1}{2\\pi}\\int_{-\\omega_{\\max}}^{\\omega_{\\max}} |\\omega|e^{i\\omega s}\\,d\\omega"
      ],
      "keywords": [
        "Ram-Lakフィルタ",
        "帯域制限",
        "畳み込み核",
        "CT再構成"
      ],
      "domain_tags": [
        "medical_imaging",
        "signal_processing"
      ]
    }
  ],
