      "canonical_latex": "y(t) = 1 - \\frac{e^{-\\zeta\\omega_n t}}{\\sqrt{1-\\zeta^2}}\\sin(\\omega_d t + \\phi)\\quad \\left(\\omega_d := \\omega_n\\sqrt{1-\\zeta^2},\\; \\cos\\phi = \\zeta,\\; \\sin\\phi = \\sqrt{1-\\zeta^2}\\right)",
      "aliases_latex": [
