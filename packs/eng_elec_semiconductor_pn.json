    {
      "id": "eng.semi.n09_minority_carrier_diffusion_eq",
      "short_code": "SEMI09",
      "kind": "theorem_formula",
      "title": "少数キャリア拡散方程式と指数減衰解",
      "summary": "準中性領域における定常少数キャリア連続方程式と、拡散長で特徴付けられる過剰キャリアの空間減衰解。",
      "canonical_latex": "D_p \\frac{d^2\\Delta p_n}{dx^2} - \\frac{\\Delta p_n}{\\tau_p} = 0,\\quad \\Delta p_n(x) = \\Delta p_n(x_n)\\exp\\!\\left(-\\frac{x - x_n}{L_p}\\right)\\quad (L_p := \\sqrt{D_p \\tau_p})",
      "aliases_latex": [
        "L_p=\\sqrt{D_p\\tau_p}"
      ],
      "keywords": [
        "minority_carrier_diffusion",
        "diffusion_length",
        "continuity_equation"
      ],
      "domain_tags": [
        "electrical_engineering"
      ]
    },
    {
