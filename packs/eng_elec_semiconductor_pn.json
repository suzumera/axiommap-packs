    {
      "id": "eng.semi.n08_law_of_the_junction",
      "short_code": "SEMI08",
      "kind": "theorem_formula",
      "title": "接合の法則（空乏層端の少数キャリア境界条件）",
      "summary": "印加電圧によるポテンシャル障壁変化が空乏層端の少数キャリア濃度を指数関数的に変調する境界条件。",
      "canonical_latex": "n_p(-x_p) = n_{p0}\\exp\\!\\left(\\frac{V_a}{V_T}\\right),\\quad p_n(x_n) = p_{n0}\\exp\\!\\left(\\frac{V_a}{V_T}\\right)",
      "aliases_latex": [
