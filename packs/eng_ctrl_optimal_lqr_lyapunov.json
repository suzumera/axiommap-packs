{
  "pack_meta": {
    "pack_id": "eng.ctrl.optimal_lqr_lyapunov",
    "schema_version": "1.0.0",
    "pack_version": "0.1.0",
    "domain": "control_engineering",
    "title": "最適制御・非線形安定性：リアプノフの安定定理・LQRとリカッチ方程式",
    "language": "ja",
    "description": "リアプノフの直接法、2次形式評価関数の変分またはベルマン最適性原理から代数リカッチ方程式(ARE)と最適レギュレータ(LQR)を導出する。"
  },
  "nodes": [
    {
      "id": "eng.lqr.n01_autonomous_system_stability",
      "short_code": "LQR01",
      "kind": "definition",
      "title": "自律非線形システムと平衡点のリアプノフ安定・漸近安定の定義",
      "summary": "時間不変の自律非線形システムにおける平衡点のリアプノフ安定（ε-δ論法）および漸近安定の定義。",
      "canonical_latex": "\\dot{\\mathbf{x}} = \\mathbf{f}(\\mathbf{x}),\\; \\mathbf{f}(\\mathbf{0})=\\mathbf{0}:\\quad \\text{Stable} \\iff \\forall \\varepsilon>0\\,\\exists \\delta>0:\\;\\|\\mathbf{x}_0\\|<\\delta \\implies \\|\\mathbf{x}(t)\\|<\\varepsilon\\;(\\forall t\\ge 0);\\quad \\text{Asymp. Stable} \\iff \\text{Stable} \\land \\lim_{t\\to\\infty}\\mathbf{x}(t)=\\mathbf{0}",
      "aliases_latex": [
        "\\dot{\\mathbf{x}} = \\mathbf{f}(\\mathbf{x}),\\quad \\|\\mathbf{x}(0)\\| < \\delta \\implies \\|\\mathbf{x}(t)\\| < \\varepsilon,\\; \\lim_{t\\to\\infty}\\|\\mathbf{x}(t)\\| = 0"
      ],
      "keywords": [
        "リアプノフ安定",
        "漸近安定",
        "平衡点",
        "自律システム",
        "非線形制御"
      ],
      "domain_tags": [
        "control_engineering"
      ]
    },
    {
      "id": "eng.lqr.n02_lyapunov_direct_method",
      "short_code": "LQR02",
      "kind": "theorem_formula",
      "title": "リアプノフの直接法（第2法）と安定・漸近安定定理",
      "summary": "正定値リアプノフ候補関数 V(x) の軌道に沿う時間微分が半負定値であれば安定、負定値であれば漸近安定であることを保証する定理。",
      "canonical_latex": "V(\\mathbf{0})=0,\\; V(\\mathbf{x})>0\\;(\\mathbf{x}\\neq\\mathbf{0}):\\quad \\dot{V}(\\mathbf{x})=\\nabla V(\\mathbf{x})\\cdot\\mathbf{f}(\\mathbf{x}) \\le 0 \\implies \\text{stable};\\qquad \\dot{V}(\\mathbf{x}) < 0\\;(\\mathbf{x}\\neq\\mathbf{0}) \\implies \\text{asymptotically stable}",
      "aliases_latex": [
        "V(\\mathbf{x}) \\succ 0,\\; \\dot{V}(\\mathbf{x}) \\preceq 0 \\implies \\text{Lyapunov stable}"
      ],
      "keywords": [
        "リアプノフの直接法",
        "リアプノフ関数",
        "正定値関数",
        "負定値",
        "安定性解析"
      ],
      "domain_tags": [
        "control_engineering"
      ]
    },
    {
      "id": "eng.lqr.n03_linear_lyapunov_equation",
      "short_code": "LQR03",
      "kind": "theorem_formula",
      "title": "線形時不変システムのリアプノフ方程式と漸近安定条件",
      "summary": "線形システム dx/dt = Ax に対して2次形式リアプノフ関数を適用して導かれる行列方程式（リアプノフ方程式）とその正定値解による安定条件。",
      "canonical_latex": "\\dot{\\mathbf{x}} = A\\mathbf{x},\\quad V(\\mathbf{x}) = \\mathbf{x}^\\top P \\mathbf{x}\\;(P = P^\\top \\succ 0),\\quad A^\\top P + P A = -Q\\;(Q \\succ 0) \\implies \\dot{V}(\\mathbf{x}) = -\\mathbf{x}^\\top Q \\mathbf{x} < 0\\;(\\mathbf{x}\\neq\\mathbf{0})",
      "aliases_latex": [
        "A^\\top P + P A + Q = 0"
      ],
      "keywords": [
        "リアプノフ方程式",
        "線形時不変システム",
        "2次形式",
        "漸近安定"
      ],
      "domain_tags": [
        "control_engineering"
      ]
    },
    {
      "id": "eng.lqr.n04_lqr_problem_formulation",
      "short_code": "LQR04",
      "kind": "definition",
      "title": "無限時間最適レギュレータ（LQR）問題の定式化",
      "summary": "線形時不変システムに対して状態と入力の重み付き2次形式評価関数を無限時間区間で最小化する最適制御問題の定義。",
      "canonical_latex": "\\min_{\\mathbf{u}(\\cdot)} J(\\mathbf{x}_0, \\mathbf{u}) := \\int_0^\\infty \\big(\\mathbf{x}(t)^\\top Q \\mathbf{x}(t) + \\mathbf{u}(t)^\\top R \\mathbf{u}(t)\\big)\\,dt\\quad \\text{s.t. } \\dot{\\mathbf{x}} = A\\mathbf{x} + B\\mathbf{u},\\; \\mathbf{x}(0)=\\mathbf{x}_0,\\; Q \\succeq 0,\\; R \\succ 0",
      "aliases_latex": [
        "J = \\int_0^\\infty (\\mathbf{x}^\\top Q \\mathbf{x} + \\mathbf{u}^\\top R \\mathbf{u})\\,dt"
      ],
      "keywords": [
        "LQR",
        "最適レギュレータ",
        "2次形式評価関数",
        "最適制御"
      ],
      "domain_tags": [
        "control_engineering"
      ]
    },
    {
      "id": "eng.lqr.n05_hjb_equation_bellman",
      "short_code": "LQR05",
      "kind": "theorem_formula",
      "title": "ベルマンの最適性原理とハミルトン＝ヤコビ＝ベルマン（HJB）方程式",
      "summary": "最適価値関数に対する動的計画法の無限小極限から導かれる定常ハミルトン＝ヤコビ＝ベルマン方程式。",
      "canonical_latex": "V^*(\\mathbf{x}) := \\inf_{\\mathbf{u}(\\cdot)} \\int_0^\\infty \\ell(\\mathbf{x}(t), \\mathbf{u}(t))\\,dt \\implies \\min_{\\mathbf{u}} \\Big\\{\\ell(\\mathbf{x}, \\mathbf{u}) + \\nabla V^*(\\mathbf{x})^\\top \\mathbf{f}(\\mathbf{x}, \\mathbf{u})\\Big\\} = 0",
      "aliases_latex": [
        "0 = \\min_{\\mathbf{u}} \\{\\ell(\\mathbf{x}, \\mathbf{u}) + (\\partial V^* / \\partial \\mathbf{x}) \\mathbf{f}(\\mathbf{x}, \\mathbf{u})\\}"
      ],
      "keywords": [
        "HJB方程式",
        "ベルマンの最適性原理",
        "動的計画法",
        "最適価値関数"
      ],
      "domain_tags": [
        "control_engineering"
      ]
    },
    {
      "id": "eng.lqr.n06_lqr_optimal_feedback_law",
      "short_code": "LQR06",
      "kind": "theorem_formula",
      "title": "LQR最適状態フィードバック則の導出",
      "summary": "2次形式価値関数 V*(x) = x^T P x をHJB方程式に適用し、入力 u に関する最小化から得られる線形状態フィードバック制御則。",
      "canonical_latex": "\\mathbf{u}^*(\\mathbf{x}) = -R^{-1} B^\\top P \\mathbf{x} = -K\\mathbf{x}\\quad \\big(K := R^{-1} B^\\top P,\\; V^*(\\mathbf{x}) = \\mathbf{x}^\\top P \\mathbf{x}\\big)",
      "aliases_latex": [
        "\\mathbf{u}^* = -K\\mathbf{x},\\quad K = R^{-1} B^\\top P"
      ],
      "keywords": [
        "最適フィードバックゲイン",
        "状態フィードバック",
        "LQR",
        "HJB方程式"
      ],
      "domain_tags": [
        "control_engineering"
      ]
    },
    {
      "id": "eng.lqr.n07_algebraic_riccati_equation",
      "short_code": "LQR07",
      "kind": "theorem_formula",
      "title": "代数リカッチ方程式（ARE）の導出",
      "summary": "LQRの最適制御入力をHJB方程式へ代入し、任意の状態に対する2次形式恒等式として得られる代数リカッチ方程式。",
      "canonical_latex": "A^\\top P + P A - P B R^{-1} B^\\top P + Q = 0\\quad (P = P^\\top \\succeq 0)",
      "aliases_latex": [
        "A^\\top P + P A - P B R^{-1} B^\\top P + Q = 0"
      ],
      "keywords": [
        "代数リカッチ方程式",
        "ARE",
        "LQR",
        "最適制御"
      ],
      "domain_tags": [
        "control_engineering"
      ]
    },
    {
      "id": "eng.lqr.n08_lqr_closed_loop_stability",
      "short_code": "LQR08",
      "kind": "theorem_formula",
      "title": "LQR閉ループ系のリアプノフ安定性と最適コスト",
      "summary": "AREの正定値解 P による2次形式をリアプノフ関数としてLQR閉ループ系の漸近安定性と最適評価値 J* を示す定理。",
      "canonical_latex": "\\dot{\\mathbf{x}} = (A - B K)\\mathbf{x},\\; V(\\mathbf{x}) = \\mathbf{x}^\\top P \\mathbf{x}\\;(P \\succ 0) \\implies \\dot{V}(\\mathbf{x}) = -\\mathbf{x}^\\top (Q + K^\\top R K)\\mathbf{x} < 0\\;(\\mathbf{x}\\neq\\mathbf{0}),\\quad J^*(\\mathbf{x}_0) = \\mathbf{x}_0^\\top P \\mathbf{x}_0",
      "aliases_latex": [
        "(A - B K)^\\top P + P (A - B K) = -(Q + K^\\top R K)"
      ],
      "keywords": [
        "閉ループ安定性",
        "LQR",
        "リアプノフ安定",
        "最適コスト"
      ],
      "domain_tags": [
        "control_engineering"
      ]
    }
  ],
