  "nodes": [
    {
      "id": "ml.diff.n01_forward_diffusion_def",
      "short_code": "DIFF01",
      "kind": "definition",
      "title": "DDPMフォワード拡散過程（マルコフ連鎖）の定義",
      "summary": "データ分布から段階的に等方ガウス雑音を注入して標準正規分布へ近づける離散時間マルコフ連鎖の遷移核の定義。",
      "canonical_latex": "q(\\mathbf{x}_{1:T} \\mid \\mathbf{x}_0) := \\prod_{t=1}^{T} q(\\mathbf{x}_t \\mid \\mathbf{x}_{t-1}),\\qquad q(\\mathbf{x}_t \\mid \\mathbf{x}_{t-1}) := \\mathcal{N}\\big(\\mathbf{x}_t; \\sqrt{1-\\beta_t}\\,\\mathbf{x}_{t-1},\\, \\beta_t I\\big)",
      "aliases_latex": [
        "q(\\mathbf{x}_t\\mid\\mathbf{x}_{t-1}) = \\mathcal{N}(\\mathbf{x}_t; \\sqrt{\\alpha_t}\\mathbf{x}_{t-1}, (1-\\alpha_t)I)"
      ],
      "keywords": [
        "DDPM",
        "フォワード拡散過程",
        "マルコフ連鎖",
        "分散スケジュール"
      ],
      "domain_tags": [
        "machine_learning",
        "generative_models"
      ]
    },
    {
      "id": "ml.diff.n02_forward_closed_form_kernel",
      "short_code": "DIFF02",
      "kind": "theorem_formula",
      "title": "任意時刻へのフォワード遷移核の閉じた形と再パラメータ化",
      "summary": "線形ガウス遷移核の再帰的合成により、初期データから任意時刻tの潜在状態への周辺遷移分布が1つのガウス分布として閉じた形で求まる定理。",
      "canonical_latex": "\\alpha_t := 1-\\beta_t,\\quad \\bar{\\alpha}_t := \\prod_{s=1}^{t} \\alpha_s \\implies q(\\mathbf{x}_t \\mid \\mathbf{x}_0) = \\mathcal{N}\\big(\\mathbf{x}_t; \\sqrt{\\bar{\\alpha}_t}\\,\\mathbf{x}_0,\\, (1-\\bar{\\alpha}_t)I\\big),\\quad \\mathbf{x}_t = \\sqrt{\\bar{\\alpha}_t}\\,\\mathbf{x}_0 + \\sqrt{1-\\bar{\\alpha}_t}\\,\\boldsymbol{\\epsilon}",
      "aliases_latex": [
        "q(\\mathbf{x}_t\\mid\\mathbf{x}_0) = \\mathcal{N}(\\sqrt{\\bar{\\alpha}_t}\\mathbf{x}_0, (1-\\bar{\\alpha}_t)I)"
      ],
      "keywords": [
        "再パラメータ化",
        "閉じた形",
        "フォワード遷移核",
        "ガウス合成"
      ],
      "domain_tags": [
        "machine_learning",
        "generative_models"
      ]
    },
    {
      "id": "ml.diff.n03_ddpm_elbo_kl_decomposition",
      "short_code": "DIFF03",
      "kind": "theorem_formula",
      "title": "DDPMの変分下界（ELBO）とマルコフKL分解",
      "summary": "拡散モデルの負の対数尤度に対する変分上界をマルコフ性を利用して事前項・各時刻のKLダイバージェンス項・再構成項へ分解する定理。",
      "canonical_latex": "-\\ln p_\\theta(\\mathbf{x}_0) \\le \\mathbb{E}_{q}\\!\\left[D_{\\mathrm{KL}}\\big(q(\\mathbf{x}_T\\mid\\mathbf{x}_0)\\,\\|\\,p(\\mathbf{x}_T)\\big) + \\sum_{t=2}^{T} D_{\\mathrm{KL}}\\big(q(\\mathbf{x}_{t-1}\\mid\\mathbf{x}_t,\\mathbf{x}_0)\\,\\|\\,p_\\theta(\\mathbf{x}_{t-1}\\mid\\mathbf{x}_t)\\big) - \\ln p_\\theta(\\mathbf{x}_0\\mid\\mathbf{x}_1)\\right]",
      "aliases_latex": [
        "L_{\\mathrm{VLB}} = L_T + \\sum_{t=2}^{T} L_{t-1} + L_0"
      ],
      "keywords": [
        "変分下界",
        "ELBO",
        "KLダイバージェンス",
        "マルコフ分解"
      ],
      "domain_tags": [
        "machine_learning",
        "generative_models"
      ]
    },
    {
      "id": "ml.diff.n04_ddpm_noise_prediction_loss",
      "short_code": "DIFF04",
      "kind": "theorem_formula",
      "title": "真の逆事後分布とDDPMノイズ予測目的関数",
      "summary": "初期状態条件付き逆事後分布の平均を注入雑音で表し、各時刻のKL最小化を雑音予測誤差の重み付き二乗ノルム最小化へ帰着させる公式。",
      "canonical_latex": "\\tilde{\\boldsymbol{\\mu}}_t(\\mathbf{x}_t, \\boldsymbol{\\epsilon}) = \\frac{1}{\\sqrt{\\alpha_t}}\\left(\\mathbf{x}_t - \\frac{\\beta_t}{\\sqrt{1-\\bar{\\alpha}_t}}\\boldsymbol{\\epsilon}\\right),\\qquad L_{\\mathrm{simple}}(\\theta) = \\mathbb{E}_{t,\\mathbf{x}_0,\\boldsymbol{\\epsilon}}\\!\\left[\\big\\|\\boldsymbol{\\epsilon} - \\boldsymbol{\\epsilon}_\\theta(\\sqrt{\\bar{\\alpha}_t}\\,\\mathbf{x}_0 + \\sqrt{1-\\bar{\\alpha}_t}\\,\\boldsymbol{\\epsilon},\\, t)\\big\\|_2^2\\right]",
      "aliases_latex": [
        "L_{\\mathrm{simple}}(\\theta) = \\mathbb{E}[\\|\\boldsymbol{\\epsilon} - \\boldsymbol{\\epsilon}_\\theta(\\mathbf{x}_t, t)\\|_2^2]"
      ],
      "keywords": [
        "ノイズ予測",
        "逆事後分布",
        "DDPM損失",
        "スコア対応"
      ],
      "domain_tags": [
        "machine_learning",
        "generative_models"
      ]
    },
    {
      "id": "ml.diff.n05_stein_score_dsm_equivalence",
      "short_code": "DIFF05",
      "kind": "theorem_formula",
      "title": "デノイジングスコアマッチング（DSM）の等価性とノイズ予測との対応",
      "summary": "未知の周辺スコアに対する明示的スコアマッチング目的関数が、摂動核の条件付きスコアを教師とするデノイジングスコアマッチングとパラメータに関して等価である定理。",
      "canonical_latex": "J_{\\mathrm{DSM}}(\\theta) := \\frac{1}{2}\\mathbb{E}_{p(\\mathbf{x})q_\\sigma(\\tilde{\\mathbf{x}}\\mid\\mathbf{x})}\\!\\left[\\big\\|\\mathbf{s}_\\theta(\\tilde{\\mathbf{x}}) - \\nabla_{\\tilde{\\mathbf{x}}}\\ln q_\\sigma(\\tilde{\\mathbf{x}}\\mid\\mathbf{x})\\big\\|_2^2\\right] = J_{\\mathrm{ESM}}(\\theta) + C,\\qquad \\mathbf{s}_\\theta(\\mathbf{x}_t, t) = -\\frac{\\boldsymbol{\\epsilon}_\\theta(\\mathbf{x}_t, t)}{\\sqrt{1-\\bar{\\alpha}_t}}",
      "aliases_latex": [
        "\\nabla_{\\mathbf{x}_t}\\ln q(\\mathbf{x}_t\\mid\\mathbf{x}_0) = -\\frac{\\boldsymbol{\\epsilon}}{\\sqrt{1-\\bar{\\alpha}_t}}"
      ],
      "keywords": [
        "スコアマッチング",
        "デノイジングスコアマッチング",
        "スタインスコア",
        "ノイズ予測"
      ],
      "domain_tags": [
        "machine_learning",
        "generative_models"
      ]
    },
    {
      "id": "ml.diff.n06_continuous_forward_sde_def",
      "short_code": "DIFF06",
      "kind": "definition",
      "title": "連続時間フォワード拡散SDE（VP-SDE）の定義",
      "summary": "離散ステップの極限としてフォワード拡散過程を確率微分方程式（伊藤SDE）として定式化する定義。",
      "canonical_latex": "d\\mathbf{x} = \\mathbf{f}(\\mathbf{x}, t)\\,dt + g(t)\\,d\\mathbf{w},\\qquad \\text{VP-SDE: } d\\mathbf{x} = -\\frac{1}{2}\\beta(t)\\mathbf{x}\\,dt + \\sqrt{\\beta(t)}\\,d\\mathbf{w}",
      "aliases_latex": [
        "d\\mathbf{x} = -\\frac{1}{2}\\beta(t)\\mathbf{x}\\,dt + \\sqrt{\\beta(t)}\\,d\\mathbf{w}_t"
