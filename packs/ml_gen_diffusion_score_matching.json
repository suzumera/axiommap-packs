        "d\\mathbf{x} = [\\mathbf{f}(\\mathbf{x},t) - g(t)^2 \\mathbf{s}_\\theta(\\mathbf{x},t)]\\,dt + g(t)\\,d\\bar{\\mathbf{w}}"
      ],
      "keywords": [
