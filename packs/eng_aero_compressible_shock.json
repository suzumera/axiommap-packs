      ]
    },
    {
      "id": "eng.comp.n08_rankine_hugoniot_relations",
      "short_code": "CFL08",
      "kind": "theorem_formula",
      "title": "ランキン＝ユゴニオの垂直衝撃波関係式",
      "summary": "理想気体の垂直衝撃波保存則を解くことで、下流マッハ数 M2、圧力比 p2/p1、密度比 rho2/rho1 を上流マッハ数 M1 のみで表す。",
      "canonical_latex": "\\frac{p_2}{p_1} = 1 + \\frac{2\\gamma}{\\gamma + 1}(M_1^2 - 1),\\quad \\frac{\\rho_2}{\\rho_1} = \\frac{(\\gamma + 1)M_1^2}{2 + (\\gamma - 1)M_1^2},\\quad M_2^2 = \\frac{1 + \\frac{\\gamma - 1}{2}M_1^2}{\\gamma M_1^2 - \\frac{\\gamma - 1}{2}}",
      "aliases_latex": [
        "\\frac{T_2}{T_1} = \\frac{p_2}{p_1}\\frac{\\rho_1}{\\rho_2}"
      ],
      "keywords": [
        "ランキン＝ユゴニオ関係式",
        "垂直衝撃波",
        "衝撃波前後比",
        "Rankine-Hugoniot"
      ],
      "domain_tags": [
        "aerospace_engineering",
        "compressible_flow"
      ]
    },
    {
