      "short_code": "CFL06",
      "kind": "theorem_formula",
      "title": "ラバールノズルの面積・マッハ数関係式とチョーク条件",
      "summary": "音速スロート断面積 A* を基準とした流路断面積比 A/A* と局所マッハ数 M の一意な関係式を与え、M=1 で断面積が最小となるチョーク条件を示す。",
      "canonical_latex": "\\left(\\frac{A}{A^*}\\right)^2 = \\frac{1}{M^2}\\left[\\frac{2}{\\gamma + 1}\\left(1 + \\frac{\\gamma - 1}{2}M^2\\right)\\right]^{\\frac{\\gamma + 1}{\\gamma - 1}}",
      "aliases_latex": [
        "\\frac{A}{A^*} = \\frac{1}{M}\\left[\\frac{2}{\\gamma + 1}\\left(1 + \\frac{\\gamma - 1}{2}M^2\\right)\\right]^{\\frac{\\gamma + 1}{2(\\gamma - 1)}}"
      ],
      "keywords": [
        "面積マッハ数関係",
        "チョーク条件",
        "音速スロート",
        "ラバールノズル",
        "area-Mach relation"
      ],
      "domain_tags": [
        "aerospace_engineering",
        "compressible_flow",
        "propulsion"
      ]
    },
    {
      "id": "eng.comp.n07_normal_shock_conservation_laws",
      "short_code": "CFL07",
      "kind": "theorem_formula",
      "title": "垂直衝撃波前後の保存則",
      "summary": "定常1次元垂直衝撃波を挟む検査体積に質量・運動量・エネルギーの保存則を適用し、衝撃波前後の状態量を結ぶ基本方程式系を得る。",
      "canonical_latex": "\\rho_1 u_1 = \\rho_2 u_2,\\quad p_1 + \\rho_1 u_1^2 = p_2 + \\rho_2 u_2^2,\\quad h_1 + \\frac{u_1^2}{2} = h_2 + \\frac{u_2^2}{2}",
      "aliases_latex": [
        "\\dot{m}'' = \\rho_1 u_1 = \\rho_2 u_2,\\; p_1 + \\rho_1 u_1^2 = p_2 + \\rho_2 u_2^2,\\; h_{01} = h_{02}"
      ],
      "keywords": [
        "垂直衝撃波",
        "保存則",
        "検査体積",
        "normal shock"
      ],
      "domain_tags": [
        "aerospace_engineering",
