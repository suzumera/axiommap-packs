    {
      "id": "eng.comp.n05_area_velocity_differential_relation",
      "short_code": "CFL05",
      "kind": "theorem_formula",
      "title": "準1次元等エントロピー流れの面積・速度微分関係式",
      "summary": "準1次元管内流の連続式と運動量式から、流路断面積変化 dA/A と流速変化 du/u の関係がマッハ数によって符号反転することを示す。",
      "canonical_latex": "\\frac{dA}{A} = (M^2 - 1)\\frac{du}{u}",
