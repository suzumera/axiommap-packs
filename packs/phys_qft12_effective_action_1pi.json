    {
      "id": "phys.qft12.n05_one_pi_vertex_functions",
      "short_code": "QFT12_05",
      "kind": "theorem_formula",
      "title": "1粒子既約（1PI）頂点関数 Γ^(n) と連結3点関数の木構造分解",
      "summary": "有効作用のn階変分として定義される1PI頂点関数 Γ^(n) を用いて、高次連結グリーン関数が完全伝播関数と1PI頂点関数の木グラフ的結合へ分解される。",
      "canonical_latex": "\\Gamma^{(n)}(x_1,\\dots,x_n) := \\left.\\frac{\\delta^n \\Gamma[\\phi_{\\mathrm{cl}}]}{\\delta \\phi_{\\mathrm{cl}}(x_1)\\cdots\\delta \\phi_{\\mathrm{cl}}(x_n)}\\right|_{\\phi_{\\mathrm{cl}}=v},\\quad \\frac{\\delta^3 W}{\\delta J_x\\delta J_y\\delta J_z} = \\int d^4x'\\,d^4y'\\,d^4z'\\,\\frac{\\delta^2 W}{\\delta J_x\\delta J_{x'}}\\frac{\\delta^2 W}{\\delta J_y\\delta J_{y'}}\\frac{\\delta^2 W}{\\delta J_z\\delta J_{z'}}\\frac{\\delta^3 \\Gamma}{\\delta \\phi_{x'}\\delta \\phi_{y'}\\delta \\phi_{z'}}",
      "aliases_latex": [
        "\\Gamma[\\phi_{\\mathrm{cl}}] = \\sum_{n=0}^{\\infty}\\frac{1}{n!}\\int d^4x_1\\cdots d^4x_n\\,\\Gamma^{(n)}(x_1,\\dots,x_n)\\prod_{k=1}^n\\big(\\phi_{\\mathrm{cl}}(x_k)-v\\big)"
      ],
      "keywords": [
        "1PI",
        "1粒子既約",
        "頂点関数",
        "木構造分解"
      ],
      "domain_tags": [
        "physics",
        "quantum_field_theory"
      ]
    },
    {
      "id": "phys.qft12.n06_dyson_equation_self_energy",
      "short_code": "QFT12_06",
      "kind": "theorem_formula",
      "title": "自己エネルギー Σ(p^2) とダイソン方程式（完全伝播関数）",
      "summary": "1PI 2点関数への量子補正（自己エネルギー -iΣ(p^2)）の幾何級数和をダイソン方程式により畳み込むことで、厳密な完全伝播関数とその極（物理的質量）が得られる。",
      "canonical_latex": "\\tilde{\\Gamma}^{(2)}(p) = -(p^2 + m^2 + \\Sigma(p^2)),\\qquad \\tilde{G}_c^{(2)}(p) = \\frac{-i}{p^2 + m^2 + \\Sigma(p^2) - i\\epsilon}",
      "aliases_latex": [
        "\\tilde{G}_c^{(2)}(p) = \\tilde{G}_0(p) + \\tilde{G}_0(p)\\big(-i\\Sigma(p^2)\\big)\\tilde{G}_c^{(2)}(p)"
