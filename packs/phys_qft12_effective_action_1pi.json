  "nodes": [
    {
      "id": "phys.qft12.n01_phi4_generating_functional_z",
      "short_code": "QFT12_01",
      "kind": "definition",
      "title": "φ4理論の生成汎関数 Z[J] と時間順序グリーン関数",
      "summary": "実スカラーφ4理論の作用に外場源 J(x) を結合させた経路積分生成汎関数 Z[J] と、その汎関数微分によるn点時間順序グリーン関数の定義。",
      "canonical_latex": "S[\\phi] = \\int d^4x\\left(-\\frac{1}{2}\\partial_\\mu\\phi\\partial^\\mu\\phi - \\frac{1}{2}m^2\\phi^2 - \\frac{\\lambda}{4!}\\phi^4\\right),\\quad Z[J] := \\int \\mathcal{D}\\phi\\,\\exp\\left(iS[\\phi] + i\\int d^4x\\,J(x)\\phi(x)\\right),\\quad G^{(n)}(x_1,\\dots,x_n) = \\left.\\frac{(-i)^n}{Z[0]}\\frac{\\delta^n Z[J]}{\\delta J(x_1)\\cdots\\delta J(x_n)}\\right|_{J=0}",
      "aliases_latex": [
        "Z[J] = \\langle \\Omega | T\\exp\\left(i\\int d^4x\\,J(x)\\hat{\\phi}(x)\\right) | \\Omega \\rangle"
      ],
      "keywords": [
        "φ4理論",
        "生成汎関数",
        "経路積分",
        "時間順序グリーン関数",
        "外場源"
      ],
      "domain_tags": [
        "physics",
        "quantum_field_theory"
      ]
    },
    {
      "id": "phys.qft12.n02_connected_generating_functional_w",
      "short_code": "QFT12_02",
      "kind": "theorem_formula",
      "title": "連結グリーン関数の生成汎関数 W[J] と連結相関関数",
      "summary": "Z[J] の対数として定義される連結生成汎関数 W[J] = -i ln Z[J] は、非連結グラフ（真空泡や積分解）を除いた連結n点グリーン関数のみを生成する。",
      "canonical_latex": "W[J] := -i\\ln Z[J]\\;\\big(Z[J] = e^{iW[J]}\\big),\\qquad G_c^{(n)}(x_1,\\dots,x_n) = (-i)^{n-1}\\left.\\frac{\\delta^n W[J]}{\\delta J(x_1)\\cdots\\delta J(x_n)}\\right|_{J=0},\\qquad G^{(2)}(x,y) = G_c^{(2)}(x,y) + G_c^{(1)}(x)G_c^{(1)}(y)",
      "aliases_latex": [
        "Z[J] = \\exp(iW[J])"
      ],
      "keywords": [
        "連結グリーン関数",
        "生成汎関数",
        "キュムラント展開",
        "非連結グラフ"
      ],
      "domain_tags": [
        "physics",
        "quantum_field_theory"
      ]
    },
    {
      "id": "phys.qft12.n03_classical_field_legendre_effective_action",
      "short_code": "QFT12_03",
      "kind": "definition",
      "title": "古典場 φ_cl とルジャンドル変換による有効作用 Γ[φ_cl]",
      "summary": "外場 J 存在下での場の真空期待値（古典場）φ_cl を変数とし、連結生成汎関数 W[J] にルジャンドル変換を施して定義される量子有効作用 Γ[φ_cl]。",
      "canonical_latex": "\\phi_{\\mathrm{cl}}(x) := \\frac{\\delta W[J]}{\\delta J(x)} = \\langle\\Omega|\\hat{\\phi}(x)|\\Omega\\rangle_J,\\qquad \\Gamma[\\phi_{\\mathrm{cl}}] := W[J] - \\int d^4x\\,J(x)\\phi_{\\mathrm{cl}}(x)",
      "aliases_latex": [
        "\\Gamma[\\phi] = W[J_\\phi] - \\int d^4x\\,J_\\phi(x)\\phi(x)"
      ],
      "keywords": [
        "有効作用",
        "ルジャンドル変換",
        "古典場",
        "量子期待値"
      ],
      "domain_tags": [
        "physics",
        "quantum_field_theory"
      ]
    },
    {
      "id": "phys.qft12.n04_quantum_eom_inverse_propagator_identity",
      "short_code": "QFT12_04",
      "kind": "theorem_formula",
      "title": "量子運動方程式と2点関数の逆関係（有効作用の2階変分）",
      "summary": "有効作用 Γ[φ_cl] の1階変分は外場 -J(x) に等しく（J=0 で量子運動方程式を与える）、2階変分 δ^2Γ/δφ_cl^2 は連結2点関数 δ^2W/δJ^2 の逆演算子となる。",
      "canonical_latex": "\\frac{\\delta \\Gamma[\\phi_{\\mathrm{cl}}]}{\\delta \\phi_{\\mathrm{cl}}(x)} = -J(x),\\qquad \\int d^4z\\,\\frac{\\delta^2 \\Gamma}{\\delta \\phi_{\\mathrm{cl}}(x)\\delta \\phi_{\\mathrm{cl}}(z)}\\frac{\\delta^2 W}{\\delta J(z)\\delta J(y)} = -\\delta^{(4)}(x-y)",
      "aliases_latex": [
        "\\left.\\frac{\\delta \\Gamma[\\phi_{\\mathrm{cl}}]}{\\delta \\phi_{\\mathrm{cl}}(x)}\\right|_{J=0} = 0"
      ],
      "keywords": [
