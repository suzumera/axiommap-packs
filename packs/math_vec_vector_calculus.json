  "nodes": [
    {
      "id": "math.vec.vc01_divergence_def",
      "short_code": "VC01",
      "kind": "definition",
      "title": "ベクトル場の発散（div）の定義",
      "summary": "3次元ベクトル場の各成分を対応する座標変数で偏微分して足し合わせたスカラー場を、ベクトル場の発散（ダイバージェンス）として定義する。",
      "canonical_latex": "\\nabla \\cdot \\mathbf{F}(\\mathbf{r}) = \\operatorname{div}\\mathbf{F}(\\mathbf{r}) := \\sum_{i=1}^{3} \\frac{\\partial F_i}{\\partial x_i} = \\frac{\\partial F_x}{\\partial x} + \\frac{\\partial F_y}{\\partial y} + \\frac{\\partial F_z}{\\partial z}",
      "aliases_latex": [
        "\\operatorname{div}\\mathbf{F} = \\partial_x F_x + \\partial_y F_y + \\partial_z F_z",
        "\\nabla\\cdot\\mathbf{F} = \\partial_i F_i"
      ],
      "keywords": [
        "発散",
        "divergence",
        "div",
        "ベクトル解析",
        "偏微分"
      ],
      "domain_tags": [
        "mathematics",
        "vector_calculus"
      ]
    },
    {
      "id": "math.vec.vc02_curl_def",
      "short_code": "VC02",
      "kind": "definition",
      "title": "ベクトル場の回転（rot / curl）の定義",
      "summary": "エディントンのイプシロンおよび偏微分作用素を用いて、3次元ベクトル場の局所的な渦度・回転を表すベクトル場（ローテーション／カール）を定義する。",
      "canonical_latex": "(\\nabla \\times \\mathbf{F})_i = (\\operatorname{rot}\\mathbf{F})_i := \\sum_{j,k=1}^{3} \\varepsilon_{ijk} \\frac{\\partial F_k}{\\partial x_j},\\quad \\nabla \\times \\mathbf{F} = \\left(\\frac{\\partial F_z}{\\partial y} - \\frac{\\partial F_y}{\\partial z},\\; \\frac{\\partial F_x}{\\partial z} - \\frac{\\partial F_z}{\\partial x},\\; \\frac{\\partial F_y}{\\partial x} - \\frac{\\partial F_x}{\\partial y}\\right)^\\top",
      "aliases_latex": [
        "\\operatorname{curl}\\mathbf{F} = \\nabla \\times \\mathbf{F}",
        "(\\operatorname{rot}\\mathbf{F})_i = \\varepsilon_{ijk}\\partial_j F_k"
      ],
      "keywords": [
        "回転",
        "rot",
        "curl",
        "エディントンのイプシロン",
        "ベクトル解析"
      ],
      "domain_tags": [
        "mathematics",
        "vector_calculus"
      ]
    },
    {
      "id": "math.vec.vc03_surface_integral_def",
      "short_code": "VC03",
      "kind": "definition",
      "title": "向き付けられた曲面上のベクトル場の面積分（流束積分）の定義",
      "summary": "パラメータ表示された滑らかな向き付け可能曲面に対して、法線ベクトル成分を通過する流束としてのベクトル場の面積分を定義する。",
      "canonical_latex": "\\iint_{S} \\mathbf{F} \\cdot d\\mathbf{S} := \\iint_{D} \\mathbf{F}(\\mathbf{r}(u,v)) \\cdot \\left(\\frac{\\partial \\mathbf{r}}{\\partial u} \\times \\frac{\\partial \\mathbf{r}}{\\partial v}\\right) du\\,dv = \\iint_{S} (\\mathbf{F} \\cdot \\mathbf{n})\\,dS",
      "aliases_latex": [
        "\\Phi = \\iint_S \\mathbf{F}\\cdot\\mathbf{n}\\,dS",
        "\\int_S \\mathbf{F}\\cdot d\\mathbf{S}"
      ],
      "keywords": [
        "面積分",
        "流束",
        "法線ベクトル",
        "曲面",
        "surface integral"
      ],
      "domain_tags": [
        "mathematics",
        "vector_calculus"
      ]
    },
    {
      "id": "math.vec.vc04_greens_theorem",
      "short_code": "VC04",
      "kind": "theorem_formula",
      "title": "グリーンの定理（平面の周回積分と重積分の関係）",
      "summary": "平面上の区分的に滑らかな単一閉曲線で囲まれた領域において、境界に沿う線積分と領域内部の2重積分を結びつける定理。",
      "canonical_latex": "\\oint_{\\partial D} (P\\,dx + Q\\,dy) = \\iint_{D} \\left(\\frac{\\partial Q}{\\partial x} - \\frac{\\partial P}{\\partial y}\\right) dx\\,dy",
      "aliases_latex": [
        "\\oint_{\\partial D} \\mathbf{F}\\cdot d\\mathbf{r} = \\iint_D (\\partial_x Q - \\partial_y P)\\,dx\\,dy"
      ],
      "keywords": [
        "グリーンの定理",
        "線積分",
        "重積分",
        "周回積分",
        "Green's theorem"
      ],
      "domain_tags": [
        "mathematics",
        "vector_calculus"
      ]
    },
    {
      "id": "math.vec.vc05_gauss_divergence_theorem",
      "short_code": "VC05",
      "kind": "theorem_formula",
      "title": "ガウスの発散定理",
      "summary": "3次元有界領域内部でのベクトル場の発散の体積積分が、その閉境界曲面を通過する外向き法線成分の面積分（全流束）に等しいことを主張する定理。",
      "canonical_latex": "\\iiint_{V} (\\nabla \\cdot \\mathbf{F})\\,dV = \\iint_{\\partial V} (\\mathbf{F} \\cdot \\mathbf{n})\\,dS",
      "aliases_latex": [
        "\\int_V \\operatorname{div}\\mathbf{F}\\,dV = \\oint_{\\partial V} \\mathbf{F}\\cdot d\\mathbf{S}"
      ],
      "keywords": [
        "ガウスの発散定理",
        "発散定理",
        "流束",
        "体積積分",
        "面積分"
      ],
      "domain_tags": [
        "mathematics",
        "vector_calculus"
      ]
    },
    {
      "id": "math.vec.vc06_stokes_theorem",
      "short_code": "VC06",
      "kind": "theorem_formula",
      "title": "ストークスの回転定理",
      "summary": "向き付けられた曲面上のベクトル場の回転の面積分が、その曲面の境界閉曲線に沿ったベクトル場の周回線積分に等しいことを主張する定理。",
      "canonical_latex": "\\oint_{\\partial S} \\mathbf{F} \\cdot d\\mathbf{r} = \\iint_{S} (\\nabla \\times \\mathbf{F}) \\cdot \\mathbf{n}\\,dS",
      "aliases_latex": [
        "\\oint_{\\partial S} \\mathbf{F}\\cdot d\\mathbf{r} = \\iint_S (\\operatorname{rot}\\mathbf{F})\\cdot d\\mathbf{S}"
      ],
      "keywords": [
