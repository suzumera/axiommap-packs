    {
      "id": "math.vec.vc07_curl_grad_zero",
      "short_code": "VC07",
      "kind": "theorem_formula",
      "title": "勾配の回転が恒等的に零となる恒等式",
      "summary": "C2級スカラー場の勾配ベクトルの回転は、混合偏微分の対称性と反対称テンソルの縮約により恒等的に零ベクトルとなる。",
      "canonical_latex": "f \\in C^2(U) \\implies \\nabla \\times (\\nabla f) = \\mathbf{0}",
      "aliases_latex": [
        "\\operatorname{rot}(\\operatorname{grad} f) = \\mathbf{0}"
      ],
      "keywords": [
        "回転",
        "勾配",
        "保存場",
        "ベクトル解析恒等式",
        "渦なし場"
      ],
      "domain_tags": [
        "mathematics",
        "vector_calculus"
      ]
    },
    {
      "id": "math.vec.vc08_div_curl_zero",
