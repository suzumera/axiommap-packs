    {
      "id": "math.vec.vc09_vector_laplacian_identity",
      "short_code": "VC09",
      "kind": "theorem_formula",
      "title": "回転の回転恒等式とベクトルラプラシアン",
      "summary": "C2級ベクトル場の二重回転を、発散の勾配と成分ごとのラプラシアン（ベクトルラプラシアン）の差として表す基本恒等式。",
      "canonical_latex": "\\nabla \\times (\\nabla \\times \\mathbf{F}) = \\nabla(\\nabla \\cdot \\mathbf{F}) - \\nabla^2 \\mathbf{F},\\quad (\\nabla^2 \\mathbf{F})_i := \\sum_{j=1}^{3} \\frac{\\partial^2 F_i}{\\partial x_j^2}",
