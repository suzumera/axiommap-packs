    {
      "id": "math.vec.vc10_div_curl_product_rules",
      "short_code": "VC10",
      "kind": "theorem_formula",
      "title": "スカラー場とベクトル場の積の発散・回転のライプニッツ則",
      "summary": "スカラー場とベクトル場の積に対する発散および回転の展開公式を積の微分法から与える。",
