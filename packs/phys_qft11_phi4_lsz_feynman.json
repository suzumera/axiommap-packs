        "quantum_field_theory"
      ]
    },
    {
      "id": "phys.qft11.n06_perturbative_expansion_connected_w",
      "short_code": "QFT11_06",
      "kind": "theorem_formula",
      "title": "摂動生成汎関数と真空泡除去・連結生成汎関数 W[J]",
      "summary": "相互作用理論の生成汎関数 Z[J] を自由生成汎関数 Z0[J] への微分演算子の作用で表し、Z[0] による規格化で真空泡ダイアグラムが相殺され連結相関関数の生成汎関数 W[J] が得られること。",
      "canonical_latex": "Z[J] = \\exp\\!\\left(-i\\int d^4x\\,\\frac{\\lambda}{4!}\\left(-i\\frac{\\delta}{\\delta J(x)}\\right)^4\\right)Z_0[J],\\qquad W[J] := -i\\ln Z[J],\\qquad \\frac{Z[J]}{Z[0]} = \\exp\\big(iW_{\\mathrm{conn}}[J]\\big)",
      "aliases_latex": [
        "Z[J]/Z[0] = \\exp(\\sum \\text{connected diagrams})"
      ],
      "keywords": [
        "摂動展開",
