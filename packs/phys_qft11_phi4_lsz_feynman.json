    {
      "id": "phys.qft11.n02_asymptotic_fields_wavefunction_renorm",
      "short_code": "QFT11_02",
      "kind": "definition",
      "title": "漸近場と波動関数くりこみ定数 Z",
      "summary": "相互作用する量子場が遠過去・遠未来において自由な漸近場へ弱収束する条件と、1粒子状態との重なりを特徴づける波動関数くりこみ定数 Z の定義。",
      "canonical_latex": "\\langle\\Omega|\\phi(x)|\\Omega\\rangle = 0,\\quad \\langle\\Omega|\\phi(x)|p\\rangle = \\sqrt{Z}\\,e^{ip\\cdot x},\\quad \\phi(x) \\xrightarrow{t\\to\\mp\\infty} \\sqrt{Z}\\,\\phi_{\\mathrm{in/out}}(x)",
      "aliases_latex": [
        "\\phi_{\\mathrm{ren}}(x) = Z^{-1/2}\\phi(x)"
      ],
      "keywords": [
        "漸近場",
        "波動関数くりこみ定数",
        "1粒子状態",
        "LSZ仮定"
      ],
      "domain_tags": [
        "physics",
        "quantum_field_theory"
      ]
    },
    {
      "id": "phys.qft11.n03_lsz_reduction_formula",
      "short_code": "QFT11_03",
      "kind": "theorem_formula",
      "title": "LSZ簡約公式（S行列要素と時間順序相関関数の関係）",
      "summary": "漸近状態間のS行列要素を、時間順序積の真空期待値（n点グリーン関数）にクライン＝ゴルドン演算子を作用させた極限として表すレーマン＝シマンツィク＝ツィンマーマン（LSZ）の簡約公式。",
      "canonical_latex": "\\langle p_1',\\dots,p_m';\\mathrm{out}|p_1,\\dots,p_n;\\mathrm{in}\\rangle_{\\mathrm{conn}} = \\left(\\frac{i}{\\sqrt{Z}}\\right)^{n+m}\\prod_{j=1}^{m}\\int d^4y_j\\,e^{-ip_j'\\cdot y_j}(-\\Box_{y_j}+m^2)\\prod_{i=1}^{n}\\int d^4x_i\\,e^{ip_i\\cdot x_i}(-\\Box_{x_i}+m^2)\\,\\langle\\Omega|T\\{\\phi(y_1)\\cdots\\phi(x_n)\\}|\\Omega\\rangle",
      "aliases_latex": [
        "S_{fi} = (iZ^{-1/2})^{n+m}\\int \\prod e^{\\mp ip\\cdot x}(-\\Box+m^2)\\langle\\Omega|T\\{\\phi\\cdots\\phi\\}|\\Omega\\rangle"
      ],
      "keywords": [
        "LSZ簡約公式",
        "S行列",
        "グリーン関数",
        "外線切断"
      ],
      "domain_tags": [
        "physics",
        "quantum_field_theory"
      ]
    },
    {
      "id": "phys.qft11.n04_generating_functional_green_functions",
      "short_code": "QFT11_04",
      "kind": "definition",
      "title": "生成汎関数 Z[J] と時間順序 n 点相関関数",
      "summary": "外場 J(x) を導入した生成汎関数 Z[J] の定義と、その汎関数微分によって時間順序 n 点相関関数（グリーン関数）を生成する関係式。",
      "canonical_latex": "Z[J] := \\langle\\Omega|T\\exp\\!\\left(i\\int d^4x\\,J(x)\\phi(x)\\right)|\\Omega\\rangle,\\qquad G^{(n)}(x_1,\\dots,x_n) = \\left.\\frac{(-i)^n}{Z[0]}\\frac{\\delta^n Z[J]}{\\delta J(x_1)\\cdots\\delta J(x_n)}\\right|_{J=0}",
      "aliases_latex": [
        "\\langle\\Omega|T\\{\\phi(x_1)\\cdots\\phi(x_n)\\}|\\Omega\\rangle = (-i)^n Z[0]^{-1}\\delta^n Z[J]/\\delta J(x_1)\\cdots\\delta J(x_n)|_{J=0}"
      ],
      "keywords": [
        "生成汎関数",
        "汎関数微分",
        "グリーン関数",
        "外場"
      ],
      "domain_tags": [
        "physics",
        "quantum_field_theory"
      ]
    },
    {
      "id": "phys.qft11.n05_wick_theorem_free_generating_functional",
      "short_code": "QFT11_05",
      "kind": "theorem_formula",
      "title": "自由場の生成汎関数 Z0[J] とウィックの定理",
      "summary": "自由スカラー場の生成汎関数がファインマン伝播関数の2次指数形式で与えられること、および時間順序積を正規積とすべての対縮約の和に展開するウィックの定理。",
      "canonical_latex": "Z_0[J] = \\exp\\!\\left(\\frac{i}{2}\\int d^4x\\,d^4y\\,J(x)\\Delta_F(x-y)J(y)\\right),\\qquad T\\{\\phi_I(x_1)\\cdots\\phi_I(x_n)\\} = :\\phi_I(x_1)\\cdots\\phi_I(x_n): + \\sum_{\\text{all contractions}} :\\text{contracted pairs}:",
      "aliases_latex": [
        "\\langle 0|T\\{\\phi_I(x_1)\\cdots\\phi_I(x_{2k})\\}|0\\rangle = \\sum_{\\text{pairings}}\\prod (-i\\Delta_F(x_i-x_j))"
      ],
      "keywords": [
        "ウィックの定理",
        "自由生成汎関数",
        "ファインマン伝播関数",
        "縮約"
      ],
      "domain_tags": [
