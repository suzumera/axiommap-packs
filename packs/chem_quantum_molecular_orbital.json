        "physical_chemistry"
      ]
    },
    {
      "id": "chem.qchem.n02_huckel_secular_eq",
      "short_code": "HMO02",
      "kind": "theorem_formula",
      "title": "ヒュッケル永年方程式と無次元エネルギー変数",
      "summary": "レイリー＝リッツの永年方程式にヒュッケル近似を代入し、無次元パラメータ x = (α - E)/β を導入することで得られる、分子グラフの隣接行列 A に基づく固有値方程式。",
      "canonical_latex": "\\det(x\\mathbf{I} + \\mathbf{A}) = 0,\\qquad x := \\frac{\\alpha - E}{\\beta},\\qquad E = \\alpha - \\beta x",
      "aliases_latex": [
        "\\det(\\mathbf{H} - E\\mathbf{I}) = 0",
        "\\mathbf{A}\\mathbf{c}_i = -x_i \\mathbf{c}_i"
      ],
      "keywords": [
        "永年方程式",
        "隣接行列",
        "固有値問題",
        "ヒュッケル行列式"
