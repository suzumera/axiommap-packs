      "canonical_latex": "\\psi_i^{\\pi} = \\sum_{\\mu=1}^{N} c_{\\mu i} \\phi_{\\mu},\\quad H_{\\mu\\mu} = \\alpha,\\quad H_{\\mu\\nu} = \\begin{cases} \\beta & (\\mu,\\nu\\text{ adjacent}) \\\\ 0 & (\\text{otherwise}) \\end{cases},\\quad S_{\\mu\\nu} = \\delta_{\\mu\\nu}",
      "aliases_latex": [
        "\\mathbf{H} = \\alpha\\mathbf{I} + \\beta\\mathbf{A},\\quad \\mathbf{S} = \\mathbf{I}"
      ],
      "keywords": [
        "ヒュッケル法",
        "π電子近似",
        "クーロン積分",
        "共鳴積分",
        "LCAO-MO"
      ],
