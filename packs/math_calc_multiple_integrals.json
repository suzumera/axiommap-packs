  "nodes": [
    {
      "id": "math.calc.mi01_multiple_integral_def",
      "short_code": "MI01",
      "kind": "definition",
      "title": "重積分（リーマン和の極限）の定義",
      "summary": "有界閉領域上の多変数関数に対して、領域の微小な格子分割に対するリーマン和の分割幅極限として重積分を定義する。",
      "canonical_latex": "\\iint_{D} f(x,y)\\,dx\\,dy := \\lim_{\\|\\Delta\\|\\to 0} \\sum_{k=1}^{N} f(\\xi_k, \\eta_k)\\,\\Delta A_k,\\quad \\iiint_{V} f(\\mathbf{x})\\,dV := \\lim_{\\|\\Delta\\|\\to 0} \\sum_{k=1}^{N} f(\\boldsymbol{\\xi}_k)\\,\\Delta V_k",
      "aliases_latex": [
        "\\int_{D} f(\\mathbf{x})\\,d\\mathbf{x} := \\lim_{\\|\\Delta\\|\\to 0} \\sum_{k} f(\\boldsymbol{\\xi}_k)\\,\\mu(D_k)"
      ],
      "keywords": [
        "重積分",
        "2重積分",
        "3重積分",
        "リーマン和",
        "領域分割"
      ],
      "domain_tags": [
        "mathematics",
        "calculus",
        "multivariable"
      ]
    },
    {
      "id": "math.calc.mi02_fubini_theorem",
      "short_code": "MI02",
      "kind": "theorem_formula",
      "title": "フビニの定理（重積分の累次積分への帰着）",
      "summary": "連続関数に対する有界領域上の重積分は、積分順序を交換可能な1変数定積分の反復（累次積分）として計算できる。",
      "canonical_latex": "\\iint_{[a,b]\\times[c,d]} f(x,y)\\,dx\\,dy = \\int_{a}^{b}\\left(\\int_{c}^{d} f(x,y)\\,dy\\right)dx = \\int_{c}^{d}\\left(\\int_{a}^{b} f(x,y)\\,dx\\right)dy",
      "aliases_latex": [
        "\\iint_{D} f(x,y)\\,dx\\,dy = \\int_{a}^{b}\\left(\\int_{\\phi_1(x)}^{\\phi_2(x)} f(x,y)\\,dy\\right)dx"
      ],
      "keywords": [
        "フビニの定理",
        "累次積分",
        "積分順序の交換",
        "縦線集合",
        "横線集合"
      ],
      "domain_tags": [
        "mathematics",
        "calculus",
        "multivariable"
      ]
    },
    {
      "id": "math.calc.mi03_jacobian_matrix_determinant",
      "short_code": "MI03",
      "kind": "definition",
      "title": "ヤコビ行列とヤコビアン（ヤコビ行列式）の定義",
      "summary": "C1級座標変換の全微分を表す1階偏導関数の行列をヤコビ行列、その行列式をヤコビアンと定義する。",
      "canonical_latex": "J_{\\mathbf{\\Phi}}(\\mathbf{u}) := \\left(\\frac{\\partial x_i}{\\partial u_j}(\\mathbf{u})\\right)_{1\\le i,j\\le n},\\quad \\frac{\\partial(x_1,\\dots,x_n)}{\\partial(u_1,\\dots,u_n)} := \\det J_{\\mathbf{\\Phi}}(\\mathbf{u})",
      "aliases_latex": [
        "\\det(D\\mathbf{\\Phi}(\\mathbf{u})) = \\det\\left(\\frac{\\partial \\mathbf{x}}{\\partial \\mathbf{u}}\\right)"
      ],
      "keywords": [
        "ヤコビ行列",
        "ヤコビアン",
        "ヤコビ行列式",
        "座標変換",
        "フレシェ微分"
      ],
      "domain_tags": [
        "mathematics",
        "calculus",
        "linear_algebra"
      ]
    },
    {
      "id": "math.calc.mi04_change_of_variables_multiple_integral",
      "short_code": "MI04",
      "kind": "theorem_formula",
      "title": "重積分の変数変換公式（ヤコビアンによる体積要素変換）",
      "summary": "C1級微分同相写像による重積分の変数変換では、微小面積・体積要素の拡大率としてヤコビアンの絶対値が掛かる。",
      "canonical_latex": "\\int_{\\mathbf{\\Phi}(\\Omega)} f(\\mathbf{x})\\,d\\mathbf{x} = \\int_{\\Omega} f(\\mathbf{\\Phi}(\\mathbf{u}))\\,\\left|\\det\\frac{\\partial \\mathbf{\\Phi}}{\\partial \\mathbf{u}}(\\mathbf{u})\\right|\\,d\\mathbf{u}",
      "aliases_latex": [
        "\\iint_{D} f(x,y)\\,dx\\,dy = \\iint_{\\Omega} f(x(u,v),y(u,v))\\,\\left|\\frac{\\partial(x,y)}{\\partial(u,v)}\\right|\\,du\\,dv"
      ],
      "keywords": [
