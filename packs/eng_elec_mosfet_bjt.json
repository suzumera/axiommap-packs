      "canonical_latex": "V_{\\mathrm{TH}} = V_{\\mathrm{FB}} + 2\\phi_F + \\frac{\\sqrt{4\\varepsilon_s q N_A \\phi_F}}{C_{\\mathrm{ox}}}",
      "aliases_latex": [
