    {
      "id": "eng.fet.fet08_common_source_gain",
      "short_code": "FET08",
      "kind": "theorem_formula",
      "title": "ソース接地増幅回路の小信号電圧利得",
      "summary": "負荷抵抗を持つソース接地増幅回路における低周波小信号電圧利得の公式。",
      "canonical_latex": "A_v := \\frac{v_{\\mathrm{out}}}{v_{\\mathrm{in}}} = -g_m \\left(R_D \\parallel r_o\\right) = -\\frac{g_m R_D r_o}{R_D + r_o}",
