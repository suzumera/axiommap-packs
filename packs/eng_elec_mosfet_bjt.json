      "canonical_latex": "Q_i(x) = -C_{\\mathrm{ox}}\\big(V_{\\mathrm{GS}} - V_{\\mathrm{TH}} - V(x)\\big)\\quad (V_{\\mathrm{GS}} - V(x) \\ge V_{\\mathrm{TH}})",
