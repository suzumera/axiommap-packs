    {
      "id": "eng.fet.fet06_transconductance_gm",
      "short_code": "FET06",
      "kind": "theorem_formula",
      "title": "相互コンダクタンス g_m と出力抵抗 r_o",
      "summary": "飽和領域のドレイン電流をゲート電圧およびドレイン電圧で偏微分して得られる小信号パラメータの表現。",
      "canonical_latex": "g_m := \\left.\\frac{\\partial I_D}{\\partial V_{\\mathrm{GS}}}\\right|_{V_{\\mathrm{DS}}} = \\mu_n C_{\\mathrm{ox}}\\frac{W}{L}\\left(V_{\\mathrm{GS}} - V_{\\mathrm{TH}}\\right) = \\sqrt{2\\mu_n C_{\\mathrm{ox}}\\frac{W}{L}I_D},\\quad r_o^{-1} := \\left.\\frac{\\partial I_D}{\\partial V_{\\mathrm{DS}}}\\right|_{V_{\\mathrm{GS}}} \\approx \\lambda I_D",
      "aliases_latex": [
        "g_m = \\frac{2I_D}{V_{\\mathrm{GS}} - V_{\\mathrm{TH}}},\\quad r_o = \\frac{1}{\\lambda I_D}"
      ],
      "keywords": [
