  "nodes": [
    {
      "id": "eng.fet.fet01_mos_electrostatics_boundary",
      "short_code": "FET01",
      "kind": "math_boundary",
      "title": "MOS構造の静電平衡とキャリア輸送の基礎法則",
      "summary": "MOSキャパシタの酸化膜容量、空乏層電荷、およびチャネル内ドリフト電流を記述する半導体物理・電磁気学の基礎関係式。",
      "canonical_latex": "C_{\\mathrm{ox}} = \\frac{\\varepsilon_{\\mathrm{ox}}}{t_{\\mathrm{ox}}},\\quad Q_{\\mathrm{dep}} = -\\sqrt{2\\varepsilon_s q N_A \\phi_s},\\quad I_D = W \\mu_n |Q_i(x)| \\frac{dV(x)}{dx}",
