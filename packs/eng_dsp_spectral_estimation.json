  "nodes": [
    {
      "id": "eng.dsp3.n01_wss_autocorrelation_def",
      "short_code": "DSP3_01",
      "kind": "definition",
      "title": "広義定常確率過程と自己相関・相互相関関数の定義",
      "summary": "時間並進に対して平均が一定で、2次モーメントが時間差のみに依存する広義定常（WSS）確率過程と、その自己相関・相互相関関数を定義する。",
      "canonical_latex": "\\mathbb{E}[X(t)] = m_X,\\quad R_X(\\tau) := \\mathbb{E}[X(t+\\tau)\\overline{X(t)}],\\quad R_{YX}(\\tau) := \\mathbb{E}[Y(t+\\tau)\\overline{X(t)}]",
      "aliases_latex": [
        "R_{XX}(\\tau) = \\mathbb{E}[X(t+\\tau)X^*(t)]"
      ],
      "keywords": [
        "広義定常過程",
        "WSS",
        "自己相関関数",
        "相互相関関数"
      ],
      "domain_tags": [
        "signal_processing",
        "stochastic_processes"
      ]
    },
    {
      "id": "eng.dsp3.n02_autocorrelation_properties",
      "short_code": "DSP3_02",
      "kind": "theorem_formula",
      "title": "自己相関関数の基本性質（共役対称性・最大値・半正定値性）",
      "summary": "広義定常過程の自己相関関数が満たす共役対称性、原点での最大値性（コーシー＝シュワルツ不等式）、およびエルミート半正定値性を示す。",
      "canonical_latex": "R_X(-\\tau) = \\overline{R_X(\\tau)},\\quad |R_X(\\tau)| \\le R_X(0),\\quad \\sum_{j,k=1}^{n} c_j \\overline{c_k} R_X(t_j - t_k) \\ge 0",
      "aliases_latex": [
        "R_X(-\\tau) = R_X(\\tau) \\text{ (for real } X\\text{)}"
      ],
      "keywords": [
        "自己相関関数",
        "共役対称性",
        "半正定値性",
        "ボホナーの定理"
      ],
      "domain_tags": [
        "signal_processing",
        "stochastic_processes"
      ]
    },
    {
      "id": "eng.dsp3.n03_power_spectral_density_def",
      "short_code": "DSP3_03",
      "kind": "definition",
      "title": "パワースペクトル密度（PSD）の定義",
      "summary": "定常確率過程の有限時間区間切り出しフーリエ変換の期待二乗振幅を時間平均して極限をとることで、周波数ごとの平均電力密度（PSD）を定義する。",
      "canonical_latex": "S_X(\\omega) := \\lim_{T \\to \\infty} \\frac{1}{2T} \\mathbb{E}\\!\\left[\\left|\\int_{-T}^{T} X(t) e^{-i\\omega t}\\,dt\\right|^2\\right]",
      "aliases_latex": [
        "P_X(\\omega) = \\lim_{T \\to \\infty} \\frac{1}{2T}\\mathbb{E}[|\\hat{X}_T(\\omega)|^2]"
      ],
      "keywords": [
        "パワースペクトル密度",
        "PSD",
        "ピリオドグラム",
        "平均電力"
      ],
      "domain_tags": [
        "signal_processing",
        "spectral_estimation"
      ]
    },
    {
      "id": "eng.dsp3.n04_wiener_khinchin_theorem",
      "short_code": "DSP3_04",
      "kind": "theorem_formula",
      "title": "ウィーナー＝ヒンチンの定理（自己相関とPSDのフーリエ変換対）",
      "summary": "広義定常確率過程のパワースペクトル密度と自己相関関数がフーリエ変換対をなすことを示す基本定理。",
      "canonical_latex": "S_X(\\omega) = \\int_{-\\infty}^{\\infty} R_X(\\tau) e^{-i\\omega\\tau}\\,d\\tau,\\qquad R_X(\\tau) = \\frac{1}{2\\pi}\\int_{-\\infty}^{\\infty} S_X(\\omega) e^{i\\omega\\tau}\\,d\\omega",
      "aliases_latex": [
        "S_X(\\omega) = \\mathcal{F}[R_X](\\omega)"
      ],
      "keywords": [
        "ウィーナー＝ヒンチンの定理",
        "パワースペクトル密度",
        "自己相関関数",
        "フーリエ変換"
      ],
      "domain_tags": [
        "signal_processing",
        "spectral_estimation"
      ]
    },
    {
      "id": "eng.dsp3.n05_lti_psd_transmission",
      "short_code": "DSP3_05",
      "kind": "theorem_formula",
      "title": "LTIシステムにおける自己相関とPSDの入出力関係",
      "summary": "インパルス応答 h(t) と周波数応答 H(ω) を持つ線形時不変システムに広義定常過程を入力した際の出力自己相関関数および出力PSDの関係式。",
      "canonical_latex": "R_Y(\\tau) = (h * \\tilde{h} * R_X)(\\tau),\\quad S_Y(\\omega) = |H(\\omega)|^2 S_X(\\omega),\\quad S_{YX}(\\omega) = H(\\omega) S_X(\\omega),\\quad \\tilde{h}(t) := \\overline{h(-t)}",
      "aliases_latex": [
        "S_Y(\\omega) = |H(\\omega)|^2 S_X(\\omega)"
      ],
      "keywords": [
        "LTIシステム",
        "周波数応答",
        "パワースペクトル密度",
        "入出力関係"
      ],
      "domain_tags": [
        "signal_processing",
        "linear_systems"
      ]
    },
    {
      "id": "eng.dsp3.n06_matched_filter_snr",
      "short_code": "DSP3_06",
      "kind": "theorem_formula",
      "title": "マッチドフィルタ（白色雑音下の出力SNR最大化フィルタ）",
      "summary": "両側電力密度 N0/2 の加法性白色雑音下の既知信号 s(t) に対し、時刻 t0 における出力信号対雑音比（SNR）を最大化する最適線形フィルタ。",
      "canonical_latex": "\\mathrm{SNR}_{\\mathrm{out}}(t_0) = \\frac{\\left|\\frac{1}{2\\pi}\\int_{-\\infty}^{\\infty} H(\\omega) S(\\omega) e^{i\\omega t_0}\\,d\\omega\\right|^2}{\\frac{N_0}{4\\pi}\\int_{-\\infty}^{\\infty} |H(\\omega)|^2\\,d\\omega} \\le \\frac{2E_s}{N_0},\\qquad H_{\\mathrm{opt}}(\\omega) = c\\,\\overline{S(\\omega)} e^{-i\\omega t_0}",
      "aliases_latex": [
        "h_{\\mathrm{opt}}(t) = c\\,\\overline{s(t_0 - t)}"
      ],
      "keywords": [
        "マッチドフィルタ",
        "整合フィルタ",
        "SNR最大化",
        "白色雑音"
      ],
      "domain_tags": [
        "signal_processing",
        "detection_theory"
      ]
    },
    {
      "id": "eng.dsp3.n07_wiener_hopf_equation",
      "short_code": "DSP3_07",
      "kind": "theorem_formula",
      "title": "ウィーナー＝ホップ方程式（最小二乗線形推定の直交原理）",
      "summary": "観測信号 X(t) の線形フィルタリングによる目標信号 D(t) の平均二乗誤差最小化問題において、推定誤差と観測信号の直交性から導かれる積分方程式。",
      "canonical_latex": "\\hat{D}(t) = \\int_{-\\infty}^{\\infty} h(u) X(t-u)\\,du,\\quad \\min_{h} \\mathbb{E}\\!\\left[|D(t) - \\hat{D}(t)|^2\\right] \\iff \\int_{-\\infty}^{\\infty} h(u) R_X(\\tau - u)\\,du = R_{DX}(\\tau)",
      "aliases_latex": [
        "(h * R_X)(\\tau) = R_{DX}(\\tau)"
      ],
      "keywords": [
        "ウィーナー＝ホップ方程式",
        "直交原理",
        "最小二乗推定",
        "MMSE"
      ],
      "domain_tags": [
        "signal_processing",
        "estimation_theory"
      ]
    },
    {
      "id": "eng.dsp3.n08_noncausal_wiener_filter",
      "short_code": "DSP3_08",
      "kind": "theorem_formula",
      "title": "非因果的ウィーナーフィルタの周波数領域解と最小平均二乗誤差",
      "summary": "全時間領域の観測を許す非因果的ウィーナー＝ホップ方程式をフーリエ変換により代数的に解いた最適フィルタの伝達関数と、その際の最小平均二乗誤差（MMSE）。",
      "canonical_latex": "H_W(\\omega) = \\frac{S_{DX}(\\omega)}{S_X(\\omega)},\\qquad \\mathrm{MMSE} = \\frac{1}{2\\pi}\\int_{-\\infty}^{\\infty} \\left(S_D(\\omega) - \\frac{|S_{DX}(\\omega)|^2}{S_X(\\omega)}\\right)d\\omega",
      "aliases_latex": [
        "H_W(\\omega) = \\frac{S_S(\\omega)}{S_S(\\omega) + S_N(\\omega)}"
      ],
      "keywords": [
        "ウィーナーフィルタ",
        "非因果フィルタ",
        "最小平均二乗誤差",
        "MMSE"
      ],
      "domain_tags": [
        "signal_processing",
        "estimation_theory"
      ]
    }
  ],
