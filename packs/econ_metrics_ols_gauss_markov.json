    "title": "計量経済学：最小二乗推定量（OLS）・ガウス＝マルコフの定理（BLUE）と操作変数法（2SLS）",
    "language": "ja",
    "description": "行列微分からOLS正規方程式と推定量 β_hat=(X^TX)^-1 X^Ty、不偏性と最小分散性（ガウス＝マルコフの定理）、内生性バイアスと操作変数推定量を導出する。"
  },
  "nodes": [
    {
      "id": "econ.met.n01_clrm_assumptions",
      "short_code": "MET01",
      "kind": "definition",
      "title": "古典的線形回帰モデル（CLRM）とガウス＝マルコフ仮定の定義",
      "summary": "線形回帰モデルにおける説明変数行列のフルカラムランク性、誤差項の条件付き期待値ゼロ（厳密外生性）、および条件付き等分散・無相関の仮定を定式化する。",
      "canonical_latex": "\\mathbf{y} = X\\boldsymbol{\\beta} + \\boldsymbol{\\varepsilon},\\quad \\operatorname{rank}(X) = k,\\quad \\mathbb{E}[\\boldsymbol{\\varepsilon} \\mid X] = \\mathbf{0},\\quad \\operatorname{Var}(\\boldsymbol{\\varepsilon} \\mid X) = \\sigma^2 I_n\\;(\\sigma^2 > 0)",
      "aliases_latex": [
        "y_i = \\mathbf{x}_i^\\top \\boldsymbol{\\beta} + \\varepsilon_i,\\; \\mathbb{E}[\\varepsilon_i \\mid X] = 0,\\; \\mathbb{E}[\\boldsymbol{\\varepsilon}\\boldsymbol{\\varepsilon}^\\top \\mid X] = \\sigma^2 I_n"
      ],
      "keywords": [
        "古典的線形回帰モデル",
        "ガウス＝マルコフ仮定",
        "厳密外生性",
        "等分散性",
        "多重共線性の不在"
      ],
      "domain_tags": [
        "econometrics",
        "statistics",
        "linear_algebra"
      ],
      "intuition_oneliner": "回帰分析が正しく機能するために、誤差が偏りなく均一で予測を邪魔しないという理想的な前提条件です。",
      "diagram_svg": "<svg viewBox=\"0 0 600 260\" xmlns=\"http://www.w3.org/2000/svg\"><line x1=\"80\" y1=\"200\" x2=\"520\" y2=\"200\" stroke=\"currentColor\" stroke-width=\"2\"/><line x1=\"80\" y1=\"40\" x2=\"80\" y2=\"200\" stroke=\"currentColor\" stroke-width=\"2\"/><line x1=\"100\" y1=\"180\" x2=\"500\" y2=\"60\" stroke=\"#3b82f6\" stroke-width=\"3\"/><circle cx=\"150\" cy=\"150\" r=\"5\" fill=\"#f97316\"/><circle cx=\"250\" cy=\"120\" r=\"5\" fill=\"#f97316\"/><circle cx=\"350\" cy=\"90\" r=\"5\" fill=\"#f97316\"/><circle cx=\"450\" cy=\"70\" r=\"5\" fill=\"#f97316\"/><text x=\"380\" y=\"120\" fill=\"#3b82f6\" font-size=\"16\">直線モデル</text></svg>"
    },
    {
      "id": "econ.met.n02_ols_estimator_closed_form",
      "short_code": "MET02",
      "kind": "theorem_formula",
      "title": "行列微分によるOLS正規方程式と閉形式推定量",
      "summary": "残差平方和（RSS）の最小化問題に対して行列微分による1階停留点条件を適用し、正規方程式とOLS推定量の閉形式解を導出する。",
      "canonical_latex": "\\min_{\\boldsymbol{\\beta}} (\\mathbf{y} - X\\boldsymbol{\\beta})^\\top(\\mathbf{y} - X\\boldsymbol{\\beta}) \\implies X^\\top X \\hat{\\boldsymbol{\\beta}}_{\\mathrm{OLS}} = X^\\top \\mathbf{y} \\implies \\hat{\\boldsymbol{\\beta}}_{\\mathrm{OLS}} = (X^\\top X)^{-1} X^\\top \\mathbf{y}",
      "aliases_latex": [
        "\\hat{\\boldsymbol{\\beta}}_{\\mathrm{OLS}} = (X^\\top X)^{-1} X^\\top \\mathbf{y}"
      ],
      "keywords": [
        "最小二乗法",
        "OLS推定量",
        "正規方程式",
        "行列微分",
        "残差平方和"
      ],
      "domain_tags": [
        "econometrics",
        "optimization",
        "linear_algebra"
      ],
      "intuition_oneliner": "データと直線のズレ（残差平方和）を最小にする最適な係数を、一発の計算式でズバリ求める方法です。",
      "diagram_svg": "<svg viewBox=\"0 0 600 260\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M 100 200 Q 300 50 500 200\" fill=\"none\" stroke=\"#3b82f6\" stroke-width=\"3\"/><circle cx=\"300\" cy=\"100\" r=\"6\" fill=\"#10b981\"/><text x=\"260\" y=\"80\" fill=\"#10b981\" font-size=\"16\">最小値 (OLS)</text><text x=\"180\" y=\"160\" fill=\"currentColor\" font-size=\"16\">残差平方和の底を狙う</text></svg>"
    },
    {
      "id": "econ.met.n03_ols_unbiasedness_covariance",
      "short_code": "MET03",
      "kind": "theorem_formula",
      "title": "OLS推定量の条件付き不偏性と共分散行列",
      "summary": "ガウス＝マルコフ仮定の下で、OLS推定量が真の母数ベクトルの条件付き不偏推定量であること、およびその条件付き共分散行列の閉形式を示す。",
      "canonical_latex": "\\mathbb{E}[\\hat{\\boldsymbol{\\beta}}_{\\mathrm{OLS}} \\mid X] = \\boldsymbol{\\beta},\\qquad \\operatorname{Var}(\\hat{\\boldsymbol{\beta}}_{\\mathrm{OLS}} \\mid X) = \\sigma^2 (X^\\top X)^{-1}",
      "aliases_latex": [
        "\\operatorname{Cov}(\\hat{\\boldsymbol{\\beta}}_{\\mathrm{OLS}} \\mid X) = \\sigma^2 (X^\\top X)^{-1}"
      ],
      "keywords": [
        "不偏性",
        "条件付き期待値",
        "共分散行列",
        "OLS推定量"
      ],
      "domain_tags": [
        "econometrics",
        "statistics"
      ]
    },
    {
      "id": "econ.met.n04_gauss_markov_theorem_blue",
      "short_code": "MET04",
      "kind": "theorem_formula",
      "title": "ガウス＝マルコフの定理（BLUE：最良線形不偏推定量）",
      "summary": "ガウス＝マルコフ仮定が成立するとき、任意の線形不偏推定量に対してOLS推定量の共分散行列との差が半正定値となり、OLSが最小分散性（BLUE）を持つことを証明する。",
      "canonical_latex": "\\tilde{\\boldsymbol{\\beta}} = C\\mathbf{y},\\; \\mathbb{E}[\\tilde{\\boldsymbol{\\beta}} \\mid X] = \\boldsymbol{\\beta} \\implies \\operatorname{Var}(\\tilde{\\boldsymbol{\\beta}} \\mid X) - \\operatorname{Var}(\\hat{\\boldsymbol{\\beta}}_{\\mathrm{OLS}} \\mid X) = \\sigma^2 D D^\\top \\succeq 0\\;\\big(D := C - (X^\\top X)^{-1}X^\\top\\big)",
      "aliases_latex": [
        "\\operatorname{Var}(\\mathbf{c}^\\top \\tilde{\\boldsymbol{\\beta}} \\mid X) \\ge \\operatorname{Var}(\\mathbf{c}^\\top \\hat{\\boldsymbol{\\beta}}_{\\mathrm{OLS}} \\mid X)"
      ],
      "keywords": [
        "ガウス＝マルコフの定理",
        "BLUE",
        "最良線形不偏推定量",
        "半正定値",
        "効率性"
      ],
      "domain_tags": [
        "econometrics",
        "statistics",
        "linear_algebra"
      ]
    },
    {
      "id": "econ.met.n05_endogeneity_ols_bias",
      "short_code": "MET05",
      "kind": "theorem_formula",
      "title": "内生性によるOLS推定量のバイアスと不一致",
      "summary": "説明変数と誤差項の相関（内生性）が存在する場合、OLS推定量の確率極限が真の母数から乖離し、不偏性および一致性が破綻することを示す。",
      "canonical_latex": "\\mathbb{E}[\\mathbf{x}_i \\varepsilon_i] \\neq \\mathbf{0} \\implies \\hat{\\boldsymbol{\\beta}}_{\\mathrm{OLS}} - \\boldsymbol{\\beta} = \\left(\\frac{1}{n}X^\\top X\\right)^{-1}\\left(\\frac{1}{n}X^\\top \\boldsymbol{\\varepsilon}\\right) \\xrightarrow{p} \\mathbb{E}[\\mathbf{x}_i \\mathbf{x}_i^\\top]^{-1} \\mathbb{E}[\\mathbf{x}_i \\varepsilon_i] \\neq \\mathbf{0}",
      "aliases_latex": [
        "\\operatorname{plim}\\hat{\\boldsymbol{\\beta}}_{\\mathrm{OLS}} = \\boldsymbol{\\beta} + \\mathbb{E}[\\mathbf{x}_i \\mathbf{x}_i^\\top]^{-1}\\mathbb{E}[\\mathbf{x}_i \\varepsilon_i]"
      ],
      "keywords": [
        "内生性",
        "欠落変数バイアス",
        "同時方程式バイアス",
        "測定誤差",
        "一致性"
      ],
      "domain_tags": [
        "econometrics",
        "statistics"
      ]
    },
    {
      "id": "econ.met.n06_iv_relevance_exogeneity_def",
      "short_code": "MET06",
      "kind": "definition",
      "title": "操作変数（IV）の関連性条件・外生性条件の定義",
      "summary": "内生性問題を解決するために導入される操作変数ベクトルが満たすべき2つの基本条件（関連性条件と除外制約を含む外生性条件）および次数条件を定義する。",
      "canonical_latex": "\\text{Relevance: }\\operatorname{rank}(\\mathbb{E}[\\mathbf{z}_i \\mathbf{x}_i^\\top]) = k,\\qquad \\text{Exogeneity: }\\mathbb{E}[\\mathbf{z}_i \\varepsilon_i] = \\mathbf{0},\\qquad l \\ge k",
      "aliases_latex": [
        "\\mathbb{E}[\\mathbf{z}_i \\varepsilon_i] = \\mathbf{0},\\; \\operatorname{rank}(\\Sigma_{zx}) = k"
      ],
      "keywords": [
        "操作変数",
        "関連性条件",
        "外生性条件",
        "識別条件",
        "次数条件"
      ],
      "domain_tags": [
        "econometrics",
        "causal_inference"
      ]
    },
    {
      "id": "econ.met.n07_iv_just_identified_estimator",
      "short_code": "MET07",
      "kind": "theorem_formula",
      "title": "ちょうど識別された操作変数推定量（IV推定量）と一致性",
      "summary": "操作変数の数と説明変数の数が等しい（ちょうど識別された）場合に、標本モーメント条件から操作変数推定量を導出し、その一致性を示す。",
      "canonical_latex": "l = k \\implies \\hat{\\boldsymbol{\\beta}}_{\\mathrm{IV}} = (Z^\\top X)^{-1} Z^\\top \\mathbf{y} = \\boldsymbol{\\beta} + (Z^\\top X)^{-1} Z^\\top \\boldsymbol{\\varepsilon} \\xrightarrow{p} \\boldsymbol{\\beta}",
      "aliases_latex": [
        "\\hat{\\boldsymbol{\\beta}}_{\\mathrm{IV}} = (Z^\\top X)^{-1} Z^\\top \\mathbf{y}"
      ],
      "keywords": [
        "IV推定量",
        "ちょうど識別",
        "モーメント法",
        "一致性"
      ],
      "domain_tags": [
        "econometrics",
        "causal_inference"
      ]
    },
    {
      "id": "econ.met.n08_2sls_estimator",
      "short_code": "MET08",
      "kind": "theorem_formula",
      "title": "2段階最小二乗推定量（2SLS）の導出",
      "summary": "過剰識別を含む一般の操作変数モデルにおいて、第1段階の射影行列による説明変数の予測値を用いた第2段階OLS回帰から2SLS推定量を導出する。",
      "canonical_latex": "\\hat{X} := P_Z X = Z(Z^\\top Z)^{-1} Z^\\top X,\\qquad \\hat{\\boldsymbol{\\beta}}_{\\mathrm{2SLS}} = (\\hat{X}^\\top \\hat{X})^{-1} \\hat{X}^\\top \\mathbf{y} = (X^\\top P_Z X)^{-1} X^\\top P_Z \\mathbf{y}",
      "aliases_latex": [
        "\\hat{\\boldsymbol{\\beta}}_{\\mathrm{2SLS}} = \\big(X^\\top Z(Z^\\top Z)^{-1} Z^\\top X\\big)^{-1} X^\\top Z(Z^\\top Z)^{-1} Z^\\top \\mathbf{y}"
      ],
      "keywords": [
        "2段階最小二乗法",
        "2SLS",
        "射影行列",
        "過剰識別",
        "操作変数法"
      ],
