    {
      "id": "eng.mod.n01_signal_space_constellation",
      "short_code": "MOD01",
      "kind": "definition",
      "title": "信号空間表現とコンステレーション（ASK/PSK/QAM）の定義",
      "summary": "正規直交基底関数系を用いて変調波形の集合をN次元ユークリッド空間内の信号点ベクトル（コンステレーション）として表現する。",
      "canonical_latex": "s_m(t) = \\sum_{k=1}^{N} s_{mk}\\phi_k(t),\\quad \\langle \\phi_j, \\phi_k \\rangle = \\delta_{jk},\\quad E_m = \\|\\mathbf{s}_m\\|^2 = \\sum_{k=1}^{N} |s_{mk}|^2",
      "aliases_latex": [
        "s_m(t) = \\operatorname{Re}\\left\\{\\tilde{s}_m g(t) e^{j2\\pi f_c t}\\right\\}",
        "s_m = \\sqrt{E_s} e^{j2\\pi m/M}"
      ],
      "keywords": [
        "信号空間",
        "コンステレーション",
        "ASK",
        "PSK",
        "QAM",
        "正規直交基底"
      ],
      "domain_tags": [
        "communications",
        "digital_modulation"
      ],
      "intuition_oneliner": "要するに何？: 複雑な波形の変調を、多次元空間の「点（座標）」の集まりとしてシンプルに捉える手法。",
      "diagram_svg": "<svg viewBox=\"0 0 600 260\" xmlns=\"http://www.w3.org/2000/svg\"><line x1=\"100\" y1=\"200\" x2=\"500\" y2=\"200\" stroke=\"currentColor\" stroke-width=\"2\"/><line x1=\"100\" y1=\"200\" x2=\"100\" y2=\"50\" stroke=\"currentColor\" stroke-width=\"2\"/><text x=\"510\" y=\"205\" fill=\"currentColor\">φ1</text><text x=\"95\" y=\"40\" fill=\"currentColor\">φ2</text><circle cx=\"200\" cy=\"150\" r=\"6\" fill=\"#3b82f6\"/><circle cx=\"300\" cy=\"100\" r=\"6\" fill=\"#f97316\"/><circle cx=\"400\" cy=\"170\" r=\"6\" fill=\"#10b981\"/><text x=\"210\" y=\"155\" fill=\"currentColor\">s1</text><text x=\"310\" y=\"105\" fill=\"currentColor\">s2</text><text x=\"410\" y=\"175\" fill=\"currentColor\">s3</text></svg>"
    },
    {
      "id": "eng.mod.n02_awgn_q_function",
      "short_code": "MOD02",
      "kind": "definition",
      "title": "AWGNチャネルモデルとQ関数（ガウス裾確率）の定義",
      "summary": "両側電力スペクトル密度N0/2の加法性白色ガウス雑音（AWGN）を正規直交基底へ射影した等価ベクトル雑音モデルと、標準正規分布の右側裾確率を表すQ関数を定義する。",
      "canonical_latex": "\\mathbf{r} = \\mathbf{s}_m + \\mathbf{n},\\quad \\mathbf{n} \\sim \\mathcal{N}\\!\\left(\\mathbf{0}, \\frac{N_0}{2}I_N\\right),\\quad Q(x) := \\frac{1}{\\sqrt{2\\pi}}\\int_{x}^{\\infty} e^{-t^2/2}\\,dt",
      "aliases_latex": [
        "Q(x) = \\frac{1}{2}\\operatorname{erfc}\\!\\left(\\frac{x}{\\sqrt{2}}\\right)"
      ],
      "keywords": [
        "AWGN",
        "Q関数",
        "白色ガウス雑音",
        "相関受信機",
        "尤度"
      ],
      "domain_tags": [
        "communications",
        "information_theory"
      ]
    },
    {
      "id": "eng.mod.n03_bpsk_ber",
      "short_code": "MOD03",
      "kind": "theorem_formula",
      "title": "AWGN下におけるBPSKのビット誤り率（BER）公式",
      "summary": "対蹠信号点を持つ2相位相偏移変調（BPSK）について、AWGNチャネル下での最適硬判定受信におけるビット誤り率を与える。",
      "canonical_latex": "P_b^{\\mathrm{BPSK}} = Q\\!\\left(\\sqrt{\\frac{2E_b}{N_0}}\\right)",
      "aliases_latex": [
        "P_b = \\frac{1}{2}\\operatorname{erfc}\\!\\left(\\sqrt{\\frac{E_b}{N_0}}\\right)"
      ],
      "keywords": [
        "BPSK",
        "ビット誤り率",
        "BER",
        "Eb/N0",
        "Q関数"
      ],
      "domain_tags": [
        "communications",
        "error_analysis"
      ]
    },
    {
      "id": "eng.mod.n04_qpsk_ber",
      "short_code": "MOD04",
      "kind": "theorem_formula",
      "title": "AWGN下におけるQPSKのシンボル誤り率とビット誤り率（グレイ符号化）",
      "summary": "QPSKを直交するI/Qの独立な2つのBPSKチャネルに分解することで、グレイ符号化時のBERがBPSKと一致すること、およびSERの厳密式を導く。",
      "canonical_latex": "P_b^{\\mathrm{QPSK}} = Q\\!\\left(\\sqrt{\\frac{2E_b}{N_0}}\\right),\\qquad P_s^{\\mathrm{QPSK}} = 2Q\\!\\left(\\sqrt{\\frac{2E_b}{N_0}}\\right) - Q^2\\!\\left(\\sqrt{\\frac{2E_b}{N_0}}\\right)",
      "aliases_latex": [
        "P_s^{\\mathrm{QPSK}} \\approx 2Q\\!\\left(\\sqrt{\\frac{E_s}{N_0}}\\right)"
      ],
      "keywords": [
        "QPSK",
        "グレイ符号",
        "シンボル誤り率",
        "SER",
        "BER"
      ],
      "domain_tags": [
        "communications",
        "error_analysis"
      ]
    },
    {
      "id": "eng.mod.n05_mqam_ser_bound",
      "short_code": "MOD05",
      "kind": "theorem_formula",
      "title": "正方M-QAMのシンボル誤り率公式",
      "summary": "正方格子状のM-QAM（M=2^{2k}）をI/Q独立な2つの√M-PAMへ分解し、平均シンボルエネルギーEsと最小ユークリッド距離から厳密なシンボル誤り率を導く。",
      "canonical_latex": "P_s^{M\\text{-QAM}} = 4\\left(1 - \\frac{1}{\\sqrt{M}}\\right)Q\\!\\left(\\sqrt{\\frac{3E_s}{(M-1)N_0}}\\right) - 4\\left(1 - \\frac{1}{\\sqrt{M}}\\right)^2 Q^2\\!\\left(\\sqrt{\\frac{3E_s}{(M-1)N_0}}\\right)",
      "aliases_latex": [
        "P_s^{M\\text{-QAM}} \\le 4\\left(1 - \\frac{1}{\\sqrt{M}}\\right)Q\\!\\left(\\sqrt{\\frac{3E_s}{(M-1)N_0}}\\right)"
      ],
      "keywords": [
        "M-QAM",
        "PAM",
        "シンボル誤り率",
        "多値変調",
        "ユニオン境界"
      ],
      "domain_tags": [
