    {
      "id": "eng.mod.n07_ofdm_subcarrier_orthogonality",
      "short_code": "MOD07",
      "kind": "definition",
      "title": "OFDMマルチキャリア変調とサブキャリア直交条件",
      "summary": "シンボル長T_symの逆数に等しいサブキャリア間隔Δf=1/T_symを選ぶことで、スペクトルが重なり合いながらも各サブキャリアが積分内積において直交するOFDM信号モデルを定義する。",
      "canonical_latex": "x(t) = \\frac{1}{\\sqrt{N}}\\sum_{k=0}^{N-1} X[k] e^{j 2\\pi k \\Delta f t},\\quad \\Delta f = \\frac{1}{T_{\\mathrm{sym}}},\\quad \\frac{1}{T_{\\mathrm{sym}}}\\int_{0}^{T_{\\mathrm{sym}}} e^{j 2\\pi (k-m)\\Delta f t}\\,dt = \\delta_{km}",
      "aliases_latex": [
        "\\langle \\phi_k, \\phi_m \\rangle = \\delta_{km}"
      ],
      "keywords": [
        "OFDM",
        "サブキャリア",
        "直交性",
        "マルチキャリア変調"
      ],
      "domain_tags": [
        "communications",
        "ofdm"
      ]
    },
    {
      "id": "eng.mod.n08_ofdm_idft_dft_realization",
      "short_code": "MOD08",
      "kind": "theorem_formula",
      "title": "IDFT/DFTによるOFDMベースバンド変復調の実現",
      "summary": "連続時間OFDM信号をN点離散サンプリングすることで送信変調が逆離散フーリエ変換（IDFT/IFFT）、受信復調が離散フーリエ変換（DFT/FFT）と等価になることを示す。",
      "canonical_latex": "x[n] = \\frac{1}{\\sqrt{N}}\\sum_{k=0}^{N-1} X[k] e^{j\\frac{2\\pi kn}{N}},\\qquad \\hat{X}[k] = \\frac{1}{\\sqrt{N}}\\sum_{n=0}^{N-1} x[n] e^{-j\\frac{2\\pi kn}{N}} = X[k]",
      "aliases_latex": [
        "\\mathbf{x} = \\mathbf{F}_N^H \\mathbf{X},\\quad \\hat{\\mathbf{X}} = \\mathbf{F}_N \\mathbf{x}"
      ],
      "keywords": [
        "OFDM",
        "IDFT",
        "DFT",
        "FFT",
