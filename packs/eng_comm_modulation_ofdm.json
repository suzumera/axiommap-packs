      ]
    },
    {
      "id": "eng.mod.n06_nyquist_isi_criterion",
      "short_code": "MOD06",
      "kind": "theorem_formula",
      "title": "ナイキストの符号間干渉（ISI）ゼロ基準",
      "summary": "シンボル周期Tsでの標本化時に符号間干渉（ISI）がゼロとなるための時間領域条件と、折り返しスペクトルの和が一定となる周波数領域の等価条件（ナイキスト第1基準）を示す。",
      "canonical_latex": "p(nT_s) = \\delta_{n,0} \\iff \\frac{1}{T_s}\\sum_{k=-\\infty}^{\\infty} P\\!\\left(f - \\frac{k}{T_s}\\right) = 1",
      "aliases_latex": [
        "\\sum_{k=-\\infty}^{\\infty} P\\!\\left(\\Omega - k\\Omega_s\\right) = T_s"
      ],
      "keywords": [
        "符号間干渉",
        "ISI",
        "ナイキスト基準",
