    {
      "id": "astro.att.n07_gravity_gradient_stability_conditions",
      "short_code": "AT07",
      "kind": "theorem_formula",
      "title": "円軌道上の重力傾度姿勢安定条件",
      "summary": "LVLH軌道座標系で微小姿勢角線形化したピッチ・ロール・ヨー運動の安定条件。ラグランジュ領域 I_2 > I_1 > I_3 とデブラ＝デルプ領域を与える。",
      "canonical_latex": "k_2 = \\frac{I_1 - I_3}{I_2} > 0 \\text{ (pitch)},\\quad 1 + 3k_1 + k_1 k_3 > 0,\\; 4k_1 k_3 > 0,\\; (1 + 3k_1 + k_1 k_3)^2 - 16 k_1 k_3 > 0\\;\\left(k_1 = \\frac{I_2 - I_3}{I_1},\\; k_3 = \\frac{I_2 - I_1}{I_3}\\right);\\quad I_2 > I_1 > I_3 \\text{ (sufficient)}",
