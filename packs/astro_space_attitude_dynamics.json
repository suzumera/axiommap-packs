    {
      "id": "astro.att.n08_reaction_wheel_coupled_eom",
      "short_code": "AT08",
      "kind": "theorem_formula",
      "title": "リアクションホイール搭載宇宙機の角運動量交換運動方程式",
      "summary": "内部角運動量貯蔵デバイス（リアクションホイール）の角運動量ベクトル h_w を含む宇宙機全体の角運動量保存則と結合運動方程式。",
      "canonical_latex": "\\mathbf{H}_{\\mathrm{tot}} = \\mathbf{I}_s\\boldsymbol{\\omega} + \\mathbf{h}_w,\\quad \\mathbf{I}_s\\dot{\\boldsymbol{\\omega}} + \\boldsymbol{\\omega}\\times(\\mathbf{I}_s\\boldsymbol{\\omega} + \\mathbf{h}_w) = \\boldsymbol{\\tau}_{\\mathrm{ext}} + \\boldsymbol{\\tau}_w,\\quad \\boldsymbol{\\tau}_w := -\\dot{\\mathbf{h}}_w",
