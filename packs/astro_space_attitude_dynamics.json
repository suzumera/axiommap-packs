    {
      "id": "astro.att.n09_quaternion_pd_feedback_control",
      "short_code": "AT09",
      "kind": "theorem_formula",
      "title": "クォータニオン誤差に基づくリアクションホイールPD姿勢安定化則",
      "summary": "誤差クォータニオンのベクトル部と角速度フィードバックおよびジャイロ補償項による3軸姿勢安定化制御則と、リアプノフ関数による大域漸近安定性。",
      "canonical_latex": "\\boldsymbol{\\tau}_w = -K_p\\mathbf{q}_{e,v} - K_d\\boldsymbol{\\omega} + \\boldsymbol{\\omega}\\times(\\mathbf{I}_s\\boldsymbol{\\omega} + \\mathbf{h}_w),\\quad V(q_e,\\boldsymbol{\\omega}) = \\frac{1}{2}\\boldsymbol{\\omega}^\\top\\mathbf{I}_s\\boldsymbol{\\omega} + K_p\\big((q_{e,0}-1)^2 + \\|\\mathbf{q}_{e,v}\\|^2\\big) \\implies \\dot{V} = -\\boldsymbol{\\omega}^\\top K_d\\boldsymbol{\\omega} \\le 0",
