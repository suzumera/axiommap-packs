    {
      "id": "astro.att.n05_torque_free_spin_stability",
      "short_code": "AT05",
      "kind": "theorem_formula",
      "title": "無トルク剛体の純粋スピン安定性と中間軸定理",
      "summary": "外力トルクがない剛体における主軸周りの定常スピン運動の線形安定性条件。最大または最小慣性主軸周りのスピンは安定であり、中間軸周りは不安定となる。",
      "canonical_latex": "\\lambda^2 + \\frac{(I_3 - I_1)(I_3 - I_2)}{I_1 I_2}\\Omega^2 = 0 \\implies \\text{linearly stable} \\iff (I_3 > I_1 \\land I_3 > I_2) \\lor (I_3 < I_1 \\land I_3 < I_2)",
      "aliases_latex": [
