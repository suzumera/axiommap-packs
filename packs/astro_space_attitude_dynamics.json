        "オイラーパラメータ",
        "方向余弦行列"
      ],
      "domain_tags": [
        "orbital_mechanics",
        "attitude_dynamics"
      ]
    },
    {
      "id": "astro.att.n04_quaternion_kinematics_ode",
      "short_code": "AT04",
      "kind": "theorem_formula",
      "title": "クォータニオン姿勢運動学微分方程式",
      "summary": "機体角速度ベクトル ω による姿勢クォータニオンの時間発展を記述する線形時変微分方程式。",
      "canonical_latex": "\\dot{q} = \\frac{1}{2}\\Omega(\\boldsymbol{\\omega})q = \\frac{1}{2}\\begin{pmatrix} 0 & -\\boldsymbol{\\omega}^\\top \\\\ \\boldsymbol{\\omega} & -[\\boldsymbol{\\omega}]_\\times \\end{pmatrix}\\begin{pmatrix} q_0 \\\\ \\mathbf{q}_v \\end{pmatrix},\\quad \\dot{q}_0 = -\\frac{1}{2}\\boldsymbol{\\omega}^\\top\\mathbf{q}_v,\\quad \\dot{\\mathbf{q}}_v = \\frac{1}{2}\\big(q_0 I_3 + [\\mathbf{q}_v]_\\times\\big)\\boldsymbol{\\omega}",
      "aliases_latex": [
