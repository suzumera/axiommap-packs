  "nodes": [
    {
      "id": "astro.att.n01_rigid_body_inertia_angular_momentum",
      "short_code": "AT01",
      "kind": "definition",
      "title": "剛体の慣性テンソルと機体固定座標系における角運動量",
      "summary": "剛体内の質量分布を表す対称正定値な慣性テンソル I と、機体固定座標系における角速度ベクトル ω に対する角運動量ベクトル H = Iω の定義。",
      "canonical_latex": "\\mathbf{H} = \\mathbf{I}\\boldsymbol{\\omega},\\quad \\mathbf{I} := \\int_{\\mathcal{B}} \\big(\\|\\mathbf{r}\\|^2 I_3 - \\mathbf{r}\\mathbf{r}^\\top\\big)\\,dm,\\quad \\mathbf{I} = \\mathrm{diag}(I_1, I_2, I_3)\\text{ (principal axes)}",
      "aliases_latex": [
        "H_i = \\sum_{j=1}^{3} I_{ij}\\omega_j",
        "\\mathbf{I} = -\\int_{\\mathcal{B}} [\\mathbf{r}]_\\times^2\\,dm"
      ],
      "keywords": [
        "慣性テンソル",
        "角運動量",
        "主慣性モーメント",
        "剛体力学"
      ],
      "domain_tags": [
        "orbital_mechanics",
        "attitude_dynamics"
      ],
      "intuition_oneliner": "要するに、回転しやすさ（慣性テンソル）に回転の勢い（角速度）を掛け合わせて、物体の回転の勢い（角運動量）を求める法則です。",
      "diagram_svg": "<svg viewBox='0 0 600 260' xmlns='http://www.w3.org/2000/svg'><circle cx='300' cy='130' r='80' fill='none' stroke='currentColor' stroke-width='2'/><path d='M220 130 L380 130' stroke='#3b82f6' stroke-width='2'/><path d='M300 50 L300 210' stroke='#3b82f6' stroke-width='2'/><path d='M300 130 C350 100 380 150 350 180' fill='none' stroke='#f97316' stroke-width='3'/><text x='360' y='170' fill='#f97316' font-size='14'>ω</text><text x='250' y='40' fill='#10b981' font-size='14'>慣性テンソル I</text></svg>"
    },
    {
      "id": "astro.att.n02_euler_rigid_body_equations",
      "short_code": "AT02",
      "kind": "theorem_formula",
      "title": "オイラーの剛体回転運動方程式",
      "summary": "回転する機体固定座標系での時間微分則（輸送定理）を角運動量保存則に適用して得られる、剛体の非線形姿勢運動方程式。",
      "canonical_latex": "\\mathbf{I}\\dot{\\boldsymbol{\\omega}} + \\boldsymbol{\\omega}\\times(\\mathbf{I}\\boldsymbol{\\omega}) = \\boldsymbol{\\tau},\\quad I_1\\dot{\\omega}_1 - (I_2 - I_3)\\omega_2\\omega_3 = \\tau_1,\\; I_2\\dot{\\omega}_2 - (I_3 - I_1)\\omega_3\\omega_1 = \\tau_2,\\; I_3\\dot{\\omega}_3 - (I_1 - I_2)\\omega_1\\omega_2 = \\tau_3",
      "aliases_latex": [
        "\\dot{\\mathbf{H}} + \\boldsymbol{\\omega}\\times\\mathbf{H} = \\boldsymbol{\\tau}"
      ],
      "keywords": [
        "オイラー方程式",
        "剛体回転",
        "角運動量",
        "輸送定理"
      ],
      "domain_tags": [
        "orbital_mechanics",
        "attitude_dynamics"
      ],
      "intuition_oneliner": "コマのように回転する物体が、遠心力やジャイロ効果を受けてどのように姿勢を崩していくかを記述する方程式です。",
      "diagram_svg": "<svg viewBox='0 0 600 260' xmlns='http://www.w3.org/2000/svg'><ellipse cx='300' cy='140' rx='120' ry='60' fill='none' stroke='currentColor' stroke-dasharray='4 4' stroke-width='2'/><path d='M300 80 C 360 80, 420 120, 380 180' fill='none' stroke='#3b82f6' stroke-width='3'/><polygon points='385,175 390,190 375,185' fill='#3b82f6'/><text x='300' y='50' fill='currentColor' text-anchor='middle' font-size='16'>Iω̇ + ω × (Iω) = τ</text><text x='300' y='220' fill='currentColor' text-anchor='middle' font-size='14'>剛体の非線形回転運動</text></svg>"
    },
    {
      "id": "astro.att.n03_attitude_quaternion_def",
      "short_code": "AT03",
      "kind": "definition",
      "title": "姿勢クォータニオン（オイラーパラメータ）と方向余弦行列",
      "summary": "特異点のない姿勢表現として用いられる単位四元数 q = (q_0, q_v^T)^T の定義と、SU(2) から SO(3) への二重被覆写像による方向余弦行列 C(q) の表示。",
      "canonical_latex": "q = \\begin{pmatrix} q_0 \\\\ \\mathbf{q}_v \\end{pmatrix} = \\begin{pmatrix} \\cos\\frac{\\theta}{2} \\\\ \\hat{\\mathbf{n}}\\sin\\frac{\\theta}{2} \\end{pmatrix},\\quad q_0^2 + \\|\\mathbf{q}_v\\|^2 = 1,\\quad C(q) = (q_0^2 - \\|\\mathbf{q}_v\\|^2)I_3 + 2\\mathbf{q}_v\\mathbf{q}_v^\\top - 2q_0[\\mathbf{q}_v]_\\times",
      "aliases_latex": [
        "q = q_0 + q_1 i + q_2 j + q_3 k,\\; \\|q\\|=1"
      ],
      "keywords": [
        "クォータニオン",
