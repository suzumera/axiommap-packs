    "language": "ja",
    "description": "状態方程式 ẋ=Ax+Bu, y=Cx の解、可制御性・可観測性行列のランク条件、状態フィードバックによる極配置、ルーエンバーガーオブザーバと分離定理を導出する。"
  },
  "nodes": [
    {
      "id": "eng.ctrl3.n01_state_space_model_def",
      "short_code": "CTRL3_01",
      "kind": "definition",
      "title": "連続時間LTIシステムの状態空間表現",
      "summary": "n次元状態ベクトル、m次元入力、p次元出力を用いた1階連立線形常微分方程式（状態方程式）および出力方程式によるシステム表現の定義。",
      "canonical_latex": "\\dot{\\mathbf{x}}(t) = A\\mathbf{x}(t) + B\\mathbf{u}(t),\\qquad \\mathbf{y}(t) = C\\mathbf{x}(t) + D\\mathbf{u}(t)\\quad (\\mathbf{x}\\in\\mathbb{R}^n,\\;\\mathbf{u}\\in\\mathbb{R}^m,\\;\\mathbf{y}\\in\\mathbb{R}^p)",
      "aliases_latex": [
        "\\dot{x} = Ax + Bu,\\; y = Cx + Du"
      ],
      "keywords": [
        "状態空間表現",
        "状態方程式",
        "出力方程式",
        "LTIシステム",
        "状態ベクトル"
      ],
      "domain_tags": [
        "control_engineering",
        "modern_control"
      ]
    },
    {
      "id": "eng.ctrl3.n02_state_transition_matrix",
      "short_code": "CTRL3_02",
      "kind": "theorem_formula",
      "title": "行列指数関数と状態遷移行列",
      "summary": "正方行列Aに対する行列指数関数e^{At}のべき級数定義と、時間微分法則および半群性（状態遷移行列としての性質）。",
      "canonical_latex": "\\Phi(t) = e^{At} := \\sum_{k=0}^{\\infty}\\frac{A^k t^k}{k!},\\quad \\frac{d}{dt}e^{At} = A e^{At} = e^{At} A,\\quad e^{A(t_1+t_2)} = e^{At_1}e^{At_2},\\quad (e^{At})^{-1} = e^{-At}",
      "aliases_latex": [
        "\\Phi(t,t_0) = e^{A(t-t_0)}"
      ],
      "keywords": [
        "行列指数関数",
        "状態遷移行列",
        "半群性",
        "マクローリン展開"
      ],
      "domain_tags": [
        "control_engineering",
        "modern_control"
      ]
    },
    {
      "id": "eng.ctrl3.n03_state_equation_solution",
      "short_code": "CTRL3_03",
      "kind": "theorem_formula",
      "title": "状態方程式の一般解（零入力応答と零状態応答）",
      "summary": "初期状態x(0)と入力u(t)に対する線形状態方程式の時間領域一般解（畳み込み積分表示）および出力応答。",
      "canonical_latex": "\\mathbf{x}(t) = e^{At}\\mathbf{x}(0) + \\int_{0}^{t} e^{A(t-\\tau)}B\\mathbf{u}(\\tau)\\,d\\tau,\\qquad \\mathbf{y}(t) = Ce^{At}\\mathbf{x}(0) + C\\int_{0}^{t} e^{A(t-\\tau)}B\\mathbf{u}(\\tau)\\,d\\tau + D\\mathbf{u}(t)",
      "aliases_latex": [
        "X(s) = (sI - A)^{-1}\\mathbf{x}(0) + (sI - A)^{-1}B U(s)"
      ],
      "keywords": [
        "状態方程式の解",
        "零入力応答",
        "零状態応答",
        "定数変化法"
      ],
      "domain_tags": [
        "control_engineering",
        "modern_control"
      ]
    },
    {
      "id": "eng.ctrl3.n04_controllability_rank_condition",
      "short_code": "CTRL3_04",
      "kind": "theorem_formula",
      "title": "可制御性とカルマンの可制御性行列ランク条件",
      "summary": "任意の初期状態から有限時間で原点（または任意の状態）へ遷移させる入力が存在する条件と、可制御性行列のフルランク条件。",
      "canonical_latex": "\\mathcal{C} := \\begin{bmatrix} B & AB & A^2B & \\cdots & A^{n-1}B \\end{bmatrix} \\in \\mathbb{R}^{n\\times nm},\\qquad (A,B)\\text{ is controllable} \\iff \\operatorname{rank}(\\mathcal{C}) = n",
      "aliases_latex": [
        "\\operatorname{rank}[B\\; AB\\; \\cdots\\; A^{n-1}B] = n"
      ],
      "keywords": [
        "可制御性",
        "可制御性行列",
        "ランク条件",
        "ケイリー・ハミルトンの定理"
      ],
      "domain_tags": [
        "control_engineering",
        "modern_control"
      ]
    },
    {
      "id": "eng.ctrl3.n05_observability_rank_condition",
      "short_code": "CTRL3_05",
      "kind": "theorem_formula",
      "title": "可観測性と可観測性行列ランク条件（双対性）",
      "summary": "有限時間の入出力観測から初期状態を一意に決定できる条件と、可観測性行列のフルランク条件および可制御性との双対関係。",
      "canonical_latex": "\\mathcal{O} := \\begin{bmatrix} C \\\\ CA \\\\ CA^2 \\\\ \\vdots \\\\ CA^{n-1} \\end{bmatrix} \\in \\mathbb{R}^{np\\times n},\\qquad (C,A)\\text{ is observable} \\iff \\operatorname{rank}(\\mathcal{O}) = n",
      "aliases_latex": [
        "(C,A)\\text{ observable} \\iff (A^\\top, C^\\top)\\text{ controllable}"
      ],
      "keywords": [
        "可観測性",
        "可観測性行列",
        "双対原理",
        "ランク条件"
      ],
      "domain_tags": [
        "control_engineering",
        "modern_control"
      ]
    },
    {
      "id": "eng.ctrl3.n06_state_feedback_pole_placement",
      "short_code": "CTRL3_06",
      "kind": "theorem_formula",
      "title": "状態フィードバック制御と極配置定理",
      "summary": "状態フィードバック則u=-Kx+rによる閉ループ系と、可制御性を必要十分条件として閉ループ極を任意に配置できる極配置定理。",
      "canonical_latex": "\\mathbf{u}(t) = -K\\mathbf{x}(t) + \\mathbf{r}(t) \\implies \\dot{\\mathbf{x}} = (A-BK)\\mathbf{x} + B\\mathbf{r};\\quad \\operatorname{rank}(\\mathcal{C})=n \\iff \\forall \\{\\lambda_i\\}_{i=1}^n,\\;\\exists K\\text{ s.t. }\\det(sI - A + BK) = \\prod_{i=1}^{n}(s-\\lambda_i)",
      "aliases_latex": [
        "K = \\begin{bmatrix} 0 & \\cdots & 0 & 1 \\end{bmatrix}\\mathcal{C}^{-1}p_{\\mathrm{des}}(A)"
      ],
      "keywords": [
        "状態フィードバック",
        "極配置法",
        "アッカーマンの公式",
        "閉ループ極"
      ],
      "domain_tags": [
        "control_engineering",
        "modern_control"
      ]
    },
    {
      "id": "eng.ctrl3.n07_luenberger_observer",
      "short_code": "CTRL3_07",
      "kind": "theorem_formula",
      "title": "ルーエンバーガー状態オブザーバと誤差ダイナミクス",
      "summary": "出力誤差フィードバックにより状態推定値x_hatを構成するルーエンバーガーオブザーバと、可観測性下での推定誤差の指数的収束。",
      "canonical_latex": "\\dot{\\hat{\\mathbf{x}}}(t) = A\\hat{\\mathbf{x}}(t) + B\\mathbf{u}(t) + L\\big(\\mathbf{y}(t) - C\\hat{\\mathbf{x}}(t)\\big),\\quad \\mathbf{e}(t) := \\mathbf{x}(t) - \\hat{\\mathbf{x}}(t) \\implies \\dot{\\mathbf{e}}(t) = (A - LC)\\mathbf{e}(t)",
      "aliases_latex": [
        "\\det(sI - A + LC) = \\prod_{i=1}^{n}(s - \\mu_i)"
      ],
      "keywords": [
        "状態オブザーバ",
        "ルーエンバーガーオブザーバ",
        "推定誤差",
        "オブザーバゲイン"
      ],
      "domain_tags": [
        "control_engineering",
        "modern_control"
      ]
    },
    {
      "id": "eng.ctrl3.n08_separation_principle",
      "short_code": "CTRL3_08",
      "kind": "theorem_formula",
      "title": "オブザーバ併合型状態フィードバックの分離定理",
      "summary": "推定状態を用いたフィードバック系全体の特性多項式が、状態フィードバック極とオブザーバ極の積に分離し独立設計が可能となる定理。",
      "canonical_latex": "\\mathbf{u} = -K\\hat{\\mathbf{x}} + \\mathbf{r} \\implies \\det\\!\\begin{pmatrix} sI - (A-BK) & -BK \\\\ 0 & sI - (A-LC) \\end{pmatrix} = \\det(sI - A + BK)\\det(sI - A + LC) = 0",
      "aliases_latex": [
        "\\sigma(A_{\\mathrm{cl}}) = \\sigma(A-BK) \\cup \\sigma(A-LC)"
      ],
      "keywords": [
        "分離定理",
        "動的出力フィードバック",
        "ブロック三角行列",
        "独立設計"
      ],
      "domain_tags": [
        "control_engineering",
        "modern_control"
      ]
    }
  ],
