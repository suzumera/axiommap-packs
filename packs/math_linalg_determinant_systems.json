        "余因子展開",
        "クロネッカーのデルタ"
      ],
      "domain_tags": [
        "mathematics",
        "linear_algebra"
      ]
    },
    {
      "id": "math.linalg.det07_adjugate_inverse_formula",
      "short_code": "DET07",
      "kind": "theorem_formula",
      "title": "余因子行列の恒等式と逆行列の明示公式",
      "summary": "元の行列と余因子行列の積は行列式倍の単位行列となり、det(A) != 0 のとき余因子行列を行列式で割ることで逆行列が明示的に求まる。",
      "canonical_latex": "A\\operatorname{adj}(A) = (\\operatorname{adj} A)A = \\det(A)\\,I_n,\\quad \\det(A)\\neq 0\\implies A^{-1}=\\frac{1}{\\det(A)}\\operatorname{adj}(A)",
      "aliases_latex": [
        "(A^{-1})_{ij} = \\frac{C_{ji}(A)}{\\det(A)}"
      ],
      "keywords": [
        "adjugate identity",
        "inverse matrix formula",
        "余因子行列",
        "逆行列公式"
      ],
      "domain_tags": [
        "mathematics",
        "linear_algebra"
      ]
    },
    {
      "id": "math.linalg.det08_cramers_rule",
      "short_code": "DET08",
      "kind": "theorem_formula",
      "title": "連立1次方程式のクラメルの公式",
      "summary": "正則な係数行列を持つn元連立1次方程式 Ax=b の一意解の各成分を、j列目を右辺ベクトルbで置き換えた行列の行列式とdet(A)の比で表す公式。",
      "canonical_latex": "\\det(A)\\neq 0 \\land A\\mathbf{x}=\\mathbf{b}\\implies x_j=\\frac{\\det(A_j)}{\\det(A)},\\quad A_j:=(\\mathbf{a}_1,\\dots,\\mathbf{a}_{j-1},\\mathbf{b},\\mathbf{a}_{j+1},\\dots,\\mathbf{a}_n)",
      "aliases_latex": [
        "x_j = \\frac{1}{\\det(A)}\\det[\\mathbf{a}_1,\\dots,\\mathbf{b},\\dots,\\mathbf{a}_n]\\quad (j=1,\\dots,n)"
      ],
      "keywords": [
        "Cramer's rule",
        "linear system",
        "クラメルの公式",
        "連立1次方程式"
      ],
      "domain_tags": [
        "mathematics",
        "linear_algebra"
      ]
    }
