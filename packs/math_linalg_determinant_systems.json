  "nodes": [
    {
      "id": "math.linalg.det01_alternating_multilinear_def",
      "short_code": "DET01",
      "kind": "definition",
      "title": "交代多重線形形式と行列式の公理的定義",
      "summary": "n次正方行列の列（または行）ベクトルを変数とするn重線形・交代的かつ単位行列で1をとる写像として行列式を特徴づける定義。",
      "canonical_latex": "D(\\mathbf{a}_1,\\dots,\\alpha\\mathbf{a}_k+\\beta\\mathbf{b}_k,\\dots,\\mathbf{a}_n)=\\alpha D(\\dots,\\mathbf{a}_k,\\dots)+\\beta D(\\dots,\\mathbf{b}_k,\\dots),\\quad \\mathbf{a}_i=\\mathbf{a}_j\\ (i\\neq j)\\implies D(\\mathbf{a}_1,\\dots,\\mathbf{a}_n)=0,\\quad D(\\mathbf{e}_1,\\dots,\\mathbf{e}_n)=1",
      "aliases_latex": [
        "\\det(\\dots,\\mathbf{a}_i,\\dots,\\mathbf{a}_j,\\dots)=-\\det(\\dots,\\mathbf{a}_j,\\dots,\\mathbf{a}_i,\\dots),\\quad \\det(I_n)=1"
      ],
      "keywords": [
        "alternating multilinear form",
        "determinant",
        "normalization",
        "交代多重線形性",
        "行列式"
      ],
      "domain_tags": [
        "mathematics",
        "linear_algebra"
      ]
    },
    {
      "id": "math.linalg.det02_leibniz_formula",
      "short_code": "DET02",
      "kind": "theorem_formula",
      "title": "ライプニッツの公式（置換による行列式の明示表現と一意存在）",
      "summary": "交代多重線形性と正規化条件から一意に定まる行列式の、対称群S_nの置換と符号を用いた明示公式。",
      "canonical_latex": "\\det(A) = \\sum_{\\sigma\\in S_n} \\operatorname{sgn}(\\sigma)\\prod_{i=1}^{n} A_{\\sigma(i),i} = \\sum_{\\tau\\in S_n} \\operatorname{sgn}(\\tau)\\prod_{i=1}^{n} A_{i,\\tau(i)}",
      "aliases_latex": [
        "\\det(A)=\\sum_{i_1,\\dots,i_n=1}^{n} \\varepsilon_{i_1\\cdots i_n} A_{i_1,1}\\cdots A_{i_n,n}"
      ],
      "keywords": [
        "Leibniz formula",
        "permutation",
        "sign of permutation",
        "ライプニッツの公式",
        "置換の符号"
      ],
      "domain_tags": [
        "mathematics",
        "linear_algebra"
      ]
    },
    {
      "id": "math.linalg.det03_elementary_row_ops_transpose",
      "short_code": "DET03",
      "kind": "theorem_formula",
      "title": "行列式の転置不変性と基本変形の法則",
      "summary": "転置行列の行列式は元の行列式と等しく、行（列）の交換は符号反転、スカラー倍はその倍、他行（列）の定数倍の加算は行列式を不変に保つ。",
      "canonical_latex": "\\det(A^\\top)=\\det(A),\\quad \\det(P_{ij}A)=-\\det(A),\\quad \\det(E_i(c)A)=c\\det(A),\\quad \\det(E_{ij}(c)A)=\\det(A)\\ (i\\neq j)",
      "aliases_latex": [
        "\\det(A)\\text{ invariant under } R_i \\leftarrow R_i + c R_j\\ (i\\neq j)"
      ],
      "keywords": [
        "transpose invariance",
        "elementary row operations",
        "転置不変性",
        "基本変形"
      ],
      "domain_tags": [
        "mathematics",
        "linear_algebra"
      ]
    },
    {
      "id": "math.linalg.det04_product_multiplicativity",
      "short_code": "DET04",
      "kind": "theorem_formula",
      "title": "行列の積の行列式（乗法性）と正則性の行列式判定",
      "summary": "同次正方行列の積に対して行列式は準同型（乗法的）であり、行列が正則であることと行列式が非零であることは同値である。",
      "canonical_latex": "\\det(AB)=\\det(A)\\det(B),\\quad A\\in\\mathrm{GL}_n(\\mathbb{F})\\iff \\det(A)\\neq 0,\\quad \\det(A^{-1})=(\\det A)^{-1}",
      "aliases_latex": [
        "\\det(AB)=\\det(A)\\det(B),\\quad \\operatorname{rank}(A)=n \\iff \\det(A)\\neq 0"
      ],
      "keywords": [
        "multiplicativity",
        "invertibility criterion",
        "行列式の乗法性",
        "正則性判定"
      ],
      "domain_tags": [
        "mathematics",
        "linear_algebra"
      ]
    },
    {
      "id": "math.linalg.det05_minor_cofactor_def",
      "short_code": "DET05",
      "kind": "definition",
      "title": "小行列式・余因子および余因子行列の定義",
      "summary": "i行j列を除いた(n-1)次小行列の行列式（小行列式）、符号付き余因子、およびその転置として定義される余因子行列（随伴行列）。",
      "canonical_latex": "M_{ij}(A):=\\det\\big(A_{\\hat{i},\\hat{j}}\\big),\\quad C_{ij}(A):=(-1)^{i+j}M_{ij}(A),\\quad (\\operatorname{adj} A)_{ij}:=C_{ji}(A)",
      "aliases_latex": [
        "\\widetilde{A}:=\\big(C_{ji}(A)\\big)_{1\\le i,j\\le n}=\\big(C(A)\\big)^\\top"
      ],
      "keywords": [
        "minor",
        "cofactor",
        "adjugate matrix",
        "小行列式",
        "余因子行列"
      ],
      "domain_tags": [
        "mathematics",
        "linear_algebra"
      ]
    },
    {
      "id": "math.linalg.det06_cofactor_expansion",
      "short_code": "DET06",
      "kind": "theorem_formula",
      "title": "ラプラスの余因子展開と異行・異列余因子和の零性",
      "summary": "任意の行または列に沿った余因子展開が行列式を与え、異なる行または列の成分と余因子の積和は恒等的に零になる。",
      "canonical_latex": "\\sum_{k=1}^{n} A_{ik} C_{jk}(A) = \\delta_{ij}\\det(A),\\quad \\sum_{k=1}^{n} A_{ki} C_{kj}(A) = \\delta_{ij}\\det(A)",
      "aliases_latex": [
        "\\det(A)=\\sum_{j=1}^{n} A_{ij}C_{ij}(A)=\\sum_{i=1}^{n} A_{ij}C_{ij}(A)"
      ],
      "keywords": [
        "Laplace expansion",
